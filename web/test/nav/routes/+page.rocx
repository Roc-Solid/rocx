import pf.Html
import pf.Router exposing [navigate!, use_action!]
import pf.Solid exposing [create_signal!]
import ../Api
import ../Generated/Paths

meta = { title: "Home", look: "home" }

## Home: what the server says of it, a count, a button that waits for the server before it
## navigates, prose the browser never hydrates, and a place below the fold.
view! = |_| {
	(count!, set_count!) = create_signal!(0.U64)
	leave! = use_action!(Api.leave({}))
	poke! = use_action!(Api.poke({}))
	go! = || {
		said = Api.wait!({})
		navigate!("${Paths.a}?after=${said}")
	}
	<section class="home">
		<h1>Home</h1>
		<p class="said">{Api.say!("home")}</p>
		<button class="count" on:click={|| set_count!(count!() + 1)}>Clicked {count!().to_str()}</button>
		<button class="go" on:click={go!}>To A, once the server says</button>
		<button class="leave" on:click={|| leave!("now")}>Leave, where the server says</button>
		<button class="poke" on:click={|| poke!("now")}>Poke the server</button>
		<NoHydration><p class="prose">Home's prose, the server's alone</p></NoHydration>
		<div class="tall"></div>
		<p id="below">Below the fold</p>
		<a class="to-seen" href={Paths.items_id({ id: "5" })} data-rocx-preload="viewport">Item 5, prefetched once seen</a>
	</section>
}
