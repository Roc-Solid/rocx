import pf.Html
import pf.Router
import ../Api
import ../Generated/Paths

## The document around every page: its title the page's, links of every kind (each opt-out of
## navigation in place among them), a bar that says a navigation is on its way, who the server says
## is here (a read the layout keeps across pages, D-117), a note the browser never hydrates, and
## where it is.
view! = |{ meta, children, .. }|
	<>
		<!doctype html>
		<html lang="en" class={meta.look}>
			<head>
				<meta charset="utf-8" />
				<title>{meta.title} · Nav</title>
				<meta name="description" content={meta.title} />
				<link rel="stylesheet" href="/nav.css" />
			</head>
			<body class={meta.look}>
				<a class="skip" href="#main">Skip to the page</a>
				<div class="progress" class:on={Router.is_routing!({})}></div>
				<nav>
					<a class="to-home" href={Paths.root}>Home</a>
					<a class="to-a" href={Paths.a}>A</a>
					<a class="to-item" href={Paths.items_id({ id: "7" })}>Item 7</a>
					<a class="to-item-hash" href={"${Paths.items_id({ id: "8" })}#deep"}>Item 8, deep</a>
					<a class="to-a-replace" href={Paths.a} replace>A, replacing</a>
					<a class="to-a-noscroll" href={Paths.a} noscroll>A, kept scroll</a>
					<a class="to-a-off" href={Paths.a} data-rocx-preload="off">A, never prefetched</a>
					<a class="to-a-reload" href={Paths.a} data-rocx-reload>A, loaded</a>
					<a class="to-guarded" href={Paths.guarded}>Guarded</a>
					<a class="to-editor" href={Paths.editor}>Editor</a>
					<a class="to-blank" href={Paths.a} target="_blank">A, new tab</a>
					<a class="to-download" href={Paths.a} download>A, downloaded</a>
					<a class="to-external" href={Paths.a} rel="external">A, external</a>
					<a class="to-elsewhere" href="http://localhost:9/elsewhere">Elsewhere</a>
					<a class="to-nowhere" href="/nowhere">Nowhere</a>
					<a class="to-file" href="/nav.css">A file</a>
					<a class="to-below" href="#below">Below</a>
					<a class="to-top" href="#">Top</a>
				</nav>
				<p class="who">{Api.say!("who")}</p>
				<NoHydration><p class="note">The layout's note, for {meta.title}</p></NoHydration>
				<main id="main">{...children}</main>
				<footer class="at">{Router.location!({}).path}</footer>
			</body>
		</html>
	</>
