import pf.Html
import pf.Solid exposing [create_signal!]

## Control flow inside control flow: a .map in a .map's row, and a .map in a match
## arm. Their children are effectful, as a component's view! is, so they may hold control flow of
## their own; the innermost ones here are plain markup, which they may be too.
Nested := [].{
	Shelf : { id : U64, name : Str, items : List(Str) }

	view! : {} => Html
	view! = |{}| {
		(shelves!, set_shelves!) = create_signal!([{ id: 1, name: "Fruit", items: ["apple", "pear"] }, { id: 2, name: "Bread", items: ["rye"] }])
		add! = || set_shelves!(shelves!().map(|shelf| if (shelf.id == 2) { ..shelf, items: shelf.items.append("spelt") } else shelf))
		swap! = || set_shelves!(shelves!().rev())
		<section class="nested">
			<button class="add" on:click={add!}>Add</button>
			<button class="swap" on:click={swap!}>Swap</button>
			<ul class="shelves">
				{...shelves!().map(|shelf|
					<li key={shelf.id}>
						<h3>{shelf.name}</h3>
						<ol>
							{...shelf!().items.map_with_index(|item, index|
								<li key={index}>{index.to_str()}: {item}</li>
							)}
						</ol>
					</li>
				)}
			</ul>
			{match shelves!().first() {
				Ok(first) =>
					<p class="first">
						First: {first.name}
						{...first.items.map_with_index(|item, i|
							<span key={i} class="item">{item}</span>
						)}
					</p>
				Err(_) => <></>
			}}
		</section>
	}
}
