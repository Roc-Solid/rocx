import pf.Html
import pf.Solid exposing [create_signal!]
import pf.For
import pf.Transition

## Glides across boxes that scroll, for the tests (`glides_app.roc`): two lists side by side, each
## scrolling on its own. An item moved from one to the other glides above the page, lifted out of
## both (each would cut it off); items moved within a list glide in it.
Glides := [].{
	Item : { id : Str, list : Str }

	view! : {} => Html
	view! = |{}| {
		(items!, set_items!) = create_signal!([{ id: "a1", list: "a" }, { id: "a2", list: "a" }, { id: "a3", list: "a" }, { id: "b1", list: "b" }])
		across! = || set_items!(items!().map(|item| if (item.id == "a1") { ..item, list: "b" } else item))
		within! = || set_items!(items!().rev())
		<div class="glides">
			<button class="across" on:click={across!}>Across</button>
			<button class="within" on:click={within!}>Within</button>
			<div style="display: flex; gap: 40px; align-items: flex-start">
				<ul class="list a" style="overflow: auto; height: 100px; width: 120px; margin: 0; padding: 0; list-style: none">
					<For each!={items!().keep_if(|item| item.list == "a")} keyed={|item| item.id}>
						{|item!, _| <li class="item" key={item!().id} transition:move={Transition.glide.ms(600)} style="height: 30px">{item!().id}</li>}
					</For>
				</ul>
				<ul class="list b" style="overflow: auto; height: 100px; width: 120px; margin: 0; padding: 0; list-style: none">
					<For each!={items!().keep_if(|item| item.list == "b")} keyed={|item| item.id}>
						{|item!, _| <li class="item" key={item!().id} transition:move={Transition.glide.ms(600)} style="height: 30px">{item!().id}</li>}
					</For>
				</ul>
			</div>
		</div>
	}
}
