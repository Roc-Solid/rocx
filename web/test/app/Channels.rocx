import pf.Html
import pf.Endpoint
import pf.Solid exposing [create_effect!, create_signal!]
import Api

## Channels, for the tests (`channels_app.roc`), a whole document: two feeds on one org's news, a
## third on another's, each subscribing from an effect; buttons that switch the org the first two
## follow, hide the second, hide all three, say two things in one handler, and ask for a resync.
Channels := [].{

	view! : {} => Html
	view! = |{}| {
		(org!, set_org!) = create_signal!("acme")
		(second!, set_second!) = create_signal!(Bool.True)
		(any!, set_any!) = create_signal!(Bool.True)
		say! = || {
			Endpoint.say!(Api.news({ org: org!() }), Hello("one"))
			Endpoint.say!(Api.news({ org: org!() }), Hello("two"))
		}
		<>
			<!doctype html>
			<html lang="en">
				<head>
					<meta charset="utf-8" />
					<title>Channels</title>
				</head>
				<body>
					<button class="switch" on:click={|| set_org!(if (org!() == "acme") "zeta" else "acme")}>Switch</button>
					<button class="toggle" on:click={|| set_second!(!second!())}>Toggle</button>
					<button class="say" on:click={say!}>Say</button>
					<button class="resync" on:click={|| Endpoint.resync!(Api.news({ org: org!() }))}>Resync</button>
					<button class="quiet" on:click={|| set_any!(!any!())}>Quiet</button>
					{if any!() {
						<>
							<Feed name="first" org!={org!} />
							{if second!() {
								<Feed name="second" org!={org!} />
							} else {
								<></>
							}}
							<Feed name="beta" org!={|| "beta"} />
						</>
					} else {
						<></>
					}}
				</body>
			</html>
		</>
	}
}

## A feed: what its subscription to an org's news heard, in order, a line each.
Feed := [].{

	view! : { name : Str, org! : () => Str } => Html
	view! = |{ name, org! }| {
		(heard!, set_heard!) = create_signal!([])
		note! = |line| set_heard!(heard!().append(line))
		create_effect!(
			|| org!(),
			|org|
				Endpoint.subscribe!(
					Api.news({ org: org }),
					|event|
						match event {
							Resync => note!("resync ${org}")
							Message(news) => note!("${news.title} ${news.n.to_str()}")
							Refused(status, _) => note!("refused ${status.to_str()}")
							Ended(why) => note!("ended ${why}")
						},
				),
		)
		<p class={"feed ${name}"}>{Str.join_with(heard!(), ", ")}</p>
	}
}
