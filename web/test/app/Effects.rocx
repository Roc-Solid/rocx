import pf.Html
import pf.Browser
import pf.Call
import pf.Solid exposing [create_effect!, create_signal!, on_cleanup!, set_interval!]

## Effects, cleanups and timers, for the tests (`effects_app.roc`), a whole document: an effect
## that notes each run and each cleanup in the log, and from its apply, after the first, calls the
## page's `seen` (`Browser.call!`, run once the page shows what the apply wrote); a ticker inside
## an if's part, its timer counting (here and above it), listening to a stream from an effect, pacing
## beats with a timer its effect starts while `pacing!` says so, and saying when it goes.
Effects := [].{

	view! : {} => Html
	view! = |{}| {
		(count!, set_count!) = create_signal!(0.U64)
		(log!, set_log!) = create_signal!([])
		(shown!, set_shown!) = create_signal!(Bool.True)
		(ticks!, set_ticks!) = create_signal!(0.U64)
		(heard!, set_heard!) = create_signal!(0.U64)
		(pacing!, set_pacing!) = create_signal!(Bool.False)
		(beats!, set_beats!) = create_signal!(0.U64)
		note! = |line| set_log!(log!().append(line))
		create_effect!(
			|| count!(),
			|count| {
				note!("ran ${count.to_str()}")
				if count > 0 Browser.call!("seen", { count: count }) else {}
				on_cleanup!(|| note!("cleaned ${count.to_str()}"))
			},
		)
		<>
			<!doctype html>
			<html lang="en">
				<head>
					<meta charset="utf-8" />
					<title>{count!().to_str()} effects</title>
				</head>
				<body>
					<p class="log">{Str.join_with(log!(), ", ")}</p>
					<button class="more" on:click={|| set_count!(count!() + 1)}>More</button>
					<button class="toggle" on:click={|| set_shown!(!shown!())}>Toggle</button>
					<button class="pace" on:click={|| set_pacing!(!pacing!())}>Pace</button>
					<p class="ticks">{ticks!().to_str()}</p>
					<p class="heard">{heard!().to_str()}</p>
					<p class="beats">{beats!().to_str()}</p>
					{if shown!() {
						<Ticker
							tick!={|| set_ticks!(ticks!() + 1)}
							hear!={|| set_heard!(heard!() + 1)}
							pacing!={pacing!}
							beat!={|| set_beats!(beats!() + 1)}
							note!={note!}
						/>
					} else {
						<></>
					}}
				</body>
			</html>
		</>
	}
}

## Counts every 20 ms, here and in its parent; listens to `/live` from an effect; beats every
## 20 ms while `pacing!` says so, with an interval its effect's apply starts (and never clears:
## the effect's cleanup stops it); says when it goes.
Ticker := [].{

	view! : { tick! : () => {}, hear! : () => {}, pacing! : () => Bool, beat! : () => {}, note! : Str => {} } => Html
	view! = |{ tick!, hear!, pacing!, beat!, note! }| {
		(mine!, set_mine!) = create_signal!(0.U64)
		_ = set_interval!(
			20,
			|| {
				set_mine!(mine!() + 1)
				tick!()
			},
		)
		create_effect!(
			|| pacing!(),
			|pacing|
				if pacing {
					_ = set_interval!(20, beat!)
					{}
				} else {
					{}
				},
		)
		create_effect!(
			|| {},
			|{}|
				Call.listen!(
					"/live",
					|heard|
						match heard {
							Event(_) => hear!()
							_ => {}
						},
				),
		)
		on_cleanup!(|| note!("ticker gone"))
		<p class="mine">{mine!().to_str()}</p>
	}
}
