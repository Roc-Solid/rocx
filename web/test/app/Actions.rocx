import pf.Html
import pf.Show
import pf.Endpoint
import pf.Server
import pf.Solid exposing [create_signal!, create_optimistic!]
import pf.Router exposing [use_submission!, use_submissions!, use_action!, revalidate!]

## D-054, for the tests (`actions_app.roc`), a whole document: `<Meta>`, `<Link>` and `<Style>` in
## its `<head>`; a count shown ahead of the server (`create_optimistic!`), and another read; a form
## whose `by` is given ahead of time (`Endpoint.with_fields`); a form with a file; an action given a
## file's URL; a submission tried again (`retry!`); and the reads a result, or a handler, reads again
## (`revalidate!`).
Actions := [].{
	Add : { by : U64, note : Str }
	Upload : { title : Str, photo : Str }

	## GET /api/tally/count: the count, as the tests' server keeps it.
	count : {} -> Endpoint({}, {}, U64)
	count = |{}| Endpoint.remote("GET", "/api/tally/count")

	## GET /api/tally/other: another number, read beside it.
	other : {} -> Endpoint({}, {}, U64)
	other = |{}| Endpoint.remote("GET", "/api/tally/other")

	## POST /api/add: adds `by` to the count; its `note` says how the tests' server answers.
	add : {} -> Endpoint({}, Add, U64)
	add = |{}| Endpoint.remote("POST", "/api/add")

	## POST /api/upload: a title and a photo, answered with what the server got.
	upload : {} -> Endpoint({}, Upload, Str)
	upload = |{}| Endpoint.remote("POST", "/api/upload")

	## Each add, as the page lists it: its input's `by` and note, and whether it is on its way,
	## refused or done.
	listed : List({ id : U64, pending : Bool, input : Try(Add, [NoInput]), result : Try(U64, [NoResult]), error : Try(Server.Problem, [NoError]) }) -> Str
	listed = |sent| Str.join_with(sent.map(|one| "${shown_input(one.input)}:${if (one.pending) "pending" else if (one.error.is_ok()) "refused" else "done"}"), " ")

	shown_input : Try(Add, [NoInput]) -> Str
	shown_input = |input|
		match input {
			Ok(given) => "${given.by.to_str()}/${given.note}"
			Err(NoInput) => "?"
		}

	view! : {} => Html
	view! = |{}| {
		adds = use_submissions!(Actions.add({}))
		latest = use_submission!(Actions.add({}))
		add! = use_action!(Actions.add({}))
		uploads = use_submission!(Actions.upload({}))
		upload! = use_action!(Actions.upload({}))
		counted = Actions.count({})
		others = Actions.other({})
		(shown!, set_shown!) = create_optimistic!(|| Endpoint.get!(counted))
		(description!, set_description!) = create_signal!("First")
		(more!, set_more!) = create_signal!(Bool.True)
		(file!, set_file!) = create_signal!("")
		<>
			<!doctype html>
			<html lang="en">
				<head>
					<meta charset="utf-8" />
					<title>Actions</title>
					<Meta name="description" content="The layout's" />
					<Meta property="og:type" content="website" />
				</head>
				<body>
					<Meta name="description" content={description!()} />
					<Show when!={more!()}>
						<Link rel="canonical" href="/actions" />
						<Style>.count { color: rgb(1, 2, 3) }</Style>
					</Show>
					<p class="count">{shown!().to_str()}</p>
					<p class="other">{Endpoint.get!(others).to_str()}</p>
					<p class="adds">{Actions.listed(adds.all!())}</p>
					<p class="uploaded">{
						match uploads.result!() {
							Ok(said) => said
							Err(NoResult) => "none"
						}
					}</p>
					<button class="optimistic" on:click={|| {
						set_shown!(shown!() + 10)
						add!({ by: 10, note: "slow" })
					}}>Add 10</button>
					<button class="refused" on:click={|| {
						set_shown!(shown!() + 100)
						add!({ by: 100, note: "refuse" })
					}}>Add 100</button>
					<button class="write-only" on:click={|| set_shown!(999)}>Write only</button>
					<button class="count-only" on:click={|| add!({ by: 1, note: "count-only" })}>Add 1</button>
					<button class="nothing" on:click={|| add!({ by: 1, note: "nothing" })}>Add 1, read nothing</button>
					<button class="flaky" on:click={|| add!({ by: 2, note: "flaky" })}>Add 2</button>
					<button class="retry" on:click={|| latest.retry!()}>Try again</button>
					<button class="read-other" on:click={|| revalidate!([Endpoint.url_of(others)])}>Read the other</button>
					<button class="describe" on:click={|| set_description!("Second")}>Describe</button>
					<button class="less" on:click={|| set_more!(!more!())}>Less</button>
					<form class="with" method="post" action={Endpoint.url_of(Endpoint.with_fields(Actions.add({}), { by: 5.U64 }))}>
						<input name="note" value="formed" />
						<button type="submit">Add 5</button>
					</form>
					<form class="files" method="post" enctype="multipart/form-data" action={Endpoint.url_of(Actions.upload({}))}>
						<input name="title" value="Sea" />
						<input type="file" name="photo" />
						<button type="submit">Upload</button>
					</form>
					<input class="file-url" on:input.value={set_file!} />
					<button class="send-file" on:click={|| upload!({ title: "Dropped", photo: file!() })}>Send the file</button>
				</body>
			</html>
		</>
	}
}
