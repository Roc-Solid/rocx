import pf.Html
import pf.Solid exposing [create_signal!]

## A long `.map` (D-071): a thousand rows, each two holes that read its item. A row is told its item
## changed only when it isn't `==` the one it had (D-053's `compared`, every list's now). One item
## changed, or every item.
Rows := [].{
	Row : { id : U64, title : Str, done : Bool }

	view! : {} => Html
	view! = |{}| {
		(rows!, set_rows!) = create_signal!(Rows.start)
		<div>
			<button class="one" on:click={|| set_rows!(Rows.toggle(rows!(), 500))}>One</button>
			<button class="all" on:click={|| set_rows!(Rows.toggle(rows!(), 0))}>All</button>
			<ul class="rows">
				{...rows!().map(|row|
					<li key={row.id} class:done={row.done}>{row.title}</li>
				)}
			</ul>
		</div>
	}

	start : List(Rows.Row)
	start = List.repeat(0, 1000).map_with_index(|_, index| { id: index + 1, title: "Row ${(index + 1).to_str()}", done: Bool.False })

	## The row `id` done or not done again; every row with 0.
	toggle : List(Rows.Row), U64 -> List(Rows.Row)
	toggle = |rows, id| rows.map(|row| if (id == 0 or row.id == id) { ..row, done: !row.done } else row)
}
