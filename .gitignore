# The pinned toolchain (`just setup`)
.tools/

# Written by rocx build (the fixture is built by the tests, from copies)
test/e2e/fixture/*.roc
!test/e2e/fixture/main.roc
test/e2e/run-*/
site/Ui/*.roc
!site/Ui/Highlight.roc
!site/Ui/Nav.roc
site/Demos/*.roc
!site/Demos/Random.roc
site/Islands.roc
site/examples/*.roc
site/stories/*.roc
web/test/app/*.roc
!web/test/app/Api.roc
!web/test/app/main.roc
!web/test/app/*_app.roc
web/test/app/Generated/

# Written by site/build.mjs and the tests
site/Generated/
site/build/
site/dist/
web/platform/targets/
web/test/build/

# The CLI platform's (which rocx is built on) and the server platform's builds: the Rust hosts, and
# the libraries Roc links apps against
cli/host/target/
cli/platform/targets/
server/host/target/
server/platform/targets/
server/test/build/
# rocx build's and rocx check --sql's (D-058) for the server's Postgres test app (test/check-sql.test.mjs)
server/test/app/Generated/
server/test/app/build/
test/static/app/Generated/
test/static/app/build/

.DS_Store

# The spike's builds
spike/*/platform/targets/
spike/*/*.wasm
spike/*/host/target/
spike/*/build/

# rocx, built from rocx-cli/*.roc (server/build.mjs rocxBinary)
bin/rocx
bin/rocx.building-*
bin/.rocx-building
bin/.rocx-opt

# A SQLite app's database file (D-045), and its WAL beside it.
*.db
*.db-shm
*.db-wal
web/test/nav/Generated/

# The native host's builds (D-063's spike): cargo's, and an app's APK and what it is made from
native/target/
native/android/build/

# The editor packages, put together by `just vscode-extension` and `just orca-plugin`
editors/build/

# A release of rocx, made here (just release-hosts, release-pack): hosts, compilers, archives
release/out/
