import pf.Html

Components := [].{
	# example
	view : { name : Str, unread : U64 } -> Html
	view = |{ name, unread }|
		<Card title="Inbox">
			<p>Welcome back, {name}. <Badge count={unread} /></p>
		</Card>

	card : { title : Str, children : List(Html) } -> Html
	card = |{ title, children }|
		<article class="card">
			<h4>{title}</h4>
			{...children}
		</article>

	badge : { count : U64 } -> Html
	badge = |{ count }| <span class="badge" class:zero={count == 0}>{count.to_str()} new</span>
	# /example

	demo : {} -> Html
	demo = |{}| view({ name: "Grace", unread: 3 })
}
