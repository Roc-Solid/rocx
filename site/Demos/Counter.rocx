import pf.Html
import pf.Solid exposing [create_signal!]

## The smallest component: a number, and buttons that change it. The number is a signal; what reads it
## (the text, the class, the Reset button's `disabled`) runs again when it changes, and patches its
## own node. The component itself runs once. Its styles are its own: the `<style>` in its block is
## scoped to its markup, so `.counter button` here is no other component's button.
Counter := [].{
	view! : { start_value : I64 } => Html
	view! = |{ start_value }| {
		(count!, set_count!) = create_signal!(start_value)
		<div class="counter" class:negative={count!() < 0}>
			<button type="button" on:click={|| set_count!(count!() - 1)} aria-label="One less">−</button>
			<output>{count!().to_str()}</output>
			<button type="button" on:click={|| set_count!(count!() + 1)} aria-label="One more">+</button>
			<button type="button" class="reset" on:click={|| set_count!(0)} disabled?={count!() == 0}>
				Reset
			</button>
		</div>
	}

	<style>
		/* The number between its two buttons, and Reset under the three, quieter: all in the middle
		   of where it is put. A grid, so the markup stays the three and Reset in a row. */
		.counter {
			display: grid;
			grid-template-columns: auto auto auto;
			justify-content: center;
			align-items: center;
			gap: var(--space-4) var(--space-5);
		}

		.counter button {
			width: 3rem;
			height: 3rem;
			padding: 0;
			border: 1px solid var(--fill-strong);
			border-radius: 50%;
			background: var(--fill);
			color: var(--text);
			font-size: 1.375rem;
			font-weight: 500;
			line-height: 1;
			cursor: pointer;
			transition:
				background-color 120ms,
				border-color 120ms,
				color 120ms;
		}

		.counter button:hover:not(:disabled) {
			border-color: color-mix(in srgb, var(--accent) 45%, transparent);
			background: var(--accent-soft);
			color: var(--accent);
		}

		.counter button:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		.counter button:disabled {
			opacity: 0.35;
			cursor: default;
		}

		/* Under the three, as wide as its word. */
		.counter .reset {
			grid-column: 1 / -1;
			justify-self: center;
			width: auto;
			height: 2rem;
			padding: 0 var(--space-4);
			border-radius: 999px;
			background: transparent;
			color: var(--text-muted);
			font-size: var(--size-sm);
			letter-spacing: 0.02em;
		}

		/* Wide enough for -99 to 999, so the buttons stay where they are as it counts. */
		.counter output {
			min-width: 3ch;
			font: 700 3rem/1 var(--font);
			font-variant-numeric: tabular-nums;
			letter-spacing: -0.03em;
			text-align: center;
		}

		.counter.negative output {
			color: var(--bad);
		}
	</style>
}
