import pf.Html
import pf.Solid exposing [create_signal!]
import pf.Show
import charts.Format
import charts.LineChart
import Random

## A price that wanders, live: the charts package's `<LineChart>`, given a new value 40 times a
## second while it plays, the oldest dropping off the left. The axis keeps up, gliding to new
## round numbers when the line outgrows it. Paused, nothing runs.
Ticker := [].{
	Walk : { values : List(Dec), seed : U64 }

	view! : {} => Html
	view! = |{}| {
		(walk!, set_walk!) = create_signal!(Ticker.start(count, 7))
		(live!, set_live!) = create_signal!(Bool.False)
		# The time since the last value: a signal nothing on the page reads, so a frame that only
		# adds to it runs no hole.
		(since!, set_since!) = create_signal!(0.0)
		tick! = |ms| {
			elapsed = since!() + ms
			if elapsed >= every {
				set_since!(elapsed - every)
				set_walk!(Ticker.step(walk!()))
			} else {
				set_since!(elapsed)
			}
		}
		<div class="ticker">
			<div class="chart-bar">
				<button type="button" aria-pressed={if (live!()) "true" else "false"} on:click={|| set_live!(!live!())}>{if (live!()) "Pause" else "Play"}</button>
				<span class="ticker-last">Now <strong>{Format.num(walk!().values.last() ?? 0.0, 2)}</strong></span>
			</div>
			<LineChart data!={walk!().values} label="A price that wanders" format={|price| Format.num(price, 1)} smooth={Bool.True} />
			<Show when!={live!()}>
				<span hidden on:frame.ms={|ms| tick!(ms)}></span>
			</Show>
		</div>
	}

	<style>
		.ticker {
			--chart-color: var(--accent);
			--chart-active: var(--accent-strong);
			--chart-grid: var(--rule);
			--chart-axis: var(--rule-strong);
			--chart-muted: var(--text-faint);
			--chart-surface: var(--bg-raised);
			display: grid;
			gap: var(--space-3);
		}

		.chart-bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-2) var(--space-4);
			color: var(--text-muted);
			font-size: var(--size-sm);
		}

		.chart-bar > button {
			padding: var(--space-1) var(--space-3);
			font-size: var(--size-sm);
		}

		.chart-bar > button[aria-pressed="true"] {
			background: var(--accent-soft);
			color: var(--accent);
		}

		.ticker-last {
			font-variant-numeric: tabular-nums;
		}

		.ticker-last strong {
			color: var(--text);
		}
	</style>

	## `size` values, from 100, each a little up or down from the one before.
	start : U64, U64 -> Ticker.Walk
	start = |size, seed| {
		var $walk = { values: [100.0], seed }
		while $walk.values.len() < size {
			$walk = Ticker.next($walk)
		}
		$walk
	}

	## One more value: the last, up or down by as much as half a unit.
	next : Ticker.Walk -> Ticker.Walk
	next = |walk| {
		roll = Random.below(walk.seed, 1001)
		last = walk.values.last() ?? 100.0
		{ values: walk.values.append(last + (roll.value.to_dec() - 500.0) / 1000.0), seed: roll.seed }
	}

	## One more value, and the oldest gone.
	step : Ticker.Walk -> Ticker.Walk
	step = |walk| {
		moved = Ticker.next(walk)
		{ ..moved, values: moved.values.drop_first(1) }
	}
}

## How many values the chart shows, and how often (in milliseconds) a new one comes.
count : U64
count = 160

every : F64
every = 25.0
