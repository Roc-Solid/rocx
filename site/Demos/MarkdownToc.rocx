import pf.Html
import markdown.Markdown
import markdown.Md
import "MarkdownFiles/guide.md" as guide : Str

## The markdown page's table of contents: the guide parsed once, its headings listed (each a link
## to its id) with its reading time, and the same parse rendered.
MarkdownToc := [].{
	view : {} -> Html
	view = |{}| {
		doc = Md.parse(guide)
		<div class="guide">
			<nav aria-label="The guide's sections">
				<p class="time">{Md.reading_minutes(doc).to_str()} min read · {Md.words(doc).to_str()} words</p>
				<ul>{...Md.headings(doc).map(|h| <li class:sub={h.level > 3}><a href={"#${h.id}"}>{h.text}</a></li>)}</ul>
			</nav>
			<Markdown doc={doc} />
		</div>
	}

	<style>
		.guide {
			display: grid;
			grid-template-columns: minmax(11rem, 0.4fr) minmax(0, 1fr);
			gap: var(--space-5);
			align-items: start;
		}

		nav {
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius);
			background: var(--fill);
			font-size: var(--size-sm);
		}

		.time {
			margin: 0 0 var(--space-2);
			color: var(--text-muted);
		}

		ul {
			margin: 0;
			padding-left: var(--space-4);
		}

		.sub {
			margin-left: var(--space-4);
			list-style: circle;
		}

		@media (max-width: 40rem) {
			.guide {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}
