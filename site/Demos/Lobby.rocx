import pf.Html
import pf.Endpoint
import pf.Solid exposing [create_effect!, create_signal!]
import ../Generated/Api

## The lobby (`routes/api/platform/live/lobby/+server.roc`, a channel): join it, and every tab on
## this page that has joined sees each wave as it is made. Open the page in a second tab to see it.
Lobby := [].{

	view! : {} => Html
	view! = |{}| {
		(joined!, set_joined!) = create_signal!(Bool.False)
		<div class="lobby">
			{if joined!() {
				<Room leave!={|| set_joined!(Bool.False)} />
			} else {
				<button type="button" class="join" on:click={|| set_joined!(Bool.True)}>Join the lobby</button>
			}}
		</div>
	}

	<style>
		.lobby {
			display: grid;
			gap: var(--space-2);
		}

		button {
			justify-self: start;
		}
	</style>
}

## In the lobby: subscribed from an effect, until it goes (Leave).
Room := [].{

	view! : { leave! : () => {} } => Html
	view! = |{ leave! }| {
		(state!, set_state!) = create_signal!("Joining…")
		(waves!, set_waves!) = create_signal!([])
		lobby = Api.channel_api_platform_live_lobby({})
		create_effect!(
			|| {},
			|{}|
				lobby.subscribe!(
					|event|
						match event {
							Resync => set_state!("In the lobby. Open this page in another tab, join there too, and wave.")
							Message(wave) => set_waves!(waves!().take_last(5).append("${wave.hand} from ${wave.from}"))
							Refused(_, why) => set_state!("No lobby here: ${why}")
							Ended(why) => set_state!("Left: ${why}")
						},
				),
		)
		<div class="room">
			<p class="state" aria-live="polite">{state!()}</p>
			<p class="hands">
				{...["👋", "🎉", "🙌"].map(|hand|
					<button key={hand} type="button" class="wave" on:click={|| lobby.say!(Wave(hand))}>{hand}</button>
				)}
				<button type="button" class="leave" on:click={leave!}>Leave</button>
			</p>
			<ol class="waves">
				{...waves!().map(|wave|
					<li key={wave}>{wave}</li>
				)}
			</ol>
		</div>
	}

	<style>
		.hands {
			display: flex;
			gap: var(--space-2);
		}

		.waves {
			margin: 0;
			min-height: 6em;
		}
	</style>
}
