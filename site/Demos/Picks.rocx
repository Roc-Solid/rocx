import pf.Html
import pf.Solid exposing [create_signal!, use_context!]
import pf.Context
import pf.For

## Picks you can reverse, add to, shout and clear: Solid's <For>, by key and
## by position, and an if and a match. The picks are a store: what is under a
## <PicksContext> reads and writes the same ones (the docs' tally does).
Picks := [].{
	Pick : { id : U64, name : Str }

	## The picks and the next id, as accessors and setters.
	Store : {
		picks! : () => List(Pick),
		set_picks! : List(Pick) => {},
		next! : () => U64,
		set_next! : U64 => {},
	}

	picks_context : Context(Store)
	picks_context = create_context()

	## A store with three picks in it.
	store! : {} => Store
	store! = |{}| {
		(picks!, set_picks!) = create_signal!([
			{ id: 1, name: "Roc" },
			{ id: 2, name: "Solid" },
			{ id: 3, name: "Elm" },
		])
		(next!, set_next!) = create_signal!(4.U64)
		{ picks!: picks!, set_picks!: set_picks!, next!: next!, set_next!: set_next! }
	}

	view! : {} => Html
	view! = |{}| {
		{ picks!, set_picks!, next!, set_next! } = use_context!(picks_context)
		reverse! = || set_picks!(picks!().rev())
		add! = || {
			set_picks!(picks!().append({ id: next!(), name: "Gleam" }))
			set_next!(next!() + 1)
		}
		shout! = || set_picks!(picks!().map(loud))
		<section class="picks">
			<div class="picks-buttons">
				<button class="reverse" on:click={reverse!}>Reverse</button>
				<button class="add" on:click={add!}>Add</button>
				<button class="shout" on:click={shout!}>Shout</button>
				<button class="clear" on:click={|| set_picks!([])}>Clear</button>
			</div>
			<div class="picks-lists">
				{# A row per id: kept while its id is there, moved with it. }
				<ol class="keyed" aria-label="By key">
					<For
						each!={picks!()}
						keyed={|pick| pick.id}
						fallback={<li class="none">None</li>}
					>
						{|pick!, index!| <li>{index!().to_str()}: {pick!().name}</li>}
					</For>
				</ol>
				{# A row per place: the pick in it changes. }
				<ol class="unkeyed" aria-label="By position">
					<For each!={picks!()} keyed={Bool.False}>
						{|pick!, index| <li>{index.to_str()}: {pick!().name}</li>}
					</For>
				</ol>
			</div>
			<div class="picks-shows">
				{if picks!().len() > 3 {
					<p class="many">More than three</p>
				} else {
					<p class="few">Three or fewer</p>
				}}
				{match picks!().first() {
					Ok(first) => <p class="first">First: {first.name}</p>
					Err(_) => <></>
				}}
			</div>
		</section>
	}

	<style>
		.picks {
			display: grid;
			gap: var(--space-4);
		}

		.picks-buttons {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.picks-lists {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--space-3);
		}

		ol {
			display: grid;
			align-content: start;
			gap: var(--space-2);
			margin: 0;
			padding: var(--space-3);
			border-radius: var(--radius);
			background: var(--bg-sunken);
			list-style: none;
		}

		ol::before {
			content: attr(aria-label);
			color: var(--magenta);
			font: 600 var(--size-2xs) var(--mono);
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		li {
			padding: var(--space-1) var(--space-2);
			border-radius: var(--radius-sm);
			background: var(--bg-raised);
			font: var(--size-sm) / 1.4 var(--mono);
		}

		.none {
			background: none;
			color: var(--text-faint);
		}

		.picks-shows {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.picks-shows p {
			margin: 0;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--pill);
			background: var(--accent-soft);
			color: var(--accent);
			font-size: var(--size-sm);
			font-weight: 600;
		}
	</style>
}

## A pick, shouted: its id is the same, so its row is too.
loud : Picks.Pick -> Picks.Pick
loud = |pick| { ..pick, name: pick.name.with_ascii_uppercased() }
