import pf.Html
import pf.Solid exposing [create_memo!, create_signal!]

## A reading list: type a title and press Enter, tick a book off.
SyntaxTour := [].{
	view! : {} => Html
	view! = |{}| {
		book = |id, title| { id, title, done: Bool.False }
		(books!, set_books!) = create_signal!([book(1, "Dune"), book(2, "Emma")])
		(draft!, set_draft!) = create_signal!("")
		left! = create_memo!(|| books!().count_if(|b| !b.done))

		add! = || {
			if !draft!().is_empty() {
				set_books!(books!().append(book(books!().len() + 1, draft!())))
				set_draft!("")
			}
		}
		tick! = |id|
			set_books!(books!().map(|b| if (b.id == id) { ..b, done: !b.done } else b))

		<section class="tour">
			<input
				placeholder="Add a book"
				value={draft!()}
				on:input.value={set_draft!}
				on:keydown.Enter={add!}
			/>
			<ul>
				{...books!().map(|b|
					<li key={b.id} class:done={b.done}>
						<input type="checkbox" checked?={b.done} on:change={|| tick!(b.id)} />
						{b.title}
					</li>
				)}
			</ul>
			{if (left!() == 0) <p>All read.</p> else <p>{left!()} to read</p>}
		</section>
	}

	<style>
		.done {
			text-decoration: line-through;
		}
	</style>
}
