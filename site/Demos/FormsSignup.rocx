import pf.Server
import pf.Endpoint
import forms.Form

## The forms page's example (site/routes/ecosystem/forms): one schema, which the demo checks in the
## browser as it is typed, and an endpoint's body is read and checked by. In an app, the schema is
## a module of its own, which a page and a route file both import, and `post!` is the route file's
## (`routes/api/signup/+server.roc`, beside `post_body = Signup.form`, D-093, D-100). The page renders what the
## endpoint answers, as the site is built.
FormsSignup := [].{
	Passwords : { password : Str, confirm : Str }

	Account : { name : Str, email : Str, age : I64, passwords : FormsSignup.Passwords, terms : Bool }

	## A password, typed twice: a form of its own, so the check across the two runs whenever both
	## can be read, whatever the rest of the form says.
	passwords : Form(FormsSignup.Passwords)
	passwords = ({ password: Form.text("password", [Required, MinLength(8), Secret]), confirm: Form.text("confirm", [Required, Secret]) }.Form).check_at("confirm", |p| p.password == p.confirm, NotSame("password"))

	## The sign-up form: each field by the name it is posted as, and its checks, in order.
	form : Form(FormsSignup.Account)
	form = {
		name: Form.text("name", [Trim, Required, MaxLength(80)]),
		email: Form.text("email", [Trim, Lowercase, Required, Email]),
		age: Form.int("age", [Min(18), Max(130)]),
		passwords: FormsSignup.passwords,
		terms: Form.checkbox("terms", [Required]),
	}.Form

	## POST /signup: given the account, read and checked by `form` (its route file's `post_body =
	## Signup.form`), as a form or JSON. What doesn't pass never reaches it: the platform refuses it
	## with each field's issues (422, JSON), the same the page shows as it is typed.
	post! : { request : Server.Request, params : {}, context : c, body : FormsSignup.Account } => Try({ welcome : Str }, Endpoint.Refusal)
	post! = |{ body, .. }| Ok({ welcome: "Welcome, ${body.name}" })

	## The endpoint, checked by `form`, as Generated/Api makes a route's from its `post_body`, with
	## `post!` as its handler.
	signup : Endpoint({}, FormsSignup.Account, { welcome : Str })
	signup = Endpoint.checked(Endpoint.local("POST", "/signup", |request, context, body| FormsSignup.post!({ request, params: {}, context, body })), FormsSignup.form)
}
