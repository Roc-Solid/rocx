import pf.Html
import pf.Solid exposing [create_memo!, create_signal!]
import pf.Loading
import pf.Errored
import ../Generated/Api

## The echo, Solid-style: pick a message, and see what the server said back. Each answer is a GET
## endpoint's (`routes/api/echo/[message]/+server.roc`), which the server answers as it renders the
## page, so every answer comes with it: picking asks nothing, and works on a copy of the site that
## is only files.
Echo := [].{

	## What the server says back to a message: `GET /api/echo/{message}`, read as a plain value.
	echo! : Str => Str
	echo! = |message| Api.get_api_echo_message({ message: message }).read!()

	## What there is to say.
	messages : List(Str)
	messages = ["the page, rendered on the server", "hello", "this site, as files"]

	view! : {} => Html
	view! = |{}| {
		(draft!, set_draft!) = create_signal!("the page, rendered on the server")
		# A GET per message, answered as the server renders; in the browser, read from the page.
		answers! = create_memo!(|| said_to!(messages))
		said! = create_memo!(|| answer_to(answers!(), draft!()))
		<form class="echo" on:submit={|| {}}>
			{...messages.map(|message|
				<button
					key={message}
					type="button"
					aria-pressed={if (message == draft!()) "true" else "false"}
					on:click={|| set_draft!(message)}
				>
					{message}
				</button>
			)}
			<Errored fallback={|problem, retry|
				<output class="echo-answer failed">
					{problem} <button type="button" on:click={retry}>Again</button>
				</output>
			}>
				<Loading fallback={<output class="echo-answer">…</output>}>
					<Answer said!={said!} />
				</Loading>
			</Errored>
		</form>
	}

	<style>
		.echo {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		/* The messages: the one picked is filled. */
		button {
			background: var(--accent-soft);
			color: var(--accent);
		}

		button[aria-pressed="true"],
		button[aria-pressed="true"]:hover:not(:disabled) {
			background: var(--accent);
			color: var(--accent-text);
		}

		/* What the server said (`answer!`, outside the block, makes one too: global, under the form). */
		.echo :global(.echo-answer) {
			flex-basis: 100%;
			min-height: 1.5em;
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius-sm);
			background: var(--bg-sunken);
			font: var(--size-sm) var(--mono);
		}

		.echo :global(.echo-answer.failed) {
			background: var(--bad-soft);
			color: var(--bad);
		}
	</style>
}

## What the server says to each message: `echo!` called for each, in order.
said_to! : List(Str) => List({ message : Str, said : Str })
said_to! = |all| {
	var $answers = []
	for message in all {
		$answers = $answers.append({ message, said: Echo.echo!(message) })
	}
	$answers
}

## What the server said to `message`.
answer_to : List({ message : Str, said : Str }), Str -> Str
answer_to = |answers, message|
	match answers.find_first(|answer| answer.message == message) {
		Ok(found) => found.said
		Err(_) => ""
	}

## What the server said. Given the memo's accessor, it can only read it.
answer! : { said! : () => Str } => Html
answer! = |{ said! }| <output class="echo-answer">{said!()}</output>
