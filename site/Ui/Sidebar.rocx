import pf.Html

## A part of the docs and its pages, down the side, in groups: each group's heading (none for a
## group named ""), then each page's name and what it is about, the one at `path` marked. It stays
## in view as the page scrolls; on a phone, it is a row above the page, each group's heading before
## its pages. Its props are getters (D-039), read where they are used, so a navigation within a part
## keeps it, its scroll with it, and only moves the mark (D-040).
Sidebar := [].{
	view! = |{ title, groups, path }|
		<nav class="sidebar" aria-label={"${title}: its pages"}>
			{...groups.map(|group|
				<div class="group" key={group.name}>
					{if (group.name == "") <></> else <p class="title">{group.name}</p>}
					<ul>
						{...group.pages.map(|page|
							<li key={page.path}>
								<a href={page.path} class:current={page.path == path} aria-current??={if (page.path == path) "page" else ""}>
									<span class="label">{page.label}</span>
									<span class="blurb">{page.blurb}</span>
								</a>
							</li>
						)}
					</ul>
				</div>
			)}
		</nav>

	<story name="A part">
		<Sidebar
			title="rocx"
			path="/syntax"
			groups={[
				{
					name: "rocx",
					pages: [
						{ path: "/rocx", label: "Overview", blurb: "What rocx is, in one page" },
						{ path: "/syntax", label: "Syntax", blurb: "Markup wherever an expression can stand" },
						{ path: "/routing", label: "Routing", blurb: "A page is a file: +page.rocx, +layout.rocx" },
						{ path: "/components", label: "Components", blurb: "Signals, and the pages that hydrate" },
					],
				},
			]}
		/>
	</story>

	<story name="A part in groups">
		<Sidebar
			title="Platform"
			path="/platform/actors"
			groups={[
				{
					name: "Overview",
					pages: [
						{ path: "/platform", label: "Overview", blurb: "Two platforms, one app" },
						{ path: "/platform/server", label: "The server", blurb: "Native Roc in a Rust host" },
						{ path: "/platform/live", label: "Live", blurb: "Rooms, topics, and channels for pages" },
					],
				},
				{
					name: "State",
					pages: [
						{ path: "/platform/database", label: "Database", blurb: "Postgres or SQLite: queries, transactions, migrations" },
						{ path: "/platform/actors", label: "Actors", blurb: "State one message at a time, kept in the database" },
						{ path: "/platform/kv", label: "Kv", blurb: "Values in memory by key, with a time to live" },
					],
				},
			]}
		/>
	</story>

	<story name="A first group with no heading">
		<Sidebar
			title="Ecosystem"
			path="/ecosystem/charts"
			groups={[
				{ name: "", pages: [{ path: "/ecosystem", label: "Overview", blurb: "What a package is, and using one" }] },
				{
					name: "Pages",
					pages: [
						{ path: "/ecosystem/charts", label: "Charts", blurb: "Eight kinds of chart that glide to their data, styled by CSS" },
						{ path: "/ecosystem/forms", label: "Forms", blurb: "A form's rules written once, checked as it is typed and at the endpoint" },
					],
				},
			]}
		/>
	</story>

	<style>
		.sidebar {
			position: sticky;
			top: var(--bar);
			align-self: start;
			max-height: calc(100vh - var(--bar));
			overflow-y: auto;
			padding: var(--space-7) 0;
			scrollbar-width: thin;
			/* Held still while a navigation's page changes beside it (site.css, Page transitions). */
			view-transition-name: site-sidebar;
		}

		ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.group + .group {
			margin-top: var(--space-5);
		}

		.title {
			margin: 0 0 var(--space-2);
			padding: 0 var(--space-3);
			color: var(--magenta);
			font-size: var(--size-2xs);
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		a {
			display: block;
			margin-bottom: 0.2rem;
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-sm);
			color: var(--text);
			line-height: 1.35;
			text-decoration: none;
		}

		a:hover {
			background: var(--fill);
		}

		.current,
		.current:hover {
			background: var(--accent-soft);
			box-shadow: inset 2px 0 0 var(--accent);
		}

		.label {
			display: block;
			font-size: var(--size-sm);
			font-weight: 600;
		}

		.current .label {
			color: var(--accent);
		}

		.blurb {
			display: block;
			color: var(--text-muted);
			font-size: var(--size-xs);
		}

		/* Narrower: a row of the part's pages above the page, which scrolls sideways, each group's
		   heading before its pages. */
		@media (max-width: 52rem) {
			.sidebar {
				position: static;
				display: flex;
				gap: var(--space-4);
				max-height: none;
				padding: var(--space-4) 0 0;
				overflow-x: auto;
				scrollbar-width: none;
				/* Above the page, it scrolls away with it, so it changes with it too. */
				view-transition-name: none;
			}

			.group {
				display: flex;
				flex: none;
				align-items: center;
			}

			.group + .group {
				margin-top: 0;
			}

			.title {
				margin: 0;
				white-space: nowrap;
			}

			ul {
				display: flex;
				gap: var(--space-1);
			}

			a {
				margin: 0;
				white-space: nowrap;
			}

			.current,
			.current:hover {
				box-shadow: none;
			}

			.blurb {
				display: none;
			}
		}
	</style>
}
