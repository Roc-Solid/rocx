import pf.Html

## A part of the platform, in `<Arch>`: its `name` (markup: code, say), a `label` above it, and what
## it does (what is inside: paragraphs, or the parts inside it). `kind` gives its colour: `roc`,
## `js`, `zig`, or `wasm` for a part that holds others.
ArchBox := [].{
	Props := {
		kind : Str,
		name : List(Html) ?? [],
		label : Str ?? "",
		children : List(Html),
	}

	view : Props -> Html
	view = |props|
		<div class={"box ${props.kind}"}>
			{=if (props.label.is_empty()) Html.empty({}) else <p class="label">{props.label}</p>}
			{=if (props.name.is_empty()) Html.empty({}) else <p class="name">{...props.name}</p>}
			{...props.children}
		</div>

	<story name="Each kind">
		<div class="kinds">
			<ArchBox kind="js" name={[<code>runtime.js</code>]}><p>JavaScript.</p></ArchBox>
			<ArchBox kind="zig" name={[<code>host.zig</code>]}><p>Zig.</p></ArchBox>
			<ArchBox kind="roc" name={[<>The app</>]}><p>Roc.</p></ArchBox>
			<ArchBox kind="wasm" label="One wasm module"><p>What holds the others.</p></ArchBox>
		</div>
	</story>

	<style>
		.box {
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius);
			background: var(--bg-raised);
		}

		.box > :global(p) {
			margin: 0;
			color: var(--text-muted);
			font-size: var(--size-sm);
		}

		.box > p.name {
			margin-bottom: var(--space-1);
			color: var(--text);
			font-weight: 700;
		}

		.name :global(code) {
			font-weight: 600;
		}

		.box > p.label {
			color: var(--text-faint);
			font: 600 var(--size-2xs) var(--mono);
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.js {
			box-shadow: inset 0 3px 0 var(--warn);
		}

		.zig {
			box-shadow: inset 0 3px 0 var(--good);
		}

		.roc {
			box-shadow: inset 0 3px 0 var(--accent);
		}

		.wasm {
			background: var(--bg-sunken);
			box-shadow: inset 0 3px 0 var(--violet);
		}

		.wasm > .box {
			margin-top: var(--space-3);
			background: var(--bg-raised);
		}

		.kinds {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
			gap: var(--space-3);
		}
	</style>
}
