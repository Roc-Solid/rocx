import pf.Html
import ArchBox

## The platform, drawn: two parts (`left` and `right`, an `<ArchBox>` each) and what passes between
## them (`wire`). One above the other on a phone.
Arch := [].{
	view : { left : List(Html), wire : Str, right : List(Html) } -> Html
	view = |{ left, wire, right }|
		<div class="arch">
			{...left}
			<p class="wire"><span aria-hidden="true">⇄</span>{wire}</p>
			{...right}
		</div>

	<story name="Two platforms">
		<Arch
			left={[<ArchBox kind="roc" name={[<code>server/</code>, <>: native</>]}><p>Roc compiled to machine code, in a Rust host.</p></ArchBox>]}
			wire="HTTP"
			right={[<ArchBox kind="wasm" name={[<code>web/</code>, <>: wasm</>]}><p>The components, compiled to WebAssembly with a Zig host.</p></ArchBox>]}
		/>
	</story>

	<story name="One inside another">
		<Arch
			left={[<ArchBox kind="js" name={[<code>web/runtime.js</code>]}><p>JavaScript: hydrates, keeps the signals, patches.</p></ArchBox>]}
			wire="ids and strings"
			right={[
				<ArchBox kind="wasm" label="One wasm module">
					<ArchBox kind="zig" name={[<code>web/host/host.zig</code>]}><p>Zig: Roc's memory, and the effects.</p></ArchBox>
					<ArchBox kind="roc" name={[<>The app</>]}><p>Roc: the components.</p></ArchBox>
				</ArchBox>,
			]}
		/>
	</story>

	<style>
		.arch {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.6fr);
			align-items: center;
			gap: var(--space-3);
			margin: var(--space-5) 0 var(--space-3);
		}

		.wire {
			margin: 0;
			color: var(--text-faint);
			font: 600 var(--size-2xs) / 1.4 var(--mono);
			text-align: center;
		}

		.wire span {
			display: block;
			color: var(--accent);
			font-size: var(--size-lg);
			text-shadow: var(--glow-text);
		}

		@media (max-width: 52rem) {
			.arch {
				grid-template-columns: minmax(0, 1fr);
			}

			.wire span {
				rotate: 90deg;
			}
		}
	</style>
}
