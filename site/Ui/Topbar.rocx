import pf.Html
import ../Generated/Paths
import Logo

## The bar at the top of every page: the site's mark, the parts of the docs (the `current` one
## marked), what it is in a line, and what the browser downloads (`wasm`). It stays at the top as
## the page scrolls. On the front page (`landing`), whose top shows the mark large, the bar has the
## name alone, and on a phone, where the bar's name is the mark, nothing there.
Topbar := [].{
	view = |{ sections, current, wasm, landing }|
		<header class="topbar" class:landing={landing}>
			<a class="brand" href={Paths.root} aria-label="Roc Solid, home">{=if (landing) Html.empty({}) else <Logo />}Roc Solid</a>
			<nav class="sections" aria-label="Parts of the docs">
				{...sections.map(|section| <a href={section.home} class:current={section.name == current}>{section.name}</a>)}
			</nav>
			<span class="tagline">Markup in Roc · pages on a native server · components in WebAssembly</span>
			<span class="stat" title="What the browser downloads to run the site's components, compressed">wasm: {wasm}</span>
		</header>

	<story name="In a part">
		<Topbar sections={[{ name: "rocx", home: "#" }, { name: "Platform", home: "#" }, { name: "Ecosystem", home: "#" }]} current="Platform" wasm="143.0 KB" landing={Bool.False} />
	</story>

	<story name="On the front page">
		<Topbar sections={[{ name: "rocx", home: "#" }, { name: "Platform", home: "#" }, { name: "Ecosystem", home: "#" }]} current="" wasm="143.0 KB" landing />
	</story>

	<style>
		.topbar {
			position: sticky;
			top: 0;
			z-index: 5;
			display: flex;
			align-items: center;
			gap: var(--space-5);
			height: var(--bar);
			padding: 0 var(--space-6);
			background: color-mix(in srgb, var(--bg) 85%, transparent);
			backdrop-filter: blur(12px);
		}

		.brand {
			display: inline-flex;
			flex: none;
			align-items: center;
			gap: var(--space-2);
			color: var(--text);
			font-size: var(--size-lg);
			font-weight: 750;
			letter-spacing: -0.02em;
			text-decoration: none;
		}

		/* The mark (a <Logo>, passed in: global under the brand), lit when the brand is pointed at. */
		.brand :global(.logo) {
			--logo-size: 2.1rem;
			transition: filter 0.2s;
		}

		.brand:hover :global(.logo) {
			filter: var(--glow-mark);
		}

		.sections {
			display: flex;
			gap: var(--space-1);
			min-width: 0;
		}

		.sections a {
			padding: var(--space-1) var(--space-3);
			border-radius: var(--pill);
			color: var(--text-muted);
			font-size: var(--size-sm);
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
		}

		.sections a:hover {
			background: var(--fill);
			color: var(--text);
		}

		.sections .current,
		.sections .current:hover {
			background: var(--magenta-soft);
			color: var(--magenta);
		}

		.tagline {
			overflow: hidden;
			color: var(--text-faint);
			font-size: var(--size-sm);
			white-space: nowrap;
			text-overflow: ellipsis;
		}

		.stat {
			flex: none;
			margin-left: auto;
			padding: var(--space-1) var(--space-3);
			border-radius: var(--pill);
			background: var(--accent-soft);
			color: var(--accent);
			font: 600 var(--size-2xs) / 1.6 var(--mono);
			white-space: nowrap;
		}

		@media (max-width: 75rem) {
			.tagline {
				display: none;
			}
		}

		/* A phone: the mark alone, and the parts beside it, which scroll if they must. */
		@media (max-width: 40rem) {
			.topbar {
				gap: var(--space-3);
				padding: 0 var(--space-4);
			}

			.brand {
				font-size: 0;
			}

			.landing .brand {
				display: none;
			}

			.sections {
				overflow-x: auto;
				scrollbar-width: none;
			}

			.sections a {
				padding: var(--space-1) var(--space-2);
			}

			.stat {
				display: none;
			}
		}
	</style>
}
