import pf.Html
import ../Generated/Paths
import Logo

## The bar at the top of every page, in three columns: the site's mark and name, the parts of the
## docs in the middle (the `current` one marked), and what the site is, in a line where there is
## room. The side columns are as wide as each other, so the parts stay where they are from page to
## page. On the front page (`landing`), whose top shows the name and the mark large, the bar leaves
## them out, and the parts still don't move. It stays at the top as the page scrolls.
Topbar := [].{
	view = |{ sections, current, landing }|
		<header class="topbar" class:landing={landing}>
			{=if (landing) Html.empty({}) else <a class="brand" href={Paths.root} aria-label="Roc Solid, home"><Logo />Roc Solid</a>}
			<nav class="sections" aria-label="Parts of the docs">
				{...sections.map(|section| <a href={section.home} class:current={section.name == current}>{section.name}</a>)}
			</nav>
			<div class="end">
				<span class="tagline">Markup in Roc · pages on a native server · components in WebAssembly</span>
			</div>
		</header>

	<story name="In a part">
		<Topbar sections={[{ name: "rocx", home: "#" }, { name: "Platform", home: "#" }, { name: "Ecosystem", home: "#" }]} current="Platform" landing={Bool.False} />
	</story>

	<story name="On the front page">
		<Topbar sections={[{ name: "rocx", home: "#" }, { name: "Platform", home: "#" }, { name: "Ecosystem", home: "#" }]} current="" landing />
	</story>

	<style>
		.topbar {
			position: sticky;
			top: 0;
			z-index: 5;
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			align-items: center;
			gap: var(--space-5);
			height: var(--bar);
			padding: 0 var(--space-6);
			background: color-mix(in srgb, var(--bg) 85%, transparent);
			backdrop-filter: blur(12px);
			/* Held still while a navigation's page changes beneath it (site.css, Page transitions). */
			view-transition-name: site-bar;
		}

		.brand {
			grid-column: 1;
			display: inline-flex;
			justify-self: start;
			align-items: center;
			gap: var(--space-2);
			color: var(--text);
			font-size: var(--size-lg);
			font-weight: 750;
			letter-spacing: -0.02em;
			text-decoration: none;
		}

		/* The mark (a <Logo>, passed in: global under the brand), lit when the brand is pointed at. */
		.brand :global(.logo) {
			--logo-size: 2.1rem;
			transition: filter 0.2s;
		}

		.brand:hover :global(.logo) {
			filter: var(--glow-mark);
		}

		.sections {
			grid-column: 2;
			display: flex;
			gap: var(--space-1);
			min-width: 0;
		}

		.sections a {
			padding: var(--space-1) var(--space-3);
			border-radius: var(--pill);
			color: var(--text-muted);
			font-size: var(--size-sm);
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
		}

		.sections a:hover {
			background: var(--fill);
			color: var(--text);
		}

		.sections .current,
		.sections .current:hover {
			background: var(--magenta-soft);
			color: var(--magenta);
		}

		.end {
			grid-column: 3;
			display: flex;
			justify-content: end;
			align-items: center;
			gap: var(--space-5);
			min-width: 0;
		}

		.tagline {
			overflow: hidden;
			color: var(--text-faint);
			font-size: var(--size-sm);
			white-space: nowrap;
			text-overflow: ellipsis;
		}

		/* The line, beside the parts in the middle, only where it fits whole. */
		@media (max-width: 105rem) {
			.tagline {
				display: none;
			}
		}

		/* Narrow: the mark alone, kept a column of its own even where it isn't (the front page), and
		   the parts beside it, which scroll if they must. */
		@media (max-width: 56rem) {
			.topbar {
				grid-template-columns: 2.1rem minmax(0, 1fr);
				gap: var(--space-3);
				padding: 0 var(--space-4);
			}

			.brand {
				font-size: 0;
			}

			.sections {
				overflow-x: auto;
				scrollbar-width: none;
			}

			.sections a {
				padding: var(--space-1) var(--space-2);
			}

			.end {
				display: none;
			}
		}
	</style>
}
