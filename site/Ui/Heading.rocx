import pf.Html

## A section's heading, with a link to it.
Heading := [].{
	view : { id : Str, children : List(Html) } -> Html
	view = |{ id, children }| <h2 id={id}>{...children}<a class="anchor" href={"#${id}"} aria-label="Link to this section">#</a></h2>

	<story name="Section">
		<Heading id="parts">Three parts</Heading>
		<p>The text under it: the anchor beside the heading links here.</p>
	</story>

	<story name="Long title">
		<Heading id="long">A heading that is long enough to wrap onto a second line on a narrow screen</Heading>
	</story>

	<style>
		.anchor {
			margin-left: var(--space-2);
			color: var(--magenta);
			text-decoration: none;
			opacity: 0;
			transition: opacity 0.15s;
		}

		h2:hover .anchor,
		.anchor:focus {
			opacity: 1;
		}
	</style>
}
