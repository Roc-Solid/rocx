import pf.Html

## A link that looks like a button: the way to somewhere the page means you to go. `primary` for the
## one it most means (cyan); the others are quiet surfaces. `bare` for a link's look instead: its text
## and an arrow (down to a place on the page, on to another page), no surface, as the front page's
## hero has them. Put several in `<Actions>`. With `submit`, it is a form's button instead, which
## sends the form it is in.
Button := [].{
	Props := {
		href : Str ?? "",
		primary : Bool ?? Bool.False,
		bare : Bool ?? Bool.False,
		submit : Bool ?? Bool.False,
		children : List(Html),
	}

	view : Props -> Html
	view = |props|
		if (props.submit)
			<button class="button" class:primary={props.primary} type="submit">{...props.children}</button>
		else
			<a class="button" class:primary={props.primary} class:bare={props.bare} href={props.href}>{...props.children}</a>

	<story name="Primary">
		<Button href="#" primary>Read the guide</Button>
	</story>

	<story name="Secondary">
		<Button href="#">See it run</Button>
	</story>

	<story name="Bare">
		<p>
			<Button href="#" primary bare>Get started</Button>
			<Button href="/rocx" bare>Read the guide</Button>
		</p>
	</story>

	<story name="A form's">
		<form method="post" action="#"><Button submit>Leave</Button></form>
	</story>

	<style>
		.button {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2) var(--space-5);
			border: 0;
			border-radius: var(--radius);
			background: var(--fill);
			color: var(--text);
			font: inherit;
			font-weight: 600;
			text-decoration: none;
			cursor: pointer;
			transition: background 0.15s, box-shadow 0.15s;
		}

		.button:hover {
			background: var(--fill-strong);
		}

		.primary {
			background: var(--accent);
			color: var(--accent-text);
		}

		.primary:hover {
			background: var(--accent-strong);
			box-shadow: var(--glow);
		}

		/* Bare: the text, a little larger, and its arrow, which moves the way it points on a hover. */
		.bare,
		.bare:hover {
			margin: 0 var(--space-3);
			padding: var(--space-1) 0;
			background: none;
			box-shadow: none;
		}

		.bare {
			color: var(--text-muted);
			font-size: var(--size-lg);
			transition: color 0.15s, text-shadow 0.15s;
		}

		.bare:hover {
			color: var(--text);
		}

		.bare.primary {
			color: var(--accent);
		}

		.bare.primary:hover {
			color: var(--accent);
			text-shadow: var(--glow-text);
		}

		.bare::after {
			content: "→";
			content: "→" / "";
			transition: translate 0.15s;
		}

		.bare[href^="#"]::after {
			content: "↓";
			content: "↓" / "";
		}

		.bare:hover::after {
			translate: 0.2rem 0;
		}

		.bare[href^="#"]:hover::after {
			translate: 0 0.2rem;
		}
	</style>
}
