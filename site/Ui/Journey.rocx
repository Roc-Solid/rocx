import pf.Html
import pf.Solid exposing [create_signal!]

## A component's way from its file to the page, a step at a time: numbered steps above, the
## picked step's panel under them (`panel`, which a page wraps in `<NoHydration>`), and the
## component itself, live, under both whatever step is picked. A click in the live part goes to
## the last step, which shows what the click did. Inside, it is a demo to site.js (`data-demo`, a
## box of no layout), so its own patches (a step picked) aren't put in the log of the demo in it.
Journey := [].{
	Step : { name : Str, file : Str, panel : List(Html) }

	Props := {
		steps : List(Step),
		label : Str ?? "Live",
		children : List(Html),
	}

	view! : Props => Html
	view! = |props| {
		(at!, set_at!) = create_signal!(0)
		# The step picked before this one: the line runs from it to the new one, and each number it
		# passes changes as the line gets there.
		(from!, set_from!) = create_signal!(0)
		go! = |index| {
			set_from!(at!())
			set_at!(index)
		}
		# How long a number waits to change: the share of the line's run it takes to reach it.
		wait! = |index| {
			now = at!()
			was = from!()
			ms =
				if (now > was and index > was and index <= now)
					(index - was) * 300 // (now - was)
				else if (now < was and index >= now and index < was)
					(was - index) * 300 // (was - now)
				else
					0
			"${ms.to_str()}ms"
		}
		steps = props.steps
		last = steps.len() - 1
		names = steps.map(|step| step.name)
		<figure class="journey">
			<div data-demo="journey">
				<div
					class="steps"
					role="tablist"
					aria-label="From the file to the page"
					style:--count={steps.len().to_str()}
					style:--last={last.to_str()}
					style:--at={at!().to_str()}
				>
					{...steps.map_with_index(|step, index|
						<button
							type="button"
							role="tab"
							id={"journey-tab-${index.to_str()}"}
							aria-controls={"journey-panel-${index.to_str()}"}
							aria-selected={if (at!() == index) "true" else "false"}
							class:done={at!() > index}
							style:--index={index.to_str()}
							style:--wait={wait!(index)}
							on:click={|| go!(index)}
						>
							<span class="num">{(index + 1).to_str()}</span>
							<span class="name">{step.name}</span>
						</button>)}
				</div>
				<div class="panels">
					{...steps.map_with_index(|step, index|
						<div
							class="panel"
							class:current={at!() == index}
							role="tabpanel"
							id={"journey-panel-${index.to_str()}"}
							aria-labelledby={"journey-tab-${index.to_str()}"}
						>
							<p class="file">{step.file}</p>
							{...step.panel}
						</div>)}
				</div>
				<p class="next">
					<button type="button" on:click={|| go!(if (at!() == last) 0 else at!() + 1)}>
						{if (at!() == last) "Start again" else "Next: ${names.get(at!() + 1) ?? ""}"}
					</button>
				</p>
				<div class="stage" on:click={|| go!(last)}>
					<p class="label">{props.label}</p>
					{...props.children}
				</div>
			</div>
		</figure>
	}

	<story name="Three steps">
		<Journey
			steps={[
				{ name: "Write", file: "Hello.rocx", panel: [<p>Markup in Roc.</p>] },
				{ name: "Build", file: "Hello.roc", panel: [<p>Plain Roc, line for line.</p>] },
				{ name: "Run", file: "app.wasm", panel: [<p>The same code, in the browser.</p>] },
			]}
		>
			<p>Hello, Ada!</p>
		</Journey>
	</story>

	<style>
		/* The column's width, as everything on the front page is. */
		.journey {
			margin: var(--space-6) 0 var(--space-8);
			overflow: hidden;
			border-radius: var(--radius-lg);
			background: var(--bg-raised);
			box-shadow: var(--shadow), 0 0 80px -40px rgb(169 155 255 / 0.45);
		}

		/* The steps in a row on one line, from the first number to the last (`--count` steps, the
		   picked one `--at` of `--last`). */
		.steps {
			--line: calc(var(--space-5) + 0.9rem - 1px);
			--ends: calc(50% / var(--count));
			position: relative;
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			grid-auto-flow: column;
			padding: var(--space-5) 0 var(--space-3);
		}

		/* The line, grey, and over it the part lit up to the picked step: the gradient stays where it
		   is and is uncovered (magenta at the first step, cyan at the last), so the lit part grows
		   to the step picked, or shrinks back to it, rather than fading in. Under the numbers: the
		   tabs make no stacking context of their own. */
		.steps::before,
		.steps::after {
			content: "";
			position: absolute;
			top: var(--line);
			right: var(--ends);
			left: var(--ends);
			height: 2px;
			border-radius: 1px;
			background: var(--rule-strong);
		}

		.steps::after {
			background: linear-gradient(90deg, var(--magenta), var(--accent));
			clip-path: inset(-4px calc(100% - 100% * var(--at) / var(--last)) -4px 0);
			transition: clip-path 0.4s cubic-bezier(0.65, 0, 0.35, 1);
		}

		/* A step: its number, and its name under it. Only the number answers the pointer. */
		[role="tab"] {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-2);
			padding: 0;
			border: 0;
			border-radius: 0;
			outline: none;
			background: none;
			color: var(--text-faint);
			font: inherit;
			font-size: var(--size-sm);
			font-weight: 600;
			cursor: pointer;
			transition: color 0.2s var(--wait);
		}

		/* The site's buttons fill under the pointer; a step doesn't. */
		[role="tab"]:hover:not(:disabled) {
			background: none;
		}

		.done {
			color: var(--text-muted);
		}

		[aria-selected="true"] {
			color: var(--text);
		}

		/* A number is the line's colour where it stands (`--index` of `--last`): filled once passed,
		   a ring where you are. It changes `--wait` after a step is picked, as the line reaches it;
		   what the pointer does (the halo) shows at once. */
		.num {
			--tint: color-mix(in srgb, var(--magenta), var(--accent) calc(100% * var(--index) / var(--last)));
			position: relative;
			z-index: 1;
			display: grid;
			place-items: center;
			width: 1.8rem;
			height: 1.8rem;
			border: 2px solid var(--rule-strong);
			border-radius: 50%;
			background: var(--bg-raised);
			font: 700 var(--size-xs) var(--mono);
			transition:
				border-color 0.2s var(--wait),
				background-color 0.2s var(--wait),
				color 0.2s var(--wait),
				box-shadow 0.15s;
		}

		.done .num {
			border-color: var(--tint);
			background-color: var(--tint);
			color: var(--accent-text);
		}

		[aria-selected="true"] .num {
			border-color: var(--tint);
			color: var(--tint);
			box-shadow: 0 0 0 4px color-mix(in srgb, var(--tint) 18%, transparent);
		}

		[role="tab"]:not([aria-selected="true"]):hover .num {
			box-shadow: 0 0 0 4px var(--fill-strong);
		}

		[role="tab"]:focus-visible .num {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}

		@media (prefers-reduced-motion: reduce) {
			.steps::after,
			[role="tab"],
			.num {
				transition: none;
			}
		}

		/* Every panel in one cell, the picked one shown: the cell is as tall as the tallest, so the
		   live part under them stays where it is whichever step is picked. */
		.panels {
			display: grid;
		}

		.panel {
			grid-area: 1 / 1;
			min-width: 0;
			padding: var(--space-3) var(--space-5) 0;
			visibility: hidden;
		}

		.current {
			visibility: visible;
		}

		.file {
			margin: 0 0 var(--space-2);
			color: var(--text-faint);
			font: 600 var(--size-sm) var(--mono);
		}

		/* What a panel says of its step: a line or two, then its code. */
		.panel :global(.say) {
			margin: 0 0 var(--space-3);
			color: var(--text-muted);
		}

		.panel :global(.code) {
			margin: 0;
		}

		/* A line stays one line, the panel scrolling sideways: the Roc rocx writes is wide, and
		   wrapped it loses its shape. */
		.panel :global(.code pre) {
			white-space: pre;
			overflow-wrap: normal;
		}

		.next {
			display: flex;
			justify-content: flex-end;
			margin: 0;
			padding: var(--space-2) var(--space-5) var(--space-4);
		}

		.next button {
			padding: var(--space-1) 0;
			border: 0;
			background: none;
			color: var(--accent);
			font: inherit;
			font-weight: 600;
			cursor: pointer;
		}

		.next button::after {
			content: " →";
			content: " →" / "";
		}

		.next button:hover {
			text-shadow: var(--glow-text);
		}

		.stage {
			padding: var(--space-4) var(--space-5) var(--space-5);
			background: var(--bg-sunken);
		}

		.label {
			margin: 0 0 var(--space-3);
			color: var(--magenta);
			font-size: var(--size-sm);
			font-weight: 600;
		}

		/* The runtime's log, in the last step: site.js writes its lines, so they are global here. */
		.panel :global(.inspector) {
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius);
			background: var(--bg-code);
			font: var(--size-xs) / 1.5 var(--mono);
		}

		.panel :global(.inspector ol) {
			max-height: 13rem;
			margin: 0;
			padding: 0;
			overflow-y: auto;
			list-style: none;
		}

		.panel :global(.inspector li) {
			padding: var(--space-2) 0;
			border-top: 1px solid var(--rule);
		}

		.panel :global(.inspector li:first-child) {
			border-top: 0;
		}

		.panel :global(.inspector .empty) {
			color: var(--text-faint);
		}

		.panel :global(.inspector .event) {
			color: var(--accent-strong);
			font-weight: 700;
		}

		.panel :global(.inspector .patch),
		.panel :global(.inspector .wire) {
			display: block;
			color: var(--text-muted);
		}

		@media (max-width: 40rem) {
			[role="tab"] {
				font-size: var(--size-xs);
			}
		}
	</style>
}
