import pf.Html
import pf.Solid exposing [create_signal!]

## A component's way from its file to the page, a step at a time: numbered steps above, the
## picked step's panel under them (`panel`, which a page wraps in `<NoHydration>`), and the
## component itself, live, under both whatever step is picked. A click in the live part goes to
## the last step, which shows what the click did. Inside, it is a demo to site.js (`data-demo`, a
## box of no layout), so its own patches (a step picked) aren't put in the log of the demo in it.
Journey := [].{
	Step : { name : Str, file : Str, panel : List(Html) }

	Props := {
		steps : List(Step),
		label : Str ?? "Live",
		children : List(Html),
	}

	view! : Props => Html
	view! = |props| {
		(at!, set_at!) = create_signal!(0)
		steps = props.steps
		last = steps.len() - 1
		names = steps.map(|step| step.name)
		<figure class="journey">
			<div data-demo="journey">
				<div class="steps" role="tablist" aria-label="From the file to the page">
					{...steps.map_with_index(|step, index|
						<button
							type="button"
							role="tab"
							id={"journey-tab-${index.to_str()}"}
							aria-controls={"journey-panel-${index.to_str()}"}
							aria-selected={if (at!() == index) "true" else "false"}
							class:done={at!() > index}
							class:reached={at!() >= index}
							on:click={|| set_at!(index)}
						>
							<span class="num">{(index + 1).to_str()}</span>
							<span class="name">{step.name}</span>
						</button>)}
				</div>
				<div class="panels">
					{...steps.map_with_index(|step, index|
						<div
							class="panel"
							class:current={at!() == index}
							role="tabpanel"
							id={"journey-panel-${index.to_str()}"}
							aria-labelledby={"journey-tab-${index.to_str()}"}
						>
							<p class="file">{step.file}</p>
							{...step.panel}
						</div>)}
				</div>
				<p class="next">
					<button type="button" on:click={|| set_at!(if (at!() == last) 0 else at!() + 1)}>
						{if (at!() == last) "Start again" else "Next: ${names.get(at!() + 1) ?? ""}"}
					</button>
				</p>
				<div class="stage" on:click={|| set_at!(last)}>
					<p class="label">{props.label}</p>
					{...props.children}
				</div>
			</div>
		</figure>
	}

	<story name="Three steps">
		<Journey
			steps={[
				{ name: "Write", file: "Hello.rocx", panel: [<p>Markup in Roc.</p>] },
				{ name: "Build", file: "Hello.roc", panel: [<p>Plain Roc, line for line.</p>] },
				{ name: "Run", file: "app.wasm", panel: [<p>The same code, in the browser.</p>] },
			]}
		>
			<p>Hello, Ada!</p>
		</Journey>
	</story>

	<style>
		/* The column's width, as everything on the front page is. */
		.journey {
			margin: var(--space-6) 0 var(--space-8);
			overflow: hidden;
			border-radius: var(--radius-lg);
			background: var(--bg-raised);
			box-shadow: var(--shadow), 0 0 80px -40px rgb(169 155 255 / 0.45);
		}

		/* The steps in a row, a line from each number to the next, lit up to the picked one. */
		.steps {
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			grid-auto-flow: column;
			padding: var(--space-5) 0 var(--space-3);
		}

		/* Each step but the first draws the line from the step before it: grey, and lit once reached. */
		/* Under every number: the tabs make no stacking context of their own, so a step's line can't
		   cover the number before it. */
		[role="tab"]:not(:first-child)::before,
		[role="tab"]:not(:first-child)::after {
			content: "";
			position: absolute;
			z-index: 0;
			top: calc(0.9rem - 1px);
			right: 50%;
			width: 100%;
			height: 2px;
			background: var(--rule-strong);
		}

		[role="tab"]:not(:first-child)::after {
			background: var(--gradient);
			opacity: 0;
			transition: opacity 0.3s;
		}

		.reached:not(:first-child)::after {
			opacity: 1;
		}

		[role="tab"] {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-2);
			padding: 0;
			border: 0;
			background: none;
			color: var(--text-faint);
			font: inherit;
			font-size: var(--size-sm);
			font-weight: 600;
			cursor: pointer;
			transition: color 0.15s;
		}

		[role="tab"]:hover,
		[aria-selected="true"] {
			color: var(--text);
		}

		.num {
			position: relative;
			z-index: 1;
			display: grid;
			place-items: center;
			width: 1.8rem;
			height: 1.8rem;
			border: 2px solid var(--rule-strong);
			border-radius: 50%;
			background: var(--bg-raised);
			font: 700 var(--size-xs) var(--mono);
			transition:
				border-color 0.15s,
				background 0.15s,
				color 0.15s;
		}

		.done .num {
			border-color: transparent;
			background: var(--gradient);
			color: var(--bg);
		}

		[aria-selected="true"] .num {
			border-color: var(--accent);
			color: var(--accent);
			box-shadow: var(--glow);
		}

		/* Every panel in one cell, the picked one shown: the cell is as tall as the tallest, so the
		   live part under them stays where it is whichever step is picked. */
		.panels {
			display: grid;
		}

		.panel {
			grid-area: 1 / 1;
			min-width: 0;
			padding: var(--space-3) var(--space-5) 0;
			visibility: hidden;
		}

		.current {
			visibility: visible;
		}

		.file {
			margin: 0 0 var(--space-2);
			color: var(--text-faint);
			font: 600 var(--size-sm) var(--mono);
		}

		/* What a panel says of its step: a line or two, then its code. */
		.panel :global(.say) {
			margin: 0 0 var(--space-3);
			color: var(--text-muted);
		}

		.panel :global(.code) {
			margin: 0;
		}

		/* A line stays one line, the panel scrolling sideways: the Roc rocx writes is wide, and
		   wrapped it loses its shape. */
		.panel :global(.code pre) {
			white-space: pre;
			overflow-wrap: normal;
		}

		.next {
			display: flex;
			justify-content: flex-end;
			margin: 0;
			padding: var(--space-2) var(--space-5) var(--space-4);
		}

		.next button {
			padding: var(--space-1) 0;
			border: 0;
			background: none;
			color: var(--accent);
			font: inherit;
			font-weight: 600;
			cursor: pointer;
		}

		.next button::after {
			content: " →";
			content: " →" / "";
		}

		.next button:hover {
			text-shadow: var(--glow-text);
		}

		.stage {
			padding: var(--space-4) var(--space-5) var(--space-5);
			background: var(--bg-sunken);
		}

		.label {
			margin: 0 0 var(--space-3);
			color: var(--magenta);
			font-size: var(--size-sm);
			font-weight: 600;
		}

		/* The runtime's log, in the last step: site.js writes its lines, so they are global here. */
		.panel :global(.inspector) {
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius);
			background: var(--bg-code);
			font: var(--size-xs) / 1.5 var(--mono);
		}

		.panel :global(.inspector ol) {
			max-height: 13rem;
			margin: 0;
			padding: 0;
			overflow-y: auto;
			list-style: none;
		}

		.panel :global(.inspector li) {
			padding: var(--space-2) 0;
			border-top: 1px solid var(--rule);
		}

		.panel :global(.inspector li:first-child) {
			border-top: 0;
		}

		.panel :global(.inspector .empty) {
			color: var(--text-faint);
		}

		.panel :global(.inspector .event) {
			color: var(--accent-strong);
			font-weight: 700;
		}

		.panel :global(.inspector .patch),
		.panel :global(.inspector .wire) {
			display: block;
			color: var(--text-muted);
		}

		@media (max-width: 40rem) {
			[role="tab"] {
				font-size: var(--size-xs);
			}
		}
	</style>
}
