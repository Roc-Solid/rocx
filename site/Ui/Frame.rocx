import pf.Html

## A page's columns under the bar: its part's pages, the page, what is on it. `landing` for the
## front page (and a story), which is in no part: one column, narrower, nothing beside it.
Frame := [].{
	view! : { landing : Bool, children : List(Html) } => Html
	view! = |{ landing, children }| <div class="frame" class:landing={landing}>{...children}</div>

	<story name="Three columns">
		<Frame landing={Bool.False}>
			<nav class="demo-column">The part's pages</nav>
			<main class="demo-column">The page</main>
			<aside class="demo-column">On this page</aside>
		</Frame>
	</story>

	<story name="The front page">
		<Frame landing={Bool.True}>
			<main class="demo-column">One column, in the middle</main>
		</Frame>
	</story>

	<style>
		.frame {
			display: grid;
			grid-template-columns: 15rem minmax(0, 1fr) 13rem;
			gap: var(--space-8);
			max-width: 88rem;
			margin: 0 auto;
			padding: 0 var(--space-6);
		}

		/* Two classes, so the narrower screens' `.frame` doesn't undo it. */
		.frame.landing {
			grid-template-columns: minmax(0, 1fr);
			max-width: 64rem;
		}

		/* The page: the layout's <main>, global here. */
		.frame > :global(main) {
			min-width: 0;
			padding: var(--space-7) 0 var(--space-9);
		}

		.demo-column {
			padding: var(--space-7) var(--space-4);
			border-radius: var(--radius);
			background: var(--bg-raised);
			color: var(--text-muted);
		}

		@media (max-width: 75rem) {
			.frame {
				grid-template-columns: 14rem minmax(0, 1fr);
			}
		}

		@media (max-width: 52rem) {
			.frame {
				display: block;
				padding: 0 var(--space-4);
			}
		}
	</style>
}
