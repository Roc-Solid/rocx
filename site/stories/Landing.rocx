import pf.Html
import ../Demos/Counter
import ../Ui/Code
import ../Ui/Button
import ../Facts
import ../Generated/Paths
import ../Generated/Sources
import ../Generated/RootPage

## Ways the front page could look, for the dev build's catalog (`just dev`, then /__rocx/stories,
## and "side by side" beside Landing). Only a dev build has stories/: `just site` never sees it.
## The first is the page as it is. The others are one layout (the line, what it means, the way in,
## then a component as written and as it runs, then write, build, run) in themes of their own:
## each sets the site's tokens (`--bg`, `--accent`, `--t-keyword`…) on its page, so the code and the
## counter in it take them too, and has its own <style>, so their classes never meet.
Landing := [].{
	<story name="Today">
		<RootPage params={{}} />
	</story>

	<story name="Midnight">
		<Midnight facts={Facts.facts!({})} />
	</story>

	<story name="Paper">
		<Paper facts={Facts.facts!({})} />
	</story>

	<story name="Neon">
		<Neon facts={Facts.facts!({})} />
	</story>

	<story name="Swiss">
		<Swiss facts={Facts.facts!({})} />
	</story>

	<story name="Phosphor">
		<Phosphor facts={Facts.facts!({})} />
	</story>

	<story name="Pastel">
		<Pastel facts={Facts.facts!({})} />
	</story>
}

## Deep indigo, a violet glow behind the line, and the component in a window that floats on it.
Midnight := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption><span class="dots"><i></i><i></i><i></i></span>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Rendered on the server, awake in your browser</p>
					<div data-demo="counter"><Counter start_value={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">1</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">2</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">3</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #0e0c17;
			--bg-raised: #1a1727;
			--bg-sunken: #0a0911;
			--bg-code: #13101e;
			--text: #ece9f7;
			--text-muted: #a8a3c0;
			--text-faint: #6f6a88;
			--rule: #2a2540;
			--rule-strong: #3d3660;
			--accent: #a77bff;
			--accent-strong: #c4a6ff;
			--accent-soft: #2a2145;
			--accent-text: #120f1d;
			--bad: #ff8a80;
			--t-keyword: #c4a6ff;
			--t-type: #6fc3e8;
			--t-string: #7fd8a4;
			--t-comment: #6f6a88;
			--t-tag: #ff8fb8;
			--t-attr: #f2c27a;
			--t-hole: #c4a6ff;
			--t-number: #ffb07a;
			--t-call: #8fa8ff;
			--t-op: #9d98b2;
			--t-entity: #ffb07a;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: radial-gradient(ellipse 70% 45% at 50% 0%, #34246a 0%, #0e0c17 100%) fill 0 / / 0 100vmax;
		}

		.top {
			text-align: center;
		}

		.kicker {
			margin: 0;
			color: var(--accent-strong);
			font: 600 0.85rem var(--mono);
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		h1 {
			max-width: 16ch;
			margin: 0.75rem auto 1.25rem;
			font-size: clamp(2.6rem, 6vw, 4.2rem);
			letter-spacing: -0.04em;
			line-height: 1.02;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 1px solid var(--rule-strong);
			border-radius: 16px;
			background: var(--bg-raised);
			box-shadow: 0 0 0 1px rgb(167 123 255 / 0.08), 0 30px 90px rgb(84 48 190 / 0.35);
			overflow: hidden;
		}

		figcaption {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			padding: 0.7rem 1rem;
			border-bottom: 1px solid var(--rule);
			color: var(--text-faint);
			font: 0.8rem var(--mono);
		}

		.dots {
			display: flex;
			gap: 0.35rem;
		}

		i {
			width: 0.65rem;
			height: 0.65rem;
			border-radius: 50%;
			background: var(--rule-strong);
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 1px dashed var(--rule-strong);
			background: var(--bg-sunken);
		}

		.label {
			margin: 0 0 0.75rem;
			color: var(--text-faint);
			font: 600 0.72rem var(--mono);
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
			text-align: center;
		}

		.trio > div {
			display: grid;
			justify-items: center;
			gap: 0.4rem;
		}

		.num {
			display: grid;
			place-items: center;
			width: 2rem;
			height: 2rem;
			border-radius: 50%;
			background: var(--accent-soft);
			color: var(--accent-strong);
			font: 700 0.85rem var(--mono);
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## Warm paper and ink: a serif line, small capitals, and the component as a figure in a book.
Paper := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid &middot; a framework</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage"><div data-demo="counter"><Counter start_value={3} /></div></div>
				<figcaption><b>Fig. 1</b> A counter, as it is written in <i>Counter.rocx</i>, and as it runs.</figcaption>
			</figure>
			<div class="trio">
				<div><span class="num">I.</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">II.</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">III.</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #f4efe4;
			--bg-raised: #fbf8f1;
			--bg-sunken: #ebe4d4;
			--bg-code: #fbf8f1;
			--text: #221c14;
			--text-muted: #5e5546;
			--text-faint: #8c8270;
			--rule: #ddd3bf;
			--rule-strong: #b9aa8c;
			--accent: #c2410c;
			--accent-strong: #9a3412;
			--accent-soft: #fbe3d4;
			--accent-text: #fff8f1;
			--bad: #b42318;
			--t-keyword: #9a3412;
			--t-type: #1d4e89;
			--t-string: #3f6212;
			--t-comment: #8c8270;
			--t-tag: #9a3412;
			--t-attr: #854d0e;
			--t-hole: #c2410c;
			--t-number: #a16207;
			--t-call: #1d4e89;
			--t-op: #5e5546;
			--t-entity: #a16207;
			--radius: 3px;
			--font: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			font-family: var(--font);
			border-image: linear-gradient(#f4efe4, #efe8da) fill 0 / / 0 100vmax;
		}

		.top {
			padding-bottom: 2.5rem;
			border-bottom: 3px double var(--rule-strong);
			text-align: center;
		}

		.kicker {
			margin: 0;
			color: var(--accent-strong);
			font-size: 0.95rem;
			font-variant: small-caps;
			letter-spacing: 0.12em;
			text-transform: lowercase;
		}

		h1 {
			max-width: 16ch;
			margin: 0.75rem auto 1.25rem;
			font: 600 clamp(2.6rem, 6vw, 4.4rem) / 1.04 var(--font);
			letter-spacing: -0.02em;
		}

		.intro {
			max-width: 32rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.25rem;
			font-style: italic;
			line-height: 1.5;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			border-radius: 2px;
			font-family: var(--font);
			font-size: 1.05rem;
		}

		.specimen {
			max-width: 38rem;
			margin: 3rem auto;
		}

		.specimen :global(.code) {
			margin: 0;
			border-color: var(--rule-strong);
			box-shadow: 0 1px 0 var(--rule);
		}

		.stage {
			margin-top: 0.75rem;
			padding: 1.25rem;
			border: 1px dashed var(--rule-strong);
			background: var(--bg-raised);
		}

		figcaption {
			margin-top: 0.85rem;
			color: var(--text-muted);
			font-size: 0.95rem;
			text-align: center;
		}

		figcaption b {
			margin-right: 0.4rem;
			font-variant: small-caps;
			letter-spacing: 0.06em;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2.5rem;
			padding-top: 2rem;
			border-top: 1px solid var(--rule);
		}

		.trio > div {
			display: grid;
			gap: 0.25rem;
		}

		.num {
			color: var(--accent);
			font-size: 1.4rem;
			font-style: italic;
		}

		.trio strong {
			font-size: 1.15rem;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
			line-height: 1.5;
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## Neon, calmly: a line in a gradient from magenta to cyan on near black, and the neon colours in
## the code and the buttons, with no borders, no glow and no grid.
Neon := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Live</p>
					<div data-demo="counter"><Counter start_value={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">01</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">02</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">03</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #0c0b12;
			--bg-raised: #15131f;
			--bg-sunken: #100e19;
			--bg-code: #15131f;
			--text: #f4f1ff;
			--text-muted: #b5aed3;
			--text-faint: #77719a;
			--rule: #221f33;
			--rule-strong: #2c2842;
			--accent: #2ee8ff;
			--accent-strong: #8ff4ff;
			--accent-soft: rgb(46 232 255 / 0.1);
			--accent-text: #0c0b12;
			--bad: #ff3fc9;
			--t-keyword: #ff4fd0;
			--t-type: #2ee8ff;
			--t-string: #b6ff4a;
			--t-comment: #77719a;
			--t-tag: #ff6fb0;
			--t-attr: #ffd447;
			--t-hole: #2ee8ff;
			--t-number: #ffd447;
			--t-call: #a99bff;
			--t-op: #b5aed3;
			--t-entity: #ffd447;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#0c0b12, #110c1d) fill 0 / / 0 100vmax;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-block;
			margin: 0;
			padding: 0.3rem 0.85rem;
			border-radius: 999px;
			background: rgb(46 232 255 / 0.1);
			color: var(--accent);
			font-size: 0.9rem;
			font-weight: 600;
		}

		h1 {
			max-width: 15ch;
			margin: 1rem auto 1.25rem;
			background: linear-gradient(90deg, #ff3fc9, #a99bff 50%, #2ee8ff);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			font-size: clamp(2.8rem, 6.5vw, 4.6rem);
			letter-spacing: -0.04em;
			line-height: 1.02;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			border: 0;
			background: rgb(255 255 255 / 0.07);
		}

		.cta :global(.button:hover) {
			background: rgb(255 255 255 / 0.12);
		}

		.cta :global(.button.primary) {
			background: var(--accent);
			color: var(--accent-text);
		}

		.cta :global(.button.primary:hover) {
			background: var(--accent-strong);
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border-radius: 16px;
			background: var(--bg-raised);
			box-shadow: 0 24px 60px rgb(0 0 0 / 0.3);
			overflow: hidden;
		}

		figcaption {
			padding: 0.9rem 1.25rem 0;
			color: var(--text-faint);
			font: 600 0.85rem var(--mono);
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1.1rem 1.25rem 1.25rem;
			background: var(--bg-sunken);
		}

		.label {
			margin: 0 0 0.75rem;
			color: #ff4fd0;
			font-size: 0.85rem;
			font-weight: 600;
		}

		.stage :global(.counter button) {
			border: 0;
			background: rgb(255 255 255 / 0.07);
		}

		.stage :global(.counter button:hover:not(:disabled)) {
			background: rgb(46 232 255 / 0.14);
			color: var(--accent);
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
			text-align: center;
		}

		.trio > div {
			display: grid;
			justify-items: center;
			gap: 0.35rem;
		}

		.num {
			background: linear-gradient(90deg, #ff3fc9, #2ee8ff);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			font-size: 1.8rem;
			font-weight: 800;
			letter-spacing: -0.02em;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## White, black and one red: a line as big as a poster, hard edges, shadows that are blocks.
Swiss := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption><span>Counter.rocx</span><span>Component</span></figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Output</p>
					<div data-demo="counter"><Counter start_value={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">01</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">02</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">03</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #ffffff;
			--bg-raised: #ffffff;
			--bg-sunken: #f1f1f1;
			--bg-code: #ffffff;
			--text: #0a0a0a;
			--text-muted: #262626;
			--text-faint: #6b6b6b;
			--rule: #0a0a0a;
			--rule-strong: #0a0a0a;
			--accent: #e10600;
			--accent-strong: #b00500;
			--accent-soft: #ffe3e1;
			--accent-text: #ffffff;
			--bad: #e10600;
			--t-keyword: #e10600;
			--t-type: #0a0a0a;
			--t-string: #0047ff;
			--t-comment: #6b6b6b;
			--t-tag: #e10600;
			--t-attr: #0a0a0a;
			--t-hole: #e10600;
			--t-number: #0047ff;
			--t-call: #0047ff;
			--t-op: #0a0a0a;
			--t-entity: #0047ff;
			--radius: 0;
			--font: "Helvetica Neue", Helvetica, Arial, sans-serif;
			margin: -2.5rem 0 -4rem;
			padding: 4.5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			font-family: var(--font);
			border-image: linear-gradient(#ffffff, #ffffff) fill 0 / / 0 100vmax;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-block;
			margin: 0;
			padding: 0.3rem 0.6rem;
			background: var(--text);
			color: #ffffff;
			font: 700 0.8rem var(--mono);
			letter-spacing: 0.2em;
			text-transform: uppercase;
		}

		h1 {
			max-width: 14ch;
			margin: 1.25rem auto 1.5rem;
			font-size: clamp(3rem, 7.5vw, 5.6rem);
			font-weight: 800;
			letter-spacing: -0.055em;
			line-height: 0.92;
			text-transform: uppercase;
		}

		.intro {
			max-width: 32rem;
			margin: 0 auto 2rem;
			font-size: 1.15rem;
			font-weight: 500;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 1rem;
		}

		.cta :global(.button) {
			border: 2px solid var(--text);
			border-radius: 0;
			box-shadow: 4px 4px 0 var(--text);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 3px solid var(--text);
			background: #ffffff;
			box-shadow: 12px 12px 0 var(--accent);
		}

		figcaption {
			display: flex;
			justify-content: space-between;
			padding: 0.5rem 0.9rem;
			background: var(--text);
			color: #ffffff;
			font: 700 0.75rem var(--mono);
			letter-spacing: 0.15em;
			text-transform: uppercase;
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 3px solid var(--text);
		}

		.stage :global(.counter button) {
			border: 2px solid var(--text);
			border-radius: 0;
			box-shadow: 3px 3px 0 var(--text);
		}

		.label {
			margin: 0 0 0.75rem;
			color: var(--accent);
			font: 700 0.75rem var(--mono);
			letter-spacing: 0.2em;
			text-transform: uppercase;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			border-top: 3px solid var(--text);
		}

		.trio > div {
			display: grid;
			gap: 0.3rem;
			padding: 1.25rem 1.25rem 0;
		}

		.trio > div + div {
			border-left: 1px solid var(--text);
		}

		.num {
			color: var(--accent);
			font-size: 2.6rem;
			font-weight: 800;
			letter-spacing: -0.05em;
			line-height: 1;
		}

		.trio strong {
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.trio p {
			margin: 0;
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}

			.trio > div + div {
				border-left: 0;
			}
		}
	</style>
}

## A green screen from long ago: everything in one monospaced face, scan lines, a cursor that blinks.
Phosphor := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">ROC SOLID v0.1 &middot; READY</p>
				<h1>Roc, from the database to the browser.<span class="cursor" aria-hidden="true">▍</span></h1>
				<p class="intro">
					&gt; One language for the whole app: the pages, the server, its jobs, and the components that
					run in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>[ Read the guide ]</Button>
					<Button href={Paths.showcase}>[ See it run ]</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>A:\&gt; TYPE COUNTER.ROCX</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">A:\&gt; RUN COUNTER</p>
					<div data-demo="counter"><Counter start_value={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><strong>[1] WRITE</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><strong>[2] BUILD</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><strong>[3] RUN</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #050a05;
			--bg-raised: #081208;
			--bg-sunken: #030703;
			--bg-code: #060d06;
			--text: #b8ffb0;
			--text-muted: #7ee077;
			--text-faint: #3c8a3a;
			--rule: #1d4a1c;
			--rule-strong: #33ff33;
			--accent: #33ff33;
			--accent-strong: #9dff8f;
			--accent-soft: #0d260d;
			--accent-text: #031003;
			--bad: #ffb000;
			--t-keyword: #9dff8f;
			--t-type: #33ff33;
			--t-string: #d4ff8f;
			--t-comment: #3c8a3a;
			--t-tag: #33ff33;
			--t-attr: #ffb000;
			--t-hole: #ffb000;
			--t-number: #ffb000;
			--t-call: #9dff8f;
			--t-op: #7ee077;
			--t-entity: #ffb000;
			--radius: 0;
			--font: var(--mono);
			position: relative;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			font-family: var(--mono);
			text-shadow: 0 0 6px rgb(51 255 51 / 0.45);
			border-image: radial-gradient(ellipse at 50% 40%, #0b170b 0%, #020502 100%) fill 0 / / 0 100vmax;
		}

		.page::after {
			content: "";
			position: absolute;
			inset: 0;
			background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.28) 0 1px, transparent 1px 3px);
			pointer-events: none;
		}

		.top {
			text-align: center;
		}

		.kicker {
			margin: 0;
			color: var(--text-faint);
			font-size: 0.8rem;
			letter-spacing: 0.2em;
		}

		h1 {
			max-width: 22ch;
			margin: 1rem auto 1.25rem;
			font: 700 clamp(2rem, 4.6vw, 3.3rem) / 1.15 var(--mono);
			letter-spacing: -0.02em;
		}

		.cursor {
			margin-left: 0.1em;
			animation: blink 1.1s steps(1) infinite;
		}

		@keyframes blink {
			50% {
				opacity: 0;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.cursor {
				animation: none;
			}
		}

		.intro {
			max-width: 36rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 1rem;
		}

		.cta :global(.button) {
			border-radius: 0;
			font-family: var(--mono);
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 2px solid var(--accent);
			border-radius: 22px;
			background: var(--bg-raised);
			box-shadow: inset 0 0 40px rgb(51 255 51 / 0.12), 0 0 30px rgb(51 255 51 / 0.15);
			overflow: hidden;
		}

		figcaption,
		.label {
			margin: 0;
			color: var(--text-faint);
			font-size: 0.8rem;
			letter-spacing: 0.1em;
		}

		figcaption {
			padding: 0.8rem 1.25rem 0;
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			background: transparent;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 1px dashed var(--rule);
		}

		.label {
			margin-bottom: 0.75rem;
		}

		.stage :global(.counter button) {
			border-radius: 0;
			background: transparent;
			color: var(--accent);
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}

		.trio > div {
			display: grid;
			gap: 0.5rem;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
			font-size: 0.9rem;
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## Soft colours that drift into one another, cards of frosted glass, everything round.
Pastel := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<div class="blob one" aria-hidden="true"></div>
			<div class="blob two" aria-hidden="true"></div>
			<section class="top">
				<p class="kicker">✿ Roc Solid</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">and here it is, running</p>
					<div data-demo="counter"><Counter start_value={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div class="pink"><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div class="lilac"><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div class="mint"><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #fbf7ff;
			--bg-raised: rgb(255 255 255 / 0.75);
			--bg-sunken: rgb(255 255 255 / 0.5);
			--bg-code: rgb(255 255 255 / 0.6);
			--text: #2d1b4e;
			--text-muted: #5f4b80;
			--text-faint: #9a8bb5;
			--rule: rgb(120 90 180 / 0.16);
			--rule-strong: rgb(120 90 180 / 0.3);
			--accent: #8b5cf6;
			--accent-strong: #6d28d9;
			--accent-soft: #ede4ff;
			--accent-text: #ffffff;
			--bad: #e11d48;
			--t-keyword: #7c3aed;
			--t-type: #0e7490;
			--t-string: #15803d;
			--t-comment: #9a8bb5;
			--t-tag: #db2777;
			--t-attr: #b45309;
			--t-hole: #7c3aed;
			--t-number: #c2410c;
			--t-call: #2563eb;
			--t-op: #5f4b80;
			--t-entity: #c2410c;
			--radius: 18px;
			--font: ui-rounded, "SF Pro Rounded", "Nunito", system-ui, sans-serif;
			position: relative;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			font-family: var(--font);
			border-image: linear-gradient(135deg, #fde2f3 0%, #ece6ff 45%, #dcf6ee 100%) fill 0 / / 0 100vmax;
		}

		.blob {
			position: absolute;
			width: 26rem;
			height: 26rem;
			border-radius: 50%;
			filter: blur(60px);
			opacity: 0.55;
			pointer-events: none;
		}

		.one {
			top: 4rem;
			left: -6rem;
			background: #f9a8d4;
		}

		.two {
			top: 22rem;
			right: -6rem;
			background: #99f6e4;
		}

		.top,
		.specimen,
		.trio {
			position: relative;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-block;
			margin: 0;
			padding: 0.35rem 0.9rem;
			border-radius: 999px;
			background: rgb(255 255 255 / 0.7);
			color: var(--accent-strong);
			font-weight: 700;
		}

		h1 {
			max-width: 16ch;
			margin: 1rem auto 1.25rem;
			font: 800 clamp(2.6rem, 6vw, 4.2rem) / 1.05 var(--font);
			letter-spacing: -0.03em;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			padding: 0.7rem 1.4rem;
			border-radius: 999px;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			padding: 0.75rem;
			border: 1px solid rgb(255 255 255 / 0.8);
			border-radius: 28px;
			background: rgb(255 255 255 / 0.45);
			box-shadow: 0 24px 70px rgb(109 40 217 / 0.16);
			backdrop-filter: blur(18px);
		}

		figcaption {
			padding: 0.35rem 0.75rem 0.6rem;
			color: var(--text-faint);
			font-weight: 700;
		}

		.specimen :global(.code) {
			margin: 0;
		}

		.stage {
			margin-top: 0.75rem;
			padding: 1rem 1.25rem 1.25rem;
			border-radius: 20px;
			background: linear-gradient(135deg, rgb(220 246 238 / 0.9), rgb(236 230 255 / 0.9));
		}

		.label {
			margin: 0 0 0.75rem;
			color: var(--text-muted);
			font-weight: 700;
		}

		.stage :global(.counter button) {
			border-radius: 999px;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
		}

		.trio > div {
			display: grid;
			gap: 0.35rem;
			padding: 1.25rem 1.4rem;
			border-radius: 22px;
		}

		.pink {
			background: rgb(253 226 243 / 0.85);
		}

		.lilac {
			background: rgb(236 230 255 / 0.9);
		}

		.mint {
			background: rgb(220 246 238 / 0.9);
		}

		.trio strong {
			font-size: 1.1rem;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}
