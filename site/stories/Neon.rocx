import pf.Html
import ../Demos/Counter
import ../Ui/Code
import ../Ui/Button
import ../Facts
import ../Generated/Paths
import ../Generated/Sources

## Neon colours, without the future: the front page's layout (the line, what it means, the way in,
## a component as written and as it runs, then write, build, run) in fluorescent inks on things
## made by hand or printed, rather than glowing on black. Each draft sets the site's tokens on its
## page, so the code and the counter in it take its colours, and has its own <style>.
Neon := [].{
	<story name="Riso">
		<Riso facts={Facts.facts!({})} />
	</story>

	<story name="Highlighter">
		<Highlighter facts={Facts.facts!({})} />
	</story>

	<story name="Pop">
		<Pop facts={Facts.facts!({})} />
	</story>

	<story name="Flat">
		<Flat facts={Facts.facts!({})} />
	</story>

	<story name="Poster">
		<Poster facts={Facts.facts!({})} />
	</story>
}

## A risograph print: fluorescent pink and blue ink on paper, the pink a little off its mark.
Riso := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<div class="grain" aria-hidden="true"></div>
			<section class="top">
				<p class="kicker">Roc Solid &middot; printed in two inks</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">and the same, running</p>
					<div data-demo="counter"><Counter start={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">1</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">2</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">3</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #f6f1e6;
			--bg-raised: #fbf7ee;
			--bg-sunken: #efe7d6;
			--bg-code: #fbf7ee;
			--text: #1d3f9a;
			--text-muted: #3d5bab;
			--text-faint: #7b8cc0;
			--rule: #d9cfbb;
			--rule-strong: #1d3f9a;
			--accent: #ff48b0;
			--accent-strong: #f0279a;
			--accent-soft: #ffd6ec;
			--accent-text: #1d3f9a;
			--bad: #ff48b0;
			--t-keyword: #f0279a;
			--t-type: #1d3f9a;
			--t-string: #1d3f9a;
			--t-comment: #7b8cc0;
			--t-tag: #f0279a;
			--t-attr: #3d5bab;
			--t-hole: #f0279a;
			--t-number: #f0279a;
			--t-call: #1d3f9a;
			--t-op: #3d5bab;
			--t-entity: #f0279a;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#f6f1e6, #f2ecdf) fill 0 / / 0 100vmax;
		}

		.grain {
			position: fixed;
			inset: 0;
			background: radial-gradient(rgb(29 63 154 / 0.1) 1px, transparent 1.4px) 0 0 / 5px 5px;
			mix-blend-mode: multiply;
			pointer-events: none;
		}

		.top {
			text-align: center;
		}

		.kicker {
			margin: 0;
			color: var(--accent-strong);
			font: 700 0.8rem var(--mono);
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		h1 {
			max-width: 15ch;
			margin: 0.75rem auto 1.25rem;
			font-size: clamp(2.8rem, 6.5vw, 4.6rem);
			font-weight: 900;
			letter-spacing: -0.04em;
			line-height: 1;
			text-shadow: 0.06em 0.04em 0 rgb(255 72 176 / 0.85);
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			border: 2px solid var(--text);
			border-radius: 999px;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 2px solid var(--text);
			border-radius: 6px;
			background: var(--bg-raised);
			box-shadow: 7px 7px 0 var(--accent);
			overflow: hidden;
		}

		figcaption {
			padding: 0.6rem 1rem;
			border-bottom: 2px solid var(--text);
			font: 700 0.8rem var(--mono);
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 2px solid var(--text);
			background: radial-gradient(#ffe14d 32%, transparent 34%) 0 0 / 9px 9px, #fff8d6;
		}

		.label {
			display: inline-block;
			margin: 0 0 0.75rem;
			padding: 0.1rem 0.5rem;
			background: var(--bg-raised);
			font: 700 0.75rem var(--mono);
			text-transform: uppercase;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
			text-align: center;
		}

		.trio > div {
			display: grid;
			justify-items: center;
			gap: 0.4rem;
		}

		.num {
			display: grid;
			place-items: center;
			width: 2.6rem;
			height: 2.6rem;
			border: 2px solid var(--text);
			border-radius: 50%;
			background: var(--accent);
			font-size: 1.2rem;
			font-weight: 900;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## A white page someone went over with highlighters: marker swipes behind the words that matter,
## and the steps on sticky notes.
Highlighter := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid</p>
				<h1>Roc, from the <mark class="yellow">database</mark> to the <mark class="pink">browser</mark>.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption><mark class="green">Counter.rocx</mark>, the whole component:</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label"><mark class="pink">it runs</mark> right here, in your browser:</p>
					<div data-demo="counter"><Counter start={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div class="note yellow"><strong>1. Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div class="note pink"><strong>2. Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div class="note green"><strong>3. Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #ffffff;
			--bg-raised: #ffffff;
			--bg-sunken: #f6f6f6;
			--bg-code: #fafafa;
			--text: #111111;
			--text-muted: #444444;
			--text-faint: #8a8a8a;
			--rule: #e6e6e6;
			--rule-strong: #111111;
			--accent: #fff200;
			--accent-strong: #ffe600;
			--accent-soft: #fffbb3;
			--accent-text: #111111;
			--bad: #ff2d95;
			--t-keyword: #d6007a;
			--t-type: #111111;
			--t-string: #0a8f2e;
			--t-comment: #8a8a8a;
			--t-tag: #d6007a;
			--t-attr: #444444;
			--t-hole: #d6007a;
			--t-number: #c45f00;
			--t-call: #111111;
			--t-op: #444444;
			--t-entity: #c45f00;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#ffffff, #ffffff) fill 0 / / 0 100vmax;
		}

		mark {
			margin: 0 -0.1em;
			padding: 0 0.1em;
			color: inherit;
			background: linear-gradient(100deg, transparent 0.04em, var(--marker) 0.1em, var(--marker) calc(100% - 0.1em), transparent calc(100% - 0.04em));
			background-size: 100% 0.62em;
			background-position: 0 88%;
			background-repeat: no-repeat;
		}

		.yellow {
			--marker: #fff200;
		}

		.pink {
			--marker: #ff7ad1;
		}

		.green {
			--marker: #6dff8a;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-block;
			margin: 0;
			border-bottom: 3px solid #ffa62b;
			font-weight: 700;
		}

		h1 {
			max-width: 15ch;
			margin: 1rem auto 1.25rem;
			font-size: clamp(2.6rem, 6vw, 4.2rem);
			font-weight: 800;
			letter-spacing: -0.035em;
			line-height: 1.08;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			border-color: var(--text);
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
		}

		figcaption,
		.label {
			margin: 0 0 0.6rem;
			color: var(--text-muted);
			font-weight: 600;
		}

		.specimen :global(.code) {
			margin: 0;
			border-color: var(--text);
		}

		.stage {
			margin-top: 1.5rem;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
			padding-top: 1rem;
		}

		.note {
			display: grid;
			gap: 0.4rem;
			align-content: start;
			padding: 1.1rem 1.2rem 1.4rem;
			background: var(--marker);
			box-shadow: 0 10px 20px rgb(0 0 0 / 0.08), 0 2px 3px rgb(0 0 0 / 0.08);
		}

		.note:nth-child(1) {
			transform: rotate(-1.5deg);
		}

		.note:nth-child(2) {
			transform: rotate(1deg) translateY(0.4rem);
		}

		.note:nth-child(3) {
			transform: rotate(-0.6deg);
		}

		.note p {
			margin: 0;
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## Flat and loud and friendly: hot pink, black outlines, shadows that are just shapes, cards in
## yellow, lime and cyan.
Pop := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker">Roc Solid</p>
				<h1>Roc, from the database to the browser.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Try it</p>
					<div data-demo="counter"><Counter start={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div class="yellow"><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div class="lime"><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div class="cyan"><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #ff90e8;
			--bg-raised: #ffffff;
			--bg-sunken: #fff4fd;
			--bg-code: #ffffff;
			--text: #000000;
			--text-muted: #1a1a1a;
			--text-faint: #555555;
			--rule: #000000;
			--rule-strong: #000000;
			--accent: #000000;
			--accent-strong: #2a2a2a;
			--accent-soft: #ffc900;
			--accent-text: #ffffff;
			--bad: #e0004d;
			--t-keyword: #c2008e;
			--t-type: #000000;
			--t-string: #0a7d38;
			--t-comment: #666666;
			--t-tag: #c2008e;
			--t-attr: #000000;
			--t-hole: #c2008e;
			--t-number: #b35c00;
			--t-call: #0047ff;
			--t-op: #333333;
			--t-entity: #b35c00;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#ff90e8, #ff90e8) fill 0 / / 0 100vmax;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-block;
			margin: 0;
			padding: 0.3rem 0.9rem;
			border: 2px solid var(--text);
			border-radius: 999px;
			background: #ffc900;
			font-weight: 800;
		}

		h1 {
			max-width: 15ch;
			margin: 1rem auto 1.25rem;
			font-size: clamp(2.8rem, 6.5vw, 4.6rem);
			font-weight: 900;
			letter-spacing: -0.045em;
			line-height: 1;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			font-size: 1.15rem;
			font-weight: 500;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 1rem;
		}

		.cta :global(.button) {
			border: 2px solid var(--text);
			border-radius: 10px;
			box-shadow: 4px 4px 0 var(--text);
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 2px solid var(--text);
			border-radius: 16px;
			background: #ffffff;
			box-shadow: 8px 8px 0 var(--text);
			overflow: hidden;
		}

		figcaption {
			padding: 0.6rem 1rem;
			border-bottom: 2px solid var(--text);
			background: #ffc900;
			font: 800 0.85rem var(--mono);
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 2px solid var(--text);
			background: #b8ff3b;
		}

		.stage :global(.counter button) {
			border: 2px solid var(--text);
			box-shadow: 3px 3px 0 var(--text);
		}

		.label {
			margin: 0 0 0.75rem;
			font-weight: 800;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.trio > div {
			display: grid;
			gap: 0.4rem;
			align-content: start;
			padding: 1.2rem 1.3rem;
			border: 2px solid var(--text);
			border-radius: 14px;
			box-shadow: 5px 5px 0 var(--text);
		}

		.yellow {
			background: #ffc900;
		}

		.lime {
			background: #b8ff3b;
		}

		.cyan {
			background: #6ef2ff;
		}

		.trio strong {
			font-size: 1.15rem;
		}

		.trio p {
			margin: 0;
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## Dark and plain, the way a good tool looks: flat surfaces, thin lines, and two neon colours used
## sparingly, with no glow.
Flat := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<section class="top">
				<p class="kicker"><span class="dot"></span>Roc Solid</p>
				<h1>Roc, from the <span class="lime">database</span> to the <span class="pink">browser</span>.</h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption><span>Counter.rocx</span><span class="faint">component</span></figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Live</p>
					<div data-demo="counter"><Counter start={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">1</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">2</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">3</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #111214;
			--bg-raised: #18191c;
			--bg-sunken: #0d0e10;
			--bg-code: #141518;
			--text: #f2f2f3;
			--text-muted: #a1a1aa;
			--text-faint: #6b6b74;
			--rule: #26272b;
			--rule-strong: #3a3b40;
			--accent: #c6ff00;
			--accent-strong: #d8ff4d;
			--accent-soft: #232b00;
			--accent-text: #111214;
			--bad: #ff3ea5;
			--t-keyword: #ff3ea5;
			--t-type: #7dd3fc;
			--t-string: #c6ff00;
			--t-comment: #6b6b74;
			--t-tag: #ff3ea5;
			--t-attr: #7dd3fc;
			--t-hole: #c6ff00;
			--t-number: #fdba74;
			--t-call: #7dd3fc;
			--t-op: #a1a1aa;
			--t-entity: #fdba74;
			margin: -2.5rem 0 -4rem;
			padding: 5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#111214, #111214) fill 0 / / 0 100vmax;
		}

		.top {
			text-align: center;
		}

		.kicker {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			margin: 0;
			padding: 0.3rem 0.8rem;
			border: 1px solid var(--rule-strong);
			border-radius: 999px;
			color: var(--text-muted);
			font-size: 0.85rem;
		}

		.dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: var(--accent);
		}

		h1 {
			max-width: 15ch;
			margin: 1rem auto 1.25rem;
			font-size: clamp(2.6rem, 6vw, 4.2rem);
			font-weight: 800;
			letter-spacing: -0.04em;
			line-height: 1.04;
		}

		.lime {
			color: var(--accent);
		}

		.pink {
			color: #ff3ea5;
		}

		.intro {
			max-width: 34rem;
			margin: 0 auto 2rem;
			color: var(--text-muted);
			font-size: 1.15rem;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 1px solid var(--rule-strong);
			border-radius: 12px;
			background: var(--bg-raised);
			overflow: hidden;
		}

		figcaption {
			display: flex;
			justify-content: space-between;
			padding: 0.65rem 1rem;
			border-bottom: 1px solid var(--rule);
			font: 0.8rem var(--mono);
		}

		.faint {
			color: var(--text-faint);
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 1px solid var(--rule);
		}

		.label {
			margin: 0 0 0.75rem;
			color: var(--accent);
			font: 600 0.75rem var(--mono);
			text-transform: uppercase;
			letter-spacing: 0.08em;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1px;
			border: 1px solid var(--rule);
			border-radius: 12px;
			background: var(--rule);
			overflow: hidden;
		}

		.trio > div {
			display: grid;
			gap: 0.35rem;
			align-content: start;
			padding: 1.25rem;
			background: var(--bg);
		}

		.num {
			color: var(--accent);
			font: 700 0.85rem var(--mono);
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}

## A poster for a race: light grey, huge narrow capitals, a neon green disc, and one word in neon
## orange.
Poster := [].{
	view : { facts : Str } -> Html
	view = |{ facts }|
		<div class="page">
			<div class="disc" aria-hidden="true"></div>
			<section class="top">
				<p class="kicker">Roc Solid &middot; full stack</p>
				<h1>Roc, from the database to the <span class="hot">browser.</span></h1>
				<p class="intro">
					One language for the whole app: the pages, the server, its jobs, and the components that run
					in your browser.
				</p>
				<p class="cta">
					<Button href={Paths.rocx} primary>Read the guide</Button>
					<Button href={Paths.showcase}>See it run</Button>
				</p>
			</section>
			<figure class="specimen">
				<figcaption>Counter.rocx</figcaption>
				<Code source={Sources.home_update.rocx} numbers={Bool.False} />
				<div class="stage">
					<p class="label">Running</p>
					<div data-demo="counter"><Counter start={3} /></div>
				</div>
			</figure>
			<div class="trio">
				<div><span class="num">1</span><strong>Write</strong><p>Markup wherever a Roc expression can stand.</p></div>
				<div><span class="num">2</span><strong>Build</strong><p>Plain Roc, line for line, for the compiler to check.</p></div>
				<div><span class="num">3</span><strong>Run</strong><p>Native on the server; {Facts.get(facts, "client_brotli")} of wasm in the browser.</p></div>
			</div>
		</div>

	<style>
		.page {
			--bg: #ecebe6;
			--bg-raised: #ffffff;
			--bg-sunken: #f5f5f2;
			--bg-code: #ffffff;
			--text: #0b0b0b;
			--text-muted: #333333;
			--text-faint: #777777;
			--rule: #cfcec7;
			--rule-strong: #0b0b0b;
			--accent: #ff5a1f;
			--accent-strong: #e8440a;
			--accent-soft: #ffe0d3;
			--accent-text: #0b0b0b;
			--bad: #ff5a1f;
			--t-keyword: #e8440a;
			--t-type: #0b0b0b;
			--t-string: #0a8a3a;
			--t-comment: #777777;
			--t-tag: #e8440a;
			--t-attr: #333333;
			--t-hole: #e8440a;
			--t-number: #0a8a3a;
			--t-call: #0b0b0b;
			--t-op: #333333;
			--t-entity: #0a8a3a;
			--condensed: "Avenir Next Condensed", "Helvetica Neue Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
			position: relative;
			margin: -2.5rem 0 -4rem;
			padding: 4.5rem 0 6rem;
			min-height: 100vh;
			color: var(--text);
			border-image: linear-gradient(#ecebe6, #ecebe6) fill 0 / / 0 100vmax;
		}

		.disc {
			position: absolute;
			top: 2rem;
			/* Past the page's edge, but never past the window's. */
			right: max(-4rem, calc(50% - 50vw));
			width: 22rem;
			height: 22rem;
			border-radius: 50%;
			background: #4dff6a;
		}

		.top,
		.specimen,
		.trio {
			position: relative;
		}

		.top {
			text-align: center;
		}

		.kicker {
			margin: 0;
			font: 800 0.85rem var(--condensed);
			letter-spacing: 0.25em;
			text-transform: uppercase;
		}

		h1 {
			max-width: 12ch;
			margin: 0.75rem auto 1.25rem;
			font-family: var(--condensed);
			font-size: clamp(3.4rem, 9vw, 6.6rem);
			font-stretch: condensed;
			font-weight: 800;
			letter-spacing: -0.02em;
			line-height: 0.9;
			text-transform: uppercase;
		}

		.hot {
			color: var(--accent);
		}

		.intro {
			max-width: 32rem;
			margin: 0 auto 2rem;
			font-size: 1.15rem;
			font-weight: 500;
		}

		.cta {
			display: flex;
			justify-content: center;
			gap: 0.75rem;
		}

		.cta :global(.button) {
			border: 2px solid var(--text);
			border-radius: 0;
			font-family: var(--condensed);
			font-size: 1.05rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.specimen {
			max-width: 40rem;
			margin: 3.5rem auto;
			border: 2px solid var(--text);
			background: #ffffff;
		}

		figcaption {
			padding: 0.5rem 1rem;
			background: var(--text);
			color: #4dff6a;
			font: 800 0.9rem var(--condensed);
			letter-spacing: 0.15em;
			text-transform: uppercase;
		}

		.specimen :global(.code) {
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.stage {
			padding: 1rem 1.25rem 1.25rem;
			border-top: 2px solid var(--text);
		}

		.label {
			margin: 0 0 0.75rem;
			color: var(--accent);
			font: 800 0.85rem var(--condensed);
			letter-spacing: 0.2em;
			text-transform: uppercase;
		}

		.trio {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}

		.trio > div {
			display: grid;
			gap: 0.3rem;
			align-content: start;
		}

		.num {
			color: transparent;
			font: 800 4rem/0.9 var(--condensed);
			-webkit-text-stroke: 2px var(--text);
		}

		.trio strong {
			font: 800 1.3rem var(--condensed);
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.trio p {
			margin: 0;
			color: var(--text-muted);
		}

		@media (max-width: 52rem) {
			.trio {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
}
