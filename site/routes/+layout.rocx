import pf.Html
import pf.Router
import pf.Store
import ../Facts
import ../Ui/Nav
import ../Ui/Topbar
import ../Ui/Sidebar
import ../Ui/Toc
import ../Ui/Pager
import ../Ui/Footer
import ../Ui/Frame
import ../Ui/SkipLink
import ../Generated/Paths
import ../Generated/Styles

## The document around every page: the bar, which goes from one part of the docs to the other,
## this part's pages, what is on this one, and the footer with what the build measured. `meta` is the
## page's (its title, description and contents); where it is, the location's (`Router.location!`);
## the facts the build measured, the server's (`Facts.facts!`). Each part is a component of the
## site's design system (site/Ui), with its stories. Where it is is read where it is used, each
## part of it a selection of a store of the path (D-053), which tells its readers only when that
## part changes: so a navigation keeps the layout (D-040), the sidebar is kept within a part, and
## the bar, the pager and what is on the page are made again only when what they show changes.
view! = |{ meta, children, .. }| {
	facts = Facts.facts!({})
	at = Store.of(|| Router.location!({}).path)
	# A story (a dev build's, at /__rocx/stories/…) is the component and nothing around it: no bar,
	# no pager and no footer, in the front page's frame.
	story! = || at.get!(Nav.is_story)
	# The front page is Roc Solid's, in no part: no sidebar, and no part current in the bar.
	landing! = || at.get!(Nav.is_landing)
	<>
		<!doctype html>
		<html lang="en" data-rocx-transitions>
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<title>{if (landing!()) meta.title else "${meta.title} · Roc Solid"}</title>
				<meta name="description" content={meta.description} />
				<meta name="color-scheme" content="dark" />
				<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
				<link rel="stylesheet" href="/site.css" />
				<NoHydration>{=Styles.style}</NoHydration>
				<script type="module" src="/site.js"></script>
			</head>
			<body>
				<SkipLink />
				{=if (story!()) Html.empty({}) else <Topbar sections={Nav.sections} current={at.get!(Nav.current_of)} landing={landing!()} />}
				<Frame landing={landing!()}>
					{=if (landing!()) Html.empty({}) else <Sidebar title={at.get!(|path| Nav.section_of(path).name)} pages={at.get!(|path| Nav.section_of(path).pages)} path={at.get!(|path| path)} />}
					<main id="content">
						{...children}
						{=if (story!()) Html.empty({}) else <Pager previous={at.get!(Nav.neighbours).previous} next={at.get!(Nav.neighbours).next} />}
					</main>
					{=if (landing!() or meta.toc.is_empty()) Html.empty({}) else <Toc links={meta.toc} />}
				</Frame>
				{=if (story!()) Html.empty({}) else <Footer facts={facts} />}
			</body>
		</html>
	</>
}
