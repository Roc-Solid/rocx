import pf.Html
import pf.Router
import ../Facts
import ../Ui/Nav
import ../Ui/Topbar
import ../Ui/Sidebar
import ../Ui/Toc
import ../Ui/Pager
import ../Ui/Footer
import ../Ui/Frame
import ../Ui/SkipLink
import ../Generated/Paths
import ../Generated/Styles

## The document around every page: the bar, which goes from one part of the docs to the other,
## this part's pages, what is on this one, and the footer with what the build measured. `meta` is the
## page's (its title, description and contents); where it is, the location's (`Router.location!`);
## the facts the build measured, the server's (`Facts.facts!`). Each part is a component of the
## site's design system (site/Ui), with its stories.
view! = |{ meta, children, .. }| {
	path = Router.location!({}).path
	facts = Facts.facts!({})
	here = Nav.section_of(path)
	# A story (a dev build's, at /__rocx/stories/…) is the component and nothing around it: no bar,
	# no pager and no footer, in the front page's frame.
	story = path.starts_with("/__rocx/stories/")
	# The front page is Roc Solid's, in no part: no sidebar, and no part current in the bar.
	landing = path == Paths.root or story
	# Previous and next, in this part. A page it doesn't list (the 404) has neither.
	(previous, next) =
		match here.pages.find_first_index(|page| page.path == path) {
			Ok(index) => (if (index == 0) Err(OutOfBounds) else here.pages.get(index - 1), here.pages.get(index + 1))
			Err(_) => (Err(OutOfBounds), Err(OutOfBounds))
		}
	<>
		<!doctype html>
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<title>{if (landing) meta.title else "${meta.title} · Roc Solid"}</title>
				<meta name="description" content={meta.description} />
				<meta name="color-scheme" content="dark" />
				<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
				<link rel="stylesheet" href="/site.css" />
				<NoHydration>{=Styles.style}</NoHydration>
				<script type="module" src="/site.js"></script>
			</head>
			<body>
				<SkipLink />
				{=if (story) Html.empty({}) else <Topbar sections={Nav.sections} current={if (landing) "" else here.name} wasm={Facts.get(facts, "client_brotli")} landing={landing} />}
				<Frame landing={landing}>
					{=if (landing) Html.empty({}) else <Sidebar title={here.name} pages={here.pages} path={path} />}
					<main id="content">
						{...children}
						{=if (story) Html.empty({}) else <Pager previous={previous} next={next} />}
					</main>
					{=if (landing or meta.toc.is_empty()) Html.empty({}) else <Toc links={meta.toc} />}
				</Frame>
				{=if (story) Html.empty({}) else <Footer facts={facts} />}
			</body>
		</html>
	</>
}
