import pf.Html
import ../Demos/Counter
import ../Ui/Code
import ../Ui/Heading
import ../Ui/PageHero
import ../Ui/Button
import ../Ui/Specimen
import ../Ui/Stats
import ../Ui/Way
import ../Generated/Sources
import ../Facts
import ../Generated/Paths

## The front page: Roc Solid as a whole, and the way into each of its parts. It is in none of them,
## so it has no sidebar.
meta = {
	title: "Roc Solid: web apps in Roc, from the database to the browser",
	description: "Roc Solid is a small web framework for Roc: pages and components written in rocx, a native server with Postgres or SQLite, channels and actors, packages for jobs, email and more, and components that hydrate in the browser, in Roc compiled to WebAssembly.",
	toc: [],
}

view! = |_| {
	# Once, here, outside every <NoHydration>: the browser's copy asks the same, from what the page
	# recorded, and uses it in the numbers, which it hydrates. A call inside a <NoHydration> would be
	# made by the server alone, and recorded for a copy that never asks.
	facts = Facts.facts!({})
	<>
		<NoHydration>
			<PageHero
				eyebrow="Roc Solid"
				title="Roc, from the database to the browser."
				centered
				actions={[
					<Button href="#start" primary>Get started</Button>,
					<Button href={Paths.rocx}>Read the guide</Button>,
					<Button href={Paths.platform_}>The platform</Button>,
					<Button href={Paths.showcase}>Play Snake, watch the birds</Button>,
				]}
			>
				One language for the whole app: the pages, the server, its jobs, and the components that run in
				your browser.
			</PageHero>
		</NoHydration>
		<Specimen file="Counter.rocx" code={[<NoHydration><Code source={Sources.home_update.rocx} numbers={Bool.False} /></NoHydration>]}>
			<div data-demo="counter"><Counter start_value={3} /></div>
			<NoHydration><p class="awake" data-stat="hydrated">Waiting for the counter to wake up…</p></NoHydration>
		</Specimen>
		<NoHydration>
			<Heading id="start">Getting started</Heading>
			<ol class="start">
				<li>
					<span class="start-num">01</span>
					<div>
						<h3>Install</h3>
						<p>
							Roc Solid builds from a clone of its repository for now. With git, Node and
							<a href="https://just.systems">just</a> on your machine, <code>just setup</code> brings the
							rest into <code>.tools/</code>: the Roc compiler it pins, and Zig and Rust unless your system
							has them. Then <code>bin/rocx</code>, the command, on your <code>PATH</code>.
						</p>
						<Code source={"git clone https://github.com/Roc-Solid/rocx\ncd rocx\njust setup\nexport PATH=\"$PWD/bin:$PATH\""} numbers={Bool.False} plain />
					</div>
				</li>
				<li>
					<span class="start-num">02</span>
					<div>
						<h3>Make a page, or an endpoint</h3>
						<p>
							A folder with <code>routes/</code> in it is an app. A <code>+page.rocx</code> is the page at
							its folder's path, rendered by the server and live in the browser; a <code>+server.roc</code>
							answers HTTP there.
						</p>
						<Code title="my-app/routes/+page.rocx" source={Sources.start_page.rocx} numbers={Bool.False} />
						<Code title="my-app/routes/hello/+server.roc" source={Sources.start_server.rocx} numbers={Bool.False} />
					</div>
				</li>
				<li>
					<span class="start-num">03</span>
					<div>
						<h3>Run it</h3>
						<p>
							<code>rocx dev</code> builds the app and serves it at <code>http://localhost:8080</code>. The
							first run writes <code>my-app/main.roc</code>, the app's program, and builds the server's
							host, once, in a few minutes. After that, a save is built and the page reloads in under a
							second, and a mistake is shown at its line in your file.
						</p>
						<Code source={"rocx dev my-app"} numbers={Bool.False} plain />
					</div>
				</li>
			</ol>
			<p>
				Then <a href={Paths.rocx}>rocx</a> for pages, components and routes, and
				<a href={Paths.platform_}>the platform</a> for what the server and the browser give an app.
			</p>

			<Heading id="parts">Three parts</Heading>
			<Way kind="rocx" href={Paths.rocx} more="rocx →" code={[<Code source={Sources.home_update.rocx} numbers={Bool.False} />]}>
				What an app is written in: Roc in which markup may stand wherever an expression can. Pages,
				layouts and components are files, and <code>rocx build</code> turns each into plain Roc, line
				for line, so the compiler checks every value put in a page.
			</Way>
			<Way kind="Platform" href={Paths.platform_} more="The platform →" code={[<Code source={Sources.platform_query.rocx} numbers={Bool.False} />]}>
				What it runs on. On the server, Roc compiled to native code in a Rust host, with Postgres or
				SQLite, values in memory, live rooms, channels and actors, and plugins, through which packages add
				more. In the browser, the components, compiled to WebAssembly, and a page of JavaScript.
			</Way>
			<Way kind="Ecosystem" href={Paths.ecosystem} more="The ecosystem →" code={[<Code source={Sources.charts_use.rocx} numbers={Bool.False} />]}>
				What it can use: packages of plain Roc and components, which work in both halves of an app.
				Fifteen so far: charts, crypto, files in S3, email, forms, Markdown, intl, an admin, guards,
				jobs and cron, MCP, OpenTelemetry, presence, Web Push and testing.
			</Way>


			<Heading id="pipeline">One app, two programs</Heading>
			<ol class="pipeline">
				<li>
					<span class="pipeline-file">Counter.rocx</span>
					<span class="pipeline-step">markup in Roc</span>
				</li>
				<li>
					<span class="pipeline-file">Counter.roc</span>
					<span class="pipeline-step"><code>rocx build</code>: plain Roc, same lines</span>
				</li>
				<li class="pipeline-fork">
					<div>
						<span class="pipeline-file">server</span>
						<span class="pipeline-step">native: pages rendered whole, endpoints</span>
					</div>
					<div>
						<span class="pipeline-file">client.wasm</span>
						<span class="pipeline-step">the same pages: the browser hydrates and runs them</span>
					</div>
				</li>
			</ol>
			<p>
				An app is two programs on two platforms, talking over HTTP. The server's is Roc compiled to native
				code in a Rust host, which also keeps values in memory, live rooms, channels and actors, and runs
				what plugins add (the jobs package's queue and schedules, the email package's mail), with Postgres
				or SQLite beneath it. The browser's is the same pages, compiled to WebAssembly with a small Zig
				host, and a page of JavaScript that hydrates what the server rendered and applies what changes. The
				<a href={Paths.platform_}>platform docs</a> describe both.
			</p>

			<Heading id="numbers">The numbers, measured on this build</Heading>
		</NoHydration>
		<Stats
			stats={[
				{ label: "Wasm for the whole site", value: Facts.get(facts, "client_brotli"), note: "brotli; ${Facts.get(facts, "client_gzip")} gzip, ${Facts.get(facts, "client_bytes")} raw" },
				{ label: "JavaScript runtime", value: Facts.get(facts, "runtime_gzip"), note: "gzip; no framework, no dependencies" },
				{ label: "The front page, rendered", value: "${Facts.get(facts, "client_render_us")} µs", note: "every component and hole run once, by the browser's wasm, in Node" },
				{ label: "The server", value: Facts.get(facts, "server_bytes"), note: "one executable: every page, and its Rust host" },
			]}
		/>
	</>
}

<style>
	/* One app, two programs: a file, the Roc it becomes, and the two builds it goes into. */
	.pipeline {
		max-width: none;
		display: grid;
		grid-template-columns: 1fr 1fr 2fr;
		align-items: center;
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}

	.pipeline > li {
		position: relative;
		padding: var(--space-4);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}

	.pipeline > li:not(:last-child)::after {
		content: "→";
		position: absolute;
		top: 50%;
		right: -0.7rem;
		translate: 0 -50%;
		color: var(--accent);
		font-weight: 700;
		text-shadow: var(--glow-text);
	}

	.pipeline-fork {
		display: grid;
		gap: var(--space-3);
	}

	.pipeline-fork > div + div {
		padding-top: var(--space-3);
		border-top: 1px dashed var(--rule-strong);
	}

	.pipeline-file {
		display: block;
		color: var(--accent);
		font: 700 var(--size-sm) var(--mono);
	}

	.pipeline-step {
		display: block;
		color: var(--text-muted);
		font-size: var(--size-sm);
	}

	/* Getting started: three steps down the page, each its number beside what to do. */
	.start {
		display: grid;
		gap: var(--space-6);
		max-width: none;
		margin: 0 0 var(--space-5);
		padding: 0;
		list-style: none;
	}

	.start > li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: var(--space-4);
		margin: 0;
	}

	.start-num {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: var(--size-xl);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.start h3 {
		margin: 0 0 var(--space-2);
		font-size: var(--size-lg);
	}

	.start p {
		margin: 0 0 var(--space-3);
	}

	/* How long the counter took to wake up: site.js writes it, and marks it awake. Under the
	   counter, in the middle, as the counter is. */
	.awake {
		margin: var(--space-3) 0 0;
		color: var(--text-faint);
		font-size: var(--size-xs);
		text-align: center;
	}

	/* On a phone, each step's number above it, and the code the whole width. */
	@media (max-width: 40rem) {
		.start > li {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}

	@media (max-width: 52rem) {
		.pipeline {
			grid-template-columns: 1fr;
		}

		.pipeline > li:not(:last-child)::after {
			content: "↓";
			top: auto;
			right: 50%;
			bottom: -1.1rem;
			translate: 50% 0;
		}
	}
</style>
