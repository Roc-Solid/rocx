import pf.Html
import ../Demos/Counter
import ../Ui/Code
import ../Ui/Heading
import ../Ui/PageHero
import ../Ui/Logo
import ../Ui/Button
import ../Ui/Journey
import ../Ui/Stats
import ../Ui/Way
import ../Generated/Sources
import ../Facts
import ../Generated/Paths

## The front page: Roc Solid as a whole, and the way into each of its parts. It is in none of them,
## so it has no sidebar.
meta = {
	title: "Roc Solid: web apps in Roc, from the database to the browser",
	description: "Roc Solid is a web framework for Roc. You write pages and components in rocx (Roc with markup in it); a native server with Postgres or SQLite renders them to HTML, and the browser runs the same Roc, compiled to WebAssembly, to make them live. Typed endpoints, forms, live channels, actors, and packages for jobs, email, charts and more.",
	toc: [],
}

view! = |_| {
	# Once, here, outside every <NoHydration>: the browser's copy asks the same, from what the page
	# recorded, and uses it in the numbers, which it hydrates. A call inside a <NoHydration> would be
	# made by the server alone, and recorded for a copy that never asks.
	facts = Facts.facts!({})
	<>
		<NoHydration>
			<div class="first-screen">
				<div class="first-screen-hero">
					<PageHero
						eyebrow="Roc Solid"
						mark={[<Logo />]}
						title="from the database to the browser"
						centered
						actions={[
							<Button href="#start" primary bare>Get started</Button>,
							<Button href={Paths.rocx} bare>Read the guide</Button>,
						]}
					>
					</PageHero>
				</div>
				<aside class="used-by" aria-label="Used by">
					<p class="used-by-label">Used by</p>
					<a class="used-by-site" href="https://publish.cogni.center">publish.cogni.center</a>
					<p class="used-by-aside">…and that's the whole list. A new framework in a new language: what did you expect?</p>
				</aside>
			</div>
		</NoHydration>
		<NoHydration>
			<Heading id="what">What Roc Solid is</Heading>
			<p>
				Roc Solid is a web framework for <a href="https://www.roc-lang.org">Roc</a>, a functional
				language that compiles to native code and to WebAssembly. You write components in
				<code>.rocx</code> files: Roc with HTML-like markup. The counter below is one. Step through how
				it gets from its file to your screen.
			</p>
		</NoHydration>
		<Journey
			steps={[
				{
					name: "Write",
					file: "Counter.rocx",
					panel: [
						<NoHydration>
							<p class="say">
								Roc, with markup wherever an expression can go. <code>count!</code> reads a signal;
								<code>set_count!</code> changes it.
							</p>
							<Code source={Sources.home_update.rocx} numbers={Bool.False} />
						</NoHydration>,
					],
				},
				{
					name: "Build",
					file: "Counter.roc",
					panel: [
						<NoHydration>
							<p class="say">
								<code>rocx build</code> turns the markup into plain Roc, line for line, so the Roc
								compiler checks every value in it.
							</p>
							<Code source={Sources.home_built.rocx} numbers={Bool.False} />
						</NoHydration>,
					],
				},
				{
					name: "Render",
					file: "What the server sends",
					panel: [
						<NoHydration>
							<p class="say">
								The server runs that Roc, compiled to native code, and sends plain HTML: readable
								before any script runs. <code>{"<!--x-->"}</code> marks the text the count changes.
							</p>
							<Code source={Sources.home_rendered.rocx} markup={Bool.True} numbers={Bool.False} />
						</NoHydration>,
					],
				},
				{
					name: "Hydrate",
					file: "In your browser",
					panel: [
						<NoHydration>
							<p class="say">
								The browser runs the same component, compiled to WebAssembly, over that HTML. It
								attaches handlers and signals to the nodes already there, and builds nothing again.
							</p>
							<Code source={"<div class=\"counter\">      ← class:negative reads count\n  <button>−</button>       ← on:click\n  <output>3</output>       ← its text reads count\n  <button>+</button>       ← on:click\n  <button>Reset</button>   ← on:click; disabled reads count\n</div>"} numbers={Bool.False} plain />
							<p class="awake" data-stat="hydrated">Waiting for the counter to wake up…</p>
						</NoHydration>,
					],
				},
				{
					name: "Click",
					file: "What the runtime did",
					panel: [
						<NoHydration>
							<p class="say">
								Press − or +. The handler sets the signal, and only what reads it runs again,
								patching its own node. Newest first:
							</p>
							<div class="inspector" data-inspect-signals="counter">
								<ol><li class="empty">Nothing yet: press − or + below.</li></ol>
							</div>
						</NoHydration>,
					],
				},
			]}
		>
			<div data-demo="counter" data-flash="yes"><Counter start_value={3} /></div>
		</Journey>
		<NoHydration>
			<p>An app gets:</p>
			<ul>
				<li>
					<strong>Pages from files.</strong> <code>routes/blog/[slug]/+page.rocx</code> is the page at
					<code>/blog/…</code>, inside its folders' layouts. Every route has a typed link.
				</li>
				<li>
					<strong>Signals, as in SolidJS.</strong> A component runs once. When a signal changes, only
					the markup that reads it runs again.
				</li>
				<li>
					<strong>Typed endpoints.</strong> A <code>+server.roc</code> answers HTTP. A page reads one as a
					plain value while the server renders it, and the answer ships inside the page.
				</li>
				<li>
					<strong>Forms and live updates</strong>: actions with optimistic updates, channels and
					server-sent events.
				</li>
				<li>
					<strong>One native server executable</strong>, with Postgres or SQLite, migrations, a key-value
					store and actors.
				</li>
				<li>
					<strong>Packages</strong> for jobs and cron, email, charts, forms, Markdown, an admin and more.
				</li>
				<li>
					<strong>Errors at your lines.</strong> The compiler checks every value you put in a page, and
					reports each mistake at its line in your <code>.rocx</code> file.
				</li>
			</ul>

			<Heading id="start">Getting started</Heading>
			<ol class="start">
				<li>
					<span class="start-num">1</span>
					<div>
						<h3>Install</h3>
						<p>
							One command installs <code>rocx</code>, its Roc compiler and both platforms, prebuilt, into
							<code>~/.rocx</code> (macOS on Apple silicon, Linux on arm64 or x86_64). No Rust, Zig or Node
							needed. It verifies each download and adds <code>~/.rocx/bin</code> to your
							<code>PATH</code>. With Nix: <code>nix profile install github:Roc-Solid/rocx</code>.
						</p>
						<Code source={"curl -fsSL https://github.com/Roc-Solid/rocx/releases/latest/download/install.sh | sh"} numbers={Bool.False} plain />
						<p>
							The first release isn't out yet. Until then, build from a clone with git and
							<a href="https://just.systems">just</a>: <code>just setup</code> fetches the rest into
							<code>.tools/</code> and builds <code>bin/rocx</code>.
						</p>
						<Code source={"git clone https://github.com/Roc-Solid/rocx\ncd rocx\njust setup\nexport PATH=\"$PWD/bin:$PATH\""} numbers={Bool.False} plain />
					</div>
				</li>
				<li>
					<span class="start-num">2</span>
					<div>
						<h3>Make an app</h3>
						<p>
							<code>rocx new</code> makes an app in its own folder and asks which database: SQLite (the
							default, a file beside the server), Postgres or Turso. It comes with sign-in by a mailed link
							(or Google and GitHub, once their keys are set), optional two-factor codes, a users table,
							refusal of other sites' posts, and rate-limited sign-in mail.
						</p>
						<Code source={"rocx new my-app\ncd my-app\nrocx dev"} numbers={Bool.False} plain />
						<p>
							<code>rocx dev</code> serves it at <code>http://localhost:8080</code>. Each save rebuilds it,
							restarts the server and reloads your open pages; a mistake shows at its line, and the last
							good build keeps running. Under <code>rocx dev</code>, sign in with any address, no mail
							needed. The app's <code>README.md</code> says what to change first, and how to test
							(<code>rocx test</code>), deploy (<code>rocx build</code> or <code>rocx build --image</code>) and
							upgrade (<code>rocx upgrade</code>).
						</p>
					</div>
				</li>
				<li>
					<span class="start-num">3</span>
					<div>
						<h3>Add a page, or an endpoint</h3>
						<p>
							Each file in <code>routes/</code> answers the URL its folders spell; that folder is all an app
							needs. A <code>+page.rocx</code> is a page: rendered to HTML on the server, made live in the
							browser. A <code>+server.roc</code> is an endpoint: functions named after HTTP methods
							(<code>get!</code>, <code>post!</code>) that answer with JSON.
						</p>
						<Code title="my-app/routes/+page.rocx" source={Sources.start_page.rocx} numbers={Bool.False} />
						<Code title="my-app/routes/hello/+server.roc" source={Sources.start_server.rocx} numbers={Bool.False} />
						<p>
							<code>view!</code> runs once: it makes a signal and returns markup. The button's text reads
							the count, so it updates when the count does. <code>get!</code> answers
							<code>GET /hello</code> with a JSON string.
						</p>
					</div>
				</li>
			</ol>
			<p>
				Next: <a href={Paths.rocx}>rocx</a> covers pages, components and routes;
				<a href={Paths.syntax}>syntax</a> lists everything markup can hold; <a href={Paths.tooling}>tooling</a>
				covers every command; <a href={Paths.platform_}>the platform</a> is what the server and the browser
				give an app; and the <a href={Paths.examples}>examples</a> are complete apps to read.
			</p>

			<Heading id="parts">Three parts</Heading>
			<Way kind="rocx" href={Paths.rocx} more="rocx →" code={[<Code source={Sources.home_update.rocx} numbers={Bool.False} />]}>
				What you write: Roc with markup wherever an expression can go. <code>rocx build</code> turns each
				page, layout and component into plain Roc with the same line numbers, for the compiler to check.
			</Way>
			<Way kind="Platform" href={Paths.platform_} more="The platform →" code={[<Code source={Sources.platform_query.rocx} numbers={Bool.False} />]}>
				What an app runs on. On the server: native Roc in a Rust host, with Postgres or SQLite, a key-value
				store, live channels, actors, and plugins that let packages add routes and jobs. In the browser:
				the same components in WebAssembly, and a small JavaScript runtime.
			</Way>
			<Way kind="Ecosystem" href={Paths.ecosystem} more="The ecosystem →" code={[<Code source={Sources.charts_use.rocx} numbers={Bool.False} />]}>
				Packages of plain Roc and components, for both halves of an app. Twenty-four so far: sign-in,
				Stripe payments, Claude, charts, crypto, file storage (S3, disk or memory), email, forms, Markdown,
				intl, an admin, audio, guards, jobs and cron, MCP, tools for models, OpenTelemetry, PostHog,
				presence, Web Push, QR codes, vibration, testing and virtual lists.
			</Way>

			<Heading id="numbers">Measured on this build</Heading>
		</NoHydration>
		<Stats
			stats={[
				{ label: "Wasm for the whole site", value: Facts.get(facts, "client_brotli"), note: "brotli; ${Facts.get(facts, "client_gzip")} gzip, ${Facts.get(facts, "client_bytes")} raw" },
				{ label: "JavaScript runtime", value: Facts.get(facts, "runtime_gzip"), note: "gzip; no framework, no dependencies" },
				{ label: "The front page, rendered", value: "${Facts.get(facts, "client_render_us")} µs", note: "by the browser's wasm, in Node" },
				{ label: "The server", value: Facts.get(facts, "server_bytes"), note: "one executable, every page in it" },
			]}
		/>
	</>
}

<style>
	/* The first screen: the hero in the middle of it, and who uses Roc Solid at its foot. As tall as
	   the window under the bar, less the page's own padding above it; taller when it must be. */
	.first-screen {
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - var(--bar) - var(--space-7));
	}

	.first-screen-hero {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
	}

	/* Centred in the screen, the hero needs no more room above it than below. */
	.first-screen-hero :global(.hero) {
		padding: var(--space-6) 0;
	}

	/* Who uses it: quiet, under a short rule, the one site in mono, and a word about the list. */
	.used-by {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-5) 0 var(--space-4);
		text-align: center;
	}

	.used-by::before {
		content: "";
		width: 4rem;
		height: 1px;
		margin-bottom: var(--space-4);
		background: var(--gradient);
		opacity: 0.6;
	}

	.used-by-label {
		margin: 0;
		color: var(--text-faint);
		font-size: var(--size-2xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.used-by-site {
		color: var(--text-muted);
		font: 600 var(--size-md) var(--mono);
		text-decoration: none;
		transition: color 0.15s;
	}

	.used-by-site:hover,
	.used-by-site:focus-visible {
		color: var(--accent);
	}

	.used-by-aside {
		max-width: 40rem;
		margin: var(--space-1) 0 0;
		color: var(--text-faint);
		font-size: var(--size-xs);
		font-style: italic;
		text-wrap: balance;
	}

	/* Getting started: three steps down the page, each its number beside what to do. */
	.start {
		display: grid;
		gap: var(--space-6);
		max-width: none;
		margin: 0 0 var(--space-5);
		padding: 0;
		list-style: none;
	}

	.start > li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: var(--space-4);
		margin: 0;
	}

	.start-num {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: var(--size-xl);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.start h3 {
		margin: 0 0 var(--space-2);
		font-size: var(--size-lg);
	}

	.start p {
		margin: 0 0 var(--space-3);
	}

	/* How long the counter took to wake up, in the Hydrate step: site.js writes it. */
	.awake {
		margin: var(--space-3) 0 0;
		color: var(--text-faint);
		font-size: var(--size-xs);
	}

	/* On a phone, each step's number above it, and the code the whole width. */
	@media (max-width: 40rem) {
		.start > li {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}
</style>
