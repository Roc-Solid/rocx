import pf.Html
import ../../Demos/Cheatsheet
import ../../Demos/SyntaxTour
import ../../Ui/Heading
import ../../Ui/Callout
import ../../Ui/Code
import ../../Ui/Example
import ../../Generated/Sources
import ../../examples/Hello
import ../../examples/Attributes
import ../../examples/Lists
import ../../examples/Components
import ../../examples/Whitespace
import ../../examples/Raw
import ../../examples/Scoped
import ../../Generated/Paths
import ../../Ui/PageHero
import ../../Ui/TableWrap
import ../../Ui/Demo

meta = {
	title: "Syntax",
	description: "Everything rocx accepts in markup: elements and fragments, holes, attributes, if, match and keyed .map rows, components and props, handlers, built-in tags, whitespace, comments and entities, scoped styles, stories, and where < starts markup.",
	toc: [
		{ id: "tour", label: "One small component" },
		{ id: "at-a-glance", label: "At a glance" },
		{ id: "elements", label: "Elements, text and fragments" },
		{ id: "holes", label: "Holes" },
		{ id: "attributes", label: "Attributes" },
		{ id: "lists", label: "if, match and lists" },
		{ id: "components", label: "Components" },
		{ id: "events", label: "Handlers, keys and transitions" },
		{ id: "tags", label: "Built-in tags" },
		{ id: "whitespace", label: "Whitespace" },
		{ id: "raw", label: "Comments, entities, script and style" },
		{ id: "styles", label: "Scoped styles" },
		{ id: "stories", label: "Stories" },
		{ id: "where", label: "Where < starts markup" },
		{ id: "types", label: "Types" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Syntax"
				title="Markup wherever an expression can stand"
			>
				A <code>.rocx</code> file is Roc with markup (HTML elements and components) wherever an expression
				can stand; inside markup, braces take you back to Roc. rocx turns markup into calls
				to the platform's <code>Html</code> module, so every <code>.rocx</code> file has
				<code>import pf.Html</code>. Each example is a real file in <code>site/examples</code>, shown with its
				output; its switch shows the Roc rocx wrote.
			</PageHero>

			<Heading id="tour">One small component</Heading>
			<p>
				Signals, a memo, handlers, holes, keyed rows, an <code>if</code> and a scoped style, each explained
				below. Type a title and press Enter, or tick a book off.
			</p>
		</NoHydration>
		<Demo>
			<div data-demo="tour"><SyntaxTour /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.syntax_tour.file} source={Sources.syntax_tour.rocx} />

			<Heading id="at-a-glance">At a glance</Heading>
			<p>
				This table is a component too: type to filter it.
			</p>
		</NoHydration>
		<Demo><div data-demo="cheatsheet"><Cheatsheet /></div></Demo>

		<NoHydration>
			<Heading id="elements">Elements, text and fragments</Heading>
			<p>
				Elements are written as in HTML, tag names in lower case. Empty elements close themselves
				(<code>{"<br />"}</code>, <code>{"<img />"}</code>, <code>{"<input />"}</code>); a bare
				<code>{"<br>"}</code> is refused. Text is escaped: a <code>{"<"}</code> in a name shows as itself,
				never as a tag.
			</p>
			<p>
				Markup is an ordinary Roc expression: name it, return it, put it in a list. A fragment,
				<code>{"<>…</>"}</code>, holds elements side by side, so nothing needs a single root;
				<code>{"<></>"}</code> is nothing at all. The Roc rocx writes keeps your line numbers, so compiler
				reports point at your lines.
			</p>
			<Example source={Sources.hello} output={Hello.demo({})} live />

			<Heading id="holes">Holes: Roc values in markup</Heading>
			<p>
				A hole, <code>{"{x}"}</code>, puts a Roc expression in markup, shown by its type: a
				<code>Str</code> as escaped text, a number as digits, <code>Html</code> as markup. Any other type,
				such as a <code>Bool</code> or a record, is a compile error at your line. A list hole,
				<code>{"{...xs}"}</code>, shows a <code>List(Html)</code>'s items in order.
			</p>
			<Code source={"<p>{name} has {count} messages, {\"\${unread.to_str()} unread\"}.</p>\n<ul>{...tags.map(|tag| <li>{tag}</li>)}</ul>"} numbers={Bool.False} />
			<p>
				In a component, a hole reruns and patches its own node when what it reads changes: a call of a name
				ending in <code>!</code> (a signal such as <code>count!()</code>, a memo, an accessor prop) or an
				effectful component's prop. Any other hole is worked out once.
			</p>
			<Callout kind="tip" title="One kind of hole">
				<p>
					rocx runs before the compiler, so it can't know <code>x</code>'s type. It writes
					<code>Html.hole(x)</code> (inside <code>{"Html.hole_of(|| …)"}</code> when it reads what changes,
					<code>Html.shown(x)</code> when not), and the compiler picks how to show the value from its type,
					through Roc's encoding. <code>{"{=x}"}</code>, in older code, is the same hole.
				</p>
			</Callout>

			<Heading id="attributes">Attributes</Heading>
			<p>
				An attribute's value is a quoted string or a Roc expression in braces. Other forms cover what HTML
				makes awkward:
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Written</th><th>Means</th></tr></thead>
					<tbody>
						<tr><td><code>{"name=\"text\""}</code>, <code>{"name='text'"}</code></td><td>A static value, as written, entities decoded, on one line.</td></tr>
						<tr><td><code>{"name={expr}"}</code></td><td>A <code>Str</code> from Roc, escaped. In a component, set again when what it reads changes.</td></tr>
						<tr><td><code>name</code></td><td>A boolean attribute that is always on, such as <code>required</code>.</td></tr>
						<tr><td><code>{"name?={bool}"}</code></td><td>A boolean attribute, there while the <code>Bool</code> is true: <code>{"disabled?={busy}"}</code>.</td></tr>
						<tr><td><code>{"name??={str}"}</code></td><td>Left out while the string is empty.</td></tr>
						<tr><td><code>{"class:name={bool}"}</code></td><td>Adds the class while the <code>Bool</code> is true. All the element's classes, a computed <code>{"class={…}"}</code>'s too, end up in one <code>class</code> attribute.</td></tr>
						<tr><td><code>{"style:--name={str}"}</code></td><td>Sets a CSS custom property, for the stylesheet to use.</td></tr>
						<tr><td><code>{"style:color={str}"}</code></td><td>Sets one CSS property. Its name is letters and dashes.</td></tr>
						<tr><td><code>{"style=\"…\""}</code></td><td>A static style, which the <code>style:</code> attributes join.</td></tr>
						<tr><td><code>{"<img enhanced:src={path} />"}</code></td><td>A photo of this site (a quoted path too) that the server makes smaller copies of. Once they are made, a moment after a page first shows it, pages get their <code>srcset</code>, a <code>sizes</code> and the photo's <code>width</code> and <code>height</code>; until then, its <code>src</code>. It loads lazily and decodes off the main thread unless <code>loading</code>, <code>fetchpriority</code> or <code>decoding</code> says otherwise. Only an <code>{"<img>"}</code> takes it, and never beside a <code>src</code> or <code>srcset</code>. See <a href={"${Paths.platform_server}#photos"}>the server</a>.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<Example source={Sources.attributes} output={Attributes.demo({})} live />
			<p>
				rocx refuses an unquoted value (<code>{"class=big"}</code>), a whole computed style
				(<code>{"style={…}"}</code>) and an inline handler (<code>{"onclick=\"…\""}</code>; in a component,
				write <code>{"on:click={…}"}</code>). A <code>style:</code> value is dropped if it holds anything but
				letters, digits, spaces and <code>.,%#()-+</code>, or calls a CSS function that could load something
				(<code>rgb()</code>, <code>calc()</code>, <code>var()</code> and other computing functions are fine;
				<code>url()</code> is not). URL attributes (<code>href</code>, <code>src</code>,
				<code>action</code> and a few more) take only <a href={"${Paths.safety}#urls"}>safe URLs</a>.
			</p>
			<Callout kind="note" title="Why style takes no values">
				<p>
					A whole style from data lets data decide layout and load URLs. Instead, switch classes, pass a
					number through a custom property, or set one property named in the file,
					<code>{"style:color={…}"}</code>, whose value is checked: for where no stylesheet reaches, such as an
					email's colours (email clients read neither stylesheets nor custom properties).
				</p>
			</Callout>

			<Heading id="lists">if, match and lists</Heading>
			<p>
				Branches and lists need no special syntax: <code>if</code>, <code>match</code> and
				<code>.map</code> work in a hole as anywhere in Roc. An <code>if</code> in a hole needs no
				<code>else</code>: <code>{"{if (late) <p>Late</p>}"}</code> shows nothing (<code>{"<></>"}</code>)
				while <code>late</code> is false. This example's list is a plain value, rendered once:
			</p>
			<Example source={Sources.lists} output={Lists.demo({})} live />
			<p>In a component, where values change, they keep the markup they made:</p>
			<ul>
				<li>
					An <code>if</code> or <code>match</code> on something changing keeps its branch's markup, and the
					signals of components inside, while that branch holds; it makes another branch's markup only when
					that one holds. A <code>match</code> arm's names always read the newest value.
				</li>
				<li>
					A <code>.map</code> over a changing list makes rows kept by key, given on each row's outermost
					element or component: <code>{"{...todos!().map(|todo| <li key={todo.id}>{todo.title}</li>)}"}</code>.
					A row is made once per key, moved on a reorder and dropped when its key goes, so focus and typing
					inside survive. It updates only when its item is no longer <code>==</code> the old one. A row that is
					an <code>if</code> keys each branch.
				</li>
				<li>
					<code>{".map_with_index(|item, i| <li key={i}>…</li>)"}</code> makes a row per position instead:
					rows stay put, each showing the item now at its position.
				</li>
				<li>
					rocx refuses a changing list without a key, at its line, saying what to write, and a key that
					mixes the index with something else (write <code>{"key={i}"}</code> alone).
				</li>
			</ul>
			<p>
				<a href={"${Paths.components}#control"}>if, match and .map</a>, on the components page, shows each
				live.
			</p>

			<Heading id="components">Components</Heading>
			<p>
				A capitalised tag is a component: a function from a record of props to <code>Html</code>.
				<code>{"<StatusPill status={s} />"}</code> calls <code>StatusPill.view</code> (or <code>view!</code>)
				when the file imports or defines a <code>StatusPill</code> module, and this file's
				<code>status_pill</code> otherwise. Each attribute is a prop: a string, a Roc value in braces, or a
				bare name (<code>Bool.True</code>). What is between the tags is the <code>children</code> prop, a
				<code>List(Html)</code>. A missing prop is a type error, unless the props are a nominal record with
				defaults (<code>{"title : Str ?? \"\""}</code>).
			</p>
			<Example source={Sources.components} output={Components.demo({})} live />
			<p>There are two kinds of component (<a href={"${Paths.components}#kinds"}>pure and effectful</a>):</p>
			<ul>
				<li>
					A <strong>pure component</strong>, <code>view</code> with no <code>!</code>, is a plain function,
					called where it is written. Its props are values; it makes no signals.
				</li>
				<li>
					An <strong>effectful component</strong>, <code>view!</code>, runs once, where it is rendered, and
					may make signals. Its value props are <em>getters</em>: rocx passes each as a function, so reading
					the prop gets the current value, and a parent can pass something that changes.
				</li>
			</ul>
			<TableWrap>
				<table>
					<thead><tr><th>Written</th><th>Means</th></tr></thead>
					<tbody>
						<tr><td><code>{"<Field value!={draft!} />"}</code></td><td>A prop named with <code>!</code> is an accessor, called like a signal: <code>value!()</code> (<a href={"${Paths.components}#passing"}>props that change</a>).</td></tr>
						<tr><td><code>{"<Card {...rest} />"}</code></td><td>Passes a record of props on as is, such as the rest of a view's props (<code>{"|{ title, ..rest }|"}</code>).</td></tr>
						<tr><td><code>{"<Repeat count!={n!()}>{|index| …}</Repeat>"}</code></td><td>A function as the only child is passed as <code>children</code> to the component's <code>view_with!</code>, which calls it.</td></tr>
						<tr><td><code>{"<ThemeContext value={dark}>…</ThemeContext>"}</code></td><td>Provides a context, defined with <code>create_context</code>, to the markup inside (<a href={"${Paths.components}#contexts"}>contexts</a>).</td></tr>
						<tr><td><code>{"<Card key={card.id} … />"}</code></td><td>On a component that is a list row's outermost tag, <code>key</code> is the row's key, never a prop.</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="events">Handlers, keys and transitions</Heading>
			<p>
				A handler, <code>{"on:event={…}"}</code>, is a Roc function the browser runs when the event reaches
				the element. It may set signals, call the server and so on; the server renders nothing for it. A
				suffix on the event's name says what the handler is given, or when it runs:
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Written</th><th>Means</th></tr></thead>
					<tbody>
						<tr><td><code>{"on:click={|| …}"}</code></td><td>Runs on the event. <code>on:submit</code> also stops the browser's own submit.</td></tr>
						<tr><td><code>{"on:input.value={set_draft!}"}</code></td><td>Given the element's value, a <code>Str</code>.</td></tr>
						<tr><td><code>{"on:change.checked={|on| …}"}</code></td><td>Given whether it is checked, a <code>Bool</code>.</td></tr>
						<tr><td><code>{"on:keydown.key={|key| …}"}</code></td><td>Given the key's name (<code>Enter</code>, <code>k</code>). <code>.keys</code> gives the key and the modifier keys held (<code>keys.shift</code>, <code>keys.mod</code>…).</td></tr>
						<tr><td><code>{"on:keydown.Escape={|| …}"}</code></td><td>Runs for that key alone, with no modifier held, and stops the browser's default (an arrow key scrolling the page). <code>.Space</code> is the space bar; letters and digits work too (<code>.w</code>).</td></tr>
						<tr><td><code>{"on:keydown.Mod+K={|| …}"}</code></td><td>Runs for that key with exactly those modifier keys held: <code>Shift</code>, <code>Ctrl</code>, <code>Alt</code>, <code>Meta</code>, and <code>Mod</code>, which is ⌘ on macOS and Ctrl elsewhere.</td></tr>
						<tr><td><code>{"on:click.prevent={|| …}"}</code></td><td>Stops the browser's default first, such as following a link the page takes over.</td></tr>
						<tr><td><code>{"on:pointermove.point={|p| …}"}</code></td><td>Given where the pointer is over the element, as shares of its width and height.</td></tr>
						<tr><td><code>{"on:drop.data={|items| …}"}</code>, <code>.files</code></td><td>Given what a drop or a paste carries, or its files; <code>on:change.files</code> on a file input gives the files chosen.</td></tr>
						<tr><td><code>{"on:frame.ms={|ms| …}"}</code></td><td>Runs every animation frame while the element is on the page, given the milliseconds since the last.</td></tr>
						<tr><td><code>{"on:viewport={|view| …}"}</code></td><td>Runs when the element shows, and each time it scrolls or changes size, given what of it shows.</td></tr>
						<tr><td><code>{"on:visibilitychange.visible={|shown| …}"}</code></td><td>On <code>{"<Document>"}</code>: given whether the page shows (false while its tab is hidden).</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<Example source={Sources.events} renders={Bool.False} />
			<p>Other attributes that only mean something in the browser:</p>
			<ul>
				<li>
					<code>{"key={…}"}</code> names an element: on a list row, its key; anywhere, it keeps an element
					moved between lists the same element, so it can glide between them.
				</li>
				<li>
					<code>{"transition={…}"}</code>, <code>{"transition:in={…}"}</code> and
					<code>{"transition:out={…}"}</code> play an animation (a <code>Transition</code>, such as
					<code>Transition.fade</code>) as the element's row or branch comes and goes;
					<code>{"transition:move={…}"}</code> glides it when it moves
					(<a href={"${Paths.components}#transitions"}>transitions</a>).
				</li>
				<li>
					<code>{"drag:data={[(type, value)]}"}</code> is what a drag of the element carries, and
					<code>{"drag:image={id}"}</code> the element shown while it is dragged
					(<a href={"${Paths.components}#drag"}>drag and drop</a>).
				</li>
			</ul>
			<p>
				Markup inside a <code>{"<NoHydration>"}</code> never runs in the browser, so rocx refuses a
				handler, <code>key</code>, transition or <code>drag:</code> attribute there, at its line. The
				<a href={Paths.components}>components</a> page covers signals and handlers in depth.
			</p>

			<Heading id="tags">Built-in tags</Heading>
			<p>A few capitalised tags are rocx's own, unless your file has a module of the same name:</p>
			<TableWrap>
				<table>
					<thead><tr><th>Written</th><th>Means</th></tr></thead>
					<tbody>
						<tr><td><code>{"<NoHydration>…</NoHydration>"}</code></td><td>Markup only the server renders. The browser keeps its HTML as is; none of the code inside is in the wasm.</td></tr>
						<tr><td><code>{"<Document on:keydown.Mod+K={…} />"}</code>, <code>{"<Window on:resize={…} />"}</code></td><td>Handlers on the whole document or window, while the markup around the tag is rendered. They take only handlers and render nothing.</td></tr>
						<tr><td><code>{"<Meta name=\"description\" content={…} />"}</code>, <code>{"<Link … />"}</code>, <code>{"<Style>…</Style>"}</code></td><td>A <code>{"<meta>"}</code>, <code>{"<link>"}</code> or <code>{"<style>"}</code> in the document's <code>{"<head>"}</code>, while the markup around the tag is rendered.</td></tr>
						<tr><td><code>{"<!doctype html>"}</code></td><td>The doctype, at the top of a root layout.</td></tr>
						<tr><td><code>{"<story name=\"…\">…</story>"}</code></td><td>One way a component looks, for the dev build's catalog (<a href="#stories">stories</a>).</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The platform also has components you import (<code>import pf.Loading</code>, and so on):
				<code>{"<Loading fallback={…}>"}</code> and <code>{"<Errored fallback={…}>"}</code> for
				<a href={"${Paths.components}#waiting"}>waiting and failing</a>, <code>{"<Repeat>"}</code> for rows
				without a list, <code>{"<Title>"}</code> for the document's title,
				<code>{"<HttpStatusCode code={404} />"}</code> for the status the server answers the page with, and
				<code>{"<Navigate>"}</code> for <a href={"${Paths.routing}#navigating"}>navigating</a>.
			</p>

			<Heading id="whitespace">Whitespace, as HTML has it</Heading>
			<p>
				Text follows HTML's rule, as in Svelte (not JSX): each run of spaces, tabs and line breaks is one
				space. Whitespace with a line break next to an element's own opening or closing tag is dropped; a
				space on the tag's line stays (<code>{"<b>On the tag's line: </b>"}</code>). So prose can break
				lines anywhere, even next to a link or a value, and elements on lines of their own get a space
				between them. <code>{"<pre>"}</code> and <code>{"<textarea>"}</code> keep text as written.
			</p>
			<Example source={Sources.whitespace} output={Whitespace.demo({})} live />

			<Heading id="raw">Comments, entities, script and style</Heading>
			<p>
				<code>{"{# … }"}</code> and <code>{"<!-- … -->"}</code> are comments; they never reach the page. A
				<code>{"{# … }"}</code> comment ends at the first <code>{"}"}</code>, so it can't contain one.
				Entities work: the common named ones (<code>&amp;amp;</code>, <code>&amp;middot;</code>,
				<code>&amp;nbsp;</code>…) and numeric ones (<code>&amp;#x2192;</code>); rocx refuses one it doesn't
				know. Write a literal <code>{"<"}</code>, <code>{">"}</code>, <code>{"{"}</code> or
				<code>{"}"}</code> in text as an entity or a string in a hole (<code>{"{\"{\"}"}</code>), so a
				stray brace is never silently text.
			</p>
			<p>
				A <code>{"<script>"}</code> or <code>{"<style>"}</code> in markup keeps its text as written,
				braces included, and takes no holes: a page's script is part of the page, never data. A
				<code>{"<style>"}</code> beside a component's definitions, outside its markup, is
				<a href="#styles">scoped</a> to that component.
			</p>
			<Example source={Sources.raw} output={Raw.demo({})} live />

			<Heading id="styles">Styles, scoped to their component</Heading>
			<p>
				A <code>{"<style>"}</code> in a component's block, beside its definitions, styles only that
				component's markup, as in Svelte. rocx adds a class named after the component to each element
				written in the block and to each selector: <code>.card .title</code> becomes
				<code>.card.rx-… .title:where(.rx-…)</code>, one class more specific than written, however long the
				selector. So two components' <code>.card</code> rules never meet, even in one file; a bare
				<code>p</code> is only this component's paragraphs; and styles don't reach into the components it
				renders. A page or layout has no block, so its <code>{"<style>"}</code> goes at the file's top level,
				for the whole file. A component, or a file's top level, has at most one <code>{"<style>"}</code>, with
				no attributes, and no <code>@import</code>, <code>@charset</code> or <code>@namespace</code> (they must
				come first in a stylesheet). Its lines are blank in the Roc, so line numbers stay yours.
			</p>
			<Example source={Sources.scoped} output={Scoped.demo({})} live />
			<p>
				Reach outside the component as in Svelte: <code>:global(body)</code>, <code>div :global(strong)</code>
				for any <code>strong</code> inside this component's divs, and a <code>{":global { … }"}</code> block
				for rules that are all global. A component's <code>@keyframes spin</code>, and <code>spin</code> in
				its <code>animation</code>, are its own; <code>@keyframes -global-spin</code> is everyone's
				<code>spin</code>. Nested rules work, <code>&amp;</code> too.
			</p>
			<p>
				rocx puts every <code>{"<style>"}</code> in the app into one stylesheet,
				<code>Generated/Styles.roc</code>. The root layout adds it to its <code>{"<head>"}</code> with
				<code>{"<NoHydration>{Styles.style}</NoHydration>"}</code> (so none of it is in the wasm): a
				<code>{"<link>"}</code> to <code>/rocx/styles-<var>hash</var>.css</code>, named by its content, so the
				browser keeps it for every page and any change gives it a new name.
			</p>

			<Heading id="stories">Stories</Heading>
			<p>
				A <code>{"<story name=\"…\">"}</code> in a component's block holds the markup of one way the
				component looks; its name starts with a letter, and the tag takes nothing else. Each story becomes a
				definition in its place (<code>{"<story name=\"Tip\">"}</code> is
				<code>story_tip!</code>), so every build checks it against the component, but only a dev build
				(<code>rocx dev</code>) shows it, in a catalog at <code>/__rocx/stories</code>
				(<a href={"${Paths.tooling}#stories"}>stories</a>).
			</p>

			<Heading id="where">Where {"<"} starts markup</Heading>
			<p>
				<code>{"<"}</code> starts markup only where an expression can begin, and only when a letter,
				<code>{">"}</code> or <code>!</code> follows. After a value on the same line it is a comparison.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Written</th><th>Read as</th></tr></thead>
					<tbody>
						<tr><td><code>{"x = <b>hi</b>"}</code>, <code>{"f(<b/>)"}</code>, <code>{"[<i/>, <b/>]"}</code>, <code>{"Html ?? <></>"}</code></td><td>markup: after <code>=</code>, <code>(</code>, <code>[</code>, <code>,</code>, <code>??</code></td></tr>
						<tr><td><code>{"|post| <li>…</li>"}</code>, <code>{"A => <b/>"}</code></td><td>markup: a lambda's body, a branch</td></tr>
						<tr><td><code>{"if (a < b) <b/> else <i/>"}</code></td><td>a comparison in the condition, then markup after it and after <code>else</code></td></tr>
						<tr><td>first on its line</td><td>markup: a block's last expression</td></tr>
						<tr><td><code>{"a < b"}</code>, <code>{"f(x)<y"}</code>, <code>{"n<b"}</code></td><td>a comparison: a value comes before it</td></tr>
						<tr><td><code>{"\"<b>\""}</code>, <code>{"'<'"}</code>, <code>{"# <i>"}</code></td><td>left alone: strings, characters and comments</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="types">Types</Heading>
			<p>
				Markup is the platform's <code>Html</code> type everywhere. A pure component, <code>view</code>, is
				a function such as <code>{"{ … } -> Html"}</code>; an effectful one, <code>view!</code>, an effect:
				<code>{"{ … } => Html"}</code>. A prop's default may be markup: <code>{"fallback : Html ?? <></>"}</code>.
				In plain Roc, these build markup without rocx:
			</p>
			<TableWrap>
				<table class="api">
					<thead><tr><th>Function</th><th>For</th></tr></thead>
					<tbody>
						<tr><td><code>Html.to_str</code><code>{"Html -> Str"}</code></td><td>markup with nothing to run in it, as a string: an email's HTML, an <code>expect</code></td></tr>
						<tr><td><code>Html.text</code><code>{"Str -> Html"}</code></td><td>escaped text</td></tr>
						<tr><td><code>Html.join</code><code>{"List(Html) -> Html"}</code></td><td>several, as one</td></tr>
						<tr><td><code>Html.empty</code><code>{"{} -> Html"}</code></td><td>nothing at all (<code>{"<></>"}</code> in markup)</td></tr>
						<tr><td><code>Html.doctype</code><code>{"{} -> Html"}</code></td><td>the doctype (<code>{"<!doctype html>"}</code> in markup)</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The <a href={Paths.platform_reference}>platform reference</a> lists every function of
				<code>Html</code> and the other modules.
			</p>
		</NoHydration>
	</>

<style>
	/* What a page uses: each function, and its type under it. */
	.api td:first-child {
		width: 64%;
	}

	.api td:first-child code {
		display: block;
		width: fit-content;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.api td:first-child code + code {
		margin-top: var(--space-1);
		color: var(--text-muted);
		font-size: var(--size-xs);
	}
</style>
