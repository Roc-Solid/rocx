import pf.Html
import ../../AppNotes
import ../../Ui/ExampleApp
import ../../Ui/Heading
import ../../Ui/PageHero
import ../../Ui/Stats
import ../../Ui/TableWrap
import ../../Generated/ExampleApps
import ../../Generated/Paths

## The example apps at a glance: each one, what its browser half weighs and what it is made of, a
## row each linking to its own page (site/routes/examples/<app>), and how they're measured. The
## numbers are `just example-apps`'s (`ExampleApps`, from site/example-apps.json); the words,
## site/AppNotes.roc's.
meta = {
	title: "Examples",
	description: "The example apps in the Roc Solid repository, each whole and small enough to read: what each shows, what its browser half weighs, what it is made of, and how fast the server answers.",
	toc: [{ id: "glance", label: "At a glance" }, { id: "measured", label: "How they're measured" }],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Examples"
				title="Whole apps, each one small enough to read"
			>
				Each is an app in the repository's <code>examples/</code>, with a README that tours it, maps each
				feature to the file that shows it, and says what it asked of the platform, and each has a page here,
				with its screenshots. <code>just examples</code> builds, checks and tests them all.
			</PageHero>

			<Heading id="glance">At a glance</Heading>
			<Stats
				stats={[
					{ label: "The smallest browser half", value: ExampleApp.kb(Overview.smallest.brotli), note: "wasm, brotli: a page and a counter" },
					{ label: "The runtime beside it", value: ExampleApp.kb(ExampleApps.runtime.brotli), note: "brotli: the JavaScript every page loads too" },
					{ label: "The largest here", value: ExampleApp.kb(Overview.largest.brotli), note: "wasm, brotli: ${Overview.largest_name}" },
					{ label: "Echo, answered", value: Overview.rps(ExampleApps.bench, "simple", 64), note: Overview.echo_note },
				]}
			/>
			<TableWrap>
				<table class="glance">
					<thead>
						<tr>
							<th scope="col">App</th>
							<th scope="col">What it is</th>
							<th scope="col" class="num">Wasm, brotli</th>
							<th scope="col" class="num">Pages</th>
							<th scope="col" class="num">Lines of Roc</th>
							<th scope="col">Database</th>
						</tr>
					</thead>
					<tbody>{...AppNotes.shown.map(Overview.row)}</tbody>
				</table>
			</TableWrap>

			<Heading id="measured">How they're measured</Heading>
			<p>
				{"Measured on ${ExampleApps.measured.date}, at commit "}<code>{ExampleApps.measured.commit}</code>{", with the compiler "}<code>{ExampleApps.measured.roc}</code>{", on an ${ExampleApps.measured.machine}. "}
				<code>just example-apps</code> builds each app's browser half again (<code>rocx build --client</code>,
				then its wasm with <code>--opt=size</code>, as <code>just examples</code> builds it), compresses it as
				this site measures its own (gzip at level 9, brotli at quality 11), and counts what the app is made
				of: pages, endpoints, its own lines of Roc (blank lines left out, not what <code>rocx build</code>
				writes, not its tests), expects and node tests. <code>just example-apps --bench</code> runs
				<a href={Paths.examples_echo}>echo</a>'s benchmark again, and <code>just example-shots</code> takes
				the screenshots. The site's build reads what they wrote, and measures nothing: a dozen wasm builds are
				minutes.
			</p>
			<p>
				The sizes are what a browser downloads when the files come compressed. The Roc Solid server sends
				them as they are, so in front of it, a CDN or a proxy that compresses (as GitHub Pages is in front
				of this site) is what makes them these sizes.
			</p>
		</NoHydration>
	</>

## What the overview works out from the numbers.
Overview := [].{

	## The apps with a browser half, smallest first.
	sized : List({ name : Str, size : ExampleApps.Size })
	sized = ExampleApps.all.keep_oks(|example| example.wasm.first().map_ok(|size| { name: example.title, size })).sort_with(|a, b| U64.order_relative_to(a.size.brotli, b.size.brotli))

	none : ExampleApps.Size
	none = { bytes: 0, gzip: 0, brotli: 0 }

	smallest : ExampleApps.Size
	smallest = Overview.sized.first().map_ok(|each| each.size) ?? Overview.none

	largest : ExampleApps.Size
	largest = Overview.sized.last().map_ok(|each| each.size) ?? Overview.none

	largest_name : Str
	largest_name = Overview.sized.last().map_ok(|each| each.name) ?? ""

	## Requests a second the benchmark measured on echo's `endpoint` ("simple", "json") at
	## `connections`, or "–".
	rps : List(ExampleApps.Bench), Str, U64 -> Str
	rps = |benches, endpoint, connections|
		match benches.first() {
			Ok(it) =>
				match it.variants.find_first(|variant| variant.name == endpoint) {
					Ok(variant) => variant.levels.find_first(|level| level.connections == connections).map_ok(|level| ExampleApp.count(level.rps)) ?? "–"
					Err(_) => "–"
				}
			Err(_) => "–"
		}

	## Under echo's number: what it was sent, and the order's number once it is measured.
	echo_note : Str
	echo_note = {
		json = Overview.rps(ExampleApps.bench, "json", 64)
		if (json == "–") "requests a second at 64 connections, a JSON string each" else "requests a second at 64 connections, a JSON string each; ${json} with an order that nests"
	}

	## An app's row: its name (a link to its page), a line on what it is, and its numbers.
	row : ExampleApps.Example -> Html
	row = |example|
		<tr>
			<th scope="row">{Overview.name(example)}</th>
			<td class="blurb">{Overview.blurb(example)}</td>
			<td class="num">{Overview.wasm(example)}</td>
			<td class="num">{example.pages.to_str()}</td>
			<td class="num">{ExampleApp.count(example.lines)}</td>
			<td>{if (example.database.is_empty()) "none" else example.database}</td>
		</tr>

	## An app's name, a link to its page if it has one.
	name : ExampleApps.Example -> Html
	name = |example|
		match AppNotes.about(example.name) {
			Ok(about) => <a href={about.path}>{example.title}</a>
			Err(NoNotes) => <span>{example.title}</span>
		}

	## The sidebar's line on an app, or that it has none.
	blurb : ExampleApps.Example -> Html
	blurb = |example|
		match AppNotes.about(example.name) {
			Ok(about) => <span>{about.blurb}</span>
			Err(NoNotes) => <span class="missing">No notes yet</span>
		}

	## An app's wasm, brotli, or that it has none.
	wasm : ExampleApps.Example -> Html
	wasm = |example|
		match example.wasm.first() {
			Ok(size) => <span>{ExampleApp.kb(size.brotli)}</span>
			Err(_) => <span class="none">none</span>
		}
}

<style>
	table {
		width: 100%;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}

	th,
	td {
		padding: var(--space-2);
		text-align: left;
		white-space: nowrap;
	}

	thead th {
		color: var(--text-muted);
		font-size: var(--size-xs);
		font-weight: 600;
		white-space: normal;
		vertical-align: bottom;
	}

	/* An app's name, the row's heading: as its README writes it. */
	tbody th {
		font-weight: 600;
		text-transform: none;
		letter-spacing: normal;
	}

	tbody tr {
		border-top: 1px solid var(--rule);
	}

	.blurb {
		color: var(--text-muted);
		white-space: normal;
	}

	.num {
		text-align: right;
	}

	.none {
		color: var(--text-muted);
		font-style: italic;
	}

	.missing {
		color: var(--magenta);
		font-weight: 600;
	}
</style>
