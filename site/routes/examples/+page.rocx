import pf.Html
import ../../AppNotes
import ../../Ui/Code
import ../../Ui/ExampleApp
import ../../Ui/Heading
import ../../Ui/PageHero
import ../../Ui/Stats
import ../../Ui/TableWrap
import ../../Generated/ExampleApps
import ../../Generated/Paths

## The example apps at a glance: where to start and how to run one, then each app, what its browser
## half weighs and what it is made of, a row each linking to its own page
## (site/routes/examples/<app>), and how they're measured. The numbers are `just example-apps`'s
## (`ExampleApps`, from site/example-apps.json); the words, site/AppNotes.roc's.
meta = {
	title: "Examples",
	description: "The example apps in the Roc Solid repository, each whole and small enough to read: where to start, how to run one, what each shows and weighs, and how fast the server answers.",
	toc: [{ id: "start", label: "Where to start" }, { id: "glance", label: "At a glance" }, { id: "measured", label: "How they're measured" }],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Examples"
				title="Whole apps, each one small enough to read"
			>
				Each example is a real app in the repository's <code>examples/</code> directory, built with Roc
				Solid from the database to the browser: the pieces fitting together, not a snippet. Each has a
				README that tours it and points to the file behind each feature, and a page here with its numbers
				and, for most, screenshots. All but hello have their own tests.
			</PageHero>

			<Heading id="start">Where to start</Heading>
			<p>
				Start with <a href={Paths.examples_hello}>hello</a>: one page with a counting button, and one
				endpoint, the two files <a href={"${Paths.root}#start"}>Getting started</a> shows. Then read
				<a href={Paths.examples_tasks}>Tasks</a>, written to be read first: file routing, middleware, a
				database, pages that read endpoints, forms that work without JavaScript, and optimistic updates,
				done the plain way, with comments on why each piece is where it is. Then pick the app that shows
				what you need from the table below.
			</p>
			<p>
				To run one, set up the repository (<code>just setup</code>), then start the app from its own
				directory, so its database file lands beside it. <code>rocx dev</code> builds it, serves it at
				http://localhost:8080 and rebuilds on save. <code>just examples</code> builds, checks and tests an
				app as the repository's checks do. <code>just examples-release</code> builds it to deploy
				(<code>rocx build</code>), then runs its tests against a server optimized for speed.
			</p>
			<Code source={"cd examples/tasks && ../../bin/rocx dev   # http://localhost:8080\njust examples tasks                      # build, check and test it\njust examples-release tasks              # its tests, as deployed"} numbers={Bool.False} plain />

			<Heading id="glance">At a glance</Heading>
			<p>
				The wasm column is the app's browser half, which every visitor downloads; an app of endpoints alone
				has none. A name links to the app's page.
			</p>
			<Stats
				stats={[
					{ label: "The smallest browser half", value: ExampleApp.kb(Overview.smallest.brotli), note: "wasm, brotli: a page and a counter" },
					{ label: "The runtime beside it", value: ExampleApp.kb(ExampleApps.runtime.brotli), note: "brotli: the JavaScript every page loads too" },
					{ label: "The largest here", value: ExampleApp.kb(Overview.largest.brotli), note: "wasm, brotli: ${Overview.largest_name}" },
					{ label: "Echo, answered", value: Overview.rps(ExampleApps.bench, "simple", 64), note: Overview.echo_note },
				]}
			/>
			<TableWrap>
				<table class="glance">
					<thead>
						<tr>
							<th scope="col">App</th>
							<th scope="col">What it is</th>
							<th scope="col" class="num">Wasm, brotli</th>
							<th scope="col" class="num">Pages</th>
							<th scope="col" class="num">Lines of Roc</th>
							<th scope="col">Database</th>
						</tr>
					</thead>
					<tbody>{...AppNotes.shown.map(Overview.row)}</tbody>
				</table>
			</TableWrap>

			<Heading id="measured">How they're measured</Heading>
			<p>
				{"Measured on ${ExampleApps.measured.date}, at commit "}<code>{ExampleApps.measured.commit}</code>{", with the compiler "}<code>{ExampleApps.measured.roc}</code>{", on an ${ExampleApps.measured.machine}. "}
				<code>just example-apps</code> rebuilds each app's browser half (<code>rocx generate --client</code>,
				then the wasm with <code>--opt=size</code>, as <code>rocx build</code> does) and compresses it as
				this site measures its own (gzip level 9, brotli quality 11). Then it counts pages, endpoints, the
				app's own lines of Roc (no blank lines, nothing rocx writes, no tests), expects
				and node tests.
			</p>
			<p>
				<code>just example-apps --bench</code> reruns <a href={Paths.examples_echo}>echo</a>'s server
				benchmark, and <code>just example-shots</code> takes the screenshots. This site's build only reads
				what they wrote, since a dozen wasm builds take minutes. How the browser's runtime compares with
				other frameworks: <a href={Paths.examples_js_framework_benchmark}>js-framework-benchmark</a>.
			</p>
			<p>
				The sizes are what a browser downloads compressed. The Roc Solid server sends files as they are, so
				in production a CDN or a compressing proxy (GitHub Pages, for this site) gets them down to these
				sizes.
			</p>
		</NoHydration>
	</>

## What the overview works out from the numbers.
Overview := [].{

	## The apps with a browser half, smallest first.
	sized : List({ name : Str, size : ExampleApps.Size })
	sized = ExampleApps.all.keep_oks(|example| example.wasm.first().map_ok(|size| { name: example.title, size })).sort_with(|a, b| U64.order_relative_to(a.size.brotli, b.size.brotli))

	none : ExampleApps.Size
	none = { bytes: 0, gzip: 0, brotli: 0 }

	smallest : ExampleApps.Size
	smallest = Overview.sized.first().map_ok(|each| each.size) ?? Overview.none

	largest : ExampleApps.Size
	largest = Overview.sized.last().map_ok(|each| each.size) ?? Overview.none

	largest_name : Str
	largest_name = Overview.sized.last().map_ok(|each| each.name) ?? ""

	## Requests a second the benchmark measured on echo's `endpoint` ("simple", "json") at
	## `connections`, or "–".
	rps : List(ExampleApps.Bench), Str, U64 -> Str
	rps = |benches, endpoint, connections|
		match benches.first() {
			Ok(it) =>
				match it.variants.find_first(|variant| variant.name == endpoint) {
					Ok(variant) => variant.levels.find_first(|level| level.connections == connections).map_ok(|level| ExampleApp.count(level.rps)) ?? "–"
					Err(_) => "–"
				}
			Err(_) => "–"
		}

	## Under echo's number: what it was sent, and the order's number once it is measured.
	echo_note : Str
	echo_note = {
		json = Overview.rps(ExampleApps.bench, "json", 64)
		if (json == "–") "requests a second at 64 connections, a JSON string each" else "requests a second at 64 connections, a JSON string each; ${json} with an order that nests"
	}

	## An app's row: its name (a link to its page), a line on what it is, and its numbers.
	row : ExampleApps.Example -> Html
	row = |example|
		<tr>
			<th scope="row">{Overview.name(example)}</th>
			<td class="blurb">{Overview.blurb(example)}</td>
			<td class="num">{Overview.wasm(example)}</td>
			<td class="num">{example.pages.to_str()}</td>
			<td class="num">{ExampleApp.count(example.lines)}</td>
			<td>{if (example.database.is_empty()) "none" else example.database}</td>
		</tr>

	## An app's name, a link to its page if it has one.
	name : ExampleApps.Example -> Html
	name = |example|
		match AppNotes.about(example.name) {
			Ok(about) => <a href={about.path}>{example.title}</a>
			Err(NoNotes) => <span>{example.title}</span>
		}

	## The sidebar's line on an app, or that it has none.
	blurb : ExampleApps.Example -> Html
	blurb = |example|
		match AppNotes.about(example.name) {
			Ok(about) => <span>{about.blurb}</span>
			Err(NoNotes) => <span class="missing">No notes yet</span>
		}

	## An app's wasm, brotli, or that it has none.
	wasm : ExampleApps.Example -> Html
	wasm = |example|
		match example.wasm.first() {
			Ok(size) => <span>{ExampleApp.kb(size.brotli)}</span>
			Err(_) => <span class="none">none</span>
		}
}

<style>
	table {
		width: 100%;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}

	th,
	td {
		padding: var(--space-2);
		text-align: left;
		white-space: nowrap;
	}

	thead th {
		color: var(--text-muted);
		font-size: var(--size-xs);
		font-weight: 600;
		white-space: normal;
		vertical-align: bottom;
	}

	/* An app's name, the row's heading: as its README writes it. */
	tbody th {
		font-weight: 600;
		text-transform: none;
		letter-spacing: normal;
	}

	tbody tr {
		border-top: 1px solid var(--rule);
	}

	.blurb {
		color: var(--text-muted);
		white-space: normal;
	}

	.num {
		text-align: right;
	}

	.none {
		color: var(--text-muted);
		font-style: italic;
	}

	.missing {
		color: var(--magenta);
		font-weight: 600;
	}
</style>
