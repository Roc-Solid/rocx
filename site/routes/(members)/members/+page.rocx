import pf.Html
import pf.Endpoint
import ../../../Generated/Api
import ../../../Generated/Paths
import ../../../Ui/Note
import ../../../Ui/Button
import ../../../Ui/PageHero

## Members only: its group's middleware (`Middlewares.member`, routes/(members)/+middleware.roc)
## runs before this page, as before its endpoint (`api/members/+server.roc`, in the same group), and
## hands on who the member is.
meta = {
	title: "Members",
	description: "A page behind middleware: only members see it.",
	toc: [],
}

## Who the member is: the page's endpoint (`GET /api/members`, for JSON), behind the same
## middleware, which read the cookie and handed on the name. The server answers it as it renders
## the page, and the page carries the answer.
member! : {} => Str
member! = |{}| Api.get_api_members({}).read!().member

view! = |_| {
	member = member!({})
	<>
		<PageHero
			eyebrow="Members"
			title={"Welcome, ${member}"}
		>
			Only members see this page. Before it rendered, <code>Middlewares.member</code> read your
			<code>member</code> cookie; without one, it would have sent you to join. The page then read its
			endpoint, <code>GET {Endpoint.url_of(Api.get_api_members({}))}</code>, which runs behind the same
			middleware, named in its own file, and answered with the name it handed on. A script that asks that endpoint for JSON gets
			the same answer, or a 401 without the cookie.
		</PageHero>
		<form method="post" action={Endpoint.url_of(Api.post_api_members_leave({}))}>
			<Button submit>Leave</Button>
		</form>
		<Note>
			Leave forgets the cookie and takes you back to the joining page. How this works:
			<a href={"${Paths.routing}#middleware"}>middleware</a>, on the routing page.
		</Note>
	</>
}
