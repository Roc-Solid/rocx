import pf.Html
import ../../../Ui/Heading
import ../../../Ui/Machine
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Generated/Sources
import ../../../Facts
import ../../../Generated/Paths
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Ui/Trace
import ../../../Ui/Who
import ../../../Ui/Arch
import ../../../Ui/ArchBox

meta = {
	title: "The browser",
	description: "The Roc Solid browser platform: an app's pages compiled to WebAssembly, a Rust host inside it, and a JavaScript runtime that hydrates the page the server sent, runs holes again when signals change, and navigates without reloading. With the sizes and timings this build measured.",
	toc: [
		{ id: "parts", label: "The parts" },
		{ id: "modules", label: "What components can use" },
		{ id: "header", label: "The header" },
		{ id: "click", label: "One click, step by step" },
		{ id: "hydration", label: "Hydration" },
		{ id: "nohydration", label: "What it never hydrates" },
		{ id: "navigation", label: "Moving between pages" },
		{ id: "waiting", label: "Waiting, in wasm" },
		{ id: "numbers", label: "The numbers" },
		{ id: "memory", label: "Memory" },
	],
}

## What the build measured on (site/machine.mjs, among its facts), for the table of builds: "" for
## what it didn't record (a build from before it did).
machine! : {} => Machine.Facts
machine! = |{}| {
	known! = |key| {
		value = Facts.fact!("machine_${key}")
		if (value == "?") "" else value
	}
	{ model: known!("model"), cpu: known!("cpu"), cores: known!("cores"), memory: known!("memory"), storage: known!("storage"), os: known!("os"), arch: known!("arch"), power: known!("power") }
}

view! = |_| {
	<>
		<NoHydration>
			<PageHero
				eyebrow="The platform · the browser"
				title="The components in WebAssembly, a Rust host, and a page of JavaScript"
			>
				The browser runs the same components the server renders: every page, with its layouts, compiled
				to one WebAssembly module. Your Roc decides what each hole shows and what each handler does. A
				JavaScript runtime tracks what reads what, runs a hole again when what it read changes, and
				touches the DOM. You write no JavaScript.
			</PageHero>

			<Heading id="parts">The parts</Heading>
			<Arch
				left={[
					<ArchBox kind="js" name={[<code>web/runtime.js</code>]}>
						<p>
							JavaScript. Hydrates the server's document. Keeps the signals, memos, effects and
							computations, and which component owns what. Runs a hole's Roc again when what it read
							changes, and patches its node. Runs effects once their markup is on the page; starts timers,
							sends requests and forms, navigates, and listens to streams and channels.
						</p>
					</ArchBox>,
				]}
				wire="ids and strings"
				right={[
					<ArchBox kind="wasm" label="One wasm module">
						<ArchBox kind="rust" name={[<code>web/host</code>]}>
							<p>Rust, inside the wasm: Roc's memory, and each of the platform's effects passed on to the runtime.</p>
						</ArchBox>
						<ArchBox kind="roc" name={[<>{"The app, on "}</>, <code>web/platform</code>]}>
							<p>
								Roc: your components, their markup with holes as closures, escaping and safe URLs, and
								endpoints as requests.
							</p>
						</ArchBox>
					</ArchBox>,
				]}
			/>
			<p>
				Markup reaches the runtime as JSON: elements, text, and holes, each a Roc closure the runtime keeps
				boxed under an id. Running a hole calls the app's <code>run</code> with its box, and the answer is
				JSON again: a text, an attribute's value, or markup. The server renders the same JSON natively
				(<a href={"${Paths.platform_server}#pages"}>pages, rendered on the server</a>). Lists are cheaper:
				once the page is up, a <code>.map</code>'s first row sends its skeleton (its elements, and the
				attributes and text written in the file), which the runtime keeps and copies; each later row sends
				only what fills the copy (its holes, handlers and values). The bootstrap, <code>web/start.js</code>,
				ends every page: it loads the runtime and the wasm from beside itself, and hydrates the document.
			</p>

			<Heading id="modules">What components can use</Heading>
			<p>Components use the browser platform's modules, which the server platform has too (the build copies them):</p>
			<ul>
				<li>
					<code>Html</code> (markup), <code>Solid</code> (signals, memos, effects, timers, contexts),
					<code>Store</code>, <code>Context</code>, <code>Repeat</code> (a row per index in a range, what
					<a href={Paths.ecosystem_virtual}>virtual lists</a> are made of), <code>Transition</code>, <code>Loading</code> and <code>Errored</code>:
					<a href={Paths.components}>components</a>.
				</li>
				<li>
					<code>Endpoint</code>, <code>Call</code>, <code>Events</code>, <code>Channel</code>,
					<code>Submission</code> and <code>Submissions</code>: <a href={Paths.calls}>talking to the
					server</a>.
				</li>
				<li>
					<code>Router</code>, <code>Search</code>, <code>Leave</code>, <code>Navigate</code>,
					<code>Title</code> and <code>HttpStatusCode</code>:
					<a href={"${Paths.routing}#navigating"}>routing and navigation</a>.
				</li>
				<li>
					<code>Browser</code> (<code>Browser.call!</code>: the page's own JavaScript, or a plugin's script,
					from a handler) and <code>Time</code> (the clock).
				</li>
			</ul>
			<p>
				<code>Server</code>, <code>Middleware</code> and <code>OpenApi</code> are there too, so route files
				compile on both sides. Roc compiles only what a program reaches, so server-only code costs the wasm
				nothing.
			</p>

			<Heading id="header">The header</Heading>
			<p>What an app gives the platform, and what the platform gives the host:</p>
			<Code title={"${Sources.platform_requires.file}, in part"} source={Sources.platform_requires.rocx} numbers={Bool.False} />
			<p>
				<code>main!</code> is the app's root, which rocx writes into the browser's copy
				(<code>Generated/Root</code>): a whole document, the page at the browser's path inside its layouts.
				The platform gives the host two functions: mount the root, and run a kept box. The browser answers
				no requests: every endpoint a component reads is the server's (in the tests, Node answers reads
				from the answers the page recorded). The rest of the header is what Roc may ask of the runtime, each
				a call into JavaScript: boxes, signals, memos, fetches (an endpoint's read is a GET), streams,
				channels, contexts, where the page is (<code>Router.location!</code>), and so on.
			</p>
			<details>
				<summary>The whole header: <code>{Sources.platform_header.file}</code></summary>
				<Code title={Sources.platform_header.file} source={Sources.platform_header.rocx} />
			</details>

			<Heading id="click">One click, step by step</Heading>
			<p>You press <b>+</b> on the counter on the <a href={Paths.root}>front page</a>. Then:</p>
			<Trace>
				<li>
					<Who kind="js">JavaScript</Who> The button's listener, attached at hydration, holds the id of the
					handler's box. The runtime opens a turn and asks the host to run it.
				</li>
				<li>
					<Who kind="roc">Roc</Who> <code>{"|| set_count!(count!() + 1)"}</code> runs:
					<code>count!()</code> asks the runtime for the signal's value (3), and <code>set_count!</code>
					hands it the next one (4), boxed.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> When the handler returns, its writes apply: the signal holds 4,
					and the three computations that read it are due: the <code>{"<output>"}</code>'s text, the
					<code>negative</code> class, and the Reset button's <code>disabled</code>.
				</li>
				<li>
					<Who kind="roc">Roc</Who> Each runs again: the text is <code>"4"</code>, the class still off,
					<code>disabled</code> still false.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> Only the text changed, so only its node is set: an unchanged value
					isn't patched. (Reset to 0 would patch the button too.)
				</li>
			</Trace>

			<Heading id="hydration">Hydration</Heading>
			<p>Hydration is how the browser takes over the server's page without building it again:</p>
			<Trace>
				<li>
					<Who kind="js">JavaScript</Who> The page ends with a script holding its endpoint reads'
					answers, then the bootstrap, <code>/rocx/start.js</code>. It fetches the runtime and the app's
					wasm ({Facts.fact!("client_brotli")} with brotli for this site, one module for every page) from
					beside itself, has the runtime compile the wasm, and asks it to hydrate the document.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> The runtime reads the answers and takes their script out of the
					page.
				</li>
				<li>
					<Who kind="roc">Roc</Who> The root runs once: it reads where the page is
					(<code>Router.location!</code>) and renders that page in its layouts, a whole document, each
					component once, where it is rendered.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> The runtime walks the server's nodes beside Roc's markup, from the
					doctype and <code>{"<html>"}</code> down, attaching each computation to its node. The server's
					HTML comments mark each hole, list row and <code>if</code> branch
					(<code>{"<!--x-->…<!--/x-->"}</code>). Nothing is fetched or built again: a read whose answer the
					page has (under <code>GET</code> and its URL) gets it from there.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> Elements a browser extension put straight in
					<code>{"<body>"}</code> or <code>{"<head>"}</code> (a password manager's popup, a dark theme's
					style) are passed over, and stay. Any other mismatch (the HTML parser moved a
					<code>{"<div>"}</code> out of a <code>{"<p>"}</code>) makes the runtime warn, naming the node and
					its place, tell the page (a <code>rocx:mismatch</code> event, for error reporting), and render
					<code>{"<body>"}</code>'s children again from the same answers. <code>{"<head>"}</code> is left
					alone: rendering it again would rerun its scripts and flash its styles. To investigate one,
					<code>{"localStorage.setItem(\"rocx:strict\", \"1\")"}</code> makes the next load throw at the
					mismatch instead.
				</li>
				<li>
					<Who kind="js">JavaScript</Who> The bootstrap tells the page it is done with a
					<code>rocx:ready</code> event, carrying how long hydrating took. From then on, a read the page has
					no answer for is a GET of the endpoint's URL.
				</li>
			</Trace>

			<Heading id="nohydration">What it never hydrates</Heading>
			<p>
				<code>{"<NoHydration>"}</code> (<code>Html.no_hydration</code> in Roc) marks markup only the server
				renders: prose, listings, anything that never changes in the browser. The server runs it once and
				writes it between <code>{"<!--nohydration-->"}</code> and <code>{"<!--/nohydration-->"}</code>, with
				no markers inside, leaving its reads out of the page's answers. In the browser's copy of a
				<code>.rocx</code> file (in <code>build/client</code>, which rocx writes) the region has no
				children, and imports only they used are gone, so none of it is in the wasm. Hydration skips the
				nodes between the markers, never building, adopting or patching them; a <code>{"<body>"}</code>
				rendered again keeps them.
			</p>
			<p>
				Nothing inside runs in the browser, so rocx refuses a handler, a <code>key</code> or a transition
				written there, at its line, and the server refuses to render a handler a component put there: a 500
				naming the element, rather than a button that silently does nothing. This page is all one
				<code>{"<NoHydration>"}</code>, so its prose costs the wasm nothing.
			</p>

			<Heading id="navigation">Moving between pages</Heading>
			<p>
				After hydration, a link to another of the app's pages doesn't reload. The runtime fetches that
				page's HTML document, as a reload would, and renders it from the document's answers with the wasm it
				has (every page is in the one module). Layouts both pages share stay, the address goes into the
				history, and scroll, focus and title change as on a reload.
				<a href={"${Paths.routing}#navigating"}>Navigating without a reload</a> lists what an app controls.
			</p>

			<Heading id="waiting">Waiting, in wasm</Heading>
			<p>
				A component reads a memo that waits for the server (an endpoint's answer, say) as a plain value: no
				async in Roc, and no JSPI. Until the answer is in, the read throws, in JavaScript, through the Roc
				frames that asked. The runtime catches it where it ran the computation, puts Roc's stack pointer back,
				and runs the computation again when the answer comes; the host frees what the stopped run allocated
				(<a href="#memory">memory</a>). The first time, a <code>{"<Loading>"}</code> above shows its
				fallback; after that, what was shown stays until the new value is in
				(<a href={"${Paths.components}#waiting"}>waiting and failing</a>).
			</p>

			<Heading id="numbers">The numbers</Heading>
			<p>
				Measured by <code>site/build.mjs</code> in Node {Facts.fact!("node")}: this site's wasm, built three
				ways (the other two on {Facts.fact!("compared")}, when <code>node site/build.mjs</code> last compared
				them). "Rendering" is the wasm rendering the <a href={Paths.root}>front page</a> as the server would,
				from the server's answers, after warming up: every component and hole outside its
				<code>{"<NoHydration>"}</code>s, once. Each build's output is checked against the server's, byte for
				byte, before it is timed.
			</p>
			<TableWrap>
				<table class="compare">
					<thead><tr><th>Built with</th><th>Raw</th><th>gzip</th><th>brotli</th><th>Rendering</th></tr></thead>
					<tbody>
						<tr><td><code>--opt=size</code></td><td>{Facts.fact!("size_bytes")}</td><td>{Facts.fact!("size_gzip")}</td><td>{Facts.fact!("size_brotli")}</td><td>{Facts.fact!("size_render_us")} µs</td></tr>
						<tr><td><code>--opt=speed</code></td><td>{Facts.fact!("speed_bytes")}</td><td>{Facts.fact!("speed_gzip")}</td><td>{Facts.fact!("speed_brotli")}</td><td>{Facts.fact!("speed_render_us")} µs</td></tr>
						<tr class="chosen"><td><code>--opt=size --specialize=yes</code> <span class="chosen-mark">this site</span></td><td>{Facts.fact!("client_bytes")}</td><td>{Facts.fact!("client_gzip")}</td><td>{Facts.fact!("client_brotli")}</td><td>{Facts.fact!("client_render_us")} µs</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Specializing Roc's lambda sets makes this site's wasm the smallest download;
				<code>--opt=speed</code> renders a little faster and is the biggest raw. Compiling this site's wasm
				took {Facts.fact!("client_compile_ms")} ms in Node. The whole runtime, minified as rocx writes it
				into the browser's copy, is {Facts.fact!("runtime_gzip")} of JavaScript gzipped. A release or a
				static copy (<code>rocx build</code>, <code>--static</code>) ships only the
				runtime code the app's wasm reaches, without in-place navigation, drags or glides where the app has
				none, as this site's static copy does. The <a href={Paths.showcase}>showcase</a> measures itself as
				it runs (frames a second, and what each costs, Roc and patches together);
				<a href={Paths.examples_js_framework_benchmark}>js-framework-benchmark</a> measures the platform beside
				Solid, Leptos, Joy, React and hand-written DOM code.
			</p>
			<Machine machine={machine!({})} />
			<p>
				Roc's floating-point code weighs most in the wasm. Building with and without it, parsing a float
				from a string costs about 18 KB compressed, printing one about 12 KB, and sine and cosine about 5 KB.
				So the runtime sends frame times as whole microseconds, the showcase's flock prints its positions as
				whole numbers, and a bird's heading is a random vector scaled by a square root, one wasm
				instruction.
			</p>
			<Callout kind="note" title="For scale">
				<p>A frame at 60 Hz is 16,667 µs.</p>
			</Callout>

			<Heading id="memory">Memory</Heading>
			<p>
				A page keeps its wasm instance while it is open, so memory has to come back. Roc's memory is the
				host's: a Rust crate, <code>web/memory</code>, which the phone's host uses too. It allocates
				power-of-two slots, as Zig's allocator for wasm does, and counts what is live. A box the runtime
				keeps (a hole's closure, a signal's value) is released when what made it goes: a row dropped, an
				<code>if</code> switching branch, a value replaced. A run that stops to wait skips the frees Roc
				would make on the way out, so the host notes what each run allocates and frees what a stopped run
				still held once the runtime lets go of what it made. The tests click, type, add and drop rows, wait
				for the server, and render pages over and over, checking that live allocations don't grow.
			</p>
		</NoHydration>
	</>
}

<style>
	/* The builds compared: numbers line up, and the site's is marked. */
	.compare td,
	.compare th {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.compare td:first-child {
		white-space: normal;
	}

	.compare tr.chosen td {
		background: var(--accent-soft);
		font-weight: 600;
	}

	.chosen-mark {
		display: inline-block;
		padding: 0 var(--space-2);
		border-radius: var(--pill);
		background: var(--accent);
		box-shadow: var(--glow);
		color: var(--accent-text);
		font-size: var(--size-2xs);
		font-weight: 700;
	}
</style>
