import pf.Html
import ../../../Ui/Heading
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Generated/Sources
import ../../../Generated/Paths
import ../../../Ui/PageHero

meta = {
	title: "The server",
	description: "The Roc Solid server platform: Roc compiled to native code in a Rust host, as one executable. How to run it, its flags and limits, its log; how each request runs as a call that pauses while it waits, how a crash ends one call only, how pages are rendered, and how plugins add to an app.",
	toc: [
		{ id: "running", label: "Running it" },
		{ id: "logging", label: "The log" },
		{ id: "deploying", label: "Deploying" },
		{ id: "layers", label: "What is Rust, what is Roc" },
		{ id: "calls", label: "A call pauses while it waits" },
		{ id: "crashes", label: "A crash ends one call" },
		{ id: "memory", label: "Memory" },
		{ id: "streams", label: "Streams of events" },
		{ id: "pages", label: "Pages, rendered on the server" },
		{ id: "photos", label: "Photos' copies" },
		{ id: "background", label: "Background loops and isolated calls" },
		{ id: "plugins", label: "Plugins" },
		{ id: "tcp", label: "Sockets and randomness" },
		{ id: "limits", label: "Not yet" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="The platform · the server"
				title="Roc compiled to native code, in a Rust host"
			>
				An app's server is one executable: your Roc compiled to machine code, linked with a Rust host
				(tokio and hyper). The host answers HTTP, runs your code for each request, keeps a crash to its
				request, and frees the memory used. Your Roc decides what each request gets; the host carries it
				out.
			</PageHero>

			<Heading id="running">Running it</Heading>
			<p>
				<code>rocx dev</code> runs the server with <code>--dev</code>. A built executable takes these
				options (with the environment variable that does the same in parentheses):
			</p>
			<Code
				title="The app's executable"
				source={"<app> --port 8080 --host 127.0.0.1        where to listen (PORT)\n      --static DIR, --file /PATH=FILE     files served as they are\n      --context-file FILE                 what the app's init! is given, once, as it starts\n      --env-file FILE                     settings for the environment, read as it starts (none without it: a .env here isn't read unless named); the environment wins\n      --database-url URL                  the database (DATABASE_URL): postgres://…, or sqlite:<path> (turso:<path>) for a SQLite (Turso) app's file elsewhere\n      --actor-idle-ms 900000              an actor idle this long is let go (0: never; kept in the database)\n      --kv-max-mb 64                      Kv's limit (KV_MAX_MB): the least recently used goes past it\n      --images-dir data/images            where enhanced:src's copies of photos are kept\n      --images-max-mb 1024                the most they take: the least recently used go past it\n      --images-wait                       a page waits for its photos' copies (a static build's server)\n      --max-body 16MiB                    the most a request's body may be (MAX_BODY): bytes, or KiB, MiB, GiB; 413 beyond\n      --public-url https://app.example    where the app is, for links it sends (PUBLIC_URL; else where it listens)\n      --dev                               reload pages on restart, show crashes, plugins' dev pages (/__rocx/mail)\n      --debug                             GET /__rocx/allocations and /__rocx/plugin-files, and plugins' debug paths\n      --live-beat-ms 15000                how often a channel stream beats, and its checks run again\n      --roc-threads N                     the threads Roc runs on (ROCX_ROC_THREADS; one a core)"}
				numbers={Bool.False}
				plain={Bool.True}
			/>
			<ul>
				<li>
					<strong>Request bodies.</strong> The host reads a body whole before your code runs: up to
					16 MiB, or <code>--max-body</code> (bytes, KiB, MiB or GiB, as in <code>64MiB</code>). A larger
					body gets 413.
				</li>
				<li>
					<strong>Static files.</strong> <code>--static</code> and <code>--file</code> serve files typed by
					their extension (<code>cache-control: no-store</code> under <code>--dev</code>). A file directly
					under <code>/rocx/</code> whose name ends in a dash and 16 hex digits
					(<code>styles-0123456789abcdef.css</code>, as rocx build names the stylesheet) is cached for a
					year (<code>cache-control: public, max-age=31536000, immutable</code>).
				</li>
				<li>
					<strong>Proxies.</strong> Outgoing requests use <code>HTTPS_PROXY</code> or
					<code>HTTP_PROXY</code> when set, except to hosts in <code>NO_PROXY</code>
					(<a href={"${Paths.platform_http}#connections"}>HTTP</a>).
				</li>
				<li>
					<strong>Starting.</strong> The server reads the file <code>--env-file</code> names, if any, into
					its environment (<a href={Paths.platform_settings}>settings</a>), and takes its port, stopping if
					the port is in use. Then it opens the database, checks the plugins, applies migrations, runs the
					app's <code>init!</code>, starts the background loops, and answers requests.
				</li>
				<li>
					<strong>Stopping.</strong> On SIGTERM or Ctrl-C, it stops listening and taking jobs, then waits
					up to ten seconds for running requests, streams and jobs.
				</li>
				<li>
					<strong>Without a database</strong> (a Postgres app with no URL), a server whose app or plugins
					have tables doesn't start, and says which have them; under <code>--dev</code> or
					<code>--debug</code> it starts and logs a line. Without tables, it starts, and what needs the
					database says so when used.
				</li>
			</ul>

			<Heading id="logging">The log</Heading>
			<p>
				Every line on stderr is an event: a level, a message and fields, from your app, the host
				(starting, stopping, a crash with its method, URL and error) or a plugin (a migration applied, a
				failed job). Keep messages fixed and details in fields, for log collectors to filter on. Log with
				<code>Log.info!</code>, <code>Log.debug!</code>, <code>Log.warn!</code> or
				<code>Log.error!</code>, a message and a record of fields (<code>{"{}"}</code> for none);
				<code>Log.line!</code> logs a message alone. The program sets the format:
			</p>
			<Code
				title="An event, and the log's format"
				source={"Log.info!(\"gate failed\", { path: request.path, error: why })\n\nprogram = {\n\t..App.program({ init! }),\n\tlogs: { format: Auto }, # or Pretty, or Json\n}"}
			/>
			<Code
				title="The line, pretty and as JSON"
				source={"14:03:12 info  gate failed  path=/admin error=\"no session\"\n{\"time\":\"2026-11-21T13:03:12.345Z\",\"level\":\"info\",\"msg\":\"gate failed\",\"error\":\"no session\",\"path\":\"/admin\"}"}
				numbers={Bool.False}
				plain={Bool.True}
			/>
			<p>
				<code>Auto</code>, the default, follows <code>ROCX_LOG</code> (<code>pretty</code> or
				<code>json</code>) if set; otherwise pretty lines to a terminal, and JSON elsewhere. A field named
				<code>time</code>, <code>level</code> or <code>msg</code> is written as <code>fields.msg</code> and
				so on, so it can't replace the line's own.
			</p>
			<p>
				A pretty line is the time, the level, the message, then the fields. At a terminal the time and the
				fields' names are dimmed and the level coloured, so the message and the values stand out. A
				request's <code>path</code>, <code>method</code> and <code>status</code> come first, then
				durations: a number named <code>{"<x>_ns"}</code>, <code>{"<x>_us"}</code> or
				<code>{"<x>_ms"}</code> is shown in the unit that reads best (<code>duration_ns=12345</code> is
				<code>duration=12µs</code>). JSON keeps the fields as they are.
			</p>
			<Code
				title="Under --dev, as the server starts"
				source={"10:36:32 info  rocx plugins: jobs, email, auth\n10:36:32 info  rocx server: http://127.0.0.1:8080 (Roc, native)\n               ➜ Stories   http://127.0.0.1:8080/__rocx/stories\n               ➜ OpenAPI   http://127.0.0.1:8080/openapi.html\n               ➜ Mailbox   http://127.0.0.1:8080/__rocx/mail\n               ➜ Sign in   http://127.0.0.1:8080/sign-in"}
				numbers={Bool.False}
				plain={Bool.True}
			/>
			<p>
				Under <code>--dev</code>, the server lists the places to open under its address: the app's stories,
				its OpenAPI page if a route serves one, what plugins add (the dev mailbox, the sign-in page) and the
				app's own (<code>{"App.program({ links: [{ label: \"Jobs\", path: \"/admin/jobs\" }] })"}</code>).
			</p>
			<p>
				Logging never waits for stderr: a thread of its own writes queued events in order, flushing when
				the queue empties and before exit. When the queue is full (64k events), the caller waits rather
				than lose a line.
			</p>

			<Heading id="deploying">Deploying</Heading>
			<p>
				<code>rocx build</code> writes <code>dist/server</code>, migrations inside, and
				<code>dist/static</code> (<a href={"${Paths.tooling}#commands"}>rocx</a>).
				<code>--target arm64musl</code> (or <code>x64musl</code>) makes a static Linux executable, from
				macOS too: the prebuilt host carries musl's C library and unwinder. To deploy:
			</p>
			<ul>
				<li>Put it in a container with the app's static files: <code>rocx build --image</code> writes an image of nothing else, without a Dockerfile, for <code>docker load -i my-app.tar</code> (<a href={"${Paths.tooling}#commands"}>rocx</a>). With only the app's database engine and no debug info, a hello world's image is 3.7 MB to send.</li>
				<li>Give a Postgres app a <code>DATABASE_URL</code>, a SQLite app a file on a volume (<code>--database-url sqlite:/data/app.db</code>).</li>
				<li>Pass settings (<code>APP_SECRET</code>, <code>SMTP_URL</code>, an API's key) as environment variables, or in a file read at start (<code>--env-file</code>; the environment wins). A plugin missing a setting stops the start, naming it.</li>
				<li>Put a TLS proxy in front, and set <code>PUBLIC_URL</code> to the public address for the links the app sends (<a href={Paths.platform_settings}>settings</a>).</li>
				<li>Run one instance. Live state, <code>Kv</code> and actors' mailboxes live in its memory, so an app runs as one server, not as copies behind a load balancer.</li>
			</ul>
			<p>CI builds and tests every example app on Linux (arm64).</p>
			<p>
				An app whose pages need no server once rendered (docs, a blog, a landing page) can be deployed as
				files: <code>rocx build app --static</code> writes every page, its data and what it loads, for
				GitHub Pages or a CDN (<a href={"${Paths.tooling}#static"}>a static copy</a>).
			</p>

			<Heading id="layers">What is Rust, what is Roc</Heading>
			<p>
				The host gives Roc general building blocks. Everything built on them is Roc, in the platform or
				packages, and an app could write its own:
			</p>
			<ul>
				<li>
					<strong>Rust</strong> (<code>server/host</code>): HTTP; threads; the database (a pool of
					Postgres connections plus one listening for notifications, or SQLite's file in the process, its
					calls on threads of their own); time zones; TCP and TLS sockets; live topics and rooms;
					channels' streams; background loops and isolated calls; actors' mailboxes and timers; values in
					memory (<code>Kv</code>); secure random numbers, AES-GCM and P-256; reading a settings file
					(<code>--env-file</code>); rendering pages of components; photos' copies.
				</li>
				<li>
					<strong>Roc</strong> (<code>server/platform/*.roc</code>): migrations, plugins (checking and
					running them), actors' state and messages, decoding database rows. Jobs, cron and email (an SMTP
					client, MIME) are Roc packages on the same effects
					(<a href={Paths.ecosystem_jobs}>packages/jobs</a>, <a href={Paths.ecosystem_email}>packages/email</a>).
				</li>
			</ul>
			<p>The <a href={Paths.platform_reference}>platform reference</a> lists every effect, with its type.</p>

			<Heading id="calls">A call pauses while it waits</Heading>
			<p>
				Your Roc runs on threads of its own (one per CPU core, or <code>--roc-threads</code> /
				<code>ROCX_ROC_THREADS</code>), beside tokio's, which handle HTTP, sockets and timers. Each call
				into Roc (a request and its page, a stream, an actor's turn, a background loop) is a
				<strong>coroutine</strong> with its own stack.
			</p>
			<p>
				When an effect waits (a query, a socket, another server, a sleep), the call pauses and its thread
				runs other calls; it resumes on the same thread when the wait ends. A waiting call holds no
				thread, so any number can wait at once. In the tests, eight requests each waiting 0.3 s on
				Postgres take about 0.3 s together, and 2,000 each waiting a second, on two threads, about a
				second.
			</p>
			<p>The costs:</p>
			<ul>
				<li>
					Roc computing for long without an effect (a long pure loop) can't pause, so calls queued on its
					thread wait. New calls go to Roc's other threads.
				</li>
				<li>
					A call with a time limit (a job's) still ends on time: the server interrupts its thread and, in
					the app's code, ends the call as a crash would.
				</li>
				<li>
					Each stack reserves 8 MiB (Roc's default; a page is a deep tree to render), but a paused call
					costs only the memory its stack touched.
				</li>
				<li>Profilers and debuggers see calls on their own stacks, not on threads.</li>
				<li>A stack overflow still ends the process, saying so on stderr first.</li>
			</ul>
			<p>
				Each call has its own context (its open transaction, rooms joined, topics listened to, sockets),
				given back when it ends. A value Roc makes belongs to its call until the call returns; then the host
				owns it, and may move it to another call (a stream's, to the call that sends it) but never shares
				it.
			</p>

			<Heading id="crashes">A crash ends one call</Heading>
			<p>
				In Roc, a <code>crash</code> or an integer overflow stops the program, but Roc's ABI lets the host
				choose how: <code>roc_crashed</code> must never return, so it can end the process or jump out of
				the Roc code that called it. This host jumps. A guard (<code>server/host/src/guard.c</code>) sets a
				jump target around every call into Roc, so a crash ends only that call:
			</p>
			<ul>
				<li><strong>A request</strong> is answered 500 (with the crash's message under <code>--dev</code>).</li>
				<li><strong>A stream</strong> ends.</li>
				<li><strong>A job</strong> counts as failed and runs again later.</li>
				<li><strong>An actor's turn</strong> is logged and reported to whoever asked; the actor's state stays as it was.</li>
				<li><strong>A transaction</strong> the call had open is rolled back.</li>
			</ul>
			<p>A crash skips only Roc's frames and a small trampoline's, so no Rust destructor is skipped.</p>

			<Heading id="memory">Memory</Heading>
			<p>
				So that a crash leaks nothing, every allocation a call makes goes into a list the call owns. When
				the call returns, the answer's strings are copied out and the list is freed (a stream's once the
				call sending it is done); when it crashes, everything in the list is freed. Roc's reference counts
				are atomic in native builds, so a value moved to another thread stays correct.
			</p>
			<p>
				The tests crash 200 requests at once, half after allocating 2,000 strings, then check that Roc
				holds no allocation (<code>--debug</code> serves the count at <code>/__rocx/allocations</code>).
				This site's tests check the same after rendering its pages over and over.
			</p>

			<Heading id="streams">Streams of events</Heading>
			<p>
				An endpoint can answer with server-sent events: a loop,
				<code>{"Events.stream(|{ send!, sleep! }| …)"}</code>, which the host runs as its own call while the
				stream is open. <code>send!</code> writes an event; <code>sleep!</code> pauses. When the client
				leaves, <code>sleep!</code> wakes early and the next <code>send!</code> returns
				<code>Err(Gone)</code>, so <code>?</code> ends the loop. A sleeping stream holds no thread: the
				tests keep 2,000 open on two threads and still answer a request at once.
				<a href={"${Paths.calls}#events"}>Events</a> shows one, with a component listening.
			</p>
			<p>
				For live data that pages follow, a <a href={"${Paths.platform_live}#channels"}>channel</a> is
				usually better: a tab's channels share one stream the host keeps without a call, and Roc runs only
				briefly, for a check or hook.
			</p>

			<Heading id="pages">Pages, rendered on the server</Heading>
			<p>
				A page is one tree of components: its layouts, the page, and what they contain. The host renders
				it whole (<code>server/host/src/signals.rs</code>) exactly as the browser's runtime would: each
				component and hole runs once, nothing is tracked or waits, and a memo is computed when made. HTML
				comments mark each hole for hydration; markup inside <code>{"<NoHydration>"}</code> is plain HTML,
				never hydrated. The site's tests check that the host and the browser's runtime render every page
				the same, byte for byte.
			</p>
			<p>
				A component's endpoint read (<code>.read!()</code>, a GET of the app's own path) is made
				in-process: through the app's <code>respond!</code> and the route directories' middleware, with
				<code>accept: application/json</code>, the page's headers (cookies included) and the app's context,
				so it gets the answer the browser would. Each URL is asked once per render. The answers go, by URL,
				into a script at the end of the page, before <code>/rocx/start.js</code>, and the browser reads them
				there instead of asking again. Reads inside a <code>{"<NoHydration>"}</code> aren't recorded: the
				browser never makes them.
			</p>
			<p>
				On a failure (a context nothing provides, a failed memo, an endpoint answering anything but 200),
				the nearest <code>{"<Errored>"}</code> shows its fallback, as in the browser. An endpoint's
				redirect redirects the page; a crash ends the render with a 500.
			</p>

			<Heading id="photos">Photos' copies</Heading>
			<p>
				Write a photo as <code>{"<img enhanced:src={path} alt=\"…\" />"}</code> and the server makes
				smaller WebP copies of it, 160 to 1920 pixels wide. The first page to show it gets the plain
				<code>src</code>, and the photo joins a queue two of the host's workers take from. Later pages get
				the copies: a <code>srcset</code>, <code>sizes</code>, and the photo's <code>width</code> and
				<code>height</code>, so the layout keeps its room. No page waits, and there is nothing to set up:
				no job, no build step.
			</p>
			<ul>
				<li><strong>Whose photos:</strong> files in the app's <code>static/</code>, or what the app's routes answer someone signed out (the server asks itself, without cookies). Never another site's, and never a photo only signed-in users may see: its copies would be anyone's.</li>
				<li><strong>Where they're kept:</strong> <code>data/images</code>, named by content and served at <code>/rocx/images/…</code> for browsers to cache for good. The directory is its own index, so a restarted server has the copies on its first page.</li>
				<li><strong>Pruning:</strong> photos no page named for 30 days go, then the least recently used while the directory is over 1 GiB (<code>--images-max-mb</code>). A removed one is made again the next time a page shows it.</li>
				<li><strong>A changed photo</strong> (a rewritten file, a route's new answer) gets new copies; its page shows the plain <code>src</code> until they exist.</li>
				<li><strong>A static build</strong> (<code>rocx build --static</code>) waits for every photo's copies and ships them with the pages.</li>
			</ul>

			<Heading id="background">Background loops and isolated calls</Heading>
			<p>
				At start, the server asks the platform's Roc which loops to run in the background: plugins' loops
				(the jobs plugin's workers, schedules and hourly sweep of finished jobs) and checks (the email
				plugin's look at the SMTP server). Each runs as its own call until the server stops; one that
				crashes restarts a second later. A loop sleeps with <code>Live.next!</code>, which wakes on a
				publish to a topic it listens to, when its time is up, or with <code>Gone</code> at shutdown.
				<code>Db.notify!</code> (and Postgres's <code>NOTIFY</code>) publish on
				<code>{"db:<channel>"}</code>: that is how job workers sleep until a job is queued.
			</p>
			<p>
				An <strong>isolated call</strong> runs Roc inside another call, guarded on its own: a crash ends it
				alone, and the caller learns why. Plugins use them (<code>Plugin.isolated!</code>); the jobs plugin
				runs each job in one, so a crashing job just fails and the worker goes on.
			</p>
			<p>
				An actor's turn is a guarded call too: its mailbox, in the host, runs it with the kind, key, state
				and message as strings, so a crash frees them all. No lock is taken: one task routes each message
				to its actor's mailbox, and each actor handles its messages one at a time
				(<a href={Paths.platform_actors}>actors</a>).
			</p>

			<Heading id="plugins">Plugins</Heading>
			<p>
				A <strong>plugin</strong> is a package that adds what only the server runs: tables, background
				loops, files, scripts every page loads, development pages, work at start, checks; never a route.
				Name the package in the app's header and list its plugin in the program. The jobs, email, auth,
				push, Stripe and audio packages, among others, are plugins.
			</p>
			<Code
				title="main.roc"
				source={"app [program] { pf: platform \"../server/platform/main.roc\", acme: \"../packages/acme/main.roc\" }\n\nimport acme.Acme\n\nprogram = App.program({\n\tinit!,\n\tplugins: [Acme.plugin({})],\n})"}
				numbers={Bool.False}
			/>
			<p>A plugin is one value, a <code>Plugin.Value</code>, made by its package from its own options:</p>
			<ul>
				<li>
					<strong>No routes.</strong> Every URL is a file under the app's <code>routes/</code> (D-116). A
					package that answers requests offers handlers for the app's own route files
					(<code>{"respond! = |{ request, .. }| JobsPage.respond!(request, { mount: \"/admin/jobs\" })"}</code>),
					wherever the app puts them, behind that folder's middleware.
				</li>
				<li>
					<strong>Tables</strong> (migrations) are applied after the platform's and before the app's,
					recorded under the plugin's name; a plugin may list one per database flavor.
				</li>
				<li>
					<strong>Calls, loops, starts and checks</strong> get the app's context (from its
					<code>init!</code>) without knowing its type (<code>Plugin.Value(context)</code>).
				</li>
				<li>
					<strong>Needs</strong> the compiler can't check: an environment variable, a database (any, or
					Postgres or SQLite only), another plugin.
				</li>
				<li><strong>Files and scripts</strong>, below.</li>
			</ul>
			<p>
				At start, the server checks every plugin and stops on any problem, listing them all: two
				development pages at one method and path, a file at the root where the app has a route, two files
				at one place, a name used twice, a need not met. Then it names the plugins on one line of the log
				(what each added too, under <code>--debug</code>).
			</p>
			<p>
				A plugin package names the server platform in its header, as an app does; a second header,
				<code>browser.roc</code>, lists the modules the browser's copy of the app can compile too.
			</p>
			<p>
				<strong>A plugin's files</strong> are embedded at build (with an <code>import … : List(U8)</code>,
				below) and handed to the host at start. The host serves them before anything else, the app's middleware included, so a sign-in
				guard never blocks a service worker or script: at <code>{"/rocx/plugins/<plugin>/<path>"}</code>,
				or <code>{"/<path>"}</code> with <code>at: Root</code> (a service worker, whose scope is where it
				is), to <code>GET</code> and <code>HEAD</code>, with its content type and an ETag of its bytes (304
				when the browser has them). Every server-rendered page loads the files listed as
				<code>scripts</code>, as modules before <code>start.js</code>. Such a script can register browser
				effects that <code>Browser.call!</code> finds as <code>{"<plugin>.<effect>"}</code>; each gets
				<code>{"{ under }"}</code>, which puts a URL under the site's base path. The
				<a href={Paths.ecosystem_push}>push</a> plugin serves its service worker at the root and its script
				this way, and the <a href={Paths.ecosystem_audio}>audio</a> plugin its player.
			</p>
			<Code
				title="A plugin's files"
				source={"import \"static/push-sw.js\" as worker : List(U8)\nimport \"static/push.js\" as script : List(U8)\n\nfiles: [\n\t{ path: \"push-sw.js\", at: Root, content_type: \"text/javascript\", body: worker },\n\t{ path: \"push.js\", at: Plugin, content_type: \"text/javascript\", body: script },\n],\nscripts: [\"push.js\"],"}
				numbers={Bool.False}
			/>

			<Heading id="tcp">Sockets and randomness</Heading>
			<p>
				<code>Tcp.connect!</code> (or <code>connect_tls!</code>, or <code>start_tls!</code> on an open
				socket) opens a socket for the call. <code>write_bytes!</code>, <code>read_exactly!</code>,
				<code>read_up_to!</code> and <code>read_until!</code> pause the call while they wait;
				<code>close!</code> closes it, and the call's end closes any left open. TLS is rustls, checked
				against the web's certificate authorities. <code>Random.bytes!</code> and
				<code>Random.seed_u64!</code> are the OS's secure randomness
				(<a href={Paths.platform_crypto}>crypto</a>). The email package's SMTP client and
				<a href={"${Paths.platform_database}#roc-pg"}>roc-pg</a>, a Postgres client in Roc, are built on
				these.
			</p>

			<Heading id="limits">Not yet</Heading>
			<ul>
				<li><strong>HTTP/1.1 only, and no TLS:</strong> put the server behind a proxy that terminates TLS.</li>
				<li><strong>A stack overflow in Roc</strong> still ends the process (it says so first).</li>
				<li><strong>Photos' copies</strong> take a photo's colours as sRGB: one in a phone's wider colour space comes out slightly paler. No AVIF, no HEIC, no photos of other sites yet.</li>
			</ul>
			<Callout kind="note" title="Built on">
				<p>
					tokio and hyper (HTTP), corosensei (coroutines), tokio-postgres with deadpool, rusqlite with
					SQLite compiled in, turso_core (Turso's engine; a release has Postgres's and Turso's only if its
					program names them), image, fast_image_resize and libwebp (photos' copies, in a release whose
					markup writes an <code>enhanced:src</code>), chrono-tz (time zones), rustls with ring (TLS, random
					numbers, AES-GCM and P-256), and Roc's glue for the types the platform's header names
					(<code>just glue</code> writes <code>server/host/src/roc_platform_abi.rs</code>).
				</p>
			</Callout>
		</NoHydration>
	</>
