import pf.Html
import ../../../Ui/Heading
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Generated/Sources
import ../../../Generated/Paths
import ../../../Ui/PageHero

meta = {
	title: "Kv: values in memory",
	description: "Kv on the Roc Solid server platform: typed values kept by key in the server's memory, with a time to live and atomic operations (increment, add, take, capped lists), for rate limits, caches and one-time tokens.",
	toc: [
		{ id: "counting", label: "Counting: a rate limit" },
		{ id: "once", label: "Once: a sign-in's state" },
		{ id: "operations", label: "The operations" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="The platform · Kv"
				title="Values in memory, by key"
			>
				<code>Kv</code> keeps values by key in the server's memory, for as long as you say or until it stops:
				never written anywhere, so a restart forgets them. For what is cheap to lose and read on every
				request: a rate limit's counts, a cache, a one-time token. A value is any type JSON can write, read
				back as the type its reader asks for.
			</PageHero>

			<Heading id="counting">Counting: a rate limit</Heading>
			<Code title={"${Sources.platform_kv_limit.file}, in part"} source={Sources.platform_kv_limit.rocx} numbers={Bool.False} />
			<p>
				<code>Kv.increment!</code> counts every request, atomically. A new counter's time to live starts with
				it, so it counts in windows: here, a minute from an address's first try.
			</p>

			<Heading id="once">Once: a sign-in's state</Heading>
			<Code title={"${Sources.platform_kv_once.file}, in part"} source={Sources.platform_kv_once.rocx} numbers={Bool.False} />
			<p>
				<code>Kv.take!</code> gives a value once: the state another site sends back signs in one request, and
				a second use with the same state finds nothing.
			</p>

			<Heading id="operations">The operations</Heading>
			<ul>
				<li>
					<code>{"Kv.set!(key, value, { ttl_ms })"}</code> and <code>Kv.get!(key)</code>; <code>Kv.delete!(key)</code>.
					A time to live of 0, the default, keeps it until the server stops.
				</li>
				<li>
					Each operation is atomic: <code>Kv.increment!</code> counts, <code>Kv.add!</code> lets one request
					in (a claim, an idempotency key), <code>Kv.take!</code> gives a value once.
				</li>
				<li>
					<code>{"Kv.push!(key, value, { keep })"}</code> and <code>Kv.list!(key)</code>: a capped list, newest first.
				</li>
				<li>
					It holds 64 MiB (<code>--kv-max-mb</code>, or <code>KV_MAX_MB</code>); past that the least recently used values go. Keys name
					their owner first (<code>login:…</code>, <code>email:mailbox</code>), so a package's never meet an app's.
				</li>
			</ul>
			<p>
				What must outlive a restart is a table's (<a href={Paths.platform_database}>the database</a>) or an
				<a href={Paths.platform_actors}>actor</a>'s. Rooms, topics, channels, values in memory, actors, tables
				and jobs, side by side: <a href={"${Paths.platform_live}#which"}>which to use</a>.
			</p>
			<Callout kind="tip" title="Tested">
				<p>
					The platform's tests let a value expire, count 200 increments at once, cap a list, and go past the
					limit to see the least recently used values go.
				</p>
			</Callout>
		</NoHydration>
	</>
