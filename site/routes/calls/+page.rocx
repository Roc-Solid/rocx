import pf.Html
import ../../Demos/Echo
import ../../Demos/Shout
import ../../Ui/Heading
import ../../Ui/Callout
import ../../Ui/Code
import pf.Endpoint
import ../../Generated/Api
import ../../Generated/Sources
import ../../Generated/Paths
import ../../Ui/Note
import ../../Ui/PageHero
import ../../Ui/TableWrap
import ../../Ui/Demo
import ../../Ui/Trace
import ../../Ui/Who
import ../../Ui/Versus

## Talking to the server: endpoints, read where a page renders, sent from event handlers, posted to by
## forms, and followed live through their events and channels.
meta = {
	title: "Talking to the server",
	description: "How a Roc Solid page talks to its server: endpoints in a route's +server.roc, typed by Generated/Api; read! gets a page's data as the server renders it; handlers send endpoints, forms post to them, and pages follow events and channels live.",
	toc: [
		{ id: "reads", label: "A page's data: read!" },
		{ id: "how", label: "From the server's render to a click" },
		{ id: "problems", label: "When a read fails" },
		{ id: "user", label: "Who is asking" },
		{ id: "endpoints", label: "Endpoints: +server.roc" },
		{ id: "forms", label: "Forms: actions and submissions" },
		{ id: "events", label: "Events, as they happen" },
		{ id: "channels", label: "Channels: live data for a page" },
		{ id: "build", label: "What rocx build does" },
		{ id: "server-functions", label: "Coming from SolidStart" },
		{ id: "limits", label: "Limits, for now" },
	],
}

## The endpoints, as they answered: the page's endpoint (`GET /api/calls`, for JSON), which the
## server answers as it renders the page.
asked! : {} => { asked : List({ method : Str, path : Str, body : Str, status : U16, answer : Str }), shouted : Str }
asked! = |{}| Api.get_api_calls({}).read!()

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Talking to the server"
				title="One definition, the endpoint's"
			>
				A page talks to its server through endpoints: handlers for one HTTP method at one path, in a
				route's <code>+server.roc</code>, typed at both ends. The server answers a page's reads as it renders
				and sends the answers with the page. Event handlers send endpoints, forms post to them, and pages
				follow events and channels live. Other clients (another app, <code>curl</code>) get the same answers,
				behind the same middleware.
			</PageHero>

			<Heading id="reads">A page's data: read!</Heading>
			<p>
				Write a <code>get!</code> in a route's <code>+server.roc</code>, and read it in a component with
				<code>{"Api.get_….read!()"}</code>. <code>Api</code> is the module rocx writes, with a function per
				endpoint. The value is the handler's typed result, for a memo or straight in markup:
			</p>
			<Code title={Sources.endpoint_echo.file} source={Sources.endpoint_echo.rocx} />
			<Code title={"${Sources.calls_component.file}, in part"} source={Sources.calls_component.rocx} numbers={Bool.False} />
		</NoHydration>
		<Demo inspect="echo">
			<div data-demo="echo" data-flash="yes"><Echo /></div>
			<NoHydration>
				<Note>
					This component, live. Every answer came with the page, so a click asks nothing, even on this
					site's static copy.
				</Note>
			</NoHydration>
		</Demo>

		<NoHydration>
			<Heading id="how">From the server's render to a click</Heading>
			<Trace>
				<li>
					<Who kind="server">server</Who> The component runs as the server renders the page, and the memo
					reads <code>{"GET /api/echo/{message}"}</code> for each message. The server answers each read
					in-process, through the endpoint's route and middleware, with
					<code>accept: application/json</code> and the page's cookies and headers. A URL read twice is
					asked once.
				</li>
				<li>
					<Who kind="server">server</Who> The page goes out with the chosen answer in the
					<code>{"<output>"}</code>, and every answer in a script at its end, each under its URL
					(<code>GET /api/echo/hello</code>).
				</li>
				<li>
					<Who kind="browser">browser</Who> Hydrating, the browser runs the same component. The memo finds
					its answers in the page and asks nothing; the server's nodes are kept.
				</li>
				<li>
					<Who kind="browser">browser</Who> A click, <code>{"on:click={|| set_draft!(message)}"}</code>,
					writes the signal. The memo reruns and finds that message's answer, and the one text node showing
					it is patched. Nothing is asked.
				</li>
				<li>
					<Who kind="browser">browser</Who> A read whose answer isn't in the page GETs the endpoint's URL:
					a URL built from a signal (one an <code>{"<input>"}</code> writes, say), a read redone with
					<code>refresh!(memo!)</code>, and every read on the page after a submission's result. Meanwhile the
					memo keeps its last value and
					<a href={"${Paths.components}#pending"}><code>is_pending!(memo!)</code></a> is true;
					<code>{"<Loading>"}</code> waits only for first values. Answers may arrive in any order: the memo
					takes only the one for its latest ask.
				</li>
			</Trace>
			<Callout kind="tip" title="Put a page's data under api/, at the page's path">
				<p>
					<code>routes/api/members/+server.roc</code> answers <code>GET /api/members</code>, which the page
					at <code>/members</code> reads; each is behind its own <code>Middlewares.member</code> (both files
					below). To pass the page's query on,
					<code>{"Endpoint.with_query(Api.get_api({}), Router.location!({}).query)"}</code> reads
					<code>/api?weeks=1</code> for the page at <code>/?weeks=1</code>, and the handler reads
					<code>request.query</code>. A layout, or a component many pages show, reads an endpoint at a path
					of its own: this site's footer reads <code>GET /api/facts</code>.
				</p>
			</Callout>
			<Versus>
				<Code title={"${Sources.members_read.file}, in part"} source={Sources.members_read.rocx} numbers={Bool.False} />
				<Code title={Sources.endpoint_members.file} source={Sources.endpoint_members.rocx} />
			</Versus>

			<Heading id="problems">When a read fails</Heading>
			<p>
				An answer other than 200 fails the memo or hole that read it, and the nearest
				<a href={"${Paths.components}#waiting"}><code>{"<Errored>"}</code></a> shows its fallback, given why
				as text (<code>GET /api/notes/9: 404: Not found</code>) and a function that tries again. To handle a
				refusal yourself, use <code>{"Api.get_….send!({})"}</code> instead, which returns
				<code>Ok(result)</code> or <code>Err(problem)</code>. A problem is a <code>Server.Problem</code>:
			</p>
			<ul>
				<li><code>HttpErr(why)</code>: no answer came (the network, say);</li>
				<li>
					<code>Refused(status, why)</code>: the endpoint's or its middleware's refusal, or a 404 for a path
					the server doesn't have;
				</li>
				<li><code>BadAnswer(why)</code>: an answer of another type, from a server of another build.</li>
			</ul>
			<p>
				A refusal met during the server's render goes in the page too, so the browser fails in the same
				place without asking again.
			</p>
			<ul>
				<li>
					<strong>A redirect redirects the whole page.</strong> When a read's middleware redirects during the
					render (a signed-out visitor sent to sign in), the page answers with that redirect.
				</li>
				<li>
					<strong>A failure nothing catches shows the app's
					<a href={"${Paths.routing}#error"}>error page</a></strong> (<code>routes/+error.rocx</code>), with
					the refusal's status if it is a 4xx: an endpoint answering <code>NotFound</code> makes the page a
					404. A 5xx, or no answer, is a 500. When an <code>{"<Errored>"}</code> catches the failure, its
					fallback shows and the page is a 200, unless the fallback sets a status with
					<code>{"<HttpStatusCode>"}</code>.
				</li>
				<li>
					<strong>Guard the root layout's reads.</strong> They run for every page, with nothing above to
					catch a failure. Wrap the holes that read in an <code>{"<Errored>"}</code>, or one failure makes
					every page a 500.
				</li>
			</ul>

			<Heading id="user">Who is asking</Heading>
			<p>
				The server's GETs during a render carry the page's cookies and headers. So a handler works out who
				is asking from the request, whoever sent it, and never takes the browser's word for it. The bag on
				the <a href={"${Paths.components}#tree"}>components page</a> finds its owner this way:
			</p>
			<Versus>
				<Code title={"${Sources.bag_reader.file}, in part"} source={Sources.bag_reader.rocx} numbers={Bool.False} />
				<Code title={Sources.endpoint_reader.file} source={Sources.endpoint_reader.rocx} />
			</Versus>
			<p>
				What its directories' middleware hands on, such as who is signed in, is a handler's
				<code>context</code>: <code>{"get! = |{ context, .. }| Ok({ member: context.member })"}</code>
				(<a href={"${Paths.routing}#middleware"}>middleware</a>). A handler can use what only the server has
				(<a href={Paths.platform_database}>the database</a>, <a href={Paths.platform_kv}>Kv</a>, jobs,
				email), and none of it reaches the browser.
			</p>

			<Heading id="endpoints">Endpoints: +server.roc</Heading>
			<p>
				A route's <code>+server.roc</code> (<code>+server.rocx</code> if it has markup) answers HTTP methods
				at its path: <code>get!</code>, <code>post!</code>, <code>put!</code>, <code>patch!</code> and
				<code>delete!</code>. Each handler is given a record: the request, the path's params (strings, or
				the <a href={"${Paths.routing}#params"}>types its annotation gives them</a>), its middleware's
				<code>context</code> and, for a method with a body, the body, read as its annotated type. It answers
				<code>Ok(result)</code>, sent as JSON, or <code>Err(refusal)</code>, sent as a status and why. An
				<code>Endpoint.Refusal</code> is:
			</p>
			<ul>
				<li>
					<code>BadRequest(why)</code> (400), <code>Unauthorized</code> (401), <code>Forbidden</code> (403),
					<code>NotFound</code> (404), <code>Conflict(why)</code> (409) or <code>Status(code, why)</code>;
				</li>
				<li>
					<code>Json(code, json)</code>: a JSON body, sent as <code>application/json</code>, such as a form's
					issues (<code>Issues.refusal</code>);
				</li>
				<li><code>Answer(response)</code>: a response of its own in the result's place (JSON with a cookie).</li>
			</ul>
			<p>
				A handler whose answer is always its own (a redirect that sets a cookie, a file) is annotated
				<code>{"Try(Server.Response, Endpoint.Refusal)"}</code> and answers <code>Ok(response)</code>, sent as
				is. A route file may also name rules to read and check its body with
				(<a href={"${Paths.routing}#endpoints"}><code>post_body</code></a>); a body that fails them is refused
				before the handler runs.
			</p>
			<Code title={Sources.endpoint_shout.file} source={Sources.endpoint_shout.rocx} />
			<Code title={Sources.endpoint_shout_word.file} source={Sources.endpoint_shout_word.rocx} />
			<p>What they answered when this page's endpoint asked them during its render:</p>
			<TableWrap>
				<table class="http">
					<thead><tr><th>Request</th><th>Body</th><th>Status</th><th>Answer</th></tr></thead>
					<tbody>
						{...asked!({}).asked.map(|{ method, path, body, status, answer }|
							<tr>
								<td><code>{method} {path}</code></td>
								<td>{if (body.is_empty()) Html.text("none") else <code>{body}</code>}</td>
								<td class:refused={status != 200}>{status.to_str()}</td>
								<td><code>{answer}</code></td>
							</tr>
						)}
					</tbody>
				</table>
			</TableWrap>
			<p>
				The app calls them as functions. rocx writes <code>Generated/Api.roc</code>, the app's contract: for
				each endpoint, a function of the path's params (<code>{"{}"}</code> with none), typed by the
				handler's annotation. It holds the method, URL and types, nothing the handler does, so the browser
				gets it too and any module may import it: a component, a route, a job, an actor.
				<code>Generated/Handlers.roc</code>, the server's alone, binds each endpoint to its handler for the
				router (<code>Endpoint.bind</code> checks that the two agree):
			</p>
			<Versus>
				<Code title="Generated/Api.roc, both copies" source={Sources.endpoint_api.rocx} numbers={Bool.False} />
				<Code title="Generated/Handlers.roc, the server's" source={Sources.endpoint_handlers.rocx} numbers={Bool.False} />
			</Versus>
			<p>
				In the browser, an event handler (an <code>on:click</code>, say) sends any endpoint with
				<code>{"Api.….send!(arg)"}</code> and gets <code>Ok(result)</code> or <code>Err(problem)</code>. The
				handler pauses until the answer is in, then runs again; only that run's writes are kept. This
				component shouts the clicked word, <code>{"Api.get_api_shout_word({ word: word }).send!({})"}</code>. On this
				site's static copy, the three words' answers are files written at build time:
			</p>
		</NoHydration>
		<Demo inspect="shout" waiting="Nothing yet: shout a word.">
			<div data-demo="shout"><Shout /></div>
		</Demo>
		<NoHydration>
			<p>
				On the server, a handler sends the app's own endpoints the same way,
				<code>{"Endpoint.send!(endpoint, arg)"}</code>, answered in-process: no HTTP, but through the
				endpoint's route and middleware, with the request's headers (cookies, <code>authorization</code>).
				What guards an endpoint guards every way to it, an MCP tool's call too. This page's endpoint asked
				the shout endpoint this way: <strong>{asked!({}).shouted}</strong>.
			</p>
			<ul>
				<li>
					<strong>A path is a page or an endpoint.</strong> A page's endpoints live under
					<code>routes/api/</code>, at the page's path. A directory holding both still works: a browser's GET
					(accepting HTML) gets the page, anything else the endpoints, each answer saying
					<code>Vary: Accept</code>. An unanswered method is a 405 listing the answered ones
					(<code>Allow</code>).
				</li>
				<li>
					<strong>Behind middleware.</strong> A POST, PUT, PATCH or DELETE from another site's page (its
					<code>Origin</code> isn't this server) gets a 403, unless the app says
					<code>cross_site: Allowed</code>. Clients that aren't pages, such as <code>curl</code>, send no
					<code>Origin</code> and get through. A directory's <code>+middleware.roc</code> adds more around its
					routes (<a href={"${Paths.routing}#middleware"}>middleware</a>).
				</li>
				<li>
					<strong>Typed at both ends.</strong> Both copies of <code>Api</code> take their types from the
					handler's annotation, which <code>rocx build</code> requires. A component that sends the wrong body,
					or reads the answer as anything else, doesn't compile, and <code>rocx check</code> points at its
					line.
				</li>
				<li>
					<strong>JSON both ways.</strong> An <code>F64</code> goes as a number; NaN or an infinity, which
					JSON can't write, is a 500 that says so. A <code>Try</code> goes as its tag,
					<code>{"{\"Ok\":5}"}</code> or <code>{"{\"Err\":\"Empty\"}"}</code>, except two shapes:
					<code>{"Try(a, [Null])"}</code> is a value that may be <code>null</code>, and a record field's
					<code>{"Try(a, [Missing])"}</code> may be left out.
				</li>
			</ul>
			<details>
				<summary>The component: <code>{Sources.demo_shout.file}</code></summary>
				<Code title={Sources.demo_shout.file} source={Sources.demo_shout.rocx} />
			</details>

			<Heading id="forms">Forms: actions and submissions</Heading>
			<p>
				A form posts to an endpoint like any HTML form, and the endpoint reads the fields by its body's
				type. For <code>{"{ name : Str, count : U64, gift : Bool, toppings : List(Str) }"}</code>, a number
				is read from its text, an unticked box is <code>Bool.False</code>, and a name sent several times is a
				list. A missing or wrong field is a 400 that names it. JSON and forms read into the same typed
				record, so one endpoint takes both.
			</p>
			<p>
				What Solid Router calls an action is the endpoint here: it already has a URL, a method and types.
				<code>use_submission!(endpoint)</code>, in a component, is the latest submission to it: whether it is
				on its way, what was sent, and the result or refusal.
			</p>
			<Code
				title="A form that shows its refusal"
				source={"import pf.Router exposing [use_submission!]\n\njoin = Api.post_api_members_join({})\nsubmission = use_submission!(join)\n<form method=\"post\" action={Endpoint.url_of(join)}>\n\t<input name=\"name\" value={submission.field!(\"name\")} />\n\t<button disabled?={submission.pending!()}>Join</button>\n\t{match submission.error!() {\n\t\tOk(problem) => <p class=\"problem\">{Server.explain(problem)}</p>\n\t\tErr(_) => <></>\n\t}}\n</form>"}
				numbers={Bool.False}
			/>
			<ul>
				<li>
					<strong>With JavaScript</strong>, the runtime sends every form that posts to one of the app's
					endpoints with <code>fetch</code>, and the page stays. <code>pending!()</code> is true while the
					answer is on its way and, after a result, until the page's reads are read again, so the new data and
					the result show together. Then <code>result!()</code> is the result, or <code>error!()</code> the refusal
					(<code>{"Refused(409, \"…\")"}</code>) or why no answer came. <code>input!()</code> is what was
					sent, as the endpoint reads it. After a refusal, <code>field!(name)</code> gives back what was typed
					in a field; after a result it is <code>""</code>, and the form is emptied (unless it, or what is
					around it, says <code>data-rocx-keep</code>), so an add form isn't filled again. Only the latest
					submission counts; <code>clear!()</code>, in an event handler, forgets it. An endpoint's redirect
					(<code>{"Ok(Server.redirect(…))"}</code>, setting a cookie, say) sends the browser there. A form
					nothing on the page reads is answered as a plain form, followed in place: back to its page with
					the flash, or to the endpoint's redirect (D-118).
				</li>
				<li>
					<strong>Without JavaScript</strong> (before the runtime loads, or with it off), the form posts as
					forms always have. Instead of JSON or text, which the browser would show as a bare page, the endpoint sends
					the browser back to the form's page with a flash: where the form posted, what was typed, and the
					result or refusal. The server keeps the flash for a minute (a cookie holds its id) for the next page
					view to read once; a typed password is never sent back. There the submission is the flash, so the
					page shows the refusal and the typed field as it would with JavaScript, and hydrates as rendered.
					<code>{"Server.flash!({})"}</code> reads the flash as it came.
				</li>
				<li>
					<strong>The endpoint says where to go next, either way:</strong>
					<code>{"Ok(Server.redirect(…))"}</code>, its annotation answering <code>Server.Response</code>, as
					behind this site's <a href={Paths.members_join}>joining page</a> (which sets a cookie too).
				</li>
				<li>
					<strong>Without a form.</strong> <code>use_action!(endpoint)</code> (Solid Router's
					<code>useAction</code>) is a function an event handler calls with the endpoint's arg. Each call is a
					submission, sent as JSON once the handler is done; the handler doesn't wait for the answer.
				</li>
				<li>
					<strong>Every submission, and optimistic values.</strong> <code>use_submissions!(endpoint)</code>
					(<code>useSubmissions</code>) lists every submission to an endpoint, from forms or actions:
					<code>all!()</code>, <code>pending!()</code>, <code>pending_inputs!()</code>, <code>clear!(id)</code>
					and <code>retry!(id)</code>. An optimistic value is a memo of the endpoint's data with
					<code>pending_inputs!()</code> applied: see
					<a href={"${Paths.components}#actions"}>actions and optimistic values</a>, live on the components
					page.
				</li>
				<li>
					<strong>Files.</strong> A form with an <code>{"<input type=\"file\">"}</code>
					(<code>enctype="multipart/form-data"</code>) is sent as the browser sends it, with or without
					JavaScript. The endpoint reads a file's field as the file's name, and the file with
					<code>{"Server.file(request, \"photo\")"}</code>: its name, type and bytes, which
					<a href={Paths.ecosystem_storage}><code>{"Storage.put_upload!"}</code></a> can keep. An action whose
					arg holds the URL of a file the page has (dropped, pasted or picked) is sent the same way. A
					request's body, files included, is 16 MiB at most unless the server's <code>--max-body</code> says
					more; over that, the answer is a 413.
				</li>
			</ul>
			<p>Where Roc Solid differs from Solid Router here:</p>
			<ul>
				<li>
				A record has no getters, so a submission's fields are methods (<code>submission.pending!()</code>),
				and <code>input!()</code> is the endpoint's own type, not a <code>FormData</code>.
				</li>
				<li>
				The form's <code>action</code> is <code>Endpoint.url_of(endpoint)</code>: Roc can't turn an
				endpoint into a string by itself.
				</li>
				<li>
					Solid's <code>action.with</code> is <code>{"Endpoint.with_fields(endpoint, { id })"}</code>, which
					puts fields in the form's URL; an action binds its values with a closure instead.
				</li>
				<li>
					Revalidate keys are URLs, not query keys: the handler names which of the page's reads a result
					redoes with <code>{"Router.revalidate!([url])"}</code>, each a URL or its beginning.
				</li>
			</ul>

			<Heading id="events">Events, as they happen</Heading>
			<p>
				An answer is sent once it is whole. For what the server learns piece by piece (a job's progress, a
				feed, what others did), an endpoint can stream server-sent events instead: <code>events!</code> in a
				<code>+server.roc</code> answers a GET asking for events (<code>accept: text/event-stream</code>)
				with <code>Events</code>. This one sends each count from 1 to <code>params.to</code> with its
				square, 300 ms apart:
			</p>
			<Code title={Sources.endpoint_count.file} source={Sources.endpoint_count.rocx} />
			<ul>
				<li>
					<strong>A stream is a loop.</strong> <code>Events.stream</code> is given <code>send!</code>, to send
					an event, and <code>sleep!</code>, to wait some milliseconds; the stream ends when the loop returns.
					The server runs it as a call of its own, paused while it sleeps, so it holds up no other request.
					When the page goes, <code>send!</code> answers <code>Err(Gone)</code>, a sleep ends early, and
					<code>?</code> ends the loop. <code>Events.from_list(items, ms)</code> and <code>Events.map</code>
					make the simple ones.
				</li>
				<li>
					<strong>Each event is JSON</strong>, typed by <code>events!</code>'s annotation, sent as a
					<code>data:</code> line; an <code>end</code> event closes the stream, so the browser doesn't ask
					again. Anything may listen:
					<code>curl -N -H 'accept: text/event-stream' localhost:8080/api/count/3</code>.
				</li>
				<li>
					<strong>A component listens</strong> with <code>Endpoint.listen!(endpoint, heard!)</code>.
					<code>heard!</code> runs like a click's handler: with <code>Event(counted)</code> for each event,
					typed as the endpoint's events; then <code>Ended</code>; or <code>Failed(problem)</code>, a refusal
					being <code>Refused(status, why)</code>. Started from an
					<a href={"${Paths.components}#effects"}>effect</a> or an event handler, it listens until its
					component goes. When an event says an endpoint's data changed, <code>refresh!(memo!)</code> reads it
					again.
				</li>
				<li>
					<strong>Behind middleware, as any endpoint.</strong> A guard refuses a stream before the loop runs.
				</li>
			</ul>
			<Code title={"${Sources.demo_count.file}, in part"} source={Sources.demo_count_update.rocx} numbers={Bool.False} />
			<p>
				It isn't live here: this site's static copy is files and can't stream. With <code>just dev</code>,
				the <code>curl</code> above shows one.
			</p>
			<details>
				<summary>The component: <code>{Sources.demo_count.file}</code></summary>
				<Code title={Sources.demo_count.file} source={Sources.demo_count.rocx} />
			</details>

			<Heading id="channels">Channels: live data for a page</Heading>
			<p>
				Each <code>listen!</code> is its own stream, checked once as it starts. For data a page follows live
				(a board others edit, who is online), use a channel. A route's <code>+server.roc</code> defines one
				with <code>channel!</code>, a check that lets a subscriber in (<code>Channel.allow(who)</code>) or
				refuses it. Its annotation types what the server publishes and what pages may say. A lobby that lets
				everyone in, and a component that subscribes:
			</p>
			<Code title={Sources.channel_lobby.file} source={Sources.channel_lobby.rocx} />
			<Code title={"${Sources.demo_lobby.file}, in part"} source={Sources.demo_lobby.rocx} numbers={Bool.False} />
			<ul>
				<li>
					<strong>Subscribe from an effect.</strong> <code>Endpoint.subscribe!</code> hears the channel until
					the effect runs again or its component goes. <code>Endpoint.say!</code> sends to the server, where
					the route's <code>receive!</code> hears it.
				</li>
				<li>
					<strong>Publish from anywhere on the server</strong>: <code>Endpoint.publish!</code>, from a request,
					a job or an actor, reaches every page subscribed with the same params, in the order published.
				</li>
				<li>
					<strong>One stream a tab.</strong> A tab's subscriptions share one connection. Each channel's check
					runs again every 15 seconds, so someone who loses access stops hearing. A subscriber that may have
					missed something hears <code>Resync</code>, its cue to read its data again.
				</li>
			</ul>
			<p>
				The lobby is live on the <a href={"${Paths.platform_live}#channels"}>live and channels</a> page,
				with the rest: hooks, reconnecting, the latest value with each key.
			</p>

			<Heading id="build">What rocx build does</Heading>
			<Trace>
				<li>
					<p>
						<strong>It names each endpoint</strong> by its method and path, in <code>Generated/Api.roc</code>:
						<code>get_api_echo_message</code> for <code>get!</code> in
						<code>routes/api/echo/[message]/+server.roc</code>. It is a function of the path's params, so no URL
						is written twice and wrong params don't compile. Its type is copied from the handler's annotation
						(body and answer; a channel's <code>Channel(who, message, said)</code>), with the imports those
						types need and no route file. So a module a route imports (a store, a job, an actor) may import
						Api too, and publish on a channel by name. A module defining a type a route's annotation names
						can't import Api, since Api imports it: <code>rocx build</code> says so, and suggests moving the
						type to a module of its own.
					</p>
				</li>
				<li>
					<p>
						<strong>It routes them.</strong> <code>Generated/Routes.roc</code> gives each path's requests to
						its page or its endpoints (each with its handler from <code>Generated/Handlers.roc</code>), behind
						its folders' middleware. The server's GETs during a render go the same way.
					</p>
				</li>
				<li>
					<p>
						<strong>It leaves the handlers out of the browser's copy.</strong> The browser's app is built from
						a copy of the app rocx writes (<code>--client site/build/client</code>), with the same
						<code>Api</code> but no <code>Handlers</code> and no middleware: only the server runs those, and
						they may read the environment or the database.
					</p>
				</li>
			</Trace>

			<Heading id="server-functions">Coming from SolidStart</Heading>
			<p>
				SolidStart has server functions (<code>"use server"</code>): code the browser calls at a URL the
				framework picks. Roc Solid has none. A page's data is a <code>get!</code> endpoint at a URL you
				choose, read with <code>{"Api.get_…(params).read!()"}</code>, so the server's render, hydration,
				later reads, other clients and the OpenAPI document all meet one handler, behind one middleware.
				<code>rocx build</code> refuses <code>{"server!(…)"}</code> and says what to write instead.
			</p>

			<Heading id="limits">Limits, for now</Heading>
			<ul>
				<li>
					<strong>A page reads with GET.</strong> During a render, the server answers GETs of the app's own
					endpoints (a path, <code>/…</code>). A POST or another site's URL is for an event handler to send
					from the browser. For another server's data during a render, give the app an endpoint whose handler
					fetches it with <a href={"${Paths.platform_http}#out"}><code>Http.fetch!(url, init)</code></a>.
				</li>
				<li>
					<strong>Types must compile in the browser.</strong> A handler may use what only the server has, but
					the types it takes and answers must compile in the browser's copy: <code>rocx build</code> refuses a
					type from a module that imports <code>pf.Db</code>, at the route's line, naming the type and the
					module.
				</li>
				<li>
					<strong>A static copy of the site has no server.</strong> Its pages are files, and so are the
					answers the server gave at build time: each page's GETs, in the page, and the GETs its components
					send from event handlers (<code>just site</code> writes those). Any other read, a POST or a stream
					needs the server (<code>just dev</code>, or wherever the app runs).
					<a href="https://roc-solid.github.io/">roc-solid.github.io</a> is such a copy: this page's echo and
					shout work there, and a demo that sends or follows something (the planner's moves, the lobby's
					channel) says no server answers.
				</li>
				<li>
					<strong>Only the endpoints' handlers stay on the server.</strong> Anything else a component imports
					ships to the browser. The server must check each request itself.
				</li>
			</ul>
		</NoHydration>
	</>

<style>
	/* Requests, and what the server answered. */
	.http td code {
		white-space: nowrap;
	}

	.http td:nth-child(2) {
		color: var(--text-faint);
	}

	.http td.refused {
		color: var(--bad);
		font-weight: 600;
	}

	.http td:last-child code {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
