import pf.Html
import ../../Demos/Echo
import ../../Demos/Shout
import pf.Server
import ../../Ui/Heading
import ../../Ui/Callout
import ../../Ui/Code
import pf.Endpoint
import ../../Generated/Api
import ../../Generated/Sources
import ../../Generated/Paths
import ../../Ui/Note
import ../../Ui/PageHero
import ../../Ui/TableWrap
import ../../Ui/Demo
import ../../Ui/Trace
import ../../Ui/Who
import ../../Ui/Versus

## Talking to the server: server functions, endpoints, and the events an endpoint streams.
meta = {
	title: "Talking to the server",
	description: "rocx server functions, defined once and called as functions on both ends; endpoints, a route's +server.roc; and the events an endpoint streams, which a component listens to.",
	toc: [
		{ id: "one", label: "One definition" },
		{ id: "how", label: "From the server's render to a key" },
		{ id: "problems", label: "When it goes wrong" },
		{ id: "user", label: "Who is asking" },
		{ id: "endpoints", label: "Endpoints: +server.roc" },
		{ id: "events", label: "Events, as they happen" },
		{ id: "forms", label: "Forms: actions and submissions" },
		{ id: "build", label: "What rocx build does" },
		{ id: "limits", label: "Limits, for now" },
	],
}

## The endpoints, asked as anything over HTTP would ask them, and as the app asks them: a function,
## run here and now. A server function, so they are asked on the server, as the page renders.
asked! : {} => { asked : List({ method : Str, path : Str, body : Str, status : U16, answer : Str }), shouted : Str }
asked! = server!(
	|request, {}| {
		context : { facts : Str }
		context = Server.context!({})
		answered = |(method, path, body, answer)| { method, path, body, status: answer.status, answer: Server.body_text(answer) }
		asked = [
			("GET", "/api/shout/rocx", "", Endpoint.respond!(Api.get_api_shout_word({ word: "rocx" }), Server.from_host("/api/shout/rocx", ""), context)),
			("POST", "/api/shout", "\"hi\"", Endpoint.respond!(Api.post_api_shout({}), Server.from_http("POST", "/api/shout", "content-type: application/json", "\"hi\"".to_utf8()), context)),
			("POST", "/api/shout", "\"\"", Endpoint.respond!(Api.post_api_shout({}), Server.from_http("POST", "/api/shout", "content-type: application/json", "\"\"".to_utf8()), context)),
			("POST", "/api/shout", "{}", Endpoint.respond!(Api.post_api_shout({}), Server.from_http("POST", "/api/shout", "content-type: application/json", "{}".to_utf8()), context)),
		]
		shouted =
			match Endpoint.run!(Api.get_api_shout_word({ word: "rocx" }), request, context, {}) {
				Ok(word) => "${word.shouted}, ${word.bytes.to_str()} bytes"
				Err(_) => "(no answer)"
			}
		{ asked: asked.map(answered), shouted }
	},
)

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Talking to the server"
				title="Defined once, called from both ends"
			>
				A server function runs on the server and is written beside the component that calls it. The
				component calls it as a function, and gets the answer as a plain value: on the server that is a
				call, made as the page renders; in the browser, a request. The browser's download holds its name
				and nothing it does. When the server should answer at a URL of its own, a route's
				<code>+server.roc</code> is an endpoint, and it can stream events as they happen.
			</PageHero>

			<Heading id="one">One definition</Heading>
			<p>
				<code>server!(…)</code> takes the implementation, which gets the request it answers (its method, path,
				headers, cookies among them, and body) and the input; the type says what goes in and what comes out.
				Its route, <code>POST /rocx/call/Demos/Echo.echo</code>, runs it. Here, a signal a click writes, a memo
				that asks the server about each message there is, and another that reads the answer to the one
				picked.
			</p>
			<Code title={"${Sources.calls_component.file}, in part"} source={Sources.calls_component.rocx} numbers={Bool.False} />
		</NoHydration>
		<Demo inspect="echo">
			<div data-demo="echo" data-flash="yes"><Echo /></div>
			<NoHydration>
				<Note>
					This component, live. Every answer came with the page: the server said each message back as it
					rendered, so a click asks nothing, and works on a copy of this site that is only files.
				</Note>
			</NoHydration>
		</Demo>

		<NoHydration>
			<Heading id="how">From the server's render to a click</Heading>
			<Trace>
				<li>
					<Who kind="server">server</Who> The component runs, as the server renders the page. The
					memo calls <code>echo!</code> with each message: on the server that is <code>Server.local</code>,
					a call of the function's own route, <code>POST /rocx/call/Demos/Echo.echo</code>, which the server
					answers in-process, with the page's cookies. It is the browser's request, made without HTTP: the
					same middleware, the same answer, and nothing to wait for.
				</li>
				<li>
					<Who kind="server">server</Who> The page goes out with the picked message's answer in
					the <code>{"<output>"}</code>, and every answer the server functions gave in a script at its end.
				</li>
				<li>
					<Who kind="browser">browser</Who> Hydrating, the same component runs. The memo calls
					<code>echo!</code>, which in the browser's copy is <code>Server.remote</code>, a request; but its
					answer for each message is in the page, so it reads them there and asks nothing. The server's nodes
					are kept.
				</li>
				<li>
					<Who kind="browser">browser</Who> A click: <code>{"on:click={|| set_draft!(message!())}"}</code>
					writes the signal, the memo that reads it runs again and finds that message's answer among the
					others, and the one text that reads it is patched. Nothing is asked: every answer is a value
					already.
				</li>
				<li>
					<Who kind="browser">browser</Who> An input whose answer isn't in the page (a signal
					an <code>{"<input>"}</code> writes, say) is <code>POST /rocx/call/Demos/Echo.echo</code>, which the
					server answers (<code>just dev</code>). Until the answer is in, the memo keeps its last value, so
					what is shown stays; <code>{"<Loading>"}</code> only waits for first values. Answers may come back
					in any order: the memo only takes the one for what it asked last.
				</li>
			</Trace>
			<p>
				The request's input and answer are JSON, derived by Roc from the types (<code>Json.to_str</code>,
				<code>Json.parse</code>): calling it with anything but a <code>Str</code>, or expecting anything else
				back, doesn't compile. A handler may call one too, and use its answer: it waits, and runs again once
				the answer is in (<a href={"${Paths.components}#handlers"}>handlers</a>). <code>refresh!(memo!)</code>
				asks again for what a memo asked.
			</p>

			<Heading id="problems">When it goes wrong</Heading>
			<p>
				A call that can't be answered fails what made it: the memo, the hole, the handler. The nearest
				<code>{"<Errored>"}</code> shows its fallback, given why, and a handler that asks again. Why is one of
				<code>Server.Problem</code>: no answer (<code>HttpErr</code>), a refusal with its status
				(<code>Refused</code>: 404 for a function the server doesn't have, 400 for input it can't read, or
				what its middleware refused with), or an answer of another type (<code>BadAnswer</code>, from a server
				of another build). The server answers a call only with POST (405 otherwise), and this site's
				middleware refuses one that a page of another site sends (403). A call the server makes while it
				renders fails the same way: its route answered something other than 200, so the
				<code>{"<Errored>"}</code> shows its status and text (<code>401: members only</code>), and the answer
				isn't put in the page. A call its middleware answers with a redirect (a signed-out visitor sent to
				sign in) makes the whole page that redirect, as SolidStart answers one thrown while it renders. A
				layout's server functions answer every page's visitors, behind the app's default middleware: nothing
				is above the root layout to catch a failure there, so it puts an <code>{"<Errored>"}</code> around the
				holes that call the server, or the page is a 500.
			</p>

			<Heading id="user">Who is asking</Heading>
			<p>
				A server function is given the request it answers: its call, <code>POST /rocx/call/…</code>, with
				the cookies of the page that made it, whether the browser sent it or the server made it while it
				rendered. So it reads who is asking from the cookies the browser sent, and never takes the browser's
				word for it. The bag on the <a href={"${Paths.components}#islands"}>components page</a> says whose
				bag it is this way:
			</p>
			<Code title={"${Sources.bag_reader.file}, in part"} source={Sources.bag_reader.rocx} numbers={Bool.False} />
			<p>
				Its route runs behind middleware: the app's default, around every request, and, for a function a
				route file defines, that file's own <code>middleware</code>, as its page and endpoints do. What the
				middleware handed on (who is signed in, say) is <code>{"Server.context!({})"}</code>, read as the
				type the body reads it as: <code>{"Server.context!({}).member"}</code>. A function that never reads
				it reads nothing. Only a server function's body has a context: read anywhere else, in a component or
				in the browser, it crashes. So does one that reads what its middleware doesn't hand on (a
				<code>member</code> no middleware in front of it adds): the server answers 500, and its log names the
				function.
			</p>
			<p>
				On the server platform, its body may use what only the server has: <code>Db</code>,
				<code>Job</code>, <code>Email</code> (<a href={Paths.platform_postgres}>Postgres</a>). The browser's copy
				of the module has none of it: the body is gone, and so are the imports only the body used.
			</p>

			<Heading id="endpoints">Endpoints: +server.roc</Heading>
			<p>
				A server function has no URL: rocx names it, and only the app calls it. When something else should
				call the server (another app, <code>curl</code>, a cache on the way), give it a path. A route's
				<code>+server.roc</code> (plain Roc; <code>+server.rocx</code> too, if it has markup) answers HTTP
				methods there: <code>get!</code>, <code>post!</code>, <code>put!</code>, <code>patch!</code> and
				<code>delete!</code>, each given the request, the path's params and, with a body, the body, read as
				JSON. It answers <code>Ok(result)</code>, sent as JSON, or a refusal, sent as its status
				(<code>Endpoint.Refusal</code>: <code>BadRequest(why)</code> is a 400).
			</p>
			<Code title={Sources.endpoint_shout.file} source={Sources.endpoint_shout.rocx} />
			<Code title={Sources.endpoint_shout_word.file} source={Sources.endpoint_shout_word.rocx} />
			<p>Over HTTP, anything may ask them. What they answered as this page rendered:</p>
			<TableWrap>
				<table class="http">
					<thead><tr><th>Request</th><th>Body</th><th>Status</th><th>Answer</th></tr></thead>
					<tbody>
						{...asked!({}).asked.map(|{ method, path, body, status, answer }|
							<tr>
								<td><code>{method} {path}</code></td>
								<td>{=if (body.is_empty()) Html.text("none") else <code>{body}</code>}</td>
								<td class:refused={status != 200}>{status.to_str()}</td>
								<td><code>{answer}</code></td>
							</tr>
						)}
					</tbody>
				</table>
			</TableWrap>
			<p>
				The app asks them as functions. rocx writes <code>Generated/Api.roc</code> from the routes: a function
				for each endpoint, of its params (<code>{"{}"}</code> with none). On the server it runs the handler
				there and then; in the browser's copy it is the method and the URL, and nothing the handler does:
			</p>
			<Versus>
				<Code title="On the server" source={Sources.endpoint_api.rocx} numbers={Bool.False} />
				<Code title="In the browser's copy" source={Sources.endpoint_api_browser.rocx} numbers={Bool.False} />
			</Versus>
			<p>
				This component asks the other one from a handler, for the word clicked,
				<code>{"Endpoint.send!(Api.get_api_shout_word({ word: word }), {}, Call.fetch!)"}</code>, and shows the
				answer, or why there is none. On a copy of this site that is only files, these three words' answers
				are files, which the server wrote as the site was built:
			</p>
		</NoHydration>
		<Demo inspect="shout" waiting="Nothing yet: shout a word.">
			<div data-demo="shout"><Shout /></div>
		</Demo>
		<NoHydration>
			<p>
				And this page asked it as it rendered, <code>{"Endpoint.run!(Api.get_api_shout_word({ word: \"rocx\" }), request, context, {})"}</code>,
				with no request: <strong>{asked!({}).shouted}</strong>.
			</p>
			<ul>
				<li>
					<strong>A page and endpoints at one path.</strong> A GET a browser sends (one that accepts HTML)
					is the page's; every other request is the endpoints'. A method nothing there answers is a 405,
					saying which are (<code>Allow</code>).
				</li>
				<li>
					<strong>Behind middleware.</strong> This site's default middleware refuses a POST, PUT, PATCH or
					DELETE that a page of another site sends (its <code>Origin</code> isn't this server) with a 403,
					and a call to a server function too; a client that isn't a page (<code>curl</code>) sends no
					<code>Origin</code>. A route file may name more (<code>middleware = Middlewares.member</code>):
					see <a href={"${Paths.routing}#middleware"}>middleware</a>.
				</li>
				<li>
					<strong>Typed at both ends.</strong> The browser's copy can't hold the handler, so its types come
					from where the component uses it; the same component is built for the server too, against the
					handler, so a mismatch doesn't compile there.
				</li>
			</ul>
			<details>
				<summary>The component: <code>{Sources.demo_shout.file}</code></summary>
				<Code title={Sources.demo_shout.file} source={Sources.demo_shout.rocx} />
			</details>

			<Heading id="events">Events, as they happen</Heading>
			<p>
				An answer is sent once it is whole. For what the server learns a piece at a time (a job's
				progress, a feed, what others did), an endpoint can stream events instead, as it makes them
				(server-sent events). <code>events!</code> in a <code>+server.roc</code> answers a GET that asks for
				them (<code>accept: text/event-stream</code>) with <code>Events</code>: here, the counts from 1 to
				<code>params.to</code>, each with its square, 300 ms apart:
			</p>
			<Code title={Sources.endpoint_count.file} source={Sources.endpoint_count.rocx} />
			<ul>
				<li>
					<strong>A stream is a loop.</strong> <code>Events.stream</code> is given <code>send!</code>, which
					sends an event, and <code>sleep!</code>, which waits so many milliseconds; it sends, sleeps and goes
					round again, and the stream ends when it returns. The server runs it on a thread of its own, so
					its sleeps hold up no other request. When the page goes, <code>send!</code> says so
					(<code>Err(Gone)</code>), a sleep ends early, and <code>?</code> ends the loop.
					<code>Events.from_list(items, ms)</code> and <code>Events.map</code> make the simple ones.
				</li>
				<li>
					<strong>Each event is JSON</strong>, of the type <code>events!</code> says, on the wire as a
					<code>data:</code> line; an <code>end</code> event says it is over, so a page doesn't ask again.
					Anything may listen: <code>curl -N -H 'accept: text/event-stream' localhost:8080/api/count/3</code>.
				</li>
				<li>
					<strong>A component listens</strong> from a handler, with <code>Endpoint.listen!</code>: each event
					runs the handler it is given, as a click would, with the event, of the endpoint's type
					(<code>Event(counted)</code>), then <code>Ended</code>, or <code>Failed</code> with why (a refusal
					is a <code>Refused</code>, with its status). Started in an
					<a href={"${Paths.components}#effects"}>effect</a>, it listens while the component is there (again
					when what the effect read changes) and stops when it goes.
				</li>
				<li>
					<strong>Behind middleware, as any endpoint.</strong> A guard refuses a stream as it refuses
					anything else, before the loop runs.
				</li>
			</ul>
			<Code title={"${Sources.demo_count.file}, in part"} source={Sources.demo_count_update.rocx} numbers={Bool.False} />
			<p>
				Its Start asks for a stream: each count is a row as the server sends it, and the component says
				when the server stopped sending (it ended the stream, and <code>Ended</code> came); Start again asks
				for a new one. It isn't live on this page, because a copy of this site as files can't stream: a host
				of files answers nothing with <code>text/event-stream</code>. With <code>just dev</code>, the
				<code>curl</code> above shows one.
			</p>
			<details>
				<summary>The component: <code>{Sources.demo_count.file}</code></summary>
				<Code title={Sources.demo_count.file} source={Sources.demo_count.rocx} />
			</details>

			<Heading id="forms">Forms: actions and submissions</Heading>
			<p>
				A form posts to an endpoint as any form posts: the endpoint reads its fields as a record of strings
				(<code>{"{ name : Str }"}</code>), and answers. Solid Router calls that an action, and
				<code>useSubmission</code> says how the latest one went. Here the endpoint is the action: it has a
				URL, a method and types already. <code>use_submission!(endpoint)</code>, in a component, is its
				latest submission: whether it is on its way, what was typed, and the endpoint's result or its
				refusal.
			</p>
			<Code
				title="rocx"
				source={"import pf.Router exposing [use_submission!]\n\njoin = Api.post_members_join({})\nsubmission = use_submission!(join)\n<form method=\"post\" action={Endpoint.url_of(join)}>\n\t<input name=\"name\" value={submission.field!(\"name\")} />\n\t<button disabled?={submission.pending!()}>Join</button>\n\t<Show when!={submission.error!()}>{|problem!| <p class=\"problem\">{Server.explain(problem!())}</p>}</Show>\n</form>"}
				numbers={Bool.False}
			/>
			<ul>
				<li>
					<strong>With the runtime</strong>, a form posting to the endpoint of a submission a component reads
					is sent with <code>fetch</code>, and the page stays. <code>pending!()</code> holds until the answer
					is in; then <code>result!()</code> is the endpoint's result, or <code>error!()</code> its refusal
					(<code>Refused(409, "…")</code>), or why there was no answer. <code>input!()</code> is what was sent,
					as the endpoint reads it, and <code>field!(name)</code> one field. The latest submission is the one
					that counts; <code>clear!()</code>, in a handler, forgets it. A redirect of the endpoint's own
					(<code>Err(Answer(Server.redirect(…)))</code>, setting a cookie, say) sends the browser there.
				</li>
				<li>
					<strong>Without it</strong> (before it loads, or with JavaScript off), the form posts, and a page of
					JSON or of text would come back. Instead the endpoint sends the browser back to the page the form
					was on, with a flash: a cookie of a minute holding where it posted, what was typed, and the result
					or the refusal. That page's submission is the flash, so it shows the refusal, with what was typed
					in its field, as it would have with the runtime, and the browser hydrates it as the server
					rendered it. The next page view lets it go. <code>{"Server.flash!({})"}</code> reads it as it came.
				</li>
				<li>
					<strong>A redirect is the endpoint's to answer, either way.</strong> An endpoint whose forms should
					go somewhere when they succeed answers <code>Err(Answer(Server.redirect(…)))</code>, as the endpoint
					behind this site's <a href={Paths.members_join}>joining page</a> does (it sets a cookie too).
				</li>
				<li>
					<strong>Where it differs from Solid:</strong> a record has no getters, so the fields are methods;
					the form's <code>action</code> is the endpoint's URL (<code>Endpoint.url_of</code>), since Roc can't
					turn an endpoint into a string by itself; <code>input!()</code> is the endpoint's own type, not a
					<code>FormData</code>. There is no <code>useSubmissions</code>, <code>useAction</code> or
					<code>.with</code> yet.
				</li>
			</ul>

			<Heading id="build">What rocx build does</Heading>
			<Trace>
				<li>
					<p><strong>Names it</strong> after its module and definition, <code>Demos/Echo.echo</code>, so no name is written twice:</p>
					<Code title={Sources.echo_generated.file} source={Sources.echo_generated.rocx} numbers={Bool.False} />
				</li>
				<li>
					<p>
						<strong>Routes it.</strong> <code>Generated/ServerFunctions.roc</code> answers each function's
						calls, and <code>Generated/Routes.roc</code> gives it every <code>POST /rocx/call/…</code> (any
						other method is a 405), past the app's default middleware and, for a function a route file
						defines, that file's. <code>Server.serve!</code> reads the input, tells the host which function
						it is serving and with what context, and answers with the function's answer as JSON.
					</p>
					<Code title={Sources.server_functions.file} source={Sources.server_functions.rocx} />
				</li>
				<li>
					<p>
						<strong>Leaves what it does out of the browser's copy.</strong> The browser's app is built from a
						copy of the site rocx writes (<code>--client site/build/client</code>), in which a server
						function is its name and nothing else, and a route file has no <code>middleware</code> (only the
						server runs it, and it may read the environment or the database); the lines stay, empty, and so
						do the lines of imports only those used:
					</p>
					<Code title={Sources.echo_browser.file} source={Sources.echo_browser.rocx} numbers={Bool.False} />
					<p>
						Leaving it out of the source is what makes this sure: an optimized build would drop a function
						nothing calls, but Roc's dev backend, which <code>just dev</code> uses, compiles it anyway.
					</p>
				</li>
			</Trace>

			<Heading id="limits">Limits, for now</Heading>
			<Callout kind="note" title="A working prototype">
				<p>The pieces are tested together, on the server and in a browser. Some are plainly missing.</p>
			</Callout>
			<ul>
				<li>
					<strong>A server function: one input, one answer, both JSON.</strong> Always a POST; no batching,
					streaming or retries, and its answer can't set a cookie. An endpoint can do the last two: it may
					answer a response of its own (<code>Err(Answer(…))</code>, a redirect setting a cookie), and stream
					events (<code>events!</code>).
				</li>
				<li>
					<strong>A form the runtime sends is URL-encoded.</strong> A form with files
					(<code>multipart/form-data</code>) posts as the browser posts it, and an endpoint reads its body
					itself.
				</li>
				<li>
					<strong>Its types are the browser's too.</strong> Its body may use what only the server has, but
					what goes in and comes out must be types the browser's copy knows.
				</li>
				<li>
					<strong>Its input and answer are JSON.</strong> An <code>F64</code> goes as a number, and one JSON
					can't write (NaN, an infinity) is a 500 that says so. The builtin <code>Try</code> has no JSON encoder
					or parser on this Roc, so rocx refuses a server function whose annotation takes or answers one, at its
					line, with the tag union to write instead: <code>{"[Ok(Str), Err([NotFound])]"}</code>, which a
					<code>match</code> reads as it reads a <code>Try</code>.
				</li>
				<li>
					<strong>A static copy of the site has no server.</strong> Its pages are files, and so are the answers
					the server gave as it was built: the server functions' answers in each page, the GETs its islands
					make (<code>just site</code> writes them). A call it didn't answer then, a POST, a stream: those
					need the server, <code>just dev</code> or wherever the server's app runs. This site's demos need
					none: <a href="https://roc-solid.github.io/">roc-solid.github.io</a> is such a copy, files on GitHub Pages, and
					every demo works there.
				</li>
				<li>
					<strong>Only server functions leave the browser's copy.</strong> Anything else a component imports
					ships, as a component's code always does; and the server must check what a call asks for itself.
				</li>
			</ul>
		</NoHydration>
	</>

<style>
	/* Requests, and what the server answered. */
	.http td code {
		white-space: nowrap;
	}

	.http td:nth-child(2) {
		color: var(--text-faint);
	}

	.http td.refused {
		color: var(--bad);
		font-weight: 600;
	}

