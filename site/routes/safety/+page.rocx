import pf.Html
import ../../Demos/EscapeLab
import ../../Ui/Heading
import ../../Ui/Callout
import ../../Ui/Code
import ../../Generated/Sources
import ../../Generated/Paths
import ../../Ui/PageHero
import ../../Ui/TableWrap
import ../../Ui/Feature
import ../../Ui/FeatureGrid
import ../../Ui/Demo
import ../../Ui/UrlChecks
import ../../Ui/Refusals

meta = {
	title: "Safety",
	description: "How rocx keeps data out of markup: an opaque Html type, escaping, names checked in hand-written markup, safe URLs, refused attributes, handlers that are never script, a same-origin check for requests, and rocx lint.",
	toc: [
		{ id: "opaque", label: "Html is opaque" },
		{ id: "names", label: "Names in hand-written Roc" },
		{ id: "lab", label: "Try to break it" },
		{ id: "urls", label: "URLs" },
		{ id: "refused", label: "What the build refuses" },
		{ id: "handlers", label: "Handlers aren't script" },
		{ id: "origin", label: "Requests from other sites" },
		{ id: "lint", label: "rocx lint" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Safety"
				title="Data can't become markup"
			>
				Cross-site scripting is data (a name, a comment, a URL) landing in a page as markup or script. In
				rocx a value is always text, so a page's only markup is what its <code>.rocx</code> files contain:
				there is no escaping to remember.
			</PageHero>

			<Heading id="opaque">Html is opaque</Heading>
			<p>
				Markup is the platform's <code>Html</code> type; outside its module, no string can become markup.
				Every value goes through one of these doors:
			</p>
			<FeatureGrid>
				<Feature title="Text and attributes">
					<p>
						Escaped: <code>{"< > & \" '"}</code> come out as entities, in text and in attribute
						values.
					</p>
				</Feature>
				<Feature title="URLs">
					<p>
						<code>href</code>, <code>src</code>, <code>action</code>, <code>formaction</code>,
						<code>poster</code> and <code>cite</code> take only <a href="#urls">safe URLs</a>.
					</p>
				</Feature>
				<Feature title="Styles">
					<p>
						A <code>style:color</code> or <code>style:--size</code> value is dropped if it could end the
						declaration or calls a function that loads something (<code>url(…)</code>).
					</p>
				</Feature>
				<Feature title="Tags and script">
					<p>
						Tags, attribute names and the text of <code>{"<script>"}</code> and <code>{"<style>"}</code> come
						only from the file, never from a value.
					</p>
				</Feature>
			</FeatureGrid>
			<Heading id="names">Names in hand-written Roc</Heading>
			<p>
				Plain Roc can build markup with <code>Html.element</code>, <code>Html.void</code> and
				<code>Html.attr</code> (and <code>Html.optional</code>, <code>Html.flag</code> and their computed
				forms), where a tag or attribute name is a <code>Str</code> that could come from data. Text and
				values are escaped as in a file, and every renderer (the server's, the browser's,
				<code>Html.to_str</code>) leaves out a name that isn't plain:
			</p>
			<ul>
				<li>
					<strong>A tag</strong> is an ASCII letter, then letters, digits and <code>-</code>
					(<code>p</code>, <code>h2</code>, <code>linearGradient</code>, <code>acme-card</code>).
					<code>img src=x onerror=…</code> isn't, so that element and its contents are left out.
				</li>
				<li>
					<strong>An attribute</strong> is an ASCII letter, then letters, digits, <code>-</code>,
					<code>_</code>, <code>.</code> and <code>:</code> (<code>data-id</code>, <code>aria-label</code>,
					<code>xml:lang</code>, <code>viewBox</code>), never starting with <code>on</code>: an inline
					handler (<code>onclick</code>) runs script, while Roc's is <code>on:click</code>
					(<a href="#handlers">below</a>). The element is written without a bad one.
				</li>
				<li>
					<strong>A <code>{"<script>"}</code></strong> is written only as a <code>.rocx</code> file has
					it, with its text as written there (<code>Html.source_text</code>, which
					<a href="#lint"><code>rocx lint</code></a> refuses in hand-written Roc). One built from text, a
					hole, or only a <code>src</code> is left out.
				</li>
			</ul>
			<p>
				A bad name never fails a page; it is left out, and reported. The server logs
				<code>rocx server: markup named what a page can't have, which wasn't written</code> with the
				page's <code>path</code> and the <code>names</code>, once per render; the browser warns on the
				console, once per name. <code>.rocx</code> files are unaffected: their names come from the file,
				and the build refuses inline handlers there.
			</p>

			<Heading id="lab">Try to break it</Heading>
			<p>
				This component renders <code>{"<a href={url} title={text}>{text}</a>"}</code> with whatever you
				type, twice: as <code>Html.to_str</code> writes it, as the server would (compiled to WebAssembly
				here), and live, where the runtime sets holes as text and attributes, never markup.
			</p>
		</NoHydration>
		<Demo><div data-demo="escape-lab"><EscapeLab /></div></Demo>

		<NoHydration>
			<Heading id="urls">URLs</Heading>
			<p>
				A URL attribute takes a relative URL or an <code>http</code>, <code>https</code>,
				<code>mailto</code> or <code>tel</code> one; anything else becomes
				<code>about:invalid#rocx-unsafe-url</code>. Tabs, line breaks and leading spaces in a scheme are
				dropped first, since browsers ignore them (<code>{"java\\tscript:"}</code> runs). In a picture's URL
				(<code>{"<img src>"}</code>, <code>{"<link href>"}</code>, <code>{"<source src>"}</code>,
				<code>{"<video poster>"}</code>), <code>data:image/…</code> passes too, SVG included: a picture runs
				no script.
			</p>
			<p>
				The check runs in the platform's <code>Html</code> module, in Roc, whenever a value becomes an
				attribute, so the server's markup and the browser's patches agree. What this page rendered for
				these values in an <code>href</code>:
			</p>
			<TableWrap>
				<UrlChecks urls={urls} />
			</TableWrap>

			<Heading id="refused">What the build refuses</Heading>
			<p>
				Some markup is refused before the compiler sees it, at its line and column. rocx's messages, from
				this page's build:
			</p>
			<TableWrap>
				<Refusals refusals={Sources.refusals} />
			</TableWrap>

			<Heading id="handlers">Handlers aren't script</Heading>
			<p>
				<code>onclick="…"</code> is refused: it is script in an attribute. A component's
				<code>{"on:click={…}"}</code> is a Roc function, which the server renders nothing for and the browser
				never sees as text. The runtime builds elements with <code>createElement</code> and sets text and
				attributes directly, never parsing markup, so a value can't become a tag. A handler inside a
				<code>{"<NoHydration>"}</code>, which is never hydrated, is refused at its line.
			</p>
			<Callout kind="note" title="What the server sends the browser is data too">
				<p>
					The page's endpoint answers travel at its end as JSON, in a
					<code>{"<script type=\"application/json\">"}</code>, every <code>{"<"}</code> written as
					<code>\u003c</code> so no answer can end the script. The runtime parses them; nothing runs them.
				</p>
			</Callout>

			<Heading id="origin">Requests from other sites</Heading>
			<p>
				Another site's page can make a visitor's browser send your app a request with its cookies (a form
				that posts, a script that fetches). So the platform answers 403 to a POST, PUT, PATCH or DELETE to
				an <a href={"${Paths.calls}#endpoints"}>endpoint</a> whose <code>Origin</code> isn't your server.
				Clients that aren't pages (<code>curl</code>, another server) send no <code>Origin</code> and are
				answered; a GET changes nothing and is answered whoever asks.
			</p>
			<p>
				The check runs on every request, before the app's
				<a href={"${Paths.routing}#middleware"}>middleware</a>, unless <code>App.program</code> says
				<code>cross_site: Allowed</code> (an API other sites' pages call, with CORS); then
				<code>{"Middleware.same_origin({})"}</code> in a directory's <code>+middleware.roc</code> puts it
				back where needed. Cookies from <code>Server.with_cookie</code> are <code>HttpOnly</code> (no script
				reads them) and <code>SameSite=Lax</code> (another site's form doesn't send them).
			</p>

			<Heading id="lint">rocx lint</Heading>
			<p>
				<code>Html.source_text</code> is how rocx writes a <code>{"<script>"}</code>'s or
				<code>{"<style>"}</code>'s text from the file. In hand-written Roc it would put any string in a page
				as markup, so <code>rocx lint</code> refuses it there. Run it in CI beside <code>rocx check</code>
				(<a href={"${Paths.tooling}#commands"}>tooling</a>).
			</p>
			<Code source={"$ rocx lint app\n✗ app/Sneaky.roc:1: Html.source_text puts text in a page as markup; only rocx may write it"} numbers={Bool.False} plain />
		</NoHydration>
	</>

## URLs to render, as the table shows them.
urls : List({ shown : Str, url : Str })
urls = [
	{ shown: "/syntax#holes", url: "/syntax#holes" },
	{ shown: "https://roc-lang.org", url: "https://roc-lang.org" },
	{ shown: "mailto:ada@example.com", url: "mailto:ada@example.com" },
	{ shown: "javascript:alert(1)", url: "javascript:alert(1)" },
	{ shown: " JavaScript:alert(1)", url: " JavaScript:alert(1)" },
	{ shown: "java\\tscript:alert(1)", url: "java\tscript:alert(1)" },
	{ shown: "data:text/html,<b>hi</b>", url: "data:text/html,<b>hi</b>" },
]
