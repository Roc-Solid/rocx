import pf.Html
import ../../Ui/Heading
import ../../Ui/Callout
import ../../Ui/Code
import ../../Generated/Sources
import ../../Generated/Paths
import ../../Ui/PageHero
import ../../Ui/TableWrap

meta = {
	title: "Tooling",
	description: "The rocx command: new, dev, build (a release, an image, a static copy), generate, check (an app, its SQL, a command's reports), test, lint, routes, fmt, agents, render, qr and upgrade; compiler errors reported at your .rocx lines; editor support; stories; how an app is built for production.",
	toc: [
		{ id: "commands", label: "Commands" },
		{ id: "errors", label: "Errors at your lines" },
		{ id: "editors", label: "In an editor" },
		{ id: "stories", label: "Stories" },
		{ id: "setup", label: "Building an app yourself" },
		{ id: "repository", label: "This repository" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				eyebrow="Tooling"
				title="A few commands, and the compiler you already have"
			>
				<code>rocx</code> turns markup into Roc, builds and serves your app as you edit, and points the
				Roc compiler's reports at your <code>.rocx</code> lines. It is written in Roc, and lives in
				<code>~/.rocx/bin</code> once installed, or at <code>bin/rocx</code> in a clone of the repository.
			</PageHero>

			<Heading id="commands">Commands</Heading>
			<p>
				<code>dir</code> is an app's folder (the one with <code>routes/</code>), the current one by
				default. <code>rocx</code> or <code>rocx --help</code> lists the commands; <code>rocx help build</code>
				or <code>rocx build --help</code> shows one command's options. At a terminal, each build step
				shows a <code>✓</code> and its time; in a pipe, in CI or with <code>NO_COLOR</code> set, the
				output is plain text.
			</p>
			<div class="commands">
				<div class="command">
					<p class="command-usage">rocx new {"[dir]"}<span>--db sqlite|postgres|turso</span></p>
					<p>
						Makes an app from rocx's template in <code>dir</code>, which must be empty or new (asked for
						at a terminal). People sign in with the <a href={Paths.ecosystem_auth}>auth package</a> (an
						email link; Google and GitHub once their keys are set; any address under
						<code>rocx dev</code>; two-factor for those who turn it on), into the app's own users table.
						Other sites' posts are refused, guard's security headers are on, and sign-in mail is rate
						limited. The database is SQLite unless you pick another (it asks at a terminal).
						<code>.rocx-version</code> names the app's rocx version (commit it); <code>.rocx</code> is the
						link the app's header reaches the platform and packages through (gitignore it). From a clone
						of the repository, <code>.rocx</code> links to the clone and there is no
						<code>.rocx-version</code>. It also writes <code>AGENTS.md</code> and <code>CLAUDE.md</code>
						(<a href="#agents">rocx agents</a>). The app's <code>README.md</code> says what to change
						first.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx dev {"[dir]"}<span>--port 8080</span><span>--opt dev|size|speed</span><span>--android {"[--lan]"}</span><span>-- {"<server options>"}</span></p>
					<div>
						<p>
							Serves the app at <code>http://localhost:8080</code> in development mode. Each save rebuilds
							it, restarts the server and reloads open pages. A failing build's errors show at their
							<code>.rocx</code> lines while the last good build keeps running. The first run writes the
							smallest <code>main.roc</code> if there is none. Each start also checks the app's SQL
							(<code>rocx check --sql</code>). At a terminal it opens with the app's address and database,
							and the server lists the places to open under it (the stories, the mailbox, the sign-in
							page, the OpenAPI page).
						</p>
						<p>
							The port is <code>--port</code>, else <code>PORT</code>, else 8080. Options after
							<code>--</code> go to the server (<code>--database-url postgres://…</code>), which also reads
							its environment (<code>DATABASE_URL</code>). A <code>.env</code> in the folder you run it in
							(<code>SMTP_URL=…</code> lines) goes to the server and its SQL check as
							<code>--env-file .env</code>; the environment wins. Development mode adds the
							<a href="#stories">stories</a> (<code>/__rocx/stories</code>), plugins' development pages
							(the email package's <a href={"${Paths.ecosystem_email}#mailbox"}>mailbox</a>) and crash
							messages in 500 answers.
						</p>
						<p>
							Builds use Roc's fast-compiling development backend (<code>--opt dev</code>: seconds).
							<code>--opt size</code> or <code>--opt speed</code> builds both programs as a release does,
							to try what ships.
						</p>
						<p>
							<code>--android</code> also builds for Android: it installs a development client on an
							emulator or a USB-connected phone, and reloads it on each save. <code>--lan</code> also
							serves the app on your network and prints a QR code for a phone on the same Wi-Fi. This
							needs the Android SDK and NDK; the <a href={Paths.examples_pomodoro}>pomodoro</a> example
							runs this way.
						</p>
					</div>
				</div>
				<div class="command">
					<p class="command-usage">rocx build {"[dir]"}<span>--out dist</span><span>--target arm64musl</span><span>--opt speed|size|dev</span></p>
					<p>
						Builds the app to deploy: <code>dist/server</code>, optimized for speed, and
						<code>dist/static</code>, the app's <code>static/</code> and the browser's files (wasm
						optimized for size). Run <code>dist/server --static dist/static</code> behind a TLS proxy
						(Caddy, say). <code>--target</code> is <code>arm64mac</code>, <code>x64mac</code>, or
						<code>arm64musl</code> or <code>x64musl</code> (static Linux executables for a container).
						<code>--opt</code> builds both programs at one level. The server has only the database engine
						the program names (SQLite if none); a Linux build has no debug info. The build replaces
						<code>dist</code> (or <code>--out</code>) only when complete; that folder must be empty or an
						earlier build (with a <code>server</code>).
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx build {"[dir]"} --image<span>--out {"<name>.tar"}</span><span>--tag name:tag</span></p>
					<p>
						The release as a container image, which rocx writes itself: no Dockerfile, no Docker. The
						server is a static Linux executable with its TLS roots inside, so the image has no base and
						one layer: <code>/app/server</code>, <code>/app/static</code>, a user to run as (65532),
						<code>/tmp</code>, and <code>/app/data</code> for a volume (a SQLite app's
						<code>data/app.db</code>). It runs in <code>/app</code> on <code>PORT</code> 8080. The output is
						an OCI image tar, <code>{"<name>.tar"}</code> after the app's folder (or <code>--out</code>),
						for <code>docker load -i</code> or podman. <code>--tag</code> defaults to the folder's name,
						<code>:latest</code>; <code>--target</code> is <code>arm64musl</code> or <code>x64musl</code>
						(default: this machine's processor). <code>--opt</code> works as above. Settings are
						environment variables (<code>docker run -e PUBLIC_URL=…</code>).
					</p>
				</div>
				<div class="command" id="static">
					<p class="command-usage">rocx build {"[dir]"} --static<span>--out dist</span><span>--base /path/</span><span>--route {"<path>"}</span><span>--built {"<build>"}</span><span>-- {"<server options>"}</span></p>
					<div>
						<p>
							Writes the app as static files into <code>dist/</code> (or <code>--out</code>) for a host
							with no server: GitHub Pages, a CDN, any web server. It builds for production, runs the
							server on a free port, and saves <code>/</code>, every page whose path has no params, and
							every page they link to, each as <code>{"<path>/index.html"}</code>. Beside them go
							<code>404.html</code> (for paths nothing answers), the app's <code>static/</code>, and
							<code>rocx/</code> (the runtime and the wasm). Each page carries the answers to its reads, so
							its data needs no server. This site is built this way.
						</p>
						<p>
							<code>--base</code> puts every URL under a path (<code>--base /docs/</code> for
							<code>example.github.io/docs/</code>). <code>--route</code> adds a path no page links to: a
							page with params (<code>/blog/hello</code>) or an endpoint's answer as a file
							(<code>/feed.xml</code>). <code>--built</code> uses a build you made (its
							<code>server</code> and <code>client/static</code>). The copy replaces its folder only when
							complete; the folder must be empty or an earlier copy.
						</p>
						<p>
							The build lists what only a server can answer, which the copy leaves out: methods that write
							(<code>post!</code>), events and channels, pages behind a directory's middleware (it runs per
							request), pages with params no link or <code>--route</code> reached, and links to paths that
							answered an error.
						</p>
					</div>
				</div>
				<div class="command">
					<p class="command-usage">rocx generate {"[dir]…"}<span>--client {"<out>"}</span><span>--dev</span></p>
					<div>
						<p>
							Only the code generation <code>rocx build</code> and <code>rocx dev</code> start with, for
							editors and scripts. Each <code>.rocx</code> file under the folders becomes a
							<code>.roc</code> file beside it, its markup as calls to the platform's <code>Html</code>.
							For an app it also writes <code>Generated/</code>: <code>Routes.roc</code> (the router),
							<code>Paths.roc</code> (typed links), <code>Api.roc</code> and <code>Handlers.roc</code> (the
							endpoints' contract and handlers), <code>Styles.roc</code> (the stylesheet),
							<code>App.roc</code> (which <code>main.roc</code> completes), <code>Root.roc</code> for an app
							with pages (the page at the browser's path, in its layouts), and route files' own Roc.
							Packages' components are copied into <code>{"Generated/<package>/"}</code>, and each folder
							under <code>content/</code> becomes <code>{"Generated/Content/<Name>.roc"}</code>, listing its
							Markdown files.
						</p>
						<p>
							<code>--client</code> also writes the browser's copy of the app into
							<code>{"<out>"}</code>: endpoints without their handlers (method, URL and types kept),
							<code>{"<NoHydration>"}</code>s without children, and only the imports still used. For an app
							with pages, it adds the browser's <code>main.roc</code> and <code>static/rocx/</code>:
							<code>start.js</code>, the runtime, and the stylesheet named by its content
							(<code>styles-<var>hash</var>.css</code>). The runtime is minified (about half the size with
							brotli), except in a <code>--dev</code> build. A build to deploy (<code>rocx build</code>, with
							or without <code>--image</code> or <code>--static</code>) ships only the runtime code the app's
							wasm and pages reach:
							in-place navigation only for an app of several pages (or one that navigates), and drags,
							pointer positions and glides only where its markup has them. An app of endpoints alone has no
							browser program, and the build says so. When the browser's copy reaches a module that
							imports something server-only (<code>pf.Db</code>, directly or not), the build warns at the
							page's or component's import, before the browser's build fails far from it.
						</p>
						<p><code>--dev</code> also builds the <a href="#stories">stories</a> and their catalog.</p>
					</div>
				</div>
				<div class="command">
					<p class="command-usage">rocx check {"[dir]"}</p>
					<p>
						Builds the app from its sources (never an older build's files) as <code>rocx dev</code> does,
						then type-checks the server's program and, for an app with pages, the browser's. Each problem
						shows at its <code>.rocx</code> line. Exits 0 when clean, 1 on an error, 2 on warnings only,
						rocx's own included: a <code>match</code> arm's value or a list row's item given to a
						component that reads it once (<a href={"${Paths.components}#control"}>if, match and .map</a>).
						Needs a <code>main.roc</code>. Run it in CI.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx test {"[dir]"}</p>
					<p>
						Builds the app as <code>rocx check</code> does, then runs its <code>expect</code>s with rocx's
						compiler, each failure at its <code>.rocx</code> line. Exits 1 if one fails.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx check -- {"<command>"}</p>
					<p>
						Runs a command (<code>roc check</code>, <code>roc build</code>, <code>just check</code>) and
						points the compiler reports it prints at the <code>.rocx</code> files
						(<a href="#errors">errors at your lines</a>). Exits with the command's code.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx check --sql {"[dir]"}<span>--engine sqlite|turso</span><span>--verbose</span><span>-- {"<server options>"}</span></p>
					<div>
						<p>
							Checks the app's SQL with its own database engine, and its row types with the compiler.
							Each string statement at a <code>Db.all!</code>, <code>Db.one!</code> or
							<code>Db.run!</code> is prepared on a scratch database built from the migrations: a
							temporary file for SQLite or Turso, or a database created, then dropped, on the Postgres
							server <code>--database-url</code> (or <code>DATABASE_URL</code>) names. It reports SQL the
							engine refuses, parameters that don't match their statement and row types that don't fit,
							at their lines, and exits 1 (<a href={"${Paths.platform_database}#checked"}>how it
							works</a>).
						</p>
						<p>
							<code>--engine</code> checks a SQLite app on Turso, or a Turso app on SQLite.
							<code>--verbose</code> also lists the calls it couldn't check, such as SQL built at run
							time. It reads no <code>.env</code> by itself: <code>-- --env-file .env</code> gives it
							one.
						</p>
					</div>
				</div>
				<div class="command">
					<p class="command-usage">rocx lint {"<dir>…"}</p>
					<p>
						Refuses <code>Html.source_text</code> in hand-written <code>.roc</code> files under the
						folders: it puts any string in a page as markup (<a href={"${Paths.safety}#lint"}>why</a>).
						Mentions in comments or strings don't count. Exits 1 if a file calls it.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx routes {"[dir]"}<span>--server</span><span>--client</span></p>
					<p>
						Lists an app's routes: each method and path, and the middleware around it, outermost first
						(<a href={"${Paths.routing}#middleware"}>what runs, in what order</a>). <code>--server</code>
						lists only the endpoints; <code>--client</code> only the pages (the error page too).
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx fmt {"<path>…"}<span>--check</span></p>
					<p>
						Formats the Roc in each <code>.rocx</code> file, and each <code>.roc</code> file rocx didn't
						write, under the paths, with <code>roc fmt</code>: rocx's compiler (an installed version's, a
						clone's <code>.tools/roc-active</code>, else the one <code>ROC</code> names), else the
						<code>roc</code> on your <code>PATH</code>. Markup and the Roc in its holes stay as written:
						markup moves only with the code around it, and <code>{"<pre>"}</code> or
						<code>{"<textarea>"}</code> text never moves. <code>--check</code> lists unformatted files, and
						exits 1 if there are any.
					</p>
				</div>
				<div class="command" id="render">
					<p class="command-usage">rocx render {"<url>"}<span>-o out.mp4</span><span>-o out.webm</span><span>-o frames/</span><span>--player n|label</span><span>--scale 2</span><span>--from n --to n</span><span>--crf 18</span></p>
					<div>
						<p>
							Films the video on the page at <code>url</code> (the
							<a href={Paths.ecosystem_video}>video package</a>'s <code>{"<Player>"}</code>) a frame at a
							time in Chromium's headless shell. Each frame is the same however long it took to draw, so
							two renders are the same. ffmpeg writes <code>.mp4</code> (H.264) and <code>.webm</code>
							(VP9); a folder (ending in <code>/</code>) gets the frames as PNGs. Without
							<code>-o</code>, it writes <code>video.mp4</code>.
						</p>
						<p>
							<code>--player</code> picks the page's player by its index from 0 or its
							<code>aria-label</code> (the first by default). <code>--scale</code> is device pixels to a
							CSS pixel (2: a 1280-wide video is 2560). <code>--from</code> and <code>--to</code> film a
							stretch, by frame. <code>--crf</code> is H.264's quality (lower is better and bigger).
							Chromium is <code>$CHROME</code>, else Playwright's headless shell; ffmpeg is
							<code>$FFMPEG</code>, the one on your <code>PATH</code>, or Nix's. The
							<a href="#stories">stories' catalog</a> copies this command for a story.
						</p>
					</div>
				</div>
				<div class="command">
					<p class="command-usage">rocx qr {"<text>"}<span>--pbm</span></p>
					<p>
						Prints the text as a QR code in the terminal (as <code>rocx dev --android --lan</code> does),
						or as a PBM image with <code>--pbm</code>. A code holds at most 2,331 bytes.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx upgrade {"[version]"}</p>
					<p>
						Installs rocx (the latest, or the version you name) into <code>~/.rocx</code> as the default.
						In an app, it also moves the app's <code>.rocx-version</code> and <code>.rocx</code> link to
						it. Every command on an app runs the version the app names, installing it if needed, so a team
						shares one version through the repository. A rocx from Nix leaves upgrading to Nix.
					</p>
				</div>
				<div class="command" id="agents">
					<p class="command-usage">rocx agents {"[dir]"}<span>--force</span></p>
					<p>
						Writes rocx's rules for coding agents into the app's <code>AGENTS.md</code>, as a block
						between two markers, and a <code>CLAUDE.md</code> that imports it if there is none. The block
						points at <code>.rocx/agents/guide.md</code>, the guide for the app's rocx version. Run it again
						after an upgrade: it rewrites only the block, so the app's own notes stay. It refuses an edited
						block without <code>--force</code>. <code>rocx check</code> says when the block is from
						another version. <code>rocx new</code> writes both files.
					</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx help {"[command]"}</p>
					<p>The commands, or one command's usage and options (<code>rocx {"<command>"} --help</code> too).</p>
				</div>
				<div class="command">
					<p class="command-usage">rocx --version</p>
					<p>
						Which rocx this is (an installed version's number, or a clone's commit), then the Roc
						compiler it runs and where it is.
					</p>
				</div>
			</div>
			<p>
				Code generation (<code>rocx generate</code>, and the first step of <code>rocx dev</code>,
				<code>rocx check</code> and <code>rocx build</code>) writes a file only when its content changes,
				so watchers don't loop. It deletes the <code>.roc</code> files it wrote whose <code>.rocx</code>
				file is gone, and stops at the first markup problem, with its line and column. Generated files end with a
				<code># rocx: generated from …</code> line. Keep them out of version control: ignore
				<code>Generated/</code>, <code>build/</code> and the <code>.roc</code> files beside your
				<code>.rocx</code> files.
			</p>
			<p><code>rocx routes</code> on the <a href={Paths.examples_hello}>hello</a> example:</p>
			<Code
				source={"$ rocx routes examples/hello\nMETHOD  PATH    MIDDLEWARE (outermost first)\nGET     /       -\nGET     /hello  -"}
				numbers={Bool.False}
				plain
			/>

			<Heading id="errors">Errors at your lines</Heading>
			<p>
				Markup mistakes (an unclosed tag, an attribute rocx refuses) are rocx's: it reports each at its
				line and column, with a caret, and stops. The rest are the Roc compiler's.
				Line <var>N</var> of a generated file is line <var>N</var> of yours, so its reports already name
				your line. <code>rocx check</code> and <code>rocx dev</code> also rewrite the location, quote your
				line, and move the caret onto your code. A route file's Roc (<code>+server.roc</code>) is reported
				at its lines too.
			</p>
			<p>A file with a type mistake:</p>
			<Code title="Posts.rocx" source={Sources.check_source} />
			<p>and what <code>rocx check -- roc check Posts.roc</code> printed for it when this page was built:</p>
			<div class="report"><Code title="The compiler, through rocx check" source={Sources.check_report} numbers={Bool.False} plain /></div>
			<Callout kind="tip" title="Reading a report">
				<p>
					Fix the mistake in your <code>.rocx</code> file: the generated <code>.roc</code> file is
					written again on the next build.
				</p>
			</Callout>

			<Heading id="editors">In an editor</Heading>
			<p>
				The repository's <code>editors/</code> folder has a grammar for <code>.rocx</code> files. It
				colours Roc (by the official Roc grammar), markup (tags, a component's tag as a type, attributes
				like <code>class:active</code> and <code>on:click.prevent</code>), the Roc in holes and markup
				inside it, and CSS in a <code>{"<style>"}</code>. Its one guess: a <code>{"<"}</code> before a
				letter starts markup, unless a value comes right before it. So <code>{"a <b"}</code> (a comparison
				with a space before <code>{"<"}</code> and none after) is coloured as markup.
			</p>
			<p>
				<strong>VS Code</strong>: <code>just vscode-extension</code> installs the extension for every
				workspace (it needs <code>code</code> on your <code>PATH</code>, and Node). Besides highlighting,
				it adds a task type: <em>Terminal → Run Task… → rocx</em> lists <code>dev</code> (runs
				<code>rocx dev</code> in its own terminal) and <code>check</code> (runs <code>rocx check</code>
				once) for each app. Their reports show at the <code>.rocx</code> line and in the Problems panel
				until the next run. A task of your own in <code>.vscode/tasks.json</code> runs any command the same
				way (<code>{"{ \"type\": \"rocx\", \"command\": \"just check\" }"}</code>). There is no language
				server yet: the editor shows what the build reports.
			</p>
			<p>
				<strong>Orca</strong>: <code>just orca-plugin</code> installs a plugin that highlights
				<code>.rocx</code> and <code>.roc</code> files. It runs nothing, so it needs no access. Orca
				plugins can't show errors: use <code>rocx check</code>.
			</p>

			<Heading id="stories">Stories</Heading>
			<p>
				A component's stories are the ways it looks, written beside it, as in Storybook. Each
				<code>{"<story name=\"…\">"}</code> among the component's definitions holds one story's markup.
				rocx makes each a definition (<code>story_tip!</code> for <code>{"<story name=\"Tip\">"}</code>),
				so every build checks it against the component. Only a development build has them:
				<code>rocx dev</code> serves a catalog at <code>/__rocx/stories</code> (<code>rocx generate
				--dev</code> writes them into the code).
			</p>
			<Code title={Sources.ui_callout.file} source={Sources.ui_callout.rocx} />
			<p>The catalog lists every story in a sidebar:</p>
			<ul>
				<li>
					<kbd>S</kbd> folds the sidebar, <kbd>/</kbd> searches it, and <kbd>↑</kbd> and <kbd>↓</kbd>
					step through it. Its parts and components fold, and its edge drags wider.
				</li>
				<li>
					The story you pick shows in a frame, with the line it is written at. <kbd>F</kbd> fills the
					window with it; <kbd>Esc</kbd> comes back.
				</li>
				<li>A component's name shows all its stories side by side.</li>
				<li>
					The pin beside a story (<kbd>P</kbd>) picks it to compare, from any component, and
					"Compare … side by side" (<kbd>C</kbd>) opens the picked ones together.
				</li>
				<li>
					A story with a <a href={Paths.ecosystem_video}>video</a> in it gets a transport: play and pause
					(<kbd>Space</kbd>), a frame at a time (<kbd>←</kbd> and <kbd>→</kbd>), a scrubber, a speed and
					looping. Every video shown follows it, so videos side by side play in step. Render copies the
					command that films them (<a href="#render">rocx render</a>).
				</li>
				<li>
					A dot marks a story the browser hasn't shown yet, and its component and part: <kbd>N</kbd>
					opens the next, and searching for <code>new</code> lists them.
				</li>
				<li>The browser remembers what it has seen, what is folded, what is picked and the width.</li>
			</ul>
			<p>
				Each story is the app's page at its own path (<code>/__rocx/stories/…</code>), rendered in the root
				layout and hydrated, so it works as in the app. A layout can tell a story by its path (this site
				shows one with nothing around it). An app with no pages can't show stories, so they are an error
				there.
			</p>
			<p>
				An app's <code>stories/</code> folder holds modules of stories only: drafts, each a component with
				its own <code>{"<style>"}</code>, side by side in the catalog. Only a development build compiles
				it, so none of it is published, styles included. This site's <code>site/stories/Landing.rocx</code>
				has the front page as it is, and drafts of it in six themes.
			</p>

			<Heading id="setup">Building an app yourself</Heading>
			<p>
				An app is two programs (<a href={Paths.platform_}>the platform</a>): the server's, native code in a
				Rust host, and the browser's, the same pages in WebAssembly. <code>rocx dev</code> builds both
				(<a href={"${Paths.root}#start"}>getting started</a>); <code>rocx build</code> builds them to
				ship (below). The server's program, <code>Generated/App.roc</code>, is rocx's: every
				request goes through the app's middleware (<code>routes/+middleware.roc</code>) to the router,
				where every URL is a file. The app's <code>main.roc</code> says only what rocx can't know:
			</p>
			<Code
				title="main.roc"
				source={"app [program] { pf: platform \"./.rocx/server/platform/main.roc\" }\n\nimport Generated/App\n\nprogram = App.program({\n\tinit!: |_started| Ok({}),\n})"}
			/>
			<ul>
				<li><code>init!</code> makes the app's context once, at start; every request's middleware gets it.</li>
				<li>
					Middleware isn't here: a <code>+middleware.roc</code> under <code>routes/</code> runs around its
					directory's routes, <code>routes/+middleware.roc</code> around every request
					(<a href={"${Paths.routing}#middleware"}>middleware</a>). Before it, changes sent from other
					sites' pages are refused (<a href={"${Paths.safety}#origin"}>why</a>) unless the app says
					<code>cross_site: Allowed</code>.
				</li>
				<li>
					It may also say <code>database</code> (<code>Sqlite("data/app.db")</code> unless it says
					<code>Postgres</code>, <code>Sqlite(path)</code> or <code>Turso(path)</code>),
					<code>plugins</code> (what packages add: tables, jobs, loops, scripts; never a route) and
					<code>links</code> (places of the app's that <code>rocx dev</code> lists as it starts).
				</li>
			</ul>
			<p>
				rocx writes the browser's program too (<code>rocx generate --client</code>): its root is the page
				at the browser's path, which the browser hydrates. This site's:
			</p>
			<Code title={Sources.client_app.file} source={Sources.client_app.rocx} />
			<p>
				For a release, <code>rocx build</code> compiles the browser's wasm with
				<code>--opt=size --specialize=yes</code> (and again with <code>--specialize=no</code> if the
				compiler crashes on it), and the server's program and host into one executable with
				<code>--opt=speed</code>, with what it serves beside it. Its <code>--target</code> works from
				a Mac too (<a href={"${Paths.platform_server}#deploying"}>deploying</a>). The executable takes its
				port, database and the rest as flags or environment variables
				(<a href={"${Paths.platform_server}#running"}>running it</a>).
			</p>
			<Code source={"rocx build --target arm64musl\ndist/server --port 8080 --static dist/static"} numbers={Bool.False} plain />
			<p>
				The server is built with boxy lowering (<code>--specialize=no</code>) by default. With Roc's
				default, lambda-set specialization, the function that renders pages gets a stack frame that grows
				with the app, and a large app's could outgrow its stack. Boxy lowering renders about as fast and
				builds much faster; <code>ROCX_SPECIALIZE=yes</code> opts back in. Specializing the browser's
				wasm makes it smaller with brotli, and faster.
			</p>
			<p>
				Both platforms have requests, routes, endpoints, events and middleware (<code>pf.Server</code>,
				<code>pf.Endpoint</code>, <code>pf.Middleware</code>, <code>pf.Events</code>,
				<code>pf.OpenApi</code>) and the modules components are written with, so a component compiles on
				both. The database, the key-value store, channels, live rooms and actors are the server
				platform's alone; jobs, cron and email are packages for it (<a href={Paths.ecosystem}>the
				ecosystem</a>).
			</p>

			<Heading id="repository">This repository</Heading>
			<TableWrap>
				<table>
					<thead><tr><th>Where</th><th>What</th></tr></thead>
					<tbody>
						<tr><td><code>rocx-cli/</code></td><td>rocx, in Roc: the transpiler and every command (<code>just dev</code>'s loop too), built into <code>bin/rocx</code></td></tr>
						<tr><td><code>cli/</code></td><td>the command-line platform rocx is built on (a Rust host): files, commands, a watched directory tree, signals, a WebSocket, and one wait for whichever comes first</td></tr>
						<tr><td><code>agents/</code></td><td>rocx's rules for coding agents: the block <code>rocx agents</code> writes into an app's <code>AGENTS.md</code>, and the guide it points at</td></tr>
						<tr><td><code>web/</code></td><td>the browser's platform: its Roc modules (with those both platforms share: components', requests, endpoints, events, middleware), the Rust host (built for wasm32), and the JavaScript runtime</td></tr>
						<tr><td><code>server/</code></td><td>the server's platform: its Roc modules, the Rust host, and the build</td></tr>
						<tr><td><code>packages/</code>, <code>examples/</code></td><td>the <a href={Paths.ecosystem}>ecosystem</a>'s packages, and complete <a href={Paths.examples}>example apps</a></td></tr>
						<tr><td><code>site/</code></td><td>this site, in rocx (pages in <code>routes/</code>): <code>just dev</code> serves it as you edit, <code>site/build.mjs</code> (<code>just site</code>) builds it static</td></tr>
						<tr><td><code>templates/</code></td><td>the app <code>rocx new</code> copies, and its tests</td></tr>
						<tr><td><code>release/</code></td><td>a release of rocx: what is built per target, the archives, the install script and its test</td></tr>
						<tr><td><code>editors/</code></td><td>the <code>.rocx</code> grammar, the VS Code extension and the Orca plugin</td></tr>
						<tr><td><code>test/</code>, <code>web/test/</code>, <code>site/test/</code>, <code>server/test/</code></td><td>the transpiler and CLI, the browser's platform, the site in a real browser, the server's platform</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				To work on Roc Solid itself, clone the repository and run <code>just setup</code>. It uses your
				system's Zig 0.17.1 and Rust 1.85 or newer (from Nix, say), else downloads them into
				<code>.tools/</code>, and adds Rust's <code>wasm32-unknown-unknown</code> target (for the browser's
				host) with <code>rustup</code>. Roc is a fork of Roc's main, at a pinned commit, with the compiler
				fixes Roc Solid needs: <code>just setup</code> builds it from a clone of the fork if there is one,
				else downloads it prebuilt from the repository's releases (macOS on Apple silicon, Linux on arm64
				or x86_64). Scripts use that compiler, never the <code>roc</code> on your <code>PATH</code>. Only
				the repository's checks and tests, the site's build and the VS Code extension need Node; rocx and
				your apps don't. CI runs <code>just check</code>, <code>just site</code>, the three parts of
				<code>just test</code> and <code>just examples</code> on every push to master and every pull
				request, on GitHub's Linux runners on arm64.
			</p>
			<Code
				source={"just setup   # the Roc fork, the pinned nightly, Zig and Rust if need be, into .tools/; then bin/rocx\njust db      # a Postgres in Docker, for the server platform (prints its DATABASE_URL)\njust test    # everything: the transpiler, both platforms, the packages, rocx new's template, the site in Chromium\njust check   # formatting, no package copied by hand, lint, and the site's and examples' type checks\njust dev     # this site, rendered per request, rebuilt and reloaded on save\njust site    # the static site, in site/dist"}
				numbers={Bool.False}
			/>
			<p>
				<code>bin/rocx</code> also has commands for the repository's scripts: <code>rocx site dev</code>
				and <code>rocx site prepare</code> (this site), <code>rocx self-build</code> (rebuilds
				<code>bin/rocx</code> when its Roc changed) and <code>rocx internal</code> (the tests' calls into
				rocx's functions).
			</p>
		</NoHydration>
	</>

<style>
	/* The commands, a card each: how it is written, and what it does. */
	.commands {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-4) 0;
	}

	.command {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}

	.command-usage {
		margin: 0;
		color: var(--accent);
		font: 600 var(--size-sm) / 1.6 var(--mono);
	}

	.command-usage span {
		display: block;
		color: var(--text-muted);
		font-weight: 400;
	}

	.command p:not(.command-usage) {
		margin: 0;
		color: var(--text-muted);
		font-size: var(--size-sm);
	}

	.command p:not(.command-usage) + p {
		margin-top: var(--space-2);
	}

	/* The compiler's report, as it prints it: its lines aren't wrapped. */
	.report :global(pre) {
		white-space: pre;
	}

	@media (max-width: 52rem) {
		.command {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
