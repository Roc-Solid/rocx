import pf.Html
import pf.Endpoint
import pf.Server
import pf.Router exposing [use_submission!]
import ../../../Generated/Api
import ../../../Ui/PageHero
import ../../../Ui/Button

## The joining page: its directory's middleware (`Middlewares.visitor`) sends a member on to the
## members' page instead. Its form
## posts to the page's endpoint, which the runtime sends with fetch (D-095); a refusal (a name of
## spaces) shows under it, with what was typed, from its submission: the runtime's, or without
## JavaScript the flash.
meta = {
	title: "Join",
	description: "Join the members with a name: a form that posts to a typed endpoint.",
	toc: [],
}

view! = |_| {
	join = Api.post_api_members_join({})
	submission = use_submission!(join)
	<>
		<NoHydration>
			<PageHero
				eyebrow="Members"
				title="Join"
			>
				Members see a page you can't see yet. Pick a name: the form posts it to an endpoint,
				<code>POST /api/members/join</code>, which sets a <code>member</code> cookie and sends you on to the
				members' page. It is a plain HTML form, so it works without JavaScript too.
			</PageHero>
		</NoHydration>
		<form class="join" method="post" action={Endpoint.url_of(join)}>
			<input type="text" name="name" placeholder="A name" aria-label="Your name" value={submission.field!("name")} required />
			<Button submit primary>Join</Button>
		</form>
		{match submission.error!() {
			Ok(problem) => <p class="problem" role="alert">{Server.explain(problem)}</p>
			Err(_) => <></>
		}}
	</>
}

<style>
	/* A name, and the button that sends it. */
	.join {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		max-width: 28rem;
		margin-top: var(--space-6);
	}

	.join input {
		flex: 1;
		min-width: 12rem;
	}

	/* Why the endpoint refused it. */
	.problem {
		margin-top: var(--space-3);
		color: var(--bad);
	}
</style>
