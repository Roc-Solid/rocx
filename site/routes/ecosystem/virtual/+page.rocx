import pf.Html
import ../../../Demos/RowsDemo
import ../../../Ui/Code
import ../../../Ui/Demo
import ../../../Ui/Heading
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Generated/Paths
import ../../../Generated/Sources

## The virtual package: installing it, a live list of a hundred thousand rows (a thousand, a
## million), its props, how it works (the box, the server, very tall lists), writing signals from
## what it measures, and its limits. The demo is the site's (site/Demos/RowsDemo.rocx), hydrated.
meta = {
	title: "Virtual lists",
	description: "The virtual package for Roc Solid apps: <VirtualList>, a list of any length that renders only the rows that show, made of the platform's <Repeat> and on:viewport.",
	toc: [
		{ id: "install", label: "Installing it" },
		{ id: "demo", label: "A million rows" },
		{ id: "props", label: "Its props" },
		{ id: "box", label: "The scrolling box" },
		{ id: "server", label: "On the server" },
		{ id: "signals", label: "Writing signals from on_view!" },
		{ id: "tall", label: "Lists taller than a browser allows" },
		{ id: "limits", label: "Limits" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/virtual</code>]}
				title="Lists of any length"
			>
				A thousand rows or a million cost the page the same: only the rows inside the box are rendered, plus
				four more on each side. Scrolling makes the rows that come into view and drops those that leave; the
				rest stay as they are.
			</PageHero>
			<p>
				Use <code>{"<VirtualList>"}</code> for a list too long to render whole: a log, every order, a grid of a
				million checkboxes. Every row must have the same height, and the list scrolls inside a box of its
				own.
			</p>

			<Heading id="install">Installing it</Heading>
			<p>Name the package in the app's header:</p>
			<Code
				title="main.roc's header"
				source={"app [program] { pf: platform \"…/server/platform/main.roc\", virtual: \"…/packages/virtual/main.roc\" }"}
				numbers={Bool.False}
			/>
			<p>
				Then <code>import virtual.VirtualList</code> in a <code>.rocx</code> file. It isn't a plugin and adds
				nothing to the server; <code>rocx build</code> copies the component into the app
				(<code>Generated/virtual/</code>), as for the <a href={Paths.ecosystem_charts}>charts</a>.
			</p>
			<p>
				It is built from two platform features any component can use: <code>{"<Repeat>"}</code> renders a
				range of rows by index (<a href={"${Paths.components}#control"}><code>if</code>, <code>match</code> and
				<code>.map</code></a>), and <code>on:viewport</code> tells a handler which part of an element shows
				(<a href={"${Paths.components}#handlers"}>handlers</a>).
			</p>

			<Heading id="demo">A million rows</Heading>
			<p>
				Each row is a number and its square. Pick a count and scroll; the line above the list says which
				rows are on the page.
			</p>
		</NoHydration>
		<Demo>
			<div data-demo="virtual"><RowsDemo /></div>
		</Demo>
		<NoHydration>
			<p>
				The row is a function child: given an index, it returns the row's markup. The demo's list, in part:
			</p>
			<Code title={"${Sources.virtual_use.file}, in part"} source={Sources.virtual_use.rocx} numbers={Bool.False} />

			<Heading id="props">Its props</Heading>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>count</code></td><td>How many rows there are. Like every value prop of an effectful component, it is a <a href={"${Paths.components}#passing"}>getter</a>: when <code>{"count={rows!()}"}</code> changes, the list follows.</td></tr>
						<tr><td><code>row_height</code></td><td>Each row's height, in pixels. Every row is this high.</td></tr>
						<tr><td><code>overscan</code></td><td>How many rows to render beyond those that show, on each side, so a quick scroll shows rows instead of a gap. 4 unless you set it.</td></tr>
						<tr><td><code>first_height</code></td><td>The box height, in pixels, to render rows for before the box is measured: on the server, and until the page hydrates. 800 unless you set it.</td></tr>
						<tr><td><code>class</code></td><td>Classes for the box, added to <code>virtual-list</code>. Give the box its height here.</td></tr>
						<tr><td><code>label</code></td><td>The box's <code>aria-label</code>. Left out when empty.</td></tr>
						<tr><td><code>on_view!</code></td><td>Called with each measure of the box, an <code>Html.Viewport</code>: <code>top</code>, <code>left</code>, <code>width</code> and <code>height</code>, in pixels.</td></tr>
						<tr><td>the child</td><td><code>{"{|index| …}"}</code>: a row, given its index from 0. It runs once, when the row is made, as an effectful component does.</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="box">The scrolling box</Heading>
			<p>
				The list is a <code>{"<div>"}</code> that scrolls (<code>overflow-y: auto</code>), so <strong>give it
				a height</strong> through its class. Inside, a second <code>{"<div>"}</code> as tall as all the rows
				(<code>count × row_height</code> pixels) gives the scrollbar its full length; the rendered rows sit in
				it at their places.
			</p>
			<p>
				A box with no height grows to fit all its rows and never scrolls, so the list renders only the rows
				in the first 4,096 pixels and leaves the rest blank.
			</p>

			<Heading id="server">On the server</Heading>
			<p>
				The server can't measure the box, so it renders the rows the first <code>first_height</code> pixels
				would show, and the browser hydrates the same rows. Then <code>on:viewport</code> measures the box,
				and the rows that really show replace them. So the first rows are in the page's HTML before any wasm
				runs.
			</p>

			<Heading id="signals">Writing signals from on_view!</Heading>
			<p>
				<code>on_view!</code> runs on every scroll, at most once per animation frame. A signal's setter
				doesn't compare values: every write re-runs whatever reads the signal, changed or not. So write a
				signal from <code>on_view!</code> only when the part of the view you use has changed. The
				<a href={Paths.examples_checkboxes}>checkboxes example</a> fits as many boxes in a row as the list's
				width allows, and writes the column count only when it changes:
			</p>
			<Code
				title="examples/checkboxes/routes/+page.rocx, in part"
				source={"on_view!={|view| if (Grid.columns(view.width) != columns!()) set_columns!(Grid.columns(view.width)) else {}}"}
				numbers={Bool.False}
			/>
			<p>
				The list does the same: it writes its view only when the range of rows changes, so scrolling within
				a row writes nothing.
			</p>

			<Heading id="tall">Lists taller than a browser allows</Heading>
			<p>
				Browsers cap an element's height: Firefox at about 17.8 million pixels, Chromium at about 33.5
				million. The demo's million 36-pixel rows are 36 million. So a list taller than 10 million pixels is
				scaled: its inner <code>{"<div>"}</code> is 10 million pixels tall, and each pixel scrolled moves
				through more than a pixel of rows, so scrolling to the end shows the last row. The row at the box's
				top is always placed where it should be.
			</p>

			<Heading id="limits">Limits</Heading>
			<ul>
				<li>
					Not yet: rows of different heights, measured as they show.
				</li>
				<li>
					One column. For a grid, lay out each row yourself: the
					<a href={Paths.examples_checkboxes}>checkboxes example</a> puts a <code>{"<Repeat>"}</code> of boxes
					in each row, as many as fit the width <code>on_view!</code> reports.

				</li>
				<li>
					In a scaled list, the scrollbar reaches to within a few rows of any row, not to one exact pixel.
				</li>
			</ul>
			<p>
				The package's <a href="https://github.com/Roc-Solid/rocx/tree/master/packages/virtual">README</a> has
				the full reference, including <code>Rows</code>, the plain-Roc arithmetic behind the list.
			</p>
		</NoHydration>
	</>
