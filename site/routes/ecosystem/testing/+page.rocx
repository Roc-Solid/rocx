import pf.Html
import ../../../Demos/TestingInbox
import ../../../Demos/TestingAnswers
import ../../../Ui/Code
import ../../../Ui/Feature
import ../../../Ui/FeatureGrid
import ../../../Ui/Heading
import ../../../Ui/PageHero
import ../../../Ui/Specimen
import ../../../Ui/TableWrap
import ../../../Generated/Sources
import ../../../Generated/Paths

## The testing package: a first test in Roc (a pure component, its expects, and what the queries
## answer, asked as this page renders), the four ways to test an app, the queries, then the same
## queries from Node against the app's server, a database of a test's own and a real browser; the
## JavaScript modules; and what is not there yet. Static: nothing on it hydrates.
meta = {
	title: "Testing",
	description: "Tests that find things in a page as a person does, by role and name, label and text: in Roc expects, and from node:test against the app's server, a database of the test's own (Postgres or SQLite) and a real browser.",
	toc: [
		{ id: "first", label: "A first test" },
		{ id: "ways", label: "Four ways to test" },
		{ id: "queries", label: "The queries" },
		{ id: "dom", label: "Dom, in Roc" },
		{ id: "node", label: "From Node" },
		{ id: "database", label: "A database, and jobs" },
		{ id: "browser", label: "In a browser" },
		{ id: "javascript", label: "The JavaScript modules" },
		{ id: "status", label: "Status and limits" },
	],
}

view! = |_|
	<NoHydration>
		<PageHero
			kicker={[<>{"The ecosystem · "}</>, <code>packages/testing</code>]}
			title="Tests that read a page as a person does"
		>
			Helpers for testing a Roc Solid app. A test finds a heading, a link by its name and a field by its
			label, as a person using the page does, not by the page's classes.
		</PageHero>
		<p>
			The same queries, with the same rules, work in a Roc <code>expect</code> and from Node's test runner
			against the running app, its database and a real browser (<a href="#ways">four ways to test</a>).
		</p>

		<Heading id="first">A first test</Heading>
		<p>
			The package is plain Roc on no platform, so any module can use it. Name it in the app's header:
		</p>
		<Code source={"app [program] { testing: \"../packages/testing/main.roc\", pf: platform \"…\" }"} numbers={Bool.False} />
		<p>
			A <a href={"${Paths.components}#kinds"}>pure component</a> (<code>view</code>, no <code>!</code>)
			makes its markup from its props alone, so an <code>expect</code> can render it with
			<code>Html.to_str</code>, read the HTML with <code>Dom.parse</code>, and ask what a person would see.
			A small inbox, and how it renders:
		</p>
		<Specimen file={Sources.testing_inbox.file} code={[<Code source={Sources.testing_inbox.rocx} numbers={Bool.False} />]} label="As it renders (a picture: it does nothing here)">
			<div inert><TestingInbox name="Ada" unread={["Lunch?", "Re: the plan"]} /></div>
		</Specimen>
		<p>Its tests sit in the same file, under the component:</p>
		<Code title={Sources.testing_inbox_expects.file} source={Sources.testing_inbox_expects.rocx} numbers={Bool.False} />
		<p>
			After <code>rocx build</code>, <code>roc test main.roc</code> runs them with every other
			<code>expect</code> in the app. Through <code>rocx check -- roc test main.roc</code>, a failing
			<code>expect</code> is reported at its line in the <code>.rocx</code> file
			(<a href={"${Paths.tooling}#errors"}>errors at your lines</a>). This site's tests run the ones above.
		</p>
		<p>
			A query that finds exactly one element answers <code>Ok</code> with it. Finding none or several, it
			answers an error that says what the page has instead, so a failing test tells you what went wrong.
			What <code>page.get</code> answered for a few queries of the inbox, as this page rendered:
		</p>
		<TableWrap><TestingAnswers /></TableWrap>
		<details>
			<summary>How the table is made: <code>{Sources.testing_answers.file}</code></summary>
			<Code title={Sources.testing_answers.file} source={Sources.testing_answers.rocx} />
		</details>

		<Heading id="ways">Four ways to test</Heading>
		<FeatureGrid>
			<Feature title="Rules and pure components, in Roc">
				<p>
					An <code>expect</code> beside the code. <code>Html.to_str</code> renders a pure component, and
					<code>Dom.parse</code> reads it. Fast, typed, and run by <code>roc test</code>.
				</p>
			</Feature>
			<Feature title="The app, over HTTP, from Node">
				<p>
					A <code>node:test</code> file builds the app as a deploy does, starts its server on its own port,
					and asks what a browser would: pages, forms, endpoints, events, and the mail it sent.
				</p>
			</Feature>
			<Feature title="Its database and its jobs">
				<p>
					Each test gets its own database, Postgres or SQLite, migrated by the server. A test can wait for
					the jobs it caused and see how each ended.
				</p>
			</Feature>
			<Feature title="A real browser">
				<p>
					Chromium's headless shell, or Firefox. The page hydrates strictly, and the test clicks and types as
					a person does. A component with signals is tested through its story.

				</p>
			</Feature>
		</FeatureGrid>

		<Heading id="queries">The queries</Heading>
		<p>
			Roc and JavaScript share the queries and their rules. The JavaScript ones use Testing Library's
			names.
		</p>
		<TableWrap>
			<table>
				<thead><tr><th>In Roc</th><th>In JavaScript</th><th>Finds</th></tr></thead>
				<tbody>
					<tr>
						<td><code>Role(role)</code></td>
						<td><code>getByRole(role)</code></td>
						<td>
							elements with that ARIA role, either written (<code>role="tab"</code>) or implied by the tag: a
							<code>{"<button>"}</code> is a button, an <code>{"<a href>"}</code> a link, an <code>{"<h2>"}</code> a
							heading, a <code>{"<ul>"}</code> a list, an <code>{"<input type=\"checkbox\">"}</code> a checkbox
						</td>
					</tr>
					<tr>
						<td><code>Named(role, name)</code></td>
						<td><code>{"getByRole(role, { name })"}</code></td>
						<td>
							elements with that role whose accessible name is <code>name</code>. The name comes from
							<code>aria-labelledby</code>, <code>aria-label</code>, a <code>{"<label>"}</code>, <code>alt</code>,
							the element's text (for a button, a link, a heading or a cell), or <code>title</code>
						</td>
					</tr>
					<tr><td><code>Text(text)</code></td><td><code>getByText(text)</code></td><td>elements whose own text is <code>text</code>, not counting their children's</td></tr>
					<tr>
						<td><code>Label(text)</code></td>
						<td><code>getByLabelText(text)</code></td>
						<td>
							the field that a <code>{"<label>"}</code> with that text names (by <code>for</code>, or by
							wrapping it), or whose <code>aria-label</code> or <code>aria-labelledby</code> says it
						</td>
					</tr>
					<tr><td><code>TestId(id)</code></td><td><code>getByTestId(id)</code></td><td>the element whose <code>data-testid</code> is <code>id</code></td></tr>
					<tr><td><code>Tag(tag)</code>, <code>Attr(name, value)</code></td><td>(none)</td><td>elements by tag, or by an attribute's value, hidden or not</td></tr>
				</tbody>
			</table>
		</TableWrap>
		<p>
			Text is compared as a reader sees it: whitespace collapsed and trimmed. Roles, names, text and labels
			skip what a reader can't see: an element marked <code>hidden</code> or <code>aria-hidden="true"</code>,
			or styled <code>display: none</code> or <code>visibility: hidden</code>, with everything inside it;
			and <code>{"<head>"}</code>, <code>{"<script>"}</code>, <code>{"<style>"}</code>,
			<code>{"<template>"}</code> and <code>{"<noscript>"}</code>. In JavaScript, a name or text may also be
			a <code>RegExp</code>, and <code>getByRole</code> also takes a heading's <code>level</code> and
			<code>{"{ hidden: true }"}</code>.
		</p>

		<Heading id="dom">Dom, in Roc</Heading>
		<p>
			<code>Dom.parse(html)</code> reads HTML into a tree. It expects closed elements, as Roc Solid writes
			them and a browser serializes them. A query on an element looks only inside it, and two
			<code>Dom</code>s compare with <code>==</code>.
		</p>
		<TableWrap>
			<table>
				<thead><tr><th>Function</th><th>Gives</th></tr></thead>
				<tbody>
					<tr><td><code>page.get(query)</code></td><td><code>{"Try(Dom, [NotFound(Str), TooMany(Str)])"}</code>: the one element, or why not</td></tr>
					<tr><td><code>page.first(query)</code>, <code>page.all(query)</code></td><td>the first match; every match, in the page's order</td></tr>
					<tr><td><code>page.contains(query)</code>, <code>page.count(query)</code></td><td>whether anything matches; how many do</td></tr>
					<tr><td><code>page.text_of(query)</code>, <code>page.texts(query)</code></td><td>the text of the one match; the text of each</td></tr>
					<tr><td><code>node.text()</code></td><td>what a reader reads in it, whitespace collapsed</td></tr>
					<tr><td><code>node.attr(name)</code>, <code>node.tag()</code>, <code>node.has_class(class)</code></td><td>an attribute (<code>Err(Missing)</code> when there is none); its tag; whether it has that class</td></tr>
					<tr><td><code>page.roles()</code></td><td>every role and name a reader can reach: print it with <code>dbg</code> when a query finds nothing</td></tr>
				</tbody>
			</table>
		</TableWrap>

		<Heading id="node">From Node</Heading>
		<p>
			For what a pure component can't show (pages, forms, endpoints, the database), test the running app
			from <code>node:test</code>. <code>buildForTests</code> builds the app as a deploy does
			(<code>rocx build</code>, the browser's wasm, the server); a markup problem, type error or warning
			throws, reported at its line in the <code>.rocx</code> file. <code>startServer</code> starts that
			server on a free port, usually once for a file's tests:
		</p>
		<Code title={Sources.testing_node_setup.file} source={Sources.testing_node_setup.rocx} numbers={Bool.False} />
		<p>
			<code>app.client()</code> is one person at a browser, with their own cookie jar. Every answer has its
			<code>status</code>, its <code>text</code>, and a <code>dom</code> with the queries:
		</p>
		<Code title={Sources.testing_node_page.file} source={Sources.testing_node_page.rocx} numbers={Bool.False} />
		<p>
			A client sends a <a href={"${Paths.calls}#forms"}>form</a> in one of two ways:
		</p>
		<ul>
			<li>
				<code>post</code> sends it as a browser does without the runtime: the endpoint answers with a
				redirect back to the page and a flash holding its result, which the test reads with
				<code>client.flash</code> (a test's server runs with <code>--debug</code>, so it tells the test what
				the flash holds).
			</li>
			<li>
				<code>submit</code> sends it as the runtime does once the page has hydrated, and gets the
				endpoint's answer directly.
			</li>
		</ul>
		<p>
			<code>read</code> reads a GET endpoint as a page reads it, and <code>events</code> reads an endpoint's
			server-sent events as they arrive:
		</p>
		<Code title={Sources.testing_node_form.file} source={Sources.testing_node_form.rocx} numbers={Bool.False} />
		<p>
			With no <code>SMTP_URL</code>, the <a href={"${Paths.ecosystem_email}#mailbox"}>email plugin</a> keeps
			the last 100 messages in the server's memory instead of sending them, under <code>--debug</code>
			(which <code>startServer</code> passes) as under <code>--dev</code>. So each test server starts with
			an empty mailbox. <code>app.mail()</code> reads the messages (each with <code>to</code>,
			<code>cc</code>, <code>bcc</code>, <code>reply_to</code>, <code>headers</code>, <code>subject</code>,
			<code>text</code>, <code>html</code>, and the <code>raw</code> message, in which no header names the
			Bcc); <code>waitForMail</code> waits for one that matches (a list such as <code>cc</code> matches when
			one of its addresses does); <code>links</code> finds a message's links:
		</p>
		<Code title={Sources.testing_node_mail.file} source={Sources.testing_node_mail.rocx} numbers={Bool.False} />

		<Heading id="database">A database, and jobs</Heading>
		<p>
			Each test can have its own database, so tests never see each other's rows. The server migrates it
			as it starts.
		</p>
		<ul>
			<li>
				On Postgres, <code>testDatabase()</code> makes a new database in the Postgres at
				<code>DATABASE_URL</code>.
			</li>
			<li>
				On SQLite, <code>testSqlite()</code> makes a database file in its own temporary directory, read and
				written with Node's <code>node:sqlite</code>. Pass the database itself to the server,
				<code>{"startServer(server, { database: db })"}</code>, so it can wake the server's job workers
				(SQLite can't tell another process that a row changed).
			</li>
		</ul>
		<p>
			Both have <code>sql</code> (a tagged template that escapes its values), <code>query</code>,
			<code>jobs</code>, <code>enqueue</code>, <code>settleJobs</code> and <code>drop</code> (which removes
			the database when the test is done).
		</p>
		<p>
			<code>settleJobs()</code> waits until every due <a href={Paths.ecosystem_jobs}>job</a> has run, with
			the jobs those queued, and answers how each one ended. It doesn't wait for a failed job's later
			retry; <code>{"settleJobs({ later: true })"}</code> runs retries and jobs queued for later at once,
			until their attempts are spent. <code>enqueue</code> queues a job as a cron would at its time.
		</p>
		<Code title={Sources.testing_node_jobs.file} source={Sources.testing_node_jobs.rocx} numbers={Bool.False} />

		<Heading id="browser">In a browser</Heading>
		<p>
			<code>launchBrowser()</code> starts Chromium's headless shell (<code>$CHROME</code>, or Playwright's
			cached one). With none, it answers <code>null</code> so the test can skip, and the run says so once.
			In CI (<code>CI</code> set, as GitHub Actions does) or with <code>ROCX_BROWSERS=required</code>, a
			missing browser is an error, so a broken browser install fails CI instead of skipping its browser
			tests. <code>ROCX_BROWSERS=optional</code> lets them skip in CI too.
		</p>
		<p>
			<code>browser.open(url)</code> opens a tab and waits until the page hydrates, strictly: if the server's
			page isn't what the browser's half renders, it throws. The tab has the same queries; each element
			found can be clicked, typed in and filled through the browser's own input. <code>findBy…</code> keeps
			looking until the page shows what it asks for.
		</p>
		<Code title={Sources.testing_node_browser.file} source={Sources.testing_node_browser.rocx} numbers={Bool.False} />
		<p>
			<code>{"launchBrowser({ engine: \"gecko\" })"}</code> starts a Gecko browser instead, headless
			(<code>$GECKO</code>, Zen or Firefox), driven over WebDriver BiDi. Its tabs do what Chromium's do,
			except take a screenshot in dark mode.
		</p>
		<p>
			<code>{"tab.drag(source, target)"}</code> drags one element onto another as a mouse does, firing
			dragstart, drag, dragenter, dragover, drop (if the target accepts it) and dragend, each with its
			coordinates. Chromium uses its own drag and drop. Gecko never finishes a drag that WebDriver starts,
			so there <code>drag</code> fires the DOM's drag events itself, carrying one <code>DataTransfer</code>.
			<code>{"tab.touchDrag(source, target)"}</code> drags with a finger, with real touch input in both
			browsers.
		</p>
		<p>
			<code>Html.to_str</code> can't render a component with signals: its holes need the runtime. Test it
			through its <a href={"${Paths.tooling}#stories"}>story</a>: <code>{"buildForTests(dir, { dev: true })"}</code>
			serves each story as a page, at <code>{"storyPath(\"Counter\", \"At ten\")"}</code>, to fetch or open
			in a tab.
		</p>

		<Heading id="javascript">The JavaScript modules</Heading>
		<p>
			Plain <code>.mjs</code> files with no dependencies, each usable alone; <code>index.mjs</code> exports
			them all. The package's <a href="https://github.com/Roc-Solid/rocx/blob/master/packages/testing/README.md">README</a>
			lists every function and option.
		</p>
		<TableWrap>
			<table>
				<thead><tr><th>Module</th><th>Gives a test</th></tr></thead>
				<tbody>
					<tr>
						<td><code>dom.mjs</code></td>
						<td>
							<code>screen(html)</code>, or <code>parse(html)</code> and <code>within(node)</code>: the queries,
							each as <code>getBy…</code> (one, or it throws), <code>queryBy…</code> (one, or <code>null</code>),
							<code>getAllBy…</code> and <code>queryAllBy…</code>. A node has <code>text</code>,
							<code>attr(name)</code>, <code>role</code>, <code>name</code> and <code>hasClass(name)</code>
						</td>
					</tr>
					<tr>
						<td><code>server.mjs</code></td>
						<td>
							<code>{"startServer(executable, { statics, database, dev, flags, env })"}</code>; its
							<code>client()</code>, with <code>get</code>, <code>post</code>, <code>submit</code>,
							<code>json</code>, <code>put</code>, <code>read</code>, <code>events</code> and <code>flash</code>;
							<code>mail()</code>, <code>waitForMail</code>, <code>logs()</code> and <code>stop()</code>; and
							<code>links</code>, <code>until</code> and <code>storyPath</code>
						</td>
					</tr>
					<tr>
						<td><code>postgres.mjs</code></td>
						<td>
							<code>testDatabase()</code>: <code>url</code>, <code>query</code>, <code>{"sql`…\${value}`"}</code>
							(each value written as a literal), <code>jobs</code>, <code>enqueue</code>, <code>settleJobs</code>
							and <code>drop</code>, over a small Postgres client of its own
						</td>
					</tr>
					<tr>
						<td><code>sqlite.mjs</code></td>
						<td>
							<code>testSqlite()</code>: <code>url</code>, <code>path</code>, <code>query</code>,
							<code>{"sql`…\${value}`"}</code> (each value a parameter), <code>jobs</code>, <code>enqueue</code>,
							<code>settleJobs</code> and <code>drop</code>, over <code>node:sqlite</code>
						</td>
					</tr>
					<tr>
						<td><code>browser.mjs</code></td>
						<td>
							<code>{"launchBrowser({ engine })"}</code>, <code>{"browser.open(url, { strict, cookies, script })"}</code>: a tab with the
							queries, <code>findBy…</code>, <code>waitFor</code>, <code>errors</code>, <code>console</code>,
							<code>screenshot</code>, <code>drag</code> and <code>touchDrag</code>; elements with
							<code>click</code>, <code>fill</code>, <code>type</code>, <code>press</code> and <code>value</code>
						</td>
					</tr>
					<tr><td><code>build.mjs</code></td><td><code>{"buildForTests(dir, { client, dev, opt })"}</code>: the app built; its server, and the directories it serves</td></tr>
				</tbody>
			</table>
		</TableWrap>

		<Heading id="status">Status and limits</Heading>
		<p>
			Everything above works and is tested: <code>roc test packages/testing/main.roc</code> runs
			<code>Dom</code>'s <code>expect</code>s, and <code>node --test</code> runs the JavaScript against a
			small app it builds, with Postgres and Chromium when they are there. The examples' tests use it too,
			such as <a href={Paths.examples_tasks}>tasks</a> and <a href={Paths.examples_board}>board</a>.
		</p>
		<p>
			Not yet (each needs a change outside the package, written up in
			<code>packages/testing/PROPOSALS.md</code>):
		</p>
		<ul>
			<li>A clock a test sets, and randomness it seeds: a test mode for the server.</li>
			<li>
				Outbound requests (<code>Http</code>, and the S3 requests of
				<a href={Paths.ecosystem_storage}>packages/storage</a>, which go through it) answered by stubs, so a
				test makes no network calls.
			</li>
			<li>
				Jobs and crons run on request, by name. Today <code>settleJobs</code> works through the database,
				and <code>enqueue</code> repeats a cron's input.
			</li>
			<li>
				Emptying the dev mailbox between tests. Today, pass <code>{"{ after }"}</code> to
				<code>waitForMail</code> to skip the messages already there.
			</li>
			<li>
				Endpoints and pages tested in Roc, answered inside the server; and a component with signals rendered
				in a Roc test.
			</li>
			<li>Helpers in this package that run inside the server under test.</li>
		</ul>
		<p>Limits:</p>
		<ul>
			<li>
				The tabs of one browser share cookies, so <code>open</code> clears them first. To test two people at
				once, launch two browsers.
			</li>
			<li>
				<code>Dom.parse</code> doesn't close elements that HTML lets you leave open:
				<code>{"<p>one<p>two"}</code> is read as one paragraph inside another.
			</li>
			<li>
				The JavaScript uses the Roc Solid repository it is in (or the one <code>ROCX_ROOT</code> names): its
				compiler, its browser driver, and its platforms' hosts, which must be built first (<code>just test</code>
				builds them).

			</li>
		</ul>
	</NoHydration>

<style>
	/* A narrow screen scrolls a table sideways (TableWrap) rather than breaking a name or a call in two,
	   or squeezing what it says into a word a line. */
	td:not(:last-child) code {
		white-space: nowrap;
	}

	td:last-child {
		min-width: 14rem;
	}
</style>
