import pf.Html
import ../../../Demos/AdminPreview
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Ui/Heading
import ../../../Ui/Note
import ../../../Generated/Sources
import ../../../Generated/Paths
import ../../../Ui/PageHero
import ../../../Ui/TableWrap

## The admin package: what it is for, installing it, a first admin (code the site's server
## compiles), its pages as the package renders them (from made-up tables, while this page renders),
## its URLs, filters, access, options and widgets, how it works, the jobs page, its modules, and what
## it doesn't do yet. All of it is static: the browser runs nothing here.
meta = {
	title: "Admin",
	description: "A Django-style admin for a Roc Solid app's tables, on Postgres or SQLite: each table's rows with a search, a filter in every column, sorting and pages, and a form for each row, read from the database's own catalog.",
	toc: [
		{ id: "install", label: "Installing it" },
		{ id: "first", label: "A first admin" },
		{ id: "looks", label: "What it looks like" },
		{ id: "pages", label: "Its pages" },
		{ id: "filters", label: "Filters" },
		{ id: "access", label: "Who may use it" },
		{ id: "options", label: "Options" },
		{ id: "widgets", label: "Widgets" },
		{ id: "how", label: "How it works" },
		{ id: "jobs-page", label: "The jobs page" },
		{ id: "modules", label: "The modules" },
		{ id: "limits", label: "Not yet" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/admin</code>]}
				title="An admin for your tables, read from the database itself"
			>
				A Django-style admin: see and fix your data without building pages for it. Each table gets a page of
				rows with a search, a filter in every column, sorting and pages, and a form to add, change or delete
				a row. The admin reads your tables from the database's catalog (Postgres or SQLite) on each request:
				no code to generate, nothing to keep in step with your schema.
			</PageHero>
			<p>
				Mount it with one route file, behind your app's middleware. The package also draws the
				<a href={"#jobs-page"}>jobs page</a>, the queue of <a href={Paths.ecosystem_jobs}>packages/jobs</a>,
				on a route file of yours too.
			</p>

			<Heading id="install">Installing it</Heading>
			<p>
				Name the package in your app's header (<code>main.roc</code>) by its directory's name, as the docs
				site does:
			</p>
			<Code title={Sources.admin_header.file} source={Sources.admin_header.rocx} numbers={Bool.False} />
			<p>
				The package names the server platform (for the jobs page), so its <code>pf</code> must be your app's
				platform file. The admin runs only on the server: nothing in the browser imports a
				<code>+server.roc</code>, so the browser's half never compiles it.
			</p>

			<Heading id="first">A first admin</Heading>
			<p>
				Add a route file at the admin's path: <code>routes/admin/db/+server.roc</code> is
				<code>/admin/db</code>. Its <code>respond!</code> hands every request to
				<code>AdminPage.respond!</code> with:
			</p>
			<ul>
				<li>
					the context from the route's <a href={"${Paths.routing}#middleware"}>middleware</a> (its
					directory's
					<code>+middleware.roc</code>, <code>middleware = Middlewares.staff</code>, says who is asking);
				</li>
				<li>
					the options: only <code>mount</code> (the route's path) and <code>access</code> are required,
					and per
					table only its <code>name</code>;
				</li>
				<li>the effects the admin runs on: <code>Db.all!</code>, <code>Db.run!</code>,
				<code>Random.bytes!</code> and <code>Db.backend!</code>.</li>
			</ul>
			<Code title={Sources.admin_route.file} source={Sources.admin_route.rocx} />
			<p>
				In your app these go in the route file. Here they are a module the compiler checks, but nothing
				answers with them: the docs site has no database.
			</p>
			<Callout kind="note" title="Why you hand it Db.all!">
				<p>
					<code>AdminPage</code> uses no platform, so either half of an app can import the admin's modules
					(this page renders the admin's pages that way, below). A module on no platform can't call
					<code>Db</code>, so your route passes it the server's effects, and the compiler checks they fit.
					<code>Db.backend!</code> tells the admin whether to write its statements for Postgres or SQLite.
				</p>
			</Callout>

			<Heading id="looks">What it looks like</Heading>
			<p>
				The package's <code>View</code> rendered these with this page, from a made-up catalog
				(<code>books</code> and <code>authors</code>) and the options above. No database is asked, and the
				frames are sandboxed: links and forms do nothing. Like the
				<a href={"${Paths.ecosystem_jobs}#page"}>jobs
				page</a>, they use the admin look: tables in a sidebar (across the top when narrow), a header with the
				page's actions, panels, and light or dark to match your system.
			</p>
			<figure class="admin-preview">
				<iframe class="list" title="The admin's list of books, as the package renders it" srcdoc={AdminPreview.list_page} sandbox="" loading="lazy"></iframe>
				<figcaption>
					A table's rows, filtered to a <code>price</code> of 10 or more, a <a href="#filters">filter</a>
					under
					each heading. A heading sorts, the search looks in <code>title</code> and <code>blurb</code>,
					and a
					foreign key links to its row.
				</figcaption>
			</figure>
			<figure class="admin-preview">
				<iframe title="The admin's form for one book, as the package renders it" srcdoc={AdminPreview.row_page} sandbox="" loading="lazy"></iframe>
				<figcaption>
					A row's form, just saved, with a <a href="#widgets">widget</a> for each column's type. The key is
					shown, not editable.
				</figcaption>
			</figure>
			<details>
				<summary>The made-up tables, and the pages rendered from them:
				<code>{Sources.admin_preview.file}</code></summary>
				<Code title={Sources.admin_preview.file} source={Sources.admin_preview.rocx} />
			</details>

			<Heading id="pages">Its pages</Heading>
			<p>
				Every page is the admin's path plus a query, so one route file is enough. A query can name only the
				tables and columns the app lets the admin show.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Query</th><th>Page</th></tr></thead>
					<tbody>
						<tr><td>(none)</td><td>the tables, each with its estimated row count (Postgres only), its comment, and a link to add a row</td></tr>
						<tr>
							<td><code>?table=books</code></td>
							<td>
								its rows, 50 a page (<code>page=2</code>), counted and paged by the database; a search
								(<code>q=cloud</code>), a filter in each column (<code>has.title=cloud</code>,
								<code>from.price=10</code>, <code>f.state=draft</code>,
								<code>is.author_id=null</code>: see
								<a href="#filters">Filters</a>), and a sort (<code>sort=title</code>, or
								<code>sort=-price</code> for descending)
							</td>
						</tr>
						<tr><td><code>?table=books&amp;k.id=21</code></td><td>a row's form: <code>k.</code> plus each primary-key column, so two-column keys work too</td></tr>
						<tr><td><code>?table=books&amp;new</code></td><td>a new row's form, with its constant defaults filled in (<code>true</code>, <code>'draft'</code>, <code>0</code>)</td></tr>
						<tr><td><code>?table=books&amp;k.id=21&amp;delete</code></td><td>a confirmation, and the button that deletes the row</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Sending a form adds, changes or deletes the row, then shows the row's page saying Saved. An update
				writes only changed columns. If the database refuses (a price that isn't a number, an author books
				still name), the form comes back with what you sent and the database's reason. A table without a
				primary key is listed, but its rows can't be opened.
			</p>

			<Heading id="filters">Filters</Heading>
			<p>
				Each column a list shows gets a filter under its heading, chosen by its type; a hidden column never
				does. Filters can't be turned off: filtering a shown column reveals nothing a visitor can't already
				see. To filter by a column, list it.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Column</th><th>Filter</th><th>Query</th></tr></thead>
					<tbody>
						<tr><td><code>text</code>, <code>varchar</code>, <code>uuid</code>, <code>json</code> and any other type</td><td>the text it contains, in any case; <code>%</code> and <code>_</code> match themselves</td><td><code>has.title=cloud</code></td></tr>
						<tr><td>a number: <code>integer</code>, <code>bigint</code>, <code>numeric</code>, <code>real</code>, …</td><td>from, to, or both, inclusive</td><td><code>from.price=10&amp;to.price=20</code></td></tr>
						<tr><td><code>date</code>, <code>timestamp</code>, <code>timestamptz</code> (in UTC), <code>time</code></td><td>from, to, or both, inclusive, with the browser's pickers</td><td><code>from.published_at=2026-03-01T00:00</code></td></tr>
						<tr><td><code>boolean</code></td><td>a select: any, yes, no</td><td><code>f.in_print=true</code></td></tr>
						<tr><td>an enum, or a check that it is one of a few values</td><td>a select of its values</td><td><code>f.state=draft</code></td></tr>
						<tr><td>a foreign key</td><td>the value it equals</td><td><code>f.author_id=3</code></td></tr>
						<tr><td>any of these, if it may be null</td><td>also empty and not empty: in its select, or in a small select under its inputs</td><td><code>is.blurb=null</code>, <code>is.blurb=set</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The filters are one GET form, no JavaScript: Enter in any of them, or the Filter button beside the
				search, sends it. Filtering keeps the search and sort and returns to the first page; page links and
				sorting keep the filters; Clear filters drops them all.
			</p>
			<p>
				Each value is checked in Roc before it reaches SQL (a number for a number, <code>2026-03-14</code> for
				a date, one of an enum's labels), and a range's value is cast to its column's type
				(<code>{"\"price\" >= $3::numeric"}</code>). A wrong value is ignored and its filter says so (Ignored:
				not a number), so a bad query never makes the page an error.
			</p>

			<Heading id="access">Who may use it</Heading>
			<p>
				The route's middleware runs first, so it can send a stranger to sign in. Then <code>access</code>
				decides from the context it handed on:
			</p>
			<TableWrap>
				<table>
					<thead><tr><th><code>access</code> says</th><th>Then</th></tr></thead>
					<tbody>
						<tr><td><code>Edit</code></td><td>every page, and adding, changing and deleting rows</td></tr>
						<tr><td><code>ReadOnly</code></td><td>the tables, rows and values; no forms</td></tr>
						<tr><td><code>Refused</code></td><td>a 403, and nothing is read</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				A form's POST must come from the same site (its <code>Origin</code> header) and send back its page's
				token. The token lives in a cookie, <code>rocx_admin_csrf</code>: sent only to the admin's path,
				unreadable by scripts (<code>HttpOnly</code>), and not sent with another site's form
				(<code>SameSite=Lax</code>). Any other POST gets a 403 before a table is read.
			</p>

			<Heading id="options">Options</Heading>
			<p><code>Admin.Config(context)</code> configures the admin. Only <code>mount</code> and
			<code>access</code> are required.</p>
			<TableWrap>
				<table>
					<thead><tr><th>Field</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>mount : Str</code></td><td>the route's path</td></tr>
						<tr><td><code>{"access : context -> [Edit, ReadOnly, Refused]"}</code></td><td>what someone may do, decided from the middleware's context</td></tr>
						<tr><td><code>tables : List(Admin.Table)</code></td><td>the tables it shows, in order, with their options (none by default)</td></tr>
						<tr><td><code>include : [Listed, All]</code></td><td><code>Listed</code> (the default) shows only those tables; <code>All</code> adds every other table of the schema, with default options, except the platform's own (<code>rocx_…</code>)</td></tr>
						<tr><td><code>schema : Str</code></td><td>the Postgres schema: <code>"public"</code> by default (SQLite's is always <code>main</code>)</td></tr>
						<tr><td><code>title : Str</code></td><td>what its pages call it: <code>"Database"</code> by default</td></tr>
						<tr><td><code>{"back : { label : Str, href : Str }"}</code></td><td>a link to the app's pages, first in every sidebar (<code>{"{ label: \"Status admin\", href: \"/admin\" }"}</code>); none by default</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				<code>Admin.Table</code> holds a table's options, naming columns as the table does. A table or column
				the schema doesn't have stops the admin: its pages say what is wrong and show nothing else until it
				is fixed, since a misspelt <code>hidden</code> would show the column it should hide.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Field</th><th>Default</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>name : Str</code></td><td>(required)</td><td>the table</td></tr>
						<tr><td><code>label : Str</code></td><td>its name, made readable: <code>book_tags</code> is Book tags</td><td>what the pages call it</td></tr>
						<tr><td><code>list : List(Str)</code></td><td>its first seven columns</td><td>the columns its list of rows shows, each with a filter</td></tr>
						<tr><td><code>search : List(Str)</code></td><td>no search box</td><td>the columns searched, for the text anywhere, in any case</td></tr>
						<tr><td><code>ordering : List(Str)</code></td><td>its key, newest first</td><td>the list's order; <code>-</code> for descending: <code>["-published_at", "title"]</code></td></tr>
						<tr><td><code>read_only : List(Str)</code></td><td>none</td><td>columns shown on the form, never written</td></tr>
						<tr><td><code>hidden : List(Str)</code></td><td>none</td><td>columns never read, shown or written, such as a password's hash</td></tr>
						<tr><td><code>labels : List((Str, Str))</code></td><td>each column's name, made readable</td><td>what to call its columns: <code>[("email", "Email address")]</code></td></tr>
						<tr><td><code>title : Str</code></td><td>its first text column that isn't its key</td><td>the column that names a row: the heading of its page, and its name in a foreign key's select</td></tr>
						<tr><td><code>per_page : U64</code></td><td>50</td><td>rows a page</td></tr>
						<tr><td><code>widgets : List((Str, Widget.Kind))</code></td><td>the column's type's</td><td>another input for a column: <code>[("body", LongText)]</code></td></tr>
						<tr><td><code>create : Bool</code>, <code>delete : Bool</code></td><td>yes</td><td>whether rows may be added or deleted</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="widgets">Widgets</Heading>
			<p>
				A widget is a column's input on a row's form, chosen from the column's type in the catalog (for a
				domain, its base type):
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Column</th><th>Widget</th></tr></thead>
					<tbody>
						<tr><td>a foreign key to a table the admin shows</td><td>a select of that table's rows, by their title (an input, when there are more than 200), and a link to the row</td></tr>
						<tr><td>an enum, or a check that it is one of a few values (<code>{"check (state in ('draft', 'published'))"}</code>)</td><td>a select of them</td></tr>
						<tr><td><code>boolean</code></td><td>a checkbox; a select of yes, no and null when it may be null</td></tr>
						<tr><td><code>smallint</code>, <code>integer</code>, <code>bigint</code></td><td>a number</td></tr>
						<tr><td><code>numeric</code>, <code>real</code>, <code>double precision</code></td><td>a decimal's input</td></tr>
						<tr><td><code>date</code>, <code>timestamp</code>, <code>timestamptz</code>, <code>time</code></td><td>the browser's pickers; a <code>timestamptz</code> in UTC</td></tr>
						<tr><td><code>json</code>, <code>jsonb</code></td><td>a text area, in a monospace font</td></tr>
						<tr><td><code>text</code>, <code>varchar(n)</code>, <code>uuid</code> and the rest</td><td>an input (with <code>maxlength</code> for a <code>varchar(n)</code>), or a text area for a value of several lines; the database reads what is typed as the column's type</td></tr>
						<tr><td>a generated column, <code>bytea</code></td><td>shown, never written</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				An empty input is null where the column allows it, else an empty text for a text column. In a new
				row, an empty input leaves a column's default to the database. To change a column's widget, name it
				in the table's <code>widgets</code>; the
				<a href="https://github.com/Roc-Solid/rocx/blob/master/packages/admin/README.md#widgets">README</a>
				lists every <code>Widget.Kind</code>.
			</p>

			<Heading id="how">How it works</Heading>
			<p>
				On each request, the admin reads the schema from the catalog into tables (<code>Catalog.read</code>):
				columns and types, which may be null or have defaults, primary and foreign keys, enums, and the values
				a check allows. On Postgres that is four small statements over <code>pg_catalog</code>. On SQLite it
				reads <code>pragma_table_list</code>, <code>pragma_table_xinfo</code> and
				<code>pragma_foreign_key_list</code>, and each table's checks from its <code>create table</code>. A
				SQLite type is read as Postgres would name it (<code>integer</code> as <code>int8</code>,
				<code>boolean</code> as <code>bool</code>), so it gets the same widget and filter.
			</p>
			<p>
				A table or column a request names is looked up there, among those the app lets the admin show. Only
				the catalog's names go into SQL, double-quoted; every value is a parameter:
			</p>
			<Code title={"${Sources.admin_ident.file}, in part"} source={Sources.admin_ident.rocx} numbers={Bool.False} />
			<p>
				A list is two statements built by <code>Sql</code>: a count, then the page's rows. These are the
				statements for <code>{"?${AdminPreview.query}"}</code> above, built as this page rendered:
			</p>
			<Code title={"?${AdminPreview.query}"} source={AdminPreview.statements} plain numbers={Bool.False} />
			<p>
				Every statement answers rows of one shape, each cell as text plus whether it was null
				(<code>Catalog.Row</code>), so one <code>Db.all!</code> reads any table. The database cuts a list's
				cells to 81 characters, so the page can tell one was cut; a key is never cut.
			</p>
			<p>
				Pages go out with <code>Content-Security-Policy: default-src 'none'</code> (no script, nothing loaded
				from elsewhere, forms sent only to this site), <code>X-Frame-Options: DENY</code> and
				<code>Cache-Control: no-store</code>, and every value is escaped.
			</p>

			<Heading id="jobs-page">The jobs page</Heading>
			<p>
				The queue of <a href={Paths.ecosystem_jobs}>packages/jobs</a> also goes on a route of yours. Put its
				route file in your admin pages' folder, so that folder's middleware decides who sees it, and give
				<code>mount</code> the route's path:
			</p>
			<Code title="routes/(admin)/admin/jobs/+server.roc" source={"import admin.JobsPage\n\nrespond! = |{ request, .. }| JobsPage.respond!(request, { mount: \"/admin/jobs\", back: { label: \"Status admin\", href: \"/admin\" } })"} numbers={Bool.False} />
			<p>
				A request passes the app's middleware, then the folder's, then the page, which needs the jobs plugin
				listed. <code>back</code> works as the tables admin's option does (none by default). The jobs page's
				own section says <a href={"${Paths.ecosystem_jobs}#page"}>what it shows and does</a>.
			</p>
			<p>
				The tables admin, the jobs page and the dev mailbox of
				<a href={Paths.ecosystem_email}>packages/email</a>
				share one look (<code>Look</code>, and <code>AdminHtml</code> on it). Each sidebar ends with
				<strong>Back to the app</strong>: to the app page the reader came from (kept in a cookie until the
				browser closes, so the page's filters and forms keep it), or to the front page, <code>/</code>, when
				they came
				from nowhere (a typed address, a bookmark) or another site. The stories catalog has it too.
			</p>

			<Heading id="modules">The modules</Heading>
			<p>
				<code>AdminPage</code> is the one module with effects: those your route hands it.
				<code>JobsPage</code> and <code>AdminHtml</code> run on the server platform. The rest is plain Roc on
				no platform; <code>roc test packages/admin/main.roc</code> runs their <code>expect</code>s.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Module</th><th>What it does</th></tr></thead>
					<tbody>
						<tr><td><code>Admin</code></td><td>the options (<code>Config</code>, <code>Table</code>, <code>Access</code>), what they name that the schema doesn't have (<code>problems</code>), and what they mean for a table: <code>showing</code>, <code>listed</code>, <code>searchable</code>, <code>writable</code>, <code>title</code>, <code>ordering</code>, <code>widget</code></td></tr>
						<tr><td><code>AdminPage</code></td><td><code>respond!(request, context, config, effects)</code>: the access check, the token, the catalog, then the page or the form</td></tr>
						<tr><td><code>Catalog</code></td><td>the statements that read the schema, on Postgres or SQLite, and <code>read</code> (<code>read_sqlite</code>), their rows as tables</td></tr>
						<tr><td><code>Sql</code></td><td><code>ident</code>, <code>contains</code> (a search's or a filter's pattern), the conditions a list's rows meet, and the statements: <code>rows</code>, <code>count</code>, <code>one</code>, <code>insert</code>, <code>update</code>, <code>delete</code>, <code>titles</code></td></tr>
						<tr><td><code>Widget</code></td><td>a column's widget from its type (<code>of</code>), its input (<code>input</code>), what a form's text writes (<code>param</code>), whether it changed (<code>same</code>), a new row's value (<code>initial</code>)</td></tr>
						<tr><td><code>Listing</code></td><td>a list's search, filters, sort and page, read from the query and written back (<code>read</code>, <code>params</code>, <code>conditions</code>, <code>order</code>, <code>key</code>); each column's filter (<code>kind</code>) and the check of its values (<code>check</code>)</td></tr>
						<tr><td><code>Paging</code></td><td><code>of(total, size, asked)</code>, <code>offset</code>, <code>shows</code>, <code>links</code>: the first two pages, three each side of this one, the last two</td></tr>
						<tr><td><code>View</code></td><td>each page's HTML: <code>index_page</code>, <code>list_page</code>, <code>row_page</code>, <code>delete_page</code>, <code>problem_page</code>, <code>problems_page</code>, and the sidebar (<code>side</code>)</td></tr>
						<tr><td><code>Look</code></td><td>the admin look: the rules every admin page shares (<code>shared</code>) and its helpers (<code>side</code>, <code>header</code>, <code>panel</code>, <code>empty</code>, <code>icon</code>, <code>button_with</code>), light and dark; the tables admin's own rules, its document, and the headers it is sent with</td></tr>
						<tr><td><code>Form</code></td><td>a query's or a form's fields, decoded, and links, encoded</td></tr>
						<tr><td><code>JobsPage</code></td><td>the jobs page: <code>{"respond!(request, { mount, back })"}</code>, from a route of the app's (server only)</td></tr>
						<tr><td><code>AdminHtml</code></td><td>the server's admin pages (the jobs page, the dev mailbox), on <code>Look</code>: a page with its stream of changes, times, links (server only)</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="limits">Not yet</Heading>
			<p>
				Everything above works on Postgres and SQLite, tested over HTTP on both: the index, a new row's form,
				a row created, found by search and filter, changed and deleted. Not yet:
			</p>
			<ul>
				<li>A list counts its rows (<code>count(*)</code>) and pages with <code>offset</code>: fine for
				thousands of rows, slow for millions.</li>
				<li>A text filter, like the search, reads every row (no index helps
				<code>{"ilike '%…%'"}</code>).</li>
				<li>A foreign key in a list shows its value, linked to its row, not the row's title; its filter
				takes a value.</li>
				<li>A foreign key or a check over several columns gives no widget: each column is edited alone.</li>
				<li>No actions on several rows at once, and no history of who changed what.</li>
				<li>
					Every route passes the effects. A server-only module could pass them itself, so a route would be
					<code>respond!(request, context, admin)</code>; the package's <code>PROPOSALS.md</code> has it.
				</li>
			</ul>
			<Note>
				The <a href="https://github.com/Roc-Solid/rocx/tree/master/packages/admin">package's README</a> is
				the full reference, with its proposals beside it in <code>packages/admin/</code>. The pages and code
				above are the package's own.
			</Note>
		</NoHydration>
	</>

<style>
	/* The admin's own pages, in frames: as wide as the text, which is narrow enough that the admin
	   lists its tables across the top, as on a phone. A book's form is taller than its frame, and
	   scrolls in it. */
	.admin-preview {
		margin: var(--space-5) 0;
	}

	.admin-preview iframe {
		display: block;
		width: 100%;
		height: 60rem;
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius);
		background: #f4f6f7;
	}

	/* The list of books, whole: its filters in its table, its six rows and its count; on a phone,
	   its titles take two lines. */
	.admin-preview iframe.list {
		height: 52rem;
	}

	@media (max-width: 40rem) {
		.admin-preview iframe.list {
			height: 57rem;
		}
	}

	.admin-preview figcaption {
		margin-top: var(--space-2);
		color: var(--text-muted);
		font-size: var(--size-sm);
	}
</style>
