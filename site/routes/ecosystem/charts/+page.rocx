import pf.Html
import ../../../Demos/BarDemo
import ../../../Demos/LineDemo
import ../../../Demos/AreaDemo
import ../../../Demos/DonutDemo
import ../../../Demos/ScatterDemo
import ../../../Demos/StackDemo
import ../../../Demos/SparkDemo
import ../../../Demos/HeatDemo
import ../../../Ui/Code
import ../../../Ui/Heading
import ../../../Generated/Sources
import ../../../Generated/Paths
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Ui/Demo

## The charts package: how to add it to an app, then each component, live (with buttons that give it
## other data, do so every few seconds, and restyle it three ways), and its props; how they move, how
## they are styled, the modules the arithmetic is in, and the limits.
meta = {
	title: "Charts",
	description: "Bar, stacked bar, line, stacked area, sparkline, donut, scatter and heatmap charts for Roc Solid apps, drawn as SVG: rendered on the server, hydrated in the browser, gliding to new data a frame at a time, and styled by custom properties.",
	toc: [
		{ id: "install", label: "Installing it" },
		{ id: "bar", label: "<BarChart>" },
		{ id: "stacked", label: "<StackedBarChart>" },
		{ id: "line", label: "<LineChart>" },
		{ id: "area", label: "<StackedAreaChart>" },
		{ id: "sparkline", label: "<Sparkline>" },
		{ id: "donut", label: "<DonutChart>" },
		{ id: "scatter", label: "<ScatterChart>" },
		{ id: "heatmap", label: "<Heatmap>" },
		{ id: "moving", label: "How they move" },
		{ id: "styling", label: "Styling, three ways" },
		{ id: "modules", label: "The arithmetic" },
		{ id: "limits", label: "Limits, for now" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/charts</code>]}
				title="Charts that glide to their data, and then stop"
			>
				Eight SVG charts for a dashboard, a report or a live tally: bar, stacked bar, line, stacked area,
				sparkline, donut, scatter and heatmap. The server renders them; the browser hydrates them like any component. When data
				changes they glide to it, a frame at a time, then nothing runs. Every chart here is live: Randomize
				gives it new data, Auto (on from the start) does so every 3.3 seconds, and Neon, Blueprint and Paper
				restyle it with CSS custom properties alone.
			</PageHero>

			<Heading id="install">Installing it</Heading>
			<p>
				Name the package in your app's header (<code>main.roc</code>), by its directory's name:
			</p>
			<Code source={"app [program] { charts: \"../packages/charts/main.roc\", pf: platform \"…/server/platform/main.roc\" }"} numbers={Bool.False} />
			<p>
				<code>rocx build</code> then copies each chart into your app; in a <code>.rocx</code> file,
				<code>import charts.BarChart</code> imports it (the <a href={"${Paths.ecosystem}#halves"}>ecosystem's
				overview</a> explains why). A chart needs its data and a few words about it:
			</p>
			<Code source={"import charts.BarChart\nimport charts.Format\n\n<BarChart data!={rain!()} label=\"Rain each month, in millimetres\" format={|mm| Format.num(mm, 0)} />"} numbers={Bool.False} />
			<p>
				Every chart takes the same three kinds of prop:
			</p>
			<ul>
				<li>
					<code>data!</code>, an <a href={"${Paths.components}#passing"}>accessor prop</a>: the chart calls
					it to read the data and follows its changes. Write any expression that reads your signals, like
					<code>{"data!={rain!()}"}</code>. Values are <code>Dec</code>, Roc's decimal.
				</li>
				<li>
					<code>label</code>, what the chart shows, for screen readers (<code>label!</code> on
					<code>{"<Sparkline>"}</code>, an accessor, since it changes with the data).
				</li>
				<li>
					<code>format</code>, which writes a value as text for ticks and readouts:
					<code>Format.short</code>
					(<code>1.3k</code>) unless you give your own. <code>{"<LineChart>"}</code> also has
					<code>format_x</code>;
					<code>{"<ScatterChart>"}</code> has <code>format_x</code> and <code>format_y</code> instead;
					<code>{"<Sparkline>"}</code> writes no values.
				</li>
			</ul>
			<p>
				In use: <a href={Paths.examples_plate}>Plate</a> (each day's energy as bars, weight as a line),
				<a href={Paths.examples_quiz}>the quiz</a> (how the room answered, as bars) and
				<a href={Paths.examples_uptime}>Uptime</a> (response times as a line, failures as a heatmap, a
				sparkline on each monitor's card).
			</p>

			<Heading id="bar">{"<BarChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-bar" idle="Roc is idle: the bars are where the data says.">
			<div data-demo="chart-bar"><BarDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use.file} source={Sources.charts_use.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => List(BarChart.Bar)"}</code>, <code>{"Bar := { label : Str, value : Dec, color : Str ?? \"\" }"}</code></td>
							<td>
								A bar per item, in order. A bar belongs to its label: a new value glides it to its
								new height;
								a new label grows a bar from the axis while the others make room; a gone label's bar
								shrinks
								into the axis and fades (its <code>{"<rect>"}</code>'s
								<a href={"${Paths.components}#transitions"}><code>transition:out</code></a>) as the
								others close
								up. A new order slides each bar to its place. A bar is in its <code>color</code> (any CSS
								colour: <code>"#c0392b"</code>, <code>"var(--brand)"</code>), which it keeps when pointed at;
								left out, it is the chart's.
							</td>
						</tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: on the ticks, and on a bar when it is pointed at or focused.</td></tr>
						<tr><td><code>{"padding : Dec ?? 0.3"}</code></td><td>The share of each bar's slot left empty. Blueprint's thin bars use 0.55, Paper's wide ones 0.12.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The axis runs from zero (or the least value, if negative) to the greatest, widened to round numbers.
				Tab reaches each bar; a screen reader reads its label and value. Two items with the same label are two
				bars.
			</p>

			<Heading id="stacked">{"<StackedBarChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-stacked" idle="Roc is idle: the columns are where the data says.">
			<div data-demo="chart-stacked"><StackDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_stacked.file} source={Sources.charts_use_stacked.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => List({ label : Str, values : List(Dec) })"}</code></td>
							<td>
								A column per item, one value per series stacked from the axis up. A column belongs
								to its
								label: its parts glide to their new sizes, a new column grows from the axis while
								the others
								make room, and a gone label's column shrinks into the axis and fades. A value below
								zero
								counts as zero.
							</td>
						</tr>
						<tr><td><code>{"series : List(Str)"}</code></td><td>The series' names, bottom one first. The legend over the chart shows each in its colour.</td></tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: on the ticks, and a column's total when it is pointed at or focused.</td></tr>
						<tr><td><code>{"padding : Dec ?? 0.3"}</code></td><td>The share of each column's slot left empty.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The axis runs from zero to the tallest column, widened to round numbers. Tab reaches each column; a
				screen reader reads its label and each series' value.
			</p>

			<Heading id="line">{"<LineChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-line" idle="Roc is idle: the line is where the data says.">
			<div data-demo="chart-line"><LineDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_line.file} source={Sources.charts_use_line.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => List({ x : Dec, y : Dec })"}</code></td>
							<td>
								The points, left to right: across by <code>x</code> (a day, an hour, a time in
								milliseconds), to scale, and up by <code>y</code>. When they change, the line glides
								to them;
								if their number changes, it jumps instead. For evenly spaced values,
								<code>{"LineChart.evenly(values)"}</code> puts them one apart, as the demo's hours
								are.
							</td>
						</tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: on the ticks up the side, and over the point under the pointer.</td></tr>
						<tr><td><code>{"format_x : (Dec -> Str) ?? Format.short"}</code></td><td>An <code>x</code> as text: on the ticks along the bottom, and the point's under the pointer.</td></tr>
						<tr><td><code>{"smooth : Bool ?? Bool.False"}</code></td><td>Monotone curves through the points (they never overshoot one) instead of straight segments.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The side axis runs from the least value to the greatest, widened to round numbers. The bottom one runs
				from the least <code>x</code> to the greatest, ticked on round numbers, so points on irregular days
				sit
				as far apart as the days: <a href={Paths.examples_plate}>Plate</a> draws its weight so, each day a
				number (<code>Date.days</code>). Pointing along the chart shows the nearest point, its value over the
				plot and its <code>x</code> on the axis. The pointer finds points by where the data puts them, not
				where the line is drawn, so a gliding line doesn't move them.
			</p>

			<Heading id="area">{"<StackedAreaChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-area" idle="Roc is idle: the bands are where the data says.">
			<div data-demo="chart-area"><AreaDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_area.file} source={Sources.charts_use_area.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => StackedAreaChart.Data"}</code>, <code>{"Data : { xs : List(Dec), bands : List(StackedAreaChart.Band) }"}</code>, <code>{"Band := { label : Str, values : List(Dec), color : Str ?? \"\" }"}</code></td>
							<td>
								The points across (<code>xs</code>, to scale, as a line chart's <code>x</code>) and a
								band for each part of the whole, a value at each point, stacked from the axis up in
								order (the first at the bottom), so the top edge is the whole. New values glide the
								bands to them; with more points or fewer, or other bands, the chart jumps. A value
								below zero counts as zero. A band is in its <code>color</code> (any CSS colour), it and
								its line in the legend; left out, it is the chart's colour for its place.
							</td>
						</tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: on the ticks up the side, each band's in the legend, and the whole over the point under the pointer.</td></tr>
						<tr><td><code>{"format_x : (Dec -> Str) ?? Format.short"}</code></td><td>An <code>x</code> as text: on the ticks along the bottom, and the point's under the pointer.</td></tr>
						<tr><td><code>{"smooth : Bool ?? Bool.False"}</code></td><td>Monotone curves through the points, as the line chart's.</td></tr>
						<tr><td><code>{"resting : [Last, Sum] ?? Last"}</code></td><td>What the legend says while no point is pointed at: each band's value at the last point (<code>Last</code>, a running total's now), or all its points' added up (<code>Sum</code>, of a count each day the period's, as the demo's fortnight).</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The side axis runs from zero to the highest whole, widened to round numbers; the bottom one as the line
				chart's. The legend says each band's value and its share of the whole, in whole percents that add up
				to 100 as a donut's do: at the point you point at, whose whole shows over the plot and whose
				<code>x</code> on the axis, or, while you point at none, as <code>resting</code> says. To a screen
				reader the chart is one image, beside the legend's words.
			</p>

			<Heading id="sparkline">{"<Sparkline>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-sparkline" idle="Roc is idle: the lines are where the data says.">
			<div data-demo="chart-sparkline"><SparkDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_sparkline.file} source={Sources.charts_use_sparkline.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr><td><code>{"data! : () => List(Dec)"}</code></td><td>The values, left to right. When they change, the line glides to them.</td></tr>
						<tr><td><code>{"label! : () => Str"}</code></td><td>What it shows, for screen readers: with no axis, say the trend. An accessor, since it changes with the data.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				A small line with no axis, shaded underneath, with a dot on the last value, to sit beside a number.
				It spans its values' range, so it shows their shape, not their size. The tiles around these are the
				demo's, not the package's.
			</p>

			<Heading id="donut">{"<DonutChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-donut" idle="Roc is idle: the slices are where the data says.">
			<div data-demo="chart-donut"><DonutDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_donut.file} source={Sources.charts_use_donut.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => List(DonutChart.Slice)"}</code>, <code>{"Slice := { label : Str, value : Dec, color : Str ?? \"\" }"}</code></td>
							<td>
								A slice per item, clockwise from twelve o'clock, its share of the ring its share of
								the
								total. A slice belongs to its label: a new value glides it to its new share, a new
								label grows
								a slice from nothing while the others make room, and a gone label's slice shrinks to
								nothing
								where it was. A value below zero counts as zero. A slice is in its <code>color</code> (any CSS
								colour), it and its legend line; left out, it is one of the chart's five.
							</td>
						</tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: the total, and each slice's value in the legend.</td></tr>
						<tr><td><code>{"total : Str ?? \"Total\""}</code></td><td>The word under the total.</td></tr>
						<tr><td><code>{"thickness : Dec ?? 52"}</code></td><td>The ring's width, out of a radius of 150. Blueprint's 24 is a thin ring; Paper's 150 is a pie. Above 90 there is no room in the middle, so the total isn't shown.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				The middle shows the total, or a slice's share while you point at it, focus it (Tab reaches each) or
				point at its legend line. A slice keeps its colour as others come and go; a new slice takes a colour
				no other has, unless the data gives each its own.
			</p>
			<p>
				A bar or a slice may carry its colour in the data, as a slice for each party in its party's:
				<code>{"{ label: party.name, value: party.seats, color: party.color }"}</code>. A record written where
				the data is passed is the chart's type, with <code>color</code> or without; a list already typed as
				plain records isn't, so name the chart's type in its annotation (<code>List(DonutChart.Slice)</code>),
				or build the records where you pass them.
			</p>

			<Heading id="scatter">{"<ScatterChart>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-scatter" idle="Roc is idle: the dots are where the data says.">
			<div data-demo="chart-scatter"><ScatterDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_scatter.file} source={Sources.charts_use_scatter.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"data! : () => List({ label : Str, x : Dec, y : Dec })"}</code></td>
							<td>
								A dot per item, across by <code>x</code> and up by <code>y</code>. A dot belongs to
								its label,
								so new values glide it to its new place. A new dot swells from nothing; a gone
								label's dot
								shrinks away (a
								<a href={"${Paths.components}#transitions"}><code>transition</code></a> both
								ways).
							</td>
						</tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format_x : (Dec -> Str) ?? Format.short"}</code></td><td>A value across: on the ticks along the bottom, and on a dot when it is pointed at or focused.</td></tr>
						<tr><td><code>{"format_y : (Dec -> Str) ?? Format.short"}</code></td><td>A value up: on the ticks up the side, and on a dot.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Each axis runs from least to greatest, widened to round numbers. Tab reaches each dot; a screen reader
				reads its label and values.
			</p>

			<Heading id="heatmap">{"<Heatmap>"}</Heading>
		</NoHydration>
		<Demo game meter="chart-heatmap" idle="Roc is idle: the browser fades the cells.">
			<div data-demo="chart-heatmap"><HeatDemo /></div>
		</Demo>
		<NoHydration>
			<Code title={Sources.charts_use_heatmap.file} source={Sources.charts_use_heatmap.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr><td><code>{"data! : () => List(List(Dec))"}</code></td><td>A list of values for each row, one value per column. A cell's colour goes from <code>--chart-heat-low</code> at zero to <code>--chart-heat-high</code> at the greatest value.</td></tr>
						<tr><td><code>{"rows : List(Str)"}</code></td><td>The rows' labels, down the side.</td></tr>
						<tr><td><code>{"columns : List(Str)"}</code></td><td>The columns' labels. Each appears in the readout; along the bottom there is room for about eight, so with more columns only every second or third is shown.</td></tr>
						<tr><td><code>label : Str</code></td><td>What the chart shows, for screen readers.</td></tr>
						<tr><td><code>{"format : (Dec -> Str) ?? Format.short"}</code></td><td>A value as text: the scale's ends, and the cell pointed at.</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Under the grid are the colour scale and a readout of the cell under the pointer (row, column, value);
				that cell's outline is drawn on top, so no neighbour covers it. A new value changes a cell's strength
				(a custom property), and a CSS transition fades it to its new colour, so Roc runs no frames: the line
				under the demo stays at zero.
			</p>

			<Heading id="moving">How they move</Heading>
			<p>
				A chart keeps what it has drawn in a <a href={"${Paths.components}#primitives"}>signal</a>, apart from
				its data. While the two differ, a hole's <code>if</code> holds an element with an
				<code>on:frame.ms</code> handler that, once per animation frame, moves the drawing a share of the
				remaining way (<code>Ease.toward</code>). Once the drawing reaches the data, the <code>if</code> turns
				false, the element goes, and the frames stop. The line under each demo counts them.
			</p>
			<p>
				Marks are kept by label, so new data moves the mark you see instead of making another. A mark that
				comes or goes plays a <a href={"${Paths.components}#transitions"}>transition</a>, which the browser
				runs. The heatmap leaves even the glide to the browser.
			</p>
			<p>
				The buttons are the demos', not the package's. Randomize sets the data's signal. Auto starts a
				<a href={"${Paths.showcase}#timers"}><code>set_interval!</code></a> and keeps the
				<code>clear!</code> it
				returns in a signal, so pressing Auto again stops it.
			</p>
			<details>
				<summary>The buttons and the looks, and the demos' data: <code>{Sources.demo_shuffle.file}</code>
				and the eight demos</summary>
				<Code title={Sources.demo_shuffle.file} source={Sources.demo_shuffle.rocx} />
				<Code title={Sources.demo_bars.file} source={Sources.demo_bars.rocx} />
				<Code title={Sources.demo_stacked.file} source={Sources.demo_stacked.rocx} />
				<Code title={Sources.demo_line.file} source={Sources.demo_line.rocx} />
				<Code title={Sources.demo_area.file} source={Sources.demo_area.rocx} />
				<Code title={Sources.demo_sparkline.file} source={Sources.demo_sparkline.rocx} />
				<Code title={Sources.demo_donut.file} source={Sources.demo_donut.rocx} />
				<Code title={Sources.demo_scatter.file} source={Sources.demo_scatter.rocx} />
				<Code title={Sources.demo_heatmap.file} source={Sources.demo_heatmap.rocx} />
			</details>

			<Heading id="styling">Styling, three ways</Heading>
			<p>
				Each chart is <code>width: 100%</code> (a donut and its legend share it, wrapping when narrow).
				Colours, lines and font come from CSS custom properties, falling back to the text's colour or a plain
				default. So a look is a few lines of CSS on any element around the charts. Neon, Blueprint and Paper
				are three: each one rule on the demo's stage, plus a prop or two the demo changes with it (the bars'
				<code>padding</code>, the line's <code>smooth</code>, the donut's <code>thickness</code>).
			</p>
			<Code title={Sources.charts_look.file} source={Sources.charts_look.rocx} />
			<TableWrap>
				<table>
					<thead><tr><th>Property</th><th>Sets</th></tr></thead>
					<tbody>
						<tr><td><code>--chart-color</code>, <code>--chart-active</code></td><td>The colour of bars, lines and dots; the colour of a bar or dot pointed at, and of the line chart's point. A bar's own <code>color</code> comes first.</td></tr>
						<tr><td><code>--chart-1</code> to <code>--chart-5</code></td><td>The colours of a donut's slices, a stacked bar chart's series and a stacked area chart's bands. A colour stays with its slice or series; a band takes its place's. A slice's or a band's own <code>color</code> comes first.</td></tr>
						<tr><td><code>--chart-heat-low</code>, <code>--chart-heat-high</code></td><td>A heatmap's colours at zero and at the greatest value.</td></tr>
						<tr><td><code>--chart-fill</code>, <code>--chart-stroke</code>, <code>--chart-stroke-width</code>, <code>--chart-outline</code></td><td>The marks' fill opacity (a stacked area chart's bands 0.3 unless set) and outline. With <code>--chart-outline: 1</code>, a slice or a part is outlined in its own colour instead of the surface's.</td></tr>
						<tr><td><code>--chart-radius</code>, <code>--chart-dot</code>, <code>--chart-line-width</code>, <code>--chart-area</code></td><td>Bars' rounded corners, dots' radius, lines' width, and the shading under a line (0 for none).</td></tr>
						<tr><td><code>--chart-grid</code>, <code>--chart-grid-dash</code>, <code>--chart-axis</code>, <code>--chart-muted</code></td><td>The grid and its dashes, the axis, and the text of ticks and labels.</td></tr>
						<tr><td><code>--chart-surface</code>, <code>--chart-font</code>, <code>--chart-glow</code></td><td>The background behind the marks (it shows in the gaps between slices and parts), the font, and a <code>filter</code> on the marks (Neon's <code>drop-shadow</code>).</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="modules">The arithmetic</Heading>
			<p>
				The components draw with plain functions on no platform, which you can use for your own charts.
				Numbers are <code>Dec</code>, so the ticks from 0 to 1 are exactly 0.2, 0.4, 0.6 and 0.8.
				<code>roc test packages/charts/main.roc</code> runs their <code>expect</code>s; the
				<a href={"https://github.com/Roc-Solid/rocx/tree/master/packages/charts"}>README</a>
				lists every function.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Module</th><th>What it does</th></tr></thead>
					<tbody>
						<tr><td><code>Scale</code></td><td><code>Scale.linear(domain, range)</code> maps values to places: <code>scale.at(value)</code> is a place, <code>scale.invert(place)</code> a value. <code>.nice(count)</code> widens the domain to round numbers, <code>.ticks(count)</code> lists them, and <code>Scale.extent(values)</code> is the least and the greatest. <code>Scale.strips(places, range)</code> gives each place the stretch nearer it than its neighbours (how the line chart's pointer finds points).</td></tr>
						<tr><td><code>Band</code></td><td><code>Band.band(count, range, padding)</code> gives a slot to each bar: <code>.at(slot)</code>, <code>.width()</code>, <code>.center(slot)</code>. A count and a slot may be fractions, as they are while a chart glides from seven bars to six.</td></tr>
						<tr><td><code>Ticks</code></td><td>About <code>count</code> ticks at 1, 2 or 5 times a power of ten.</td></tr>
						<tr><td><code>Path</code></td><td>SVG path data: <code>line</code>, <code>smooth</code> (monotone curves), <code>area</code>, <code>smooth_area</code>, and <code>arc</code> (a donut's slice).</td></tr>
						<tr><td><code>Format</code></td><td>Numbers as labels: <code>num(x, places)</code> (<code>"2.5"</code>, not <code>"2.50"</code>), <code>short</code> (<code>"1.3k"</code>), <code>percent</code>, <code>shares</code> (whole percents that add up to 100, as a donut's legend says them), and <code>coord</code> (to hundredths, for SVG).</td></tr>
						<tr><td><code>Ease</code></td><td><code>toward(from, to, ms, close)</code>: one frame's step of a glide, which finishes once it is within <code>close</code>.</td></tr>
						<tr><td><code>Keys</code></td><td>What keeps a mark its own: <code>unique</code> (a key per label, <code>Jan#1</code> for a second <code>Jan</code>), <code>merge</code> (the new keys, with the ones on their way out kept where they were), <code>slots</code> (a colour that stays with its key).</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="limits">Limits, for now</Heading>
			<ul>
				<li>
					Values are <code>Dec</code>, and Roc has no <code>F64</code> to <code>Dec</code> conversion yet.
					Round to an integer and divide:
					<code>(x * 1000.0).round_to_i64_try()</code>, then <code>.to_dec() / 1000.0</code>.
				</li>
				<li>
					Stacked bars have five colours, so a sixth series shares one, and so do a donut's sixth slice and
					a stacked area chart's sixth band unless the data gives them their colours: fold the smallest
					into "Other". When new data
					reorders a donut's slices, they jump rather than glide.
				</li>
				<li>
					Tab can't reach a heatmap's cells or a line chart's, stacked area chart's or sparkline's points; to a screen reader,
					each is one image, named by its label.
				</li>
				<li>
					A line chart's ticks along the bottom fall on round numbers of its <code>x</code>: days since 1970
					in steps of 1, 2, 5, 10 or 20, not each Monday or the first of each month.
				</li>
				<li>
					rocx requires HTML tags in lower case, so SVG's camel-cased elements
					(<code>{"<linearGradient>"}</code>, <code>{"<clipPath>"}</code>) can't be written yet.
				</li>
			</ul>
