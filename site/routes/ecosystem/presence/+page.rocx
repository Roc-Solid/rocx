import pf.Html
import presence.AvatarStack
import presence.LiveCursors
import presence.Stack
import presence.TypingIndicator
import ../../../Demos/PresenceDemo
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Ui/Demo
import ../../../Ui/Heading
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Generated/Sources
import ../../../Generated/Paths

## The presence package: a room kept in the browser first (this site has no server), then how an
## app uses it, each component, how a room works, the stores, the modules, and what waits on the
## platform.
meta = {
	title: "Presence",
	description: "Who is here, who is typing and where they point, for Roc Solid apps: an avatar stack, a typing indicator and live cursors, over a room the server keeps.",
	toc: [
		{ id: "room", label: "A room, in your browser" },
		{ id: "use", label: "Using it" },
		{ id: "stack", label: "<AvatarStack>" },
		{ id: "typing", label: "<TypingIndicator>" },
		{ id: "cursors", label: "<LiveCursors>" },
		{ id: "how", label: "How a room works" },
		{ id: "stores", label: "The stores" },
		{ id: "modules", label: "The modules" },
		{ id: "styling", label: "Styling" },
		{ id: "status", label: "Status" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/presence</code>]}
				title="Who is here, who is typing, and where they point"
			>
				An avatar stack, a typing line and live cursors for a shared page, fed by a room the server keeps.
				Tabs come and go cleanly: a reload doesn't flicker, and a laptop that shuts is swept out.
			</PageHero>
			<p>
				Use it when people share a page (a board, a document, a quiz) and should see who else is there. A
				<em>room</em> is the set of people on that page right now, each with a name, a colour and a status.
				The package has three components that show a room (<code>{"<AvatarStack>"}</code>,
				<code>{"<TypingIndicator>"}</code> and <code>{"<LiveCursors>"}</code>), a browser side that joins one
				(<code>Presence.join!</code>), and a server side that keeps it (<code>PresenceServer</code>), all on a
				route's <a href={"${Paths.platform_live}#channels"}>channel</a>.
			</p>

			<Heading id="room">A room, in your browser</Heading>
			<p>
				This site has no server, so the demo plays its part: it keeps a list of who is here and tells the
				package's stores what a room's channel would. Press a button, or let Auto (on from the start) act
				every 1.5 seconds.
			</p>
		</NoHydration>
		<Demo>
			<div data-demo="presence"><PresenceDemo /></div>
		</Demo>
		<NoHydration>
			<p>
				Faces grow in and fade out. A typing line runs out on its own; no message says the person stopped. A
				cursor glides to each place it is sent, fades once still (press Auto to stop them), and is forgotten
				later. The demo's times are short (four seconds for typing, three to fade, twenty to forget);
				<code>Presence.join!</code> uses seven, five and thirty.
			</p>

			<Heading id="use">Using it</Heading>
			<p>
				Name the package in the app's header, as for any <a href={Paths.ecosystem}>package</a>. It isn't a
				plugin, so the program needs nothing more:
			</p>
			<Code source={"app [program] { pf: platform \"…/server/platform/main.roc\", presence: \"…/packages/presence/main.roc\" }"} numbers={Bool.False} />
			<p>
				<code>rocx generate</code> (which <code>rocx dev</code> and <code>rocx build</code> run first) copies the
				components and browser stores into the app, so both halves compile them. Each component takes its data as an accessor (a function ending in <code>!</code> that reads a
				value), so it shows whatever feeds it: a room's channel, or here, the demo.
			</p>
			<Code title={"${Sources.presence_use.file}, in part"} source={Sources.presence_use.rocx} />
			<p>
				In an app, a room is a route's <a href={"${Paths.platform_live}#channels"}>channel</a> under
				<code>api/</code>, named by its URL. The channel's check admits a member as the person the
				middleware says they are: key and metadata come from the server, never the page. Its hooks are
				<code>PresenceServer</code>'s, so a tab joins as it subscribes and leaves when the subscription
				ends. The whole route from examples/board:
			</p>
			<Code title={Sources.presence_route.file} source={Sources.presence_route.rocx} />
			<p>
				The page joins with <code>Presence.join!</code>, given the channel. It subscribes, tells the room
				every 15 seconds that the tab is still here, and returns the accessors the components read
				(<code>members!</code>, <code>others!</code>, <code>typing!</code>, <code>cursors!</code>) and the
				functions that tell the room about this tab (<code>status!</code>, <code>update!</code>,
				<code>typed!</code>, <code>moved!</code>…). It all goes over the tab's one live stream, with its
				other channels; presence needs no other endpoint.
			</p>
			<Code title={"${Sources.presence_join.file}, in part"} source={Sources.presence_join.rocx} />
			<p>
				A status is <code>Online</code> (the start), <code>Away</code>, <code>Busy</code> or
				<code>Offline</code>: a typo is a compile error, and the avatar stack knows how to show each. Set it
				from a handler or an effect with <code>{"(here.status!)(Busy)"}</code>. To show a hidden tab as away,
				add <code>{"<Document on:visibilitychange.visible={here.visible!} />"}</code>: while hidden, the tab
				is <code>Away</code> and its cursor gone; shown again, its status comes back.
			</p>
			<p>
				A member's metadata, <code>Wire.Meta(d)</code>, is what the components show (name, picture, colour,
				status) plus <code>data</code>: the app's own, of any type JSON can carry and <code>==</code> can
				compare (<code>{"{}"}</code> for none). The channel's check sets it first; the page changes
				<code>data</code> with <code>{"(here.update!)(data)"}</code>, up to a kibibyte of JSON. On the board
				it is the card a person has open (<code>{"{ card : Str }"}</code>), shown on each tile. Name, picture and
				colour stay the server's. A room where only the server may set <code>data</code> refuses
				<code>Update</code> in its own <code>receive!</code>. <code>{"Wire.meta(name, data)"}</code> makes
				metadata, leaving the rest to the components.
			</p>

			<Heading id="stack">{"<AvatarStack>"}</Heading>
			<div class="sample">
				<AvatarStack faces!={faces} max={4} />
			</div>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"faces! : () => List(Stack.Face)"}</code></td>
							<td>
								who is here, in order: <code>{"{ key, name, image, color, status }"}</code>, made
								from a member by <code>Wire.face</code>. With no <code>image</code>, a face shows
								its initials on its <code>color</code>; with no <code>color</code> either, on one
								picked from its key, the same every time
							</td>
						</tr>
						<tr><td><code>{"max : U64 ?? 5"}</code></td><td>how many places the stack takes, counting the <code>+N</code></td></tr>
						<tr><td><code>{"label : Str ?? \"\""}</code></td><td>what a screen reader hears for the stack; when empty, it says who is here: <code>"Ann, Bo and 2 others are here"</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Each face gets its status as a class, such as <code>status-away</code>. <code>Online</code> needs no
				mark (being in the stack says it); <code>Away</code> dims the face and adds an orange dot;
				<code>Busy</code> adds a red dot;
				<code>Offline</code> greys the face (as examples/quiz shows a player who dropped). A screen reader
				hears the status after the name: "Alan Turing (away)". The <code>+N</code>'s tooltip names who it
				stands for.
			</p>

			<Heading id="typing">{"<TypingIndicator>"}</Heading>
			<div class="sample">
				<TypingIndicator names!={["Ada Lovelace", "Alan Turing"]} />
			</div>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr><td><code>{"names! : () => List(Str)"}</code></td><td>who is typing; <code>Wire.names(members, keys)</code> turns the room's keys into names</td></tr>
						<tr><td><code>{"say : (List(Str) -> Str) ?? Typing.sentence"}</code></td><td>writes the sentence: <code>"Ann is typing…"</code>, <code>"Ann and Bo are typing…"</code>, <code>"Ann, Bo and 2 others are typing…"</code>. Give your own for another language</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Three bobbing dots and the sentence. With no one typing, the line keeps its height, so nothing below
				jumps. A screen reader hears it change (<code>aria-live="polite"</code>).
			</p>

			<Heading id="cursors">{"<LiveCursors>"}</Heading>
		</NoHydration>
		<div class="sample">
			<LiveCursors cursors!={cursors}>
				<div class="area"><p>What everyone points at</p></div>
			</LiveCursors>
		</div>
		<NoHydration>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"cursors! : () => List(LiveCursors.Pointer)"}</code></td>
							<td>
								others' cursors, <code>{"{ key, name, color, x, y, idle }"}</code>, made by
								<code>Wire.pointers(members, cursors)</code>. <code>x</code> and <code>y</code> are
								fractions of the area (0 to 1), so a place is the same on any screen
							</td>
						</tr>
						<tr><td><code>{"children : List(Html)"}</code></td><td>the area they point at</td></tr>
						<tr><td><code>{"on_move! : (Html.Point => {}) ?? |_| {}"}</code></td><td>called with your own pointer's place over the area (fractions of it), at most once a frame. Pass a room's <code>here.moved!</code>, which sends it at most 20 times a second</td></tr>
						<tr><td><code>{"on_leave! : (() => {}) ?? || {}"}</code></td><td>called when your pointer leaves the area. Pass a room's <code>here.away!</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Each cursor is an arrow in its member's colour, with their name. Cursors take no pointer events, so
				clicks reach what is under them. To send your own, write
				<code>{"<LiveCursors … on_move!={here.moved!} on_leave!={here.away!}>"}</code>; over the demo's note,
				yours shows as the others would see it, labelled You. Since it listens to the pointer,
				<code>{"<LiveCursors>"}</code> must be outside a <code>{"<NoHydration>"}</code>, as the sample above
				is.
			</p>

			<Heading id="how">How a room works</Heading>
			<p>
				<strong>The server keeps the room</strong> in its own memory: no broker to run. <code>Room</code> is
				the room's state: who is here, with their metadata, since when, and from which tabs.
				<code>join</code>, <code>leave</code>, <code>update</code> (new metadata) and <code>sweep</code>
				return the changes others should hear (<code>Joined</code>, <code>Left</code> or <code>Changed</code>), numbering the state with
				each. <code>Room</code> never reads a clock: the caller passes the time in, so tests check a timeout
				without waiting:
			</p>
			<Code title={"${Sources.presence_grace.file}, in part"} source={Sources.presence_grace.rocx} />
			<ul>
				<li>
					<strong>Leaving has a grace period.</strong> A member with two tabs is one face, and leaves with
					the last. A tab whose stream ends leaves after five seconds unless it is back, so a reload or
					reconnect doesn't flicker out and in. A page that drops the room while the tab stays open (it
					went to another room) leaves at once: its <code>on_close!</code> hook is told
					<code>Dropped</code>.
				</li>
				<li>
					<strong>Vanishing has a timeout.</strong> A page says it is here every 15 seconds; a tab unheard
					for 75 seconds (a laptop shut, a network gone) is swept out, however long its connection
					lingers. Browsers may slow a hidden tab's timers to once a minute, so 75 seconds is that
					minute plus a beat. The live stream usually notices first: the server writes a beat on it
					every 15 seconds, and drops a connection that leaves it unacknowledged for 20. That ends the
					tab's subscription (<code>Gone</code>), and the grace runs from there.
				</li>
				<li>
					<strong>Changes are numbered.</strong> A page's copy of the room (<code>Mirror</code>) takes a
					snapshot, then each change in order, ignoring any older than the snapshot. A skipped number
					means a missed change, and the page asks for a fresh snapshot.
				</li>
				<li>
					<strong>Kept in memory, swapped in.</strong> Each room lives in the server's
					<a href={Paths.platform_kv}>Kv</a> store. A change reads the room, sweeps it, changes it, and
					writes it back only if no one else changed it meanwhile (<code>Kv.swap!</code>), else reads
					it again. So two tabs joining at once both count, and nothing is written to the database. The
					change is then published on the room's channel, numbered. Since each change sweeps first, a
					tab past its grace goes at the room's next change, another tab's beat at the latest. A room
					silent for a quarter of an hour is forgotten.
				</li>
				<li>
					<strong>Typing and cursors are passed on, never kept.</strong> The server forwards them to the
					other tabs. Only a cursor's latest place counts, so a tab that falls behind skips to it.
				</li>
			</ul>

			<Heading id="stores">The stores</Heading>
			<p>
				The browser's side is a set of Solid-style stores: functions you call in a component, like
				<code>create_signal!</code>, that keep state in signals. <code>join!</code> is a whole room on its
				channel; the others are its parts, and take what a room says however it arrives, so you can feed them
				from elsewhere, as the demo does.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Store</th><th>Gives</th></tr></thead>
					<tbody>
						<tr><td><code>{"Presence.join!(channel)"}</code></td><td>the room on a route's channel, joined while the component is on the page: everything <code>create_room!</code> gives, fed by the channel, plus <code>others!</code> (everyone but you) and what this tab says: <code>status!(status)</code>, <code>update!(data)</code>, <code>typed!()</code> and <code>done!()</code>, <code>moved!(point)</code> and <code>away!()</code>, <code>visible!(shown)</code>. Every 15 seconds it tells the room this tab is here, and repeats its <code>data</code> if the room has other data for it</td></tr>
						<tr><td><code>{"Presence.create_room!(on_gap!)"}</code></td><td>all the parts at once, fed a room's events with <code>heard!(event)</code>: <code>members!</code>, <code>synced!</code>, <code>me!</code> (this tab's key and id), <code>typing!</code> (others' keys), <code>cursors!</code> (others'), and <code>lost!</code> for when the stream drops. Someone who leaves stops typing, and their cursor goes</td></tr>
						<tr><td><code>{"Presence.create_presence!(on_gap!)"}</code></td><td>who is here: <code>members!</code>, <code>synced!</code>, <code>receive!(message)</code>, <code>lost!</code>. <code>on_gap!</code> runs when a change was missed</td></tr>
						<tr><td><code>{"Presence.create_typing!(ttl)"}</code></td><td>who is typing: <code>who!</code>, <code>started!(key)</code>, <code>stopped!(key)</code>. A ping lasts <code>ttl</code> milliseconds</td></tr>
						<tr><td><code>{"Presence.create_typist!(every, send!)"}</code></td><td>your own typing: call <code>typed!()</code> on each key and <code>done!()</code> when the text is sent or left. <code>send!</code> is given <code>Started</code> (at once, then at most every <code>every</code> milliseconds) or <code>Stopped</code></td></tr>
						<tr><td><code>{"Presence.create_cursors!({ idle, forget })"}</code></td><td>others' cursors: <code>shown!</code>, <code>moved!(move)</code>, <code>gone!(key)</code></td></tr>
						<tr><td><code>{"Presence.create_pointer!(every, send!)"}</code></td><td>your own pointer: <code>moved!(point)</code> and <code>away!()</code>. <code>send!</code> is given <code>Moved(point)</code> at once, then at most every <code>every</code> milliseconds (the latest place held and sent when due, so a cursor ends where the pointer stopped), or <code>Away</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Call each store at most once per handler. As in Solid 2.0, a handler's writes apply when it is done,
				so a second call sees the store as it was before the first, and the first change is lost. A channel
				gives each event its own handler, so a page fed by one is safe. A store whose entries expire (typing,
				idle cursors) runs a quarter-second timer only while something can expire.
			</p>
			<p>
				The demo, with no channel, does what one would: a press tells the stores what happened, one call each,
				and each cursor move comes from its own timeout.
			</p>
			<Code title={"${Sources.presence_stores.file}, in part"} source={Sources.presence_stores.rocx} />

			<Heading id="modules">The modules</Heading>
			<p>
				Under the components and stores is plain Roc on no platform, so the server's hooks and the browser's
				stores run the same code. The browser sees these modules through the package's
				<code>browser.roc</code>; the server also sees <code>PresenceServer</code>.
				<code>roc test packages/presence/main.roc</code> runs their <code>expect</code>s. The
				<a href="https://github.com/Roc-Solid/rocx/tree/master/packages/presence">package's README</a> lists
				every function.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Module</th><th>What it does</th></tr></thead>
					<tbody>
						<tr><td><code>Room</code></td><td>a room, as the server keeps it: <code>join</code>, <code>update</code>, <code>heartbeat</code>, <code>leave</code>, <code>quit</code>, <code>sweep</code>, <code>signal</code>; <code>members</code>, <code>version</code>, and <code>deadline</code> (when the next sweep could find someone); <code>save</code> and <code>load</code> for JSON; <code>Room.defaults</code> and <code>beat_every</code></td></tr>
						<tr><td><code>Mirror</code></td><td>a page's copy of a room: <code>receive</code> a <code>Snapshot</code> or a numbered <code>Delta</code> (<code>Err(Gap)</code> when one was missed), <code>members</code>, <code>is_synced</code></td></tr>
						<tr><td><code>Diff</code></td><td><code>between(before, after)</code>: who left, joined and changed; <code>apply</code> one change</td></tr>
						<tr><td><code>Throttle</code></td><td>at most one send every <code>every</code> milliseconds: the first at once, the latest held until it is due. A cursor sent 20 times a second ends where the pointer stopped</td></tr>
						<tr><td><code>Cursors</code></td><td><code>place</code> (a pointer's pixels as fractions of the area), <code>moved</code>, <code>gone</code>, <code>shown</code>, <code>sweep</code>, <code>coalesce</code> (a burst, one move per member), <code>percent</code></td></tr>
						<tr><td><code>Typing</code></td><td>who is typing: <code>started</code>, <code>stopped</code>, <code>who</code>, <code>deadline</code>, <code>sentence</code></td></tr>
						<tr><td><code>Typist</code></td><td>your own typing: <code>typed(now)</code> says when to ping, <code>done</code> when to say it stopped</td></tr>
						<tr><td><code>Stack</code></td><td><code>split</code> (who fits, and the <code>+N</code>), <code>initials</code> (<code>"Ada Lovelace"</code> is <code>"AL"</code>), <code>color</code> (the same key always gets the same colour), <code>names</code>, <code>label</code>; a face's <code>Status</code> and its <code>status_word</code></td></tr>
						<tr><td><code>Wire</code></td><td>what a room's channel carries: to a page, an <code>Event</code> (<code>Welcome</code>, <code>Presence</code>, <code>Typing</code>, <code>Moved</code>, <code>Away</code>); from one, a <code>Said</code> (<code>Here</code> with its status, <code>Update</code> with its data, <code>Typing</code>, <code>Moved</code>, <code>Away</code>); who is in it, a <code>Member</code> (a key and a <code>Meta</code>: name, image, color, status, data); <code>meta(name, data)</code>; and <code>face</code>, <code>names</code> and <code>pointers</code> to feed the components</td></tr>
						<tr><td><code>PresenceServer</code></td><td>the server's side: a room channel's hooks, <code>on_open!</code>, <code>on_close!</code> and <code>receive!</code>, with the room kept in <code>Kv</code></td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="styling">Styling</Heading>
			<p>
				Sizes and colours come from CSS custom properties. The avatar stack:
				<code>--avatar-size</code> (2rem), <code>--avatar-overlap</code> (0.375rem), <code>--avatar-ring</code>
				(the ring between faces; set it to the page's background), <code>--avatar-font</code>,
				<code>--avatar-more</code>, <code>--avatar-away</code>, <code>--avatar-busy</code> and
				<code>--avatar-offline</code> (an offline face's opacity, 0.5). The typing line: <code>--typing-color</code> and <code>--typing-size</code>. Cursors:
				<code>--cursor-glide</code> (0.12s; the demo's is 1.4s) and <code>--cursor-font</code>. Under
				<code>prefers-reduced-motion</code>, the dots stop bobbing and cursors jump instead of gliding.
			</p>

			<Heading id="status">Status</Heading>
			<p>
				Everything above works today. In examples/board, two people in their own browsers see each other,
				which card each has open, one going away while their tab is hidden, and a third leaving when they
				close their browser.
			</p>
			<p>
				Not yet (the package's PROPOSALS.md has details): a room that trusts the live stream's end and
				drops the page's 15-second beats, and a room named by the page's path with no route of its own (a
				"who's viewing this page" stack).
			</p>
			<details>
				<summary>The demo: <code>{Sources.presence_demo.file}</code></summary>
				<Code title={Sources.presence_demo.file} source={Sources.presence_demo.rocx} />
			</details>
			<details>
				<summary>The avatar stack: <code>{Sources.presence_avatar_stack.file}</code></summary>
				<Code title={Sources.presence_avatar_stack.file} source={Sources.presence_avatar_stack.rocx} />
			</details>
			<details>
				<summary>The typing indicator: <code>{Sources.presence_typing_indicator.file}</code></summary>
				<Code title={Sources.presence_typing_indicator.file} source={Sources.presence_typing_indicator.rocx} />
			</details>
			<details>
				<summary>The cursors: <code>{Sources.presence_live_cursors.file}</code></summary>
				<Code title={Sources.presence_live_cursors.file} source={Sources.presence_live_cursors.rocx} />
			</details>
			<details>
				<summary>The stores: <code>{Sources.presence_stores_file.file}</code></summary>
				<Code title={Sources.presence_stores_file.file} source={Sources.presence_stores_file.rocx} />
			</details>
			<details>
				<summary>The server's side: <code>{Sources.presence_server.file}</code></summary>
				<Code title={Sources.presence_server.file} source={Sources.presence_server.rocx} />
			</details>
		</NoHydration>
	</>

## The avatar stack's sample: seven here, four places.
faces : List(Stack.Face)
faces = [
	face("ada", "Ada Lovelace", Online),
	face("alan", "Alan Turing", Away),
	face("grace", "Grace Hopper", Online),
	face("edsger", "Edsger Dijkstra", Busy),
	face("barbara", "Barbara Liskov", Online),
	face("donald", "Donald Knuth", Online),
	face("frances", "Frances Allen", Online),
]

face : Str, Str, Stack.Status -> Stack.Face
face = |key, name, status| { key, name, image: "", color: "", status }

## The cursors' sample: one moving, one still a while.
cursors : List(LiveCursors.Pointer)
cursors = [
	{ key: "ada", name: "Ada", color: Stack.color("ada"), x: 0.22, y: 0.3, idle: Bool.False },
	{ key: "alan", name: "Alan", color: Stack.color("alan"), x: 0.68, y: 0.55, idle: Bool.True },
]

