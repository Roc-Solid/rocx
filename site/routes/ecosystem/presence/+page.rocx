import pf.Html
import presence.AvatarStack
import presence.LiveCursors
import presence.Stack
import presence.TypingIndicator
import ../../../Demos/PresenceDemo
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Ui/Demo
import ../../../Ui/Heading
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Generated/Sources
import ../../../Generated/Paths

## The presence package: a room kept in the browser first (this site has no server), then how an
## app uses it, each component, how a room works, the stores, the modules, and what waits on the
## platform.
meta = {
	title: "Presence",
	description: "Who is here, who is typing and where they point, for Roc Solid apps: an avatar stack, a typing indicator and live cursors, over a room the server keeps.",
	toc: [
		{ id: "room", label: "A room, in your browser" },
		{ id: "use", label: "Using it" },
		{ id: "stack", label: "<AvatarStack>" },
		{ id: "typing", label: "<TypingIndicator>" },
		{ id: "cursors", label: "<LiveCursors>" },
		{ id: "how", label: "How a room works" },
		{ id: "stores", label: "The stores" },
		{ id: "modules", label: "The modules" },
		{ id: "styling", label: "Styling" },
		{ id: "status", label: "Status" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/presence</code>]}
				title="Who is here, who is typing, and where they point"
			>
				A room's presence: who is in it right now, with a name, a colour and a status each; who is
				typing; and everyone's cursor over what they share. A member with two tabs open is one face, and
				leaves when the last tab does. A page that goes to another room leaves at once, and one that
				closes a few seconds later; one that vanishes without a word, a laptop shut or a network gone, is
				swept out when its heartbeats stop.
			</PageHero>

			<Heading id="room">A room, in your browser</Heading>
			<p>
				This site is static files, with no server to keep a room. So the demo plays the server's part: it
				keeps a list of who is here, and tells the package's stores and components what a room's channel
				would. Press a button, or let Auto, on from the start, do something every 1.5 seconds.
			</p>
		</NoHydration>
		<Demo>
			<div data-demo="presence"><PresenceDemo /></div>
		</Demo>
		<NoHydration>
			<p>
				A face that comes grows in, and one that goes fades out. A typing line runs out on its own after
				four seconds, with no message to say it stopped. A cursor glides to each place it is sent, fades once
				it has been still for three seconds (press Auto to stop them), and is forgotten after twenty.
			</p>

			<Heading id="use">Using it</Heading>
			<p>
				Name the package in the app's header, as any package (<a href={Paths.ecosystem}>the ecosystem</a>), and
				import its components. Each takes its data as an accessor, so it shows whatever feeds it: a room's
				channel in an app, or, here, the demo.
			</p>
			<Code title={"${Sources.presence_use.file}, in part"} source={Sources.presence_use.rocx} />
			<p>
				In an app, a room is a route's <a href={"${Paths.platform_live}#channels"}>channel</a>, and the server
				keeps it. Its check lets a member in, as who the middleware says they are (their key and metadata,
				never the page's say), and its hooks are the package's <code>PresenceServer</code>'s: a tab joins as it
				subscribes, and leaves when its subscription ends.
			</p>
			<Code title={Sources.presence_route.file} source={Sources.presence_route.rocx} />
			<p>
				The page joins the room with <code>Presence.join!</code>, given the channel: it subscribes, says every
				15 seconds that this tab is still here, and gives what the components read. What the page says (its
				status, that it is typing) goes over the tab's one stream, with its other channels; nothing has an
				endpoint of its own.
			</p>
			<Code title={"${Sources.presence_join.file}, in part"} source={Sources.presence_join.rocx} />

			<Heading id="stack">{"<AvatarStack>"}</Heading>
			<div class="sample">
				<AvatarStack faces!={faces} max={4} />
			</div>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"faces! : () => List(Stack.Face)"}</code></td>
							<td>
								who is here, in order: <code>{"{ key, name, image, color, status }"}</code>
								(<code>Wire.face</code> makes one from a member). A face whose <code>image</code> is empty shows
								its initials on its <code>color</code>, or, when that is empty too, a colour its key always gets
							</td>
						</tr>
						<tr><td><code>{"max : U64 ?? 5"}</code></td><td>how many places, the <code>+N</code> among them</td></tr>
						<tr><td><code>{"label : Str ?? \"\""}</code></td><td>what a screen reader hears for the stack; empty, it says who is here: <code>"Ann, Bo and 2 others are here"</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				A status (<code>away</code>, <code>busy</code>, any word) is a class, <code>status-away</code>, and a dot:
				green, orange for <code>away</code>, red for <code>busy</code>. The <code>+N</code>'s tooltip names the
				ones it stands for.
			</p>

			<Heading id="typing">{"<TypingIndicator>"}</Heading>
			<div class="sample">
				<TypingIndicator names!={["Ada Lovelace", "Alan Turing"]} />
			</div>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr><td><code>{"names! : () => List(Str)"}</code></td><td>who is typing (<code>Wire.names(members, keys)</code> turns keys into names)</td></tr>
						<tr><td><code>{"say : (List(Str) -> Str) ?? Typing.sentence"}</code></td><td>the sentence: <code>"Ann is typing…"</code>, <code>"Ann and Bo are typing…"</code>, <code>"Ann, Bo and 2 others are typing…"</code>; give your own for another language</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Three dots that bob, and the sentence. With no one typing, its line keeps its height, so nothing under
				it jumps; a screen reader hears it change (<code>aria-live="polite"</code>).
			</p>

			<Heading id="cursors">{"<LiveCursors>"}</Heading>
			<div class="sample">
				<LiveCursors cursors!={cursors}>
					<div class="area"><p>What everyone points at</p></div>
				</LiveCursors>
			</div>
			<TableWrap>
				<table>
					<thead><tr><th>Prop</th><th>Is</th></tr></thead>
					<tbody>
						<tr>
							<td><code>{"cursors! : () => List(LiveCursors.Pointer)"}</code></td>
							<td>
								others' cursors, <code>{"{ key, name, color, x, y, idle }"}</code>: <code>x</code> and <code>y</code>
								are shares of the area, from 0 to 1, so a place is the same on a narrow screen and a wide one
								(<code>Wire.pointers(members, cursors)</code> makes them)
							</td>
						</tr>
						<tr><td><code>{"children : List(Html)"}</code></td><td>the area they point at</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Each cursor is an arrow in its member's colour, with their name beside it. It glides to each place it
				is sent, fades when idle, and takes no pointer events, so what is under it is clicked as before.
				Drawing others' cursors works today; sending your own doesn't yet, since a handler isn't given where
				the pointer is (see <a href="#status">Status</a>).
			</p>

			<Heading id="how">How a room works</Heading>
			<p>
				<strong>The room is the server's.</strong> One server instance, so there is no broker: the server
				keeps each room itself. <code>Room</code> is its state: who is here, each with their metadata, since when, and from
				which tabs. <code>join</code>, <code>leave</code>, <code>update</code> (new metadata) and
				<code>sweep</code> answer the changes others should hear, <code>Joined</code>, <code>Left</code> and
				<code>Changed</code>, and number the room's state with each one. Time is the caller's: its tests run on
				a clock they are given, so a timeout is tested without waiting for one.
			</p>
			<Code title={"${Sources.presence_grace.file}, in part"} source={Sources.presence_grace.rocx} />
			<ul>
				<li>
					<strong>Leaving has a grace.</strong> A tab whose stream ends leaves after five seconds, unless it is
					back by then: a page that reloads or reconnects doesn't flicker out and in. A page that drops the
					room while the tab stays (it goes to another room) leaves at once: <code>on_close!</code> is told
					<code>Dropped</code>.
				</li>
				<li>
					<strong>Vanishing has a timeout.</strong> A page says it is here every 15 seconds. A tab unheard for 75
					seconds is swept out, however long its connection lingers: a browser may hold a hidden tab's timers
					back to once a minute, and 75 seconds is that minute and a beat to spare.
				</li>
				<li>
					<strong>Changes are numbered.</strong> A page's copy of the room (<code>Mirror</code>) takes a snapshot,
					then each change in order. One older than its snapshot is no news; one that skips a number is a gap,
					and the page asks for a snapshot again.
				</li>
				<li>
					<strong>Kept in memory, swapped in.</strong> In an app, a room is kept in the server's
					<code>Kv</code>. Each change reads it, sweeps it, changes it and swaps it back only if no one else
					changed it meanwhile (<code>Kv.swap!</code>), else reads it again, so two tabs that join at once
					both count, and nothing is written to Postgres. What changed is published on the room's channel,
					numbered.
				</li>
			</ul>

			<Heading id="stores">The stores</Heading>
			<p>
				The browser's side, as Solid primitives: each is called in a component, as
				<code>create_signal!</code> is, and keeps its state in signals. <code>join!</code> is a room on its
				channel; the others take what a room says however it comes.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Store</th><th>Gives</th></tr></thead>
					<tbody>
						<tr><td><code>{"Presence.join!(channel)"}</code></td><td>the room on a route's channel, joined while the component is there: what <code>create_room!</code> gives, fed by the channel, and what this tab says, <code>status!(word)</code>, <code>typed!()</code> and <code>done!()</code>, <code>moved!(point)</code> and <code>away!()</code>; it says it is here every 15 seconds</td></tr>
						<tr><td><code>{"Presence.create_room!(on_gap!)"}</code></td><td>all of them at once, fed a room's events with <code>heard!(event)</code>: <code>members!</code>, <code>synced!</code>, <code>me!</code>, <code>typing!</code> (your own left out), <code>cursors!</code> (others'), <code>lost!</code>; one who leaves stops typing, and their cursor goes</td></tr>
						<tr><td><code>{"Presence.create_presence!(on_gap!)"}</code></td><td><code>members!</code>, <code>synced!</code>, <code>receive!(message)</code>, <code>lost!</code></td></tr>
						<tr><td><code>{"Presence.create_typing!(ttl)"}</code></td><td><code>who!</code>, <code>started!(key)</code>, <code>stopped!(key)</code>; a ping lasts <code>ttl</code> milliseconds</td></tr>
						<tr><td><code>{"Presence.create_typist!(every, send!)"}</code></td><td>your own typing: <code>typed!()</code> on each key, <code>done!()</code> when the text is sent or left; <code>send!</code> is given <code>Started</code> (at once, then at most every <code>every</code>) or <code>Stopped</code></td></tr>
						<tr><td><code>{"Presence.create_cursors!({ idle, forget })"}</code></td><td><code>shown!</code>, <code>moved!(move)</code>, <code>gone!(key)</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				A write applies when its handler is done, as in Solid 2.0, so call a store once a handler: a second
				call in the same handler sees the store as it was before the first. A channel hands each event to a
				handler of its own, so this is how a page uses them anyway. The browser has no clock yet, so a store
				keeps its own, a timer that ticks every quarter second, and only while something can expire.
			</p>
			<p>
				The demo above has no channel, so it does what one would: a press tells the stores what happened, once
				each, and each cursor's move goes from a timeout of its own.
			</p>
			<Code title={"${Sources.presence_stores.file}, in part"} source={Sources.presence_stores.rocx} />

			<Heading id="modules">The modules</Heading>
			<p>
				Plain Roc, on no platform, so the server's hooks and the browser's stores run the same code (the
				browser's half sees them through the package's <code>browser.roc</code>), and
				<code>PresenceServer</code>, the server's side. <code>roc test packages/presence/main.roc</code> runs
				their <code>expect</code>s.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Module</th><th>What it does</th></tr></thead>
					<tbody>
						<tr><td><code>Room</code></td><td>a room, as the server keeps it: <code>join</code>, <code>update</code>, <code>heartbeat</code>, <code>leave</code>, <code>quit</code>, <code>sweep</code>, <code>signal</code>; <code>members</code>, <code>version</code>, <code>deadline</code> (when the next sweep could find someone); <code>save</code> and <code>load</code> for JSON; <code>Room.defaults</code>, and <code>beat_every</code></td></tr>
						<tr><td><code>Mirror</code></td><td>a page's copy: <code>receive</code> a <code>Snapshot</code> or a numbered <code>Delta</code> (<code>Err(Gap)</code> when one was missed), <code>members</code>, <code>is_synced</code></td></tr>
						<tr><td><code>Diff</code></td><td><code>between(before, after)</code>: who left, joined and changed; <code>apply</code> one change</td></tr>
						<tr><td><code>Throttle</code></td><td>at most one send every <code>every</code> milliseconds, the first at once and the latest held until it is due: a cursor sent 20 times a second ends where the pointer stopped</td></tr>
						<tr><td><code>Cursors</code></td><td><code>place</code> (a pointer's pixels as shares of the area), <code>moved</code>, <code>gone</code>, <code>shown</code>, <code>sweep</code>, <code>coalesce</code> (a burst, one move per member), <code>percent</code></td></tr>
						<tr><td><code>Typing</code></td><td>who is typing: <code>started</code>, <code>stopped</code>, <code>who</code>, <code>deadline</code>, <code>sentence</code></td></tr>
						<tr><td><code>Typist</code></td><td>your own typing: <code>typed(now)</code> says when to ping, <code>done</code> when to say it stopped</td></tr>
						<tr><td><code>Stack</code></td><td><code>split</code> (who fits, and <code>+N</code>), <code>initials</code> (<code>"Ada Lovelace"</code> is <code>"AL"</code>), <code>color</code> (the same key, the same colour), <code>names</code>, <code>label</code></td></tr>
						<tr><td><code>Wire</code></td><td>what a room's channel carries: to a page (<code>Event</code>: <code>Welcome</code>, <code>Presence</code>, <code>Typing</code>, <code>Moved</code>, <code>Away</code>), from one (<code>Said</code>: <code>Here</code>, with its status, <code>Typing</code>, <code>Moved</code>, <code>Away</code>), who is in it (<code>Member</code>: a key and <code>Meta</code>: name, image, color, status), and <code>face</code>, <code>names</code>, <code>pointers</code> to feed the components</td></tr>
						<tr><td><code>PresenceServer</code></td><td>the server's side: a room channel's hooks, <code>on_open!</code>, <code>on_close!</code> and <code>receive!</code>, the room kept in <code>Kv</code></td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="styling">Styling</Heading>
			<p>
				The components take their sizes and colours from custom properties: <code>--avatar-size</code> (2rem),
				<code>--avatar-overlap</code>, <code>--avatar-ring</code> (between faces: the page's background),
				<code>--avatar-font</code>, <code>--avatar-more</code>, <code>--avatar-status</code>,
				<code>--avatar-away</code>, <code>--avatar-busy</code>; <code>--typing-color</code>,
				<code>--typing-size</code>; <code>--cursor-glide</code> (0.12s; the demo's is 1.4s) and
				<code>--cursor-font</code>. Under <code>prefers-reduced-motion</code>, the dots stop bobbing and the
				cursors jump instead of gliding.
			</p>

			<Heading id="status">Status</Heading>
			<p>Works today:</p>
			<ul>
				<li>the modules, with their tests (<code>roc test packages/presence/main.roc</code>);</li>
				<li>the three components and the stores, which <code>rocx build</code> copies into an app;</li>
				<li>
					the server's side on a route's channel, which an app imports (<code>presence.PresenceServer</code>):
					in examples/board, two people in browsers of their own each see the other, see which card each has
					open, and see a third who closes their browser leave.
				</li>
			</ul>
			<p>Waits on a proposal (the package's PROPOSALS.md has each of these, and a few more):</p>
			<ul>
				<li>sending your own cursor: a handler given where the pointer is (<code>on:pointermove.point</code>);</li>
				<li>a clock in the browser, and knowing when a tab is hidden, to show it as away;</li>
				<li>the app's own metadata on the wire, instead of <code>Wire.Meta</code>, once the compiler can carry it.</li>
			</ul>
			<details>
				<summary>The demo: <code>{Sources.presence_demo.file}</code></summary>
				<Code title={Sources.presence_demo.file} source={Sources.presence_demo.rocx} />
			</details>
			<details>
				<summary>The avatar stack: <code>{Sources.presence_avatar_stack.file}</code></summary>
				<Code title={Sources.presence_avatar_stack.file} source={Sources.presence_avatar_stack.rocx} />
			</details>
			<details>
				<summary>The typing indicator: <code>{Sources.presence_typing_indicator.file}</code></summary>
				<Code title={Sources.presence_typing_indicator.file} source={Sources.presence_typing_indicator.rocx} />
			</details>
			<details>
				<summary>The cursors: <code>{Sources.presence_live_cursors.file}</code></summary>
				<Code title={Sources.presence_live_cursors.file} source={Sources.presence_live_cursors.rocx} />
			</details>
			<details>
				<summary>The stores: <code>{Sources.presence_stores_file.file}</code></summary>
				<Code title={Sources.presence_stores_file.file} source={Sources.presence_stores_file.rocx} />
			</details>
			<details>
				<summary>The server's side: <code>{Sources.presence_server.file}</code></summary>
				<Code title={Sources.presence_server.file} source={Sources.presence_server.rocx} />
			</details>
		</NoHydration>
	</>

## The avatar stack's sample: seven here, four places.
faces : List(Stack.Face)
faces = [
	face("ada", "Ada Lovelace", ""),
	face("alan", "Alan Turing", "away"),
	face("grace", "Grace Hopper", ""),
	face("edsger", "Edsger Dijkstra", "busy"),
	face("barbara", "Barbara Liskov", ""),
	face("donald", "Donald Knuth", ""),
	face("frances", "Frances Allen", ""),
]

face : Str, Str, Str -> Stack.Face
face = |key, name, status| { key, name, image: "", color: "", status }

## The cursors' sample: one moving, one still a while.
cursors : List(LiveCursors.Pointer)
cursors = [
	{ key: "ada", name: "Ada", color: Stack.color("ada"), x: 0.22, y: 0.3, idle: Bool.False },
	{ key: "alan", name: "Alan", color: Stack.color("alan"), x: 0.68, y: 0.55, idle: Bool.True },
]

<style>
	.sample {
		--avatar-ring: var(--bg);
		--avatar-more: var(--rule-strong);
		--avatar-status: var(--good);
		--avatar-away: var(--warn);
		--avatar-busy: var(--bad);
		--typing-color: var(--text-muted);
		margin: var(--space-4) 0;
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--bg-sunken);
	}

	.area {
		display: grid;
		place-items: center;
		min-height: 8rem;
		border: 1px dashed var(--rule-strong);
		border-radius: var(--radius-sm);
		color: var(--text-faint);
	}

	.area p {
		margin: 0;
	}
</style>
