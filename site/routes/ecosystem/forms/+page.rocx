import pf.Html
import pf.Server
import pf.Endpoint
import pf.OpenApi
import forms.Issues
import forms.Regex
import ../../../Demos/FormsDemo
import ../../../Demos/FormsSignup
import ../../../Ui/Code
import ../../../Ui/Heading
import ../../../Ui/Note
import ../../../Generated/Sources
import ../../../Generated/Paths
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Ui/Demo

## The forms package's page: a form checked as it is typed (the page's one live demo), how to
## install it, the schema it is checked with, what an endpoint answers with the same schema
## (rendered from the package as the site is built), the page's side, the checks, the issues and
## their English, the regex engine, the components, and what isn't done yet.
meta = {
	title: "Forms",
	description: "A form's rules written once in Roc: the browser checks what is typed as it is typed, and the endpoint reads what was posted into a typed record, or refuses it with the same issues.",
	toc: [
		{ id: "install", label: "Installing it" },
		{ id: "try", label: "Try it" },
		{ id: "schema", label: "One schema" },
		{ id: "endpoint", label: "At the endpoint" },
		{ id: "page", label: "In the page" },
		{ id: "values", label: "Values and their checks" },
		{ id: "forms", label: "Putting fields together" },
		{ id: "issues", label: "Issues" },
		{ id: "regex", label: "Patterns" },
		{ id: "components", label: "The components" },
		{ id: "status", label: "Not yet" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/forms</code>]}
				title="Forms: the rules written once, checked in the browser and at the endpoint"
			>
				Write a form's rules once, in Roc, much as zod does for TypeScript. The browser checks each field
				as it is typed, and the endpoint the form posts to runs the very same code: it reads the post into a
				typed record, or refuses it with the same issues. The rules go past what a type can say: lengths,
				patterns, email addresses, ranges, choices, days, and checks across fields.
			</PageHero>

			<Heading id="install">Installing it</Heading>
			<p>
				Name the package in your app's header, <code>main.roc</code>. <code>rocx build</code> gives the
				browser's half of the app the same packages, so this is the only place you name it. Forms is not a
				<a href={"${Paths.platform_server}#plugins"}>plugin</a>: there is nothing to add to
				<code>App.program</code>.
			</p>
			<Code source={"app [program] { forms: \"../packages/forms/main.roc\", pf: platform \"…\" }"} numbers={Bool.False} />
			<p>
				Then <code>import forms.Form</code> wherever you write a schema, and
				<code>import forms.LiveForm</code> and the field components in a <code>.rocx</code> file.
			</p>

			<Heading id="try">Try it</Heading>
			<p>
				Type in a field, then leave it. If what you typed fails a check, the issue shows under the field,
				and it goes as soon as the field passes. Send shows every issue at once, with a summary above the
				form that links to each field. Once there are none, the demo shows the record the form reads.
			</p>
		</NoHydration>
		<Demo>
			<div data-demo="forms"><FormsDemo /></div>
		</Demo>
		<NoHydration>
			<Note>
				This site is static files, so the demo sends nothing: it checks in your browser, with the code an
				endpoint would check it with. In an app, Send posts the form, and the endpoint has the last word.
			</Note>

			<Heading id="schema">One schema</Heading>
			<p>
				You build a form with Roc's record builder: each field under the name the form posts it as, with
				its checks, in order. The record's type is what the form reads: here <code>age</code> is an
				<code>I64</code> and <code>terms</code> a <code>Bool</code>. The two passwords are a small form of
				their own inside it, so the check that compares them runs whenever both can be read, whatever is
				wrong elsewhere.
			</p>
			<Code title={Sources.forms_schema.file} source={Sources.forms_schema.rocx} />
			<p>
				In an app, the schema is a module of its own, which the page and the endpoint both import. The
				checks are data, so the same schema also tells a browser which attributes to put on each input, and
				can describe the form as JSON Schema. <code>form.json_schema()</code> gives, as this site is built:
			</p>
			<Code source={pretty(FormsSignup.form.json_schema(), 2)} plain numbers={Bool.False} />

			<Heading id="endpoint">At the endpoint</Heading>
			<p>
				An <a href={"${Paths.routing}#endpoints"}>endpoint</a> reads its body with the same schema. Its
				route file names the form beside the handler, and the handler's <code>body</code> is the form's
				record (D-093):
			</p>
			<Code title="routes/signup/+server.roc" source={signup_route} numbers={Bool.False} />
			<p>
				The platform reads a form's fields, URL-encoded or multipart, or a JSON object's, with the form, and
				gives <code>post!</code> the account. What doesn't pass never reaches it: the endpoint refuses it with
				a <code>422</code> and the issues as JSON (<code>application/json</code>). A box left unticked, which
				a browser doesn't send at all, is the form's to judge. <code>Generated/Api</code> makes the endpoint
				so in both copies (<code>{"Endpoint.checked(Endpoint.remote(\"POST\", \"/signup\"), Signup.form)"}</code>), so a
				page's submission is read with the form too, and <code>/openapi.json</code> documents the body with
				the form's schema. A handler refuses what only it can check (a name already taken) with
				<code>Issues.refusal</code>. This site's handler:
			</p>
			<Code title={Sources.forms_endpoint.file} source={Sources.forms_endpoint.rocx} />
			<p>
				Sent the body <code>{bad_post}</code>, it answers (run as this site is built):
			</p>
			<Code source={answered!(bad_post)} plain numbers={Bool.False} />
			<p>Read back with <code>Issues.from_problem</code>, as a page reads a refusal, the issues are:</p>
			<TableWrap>
				<table id="forms-answer">
					<thead><tr><th>Field</th><th>Code</th><th>Message</th></tr></thead>
					<tbody>
						{...refused!(bad_post).map(|issue| <tr><td><code>{issue.field}</code></td><td><code>{Issues.key(issue.code)}</code></td><td>{issue.message}</td></tr>)}
					</tbody>
				</table>
			</TableWrap>
			<p>
				A body that passes every check gets the handler's result: <code>{answered!(good_post)}</code>.
				So does the same as JSON: <code>{answered!(good_json)}</code>. Its body in
				<code>/openapi.json</code>, the form's schema three ways:
			</p>
			<Code source={pretty("{${OpenApi.sent(FormsSignup.signup, [])}}", 2)} plain numbers={Bool.False} />

			<Heading id="page">In the page</Heading>
			<p>
				<code>LiveForm</code> holds a form's state in a component: what is typed in each field, which fields
				you have left, and whether the form was sent. You make it once, as you make a
				<a href={"${Paths.components}#primitives"}>signal</a>. The package's field components take their
				attributes from the schema (<code>type="email"</code>, <code>required</code>,
				<code>maxlength</code>, <code>min</code>) and say when they are invalid
				(<code>aria-invalid</code>, <code>aria-describedby</code>). This site has no server to post to, so
				the demo uses a local form, which only the browser reads:
			</p>
			<Code title={Sources.forms_demo.file} source={Sources.forms_demo.rocx} />
			<p>
				An app's page posts the form to its endpoint instead. Make the live form with
				<code>LiveForm.of!(Signup.form, Api.post_signup({"{}"}))</code>, and write
				<code>{"<form method=\"post\" action={live.url()} novalidate>"}</code>, with no
				<code>on:submit</code>. With the runtime, the form is sent in the background: the page stays and
				shows the endpoint's issues at their fields. Without it, the browser posts the form, and the page
				comes back with what was typed and the issues (a
				<a href={"${Paths.calls}#forms"}>submission</a> read from the flash). Passwords are never written
				back into the page.
			</p>
			<p>
				An edit form starts filled in with the record as it is:
				<code>{"LiveForm.filled!(TaskForm.editing, save, [(\"title\", task.title), (\"notes\", task.notes)])"}</code>.
				Any form can start afresh from a handler: <code>live.reset!()</code> puts back what it started
				with and forgets every issue. The inputs stay where they are, and so does focus (Start again, in
				the demo). An add form resets once the endpoint has accepted what it sent:
				<code>{"create_effect!(|| live.accepted!(), |accepted| if (accepted) live.reset!() else {})"}</code>.
				<a href={Paths.examples_tasks}>examples/tasks</a> does both.
			</p>

			<Heading id="values">Values and their checks</Heading>
			<p>
				Each kind of value takes a list of checks, run in order, and reports everything wrong with the
				value, not only the first thing. A text check other than <code>Required</code> passes an empty
				value, as a browser's <code>minlength</code> and <code>pattern</code> do:
				<code>Value.text([Email])</code> takes <code>""</code> or an address.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Value</th><th>Reads</th><th>Checks</th></tr></thead>
					<tbody>
						<tr>
							<td><code>Value.text(checks)</code></td>
							<td><code>Str</code>, as typed</td>
							<td>
								<code>Trim</code>, <code>Lowercase</code>, <code>CollapseSpaces</code> (each changes the text for
								the checks after it); <code>Required</code>; <code>MinLength(n)</code>, <code>MaxLength(n)</code>
								(characters); <code>Matches(pattern)</code> (the whole text); <code>Email</code> (as
								<code>{"<input type=\"email\">"}</code> checks one); <code>Url</code> (<code>http</code> or
								<code>https</code>); <code>OneOf(options)</code>; <code>Secret</code> (a password, never written
								back into a page)
							</td>
						</tr>
						<tr><td><code>Value.int(checks)</code></td><td><code>I64</code>: <code>42</code>, <code>-3</code>, <code>+7</code></td><td><code>Min(n)</code>, <code>Max(n)</code>, <code>Step(n)</code> (counted from the <code>Min</code>, or from 0, as a browser's <code>step</code> is)</td></tr>
						<tr><td><code>Value.dec(checks)</code></td><td><code>Dec</code>: <code>2.5</code>, <code>.5</code>; no exponent</td><td><code>Min(x)</code>, <code>Max(x)</code>, <code>Step(x)</code></td></tr>
						<tr><td><code>Value.checkbox(checks)</code></td><td><code>Bool</code>: sent or not</td><td><code>[Required]</code>: it must be ticked</td></tr>
						<tr><td><code>Value.choice(options)</code></td><td>what the option stands for: <code>{"[(\"free\", Free), (\"pro\", Pro)]"}</code></td><td>one of them</td></tr>
						<tr><td><code>Value.date(checks)</code></td><td>a <code>Date</code>: <code>2026-11-21</code></td><td><code>Min("2026-01-01")</code>, <code>Max(…)</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				An empty number, choice or day fails as <code>Required</code>. For anything the checks don't
				cover, <code>.check(ok, code)</code> adds a check of your own, and <code>.map</code> and
				<code>.try_map</code> turn the value into another type (a <code>Username</code>, an
				<code>Isbn</code>), or into an issue.
			</p>
			<p>
				A bad pattern crashes where the value is made. Roc computes a top-level value while the app
				compiles, so in a top-level form a typo in a pattern stops the build instead of reaching a user.
			</p>

			<Heading id="forms">Putting fields together</Heading>
			<TableWrap>
				<table>
					<thead><tr><th>Function</th><th>What it does</th></tr></thead>
					<tbody>
						<tr><td><code>Form.text(name, checks)</code>, <code>int</code>, <code>dec</code>, <code>checkbox</code>, <code>choice</code>, <code>date</code></td><td>the field posted as <code>name</code>, read as that kind of value</td></tr>
						<tr><td><code>Form.field(name, value)</code></td><td>the same, for any <code>Value</code></td></tr>
						<tr><td><code>Form.optional(name, value)</code></td><td><code>Err(Missing)</code> when left empty, otherwise read</td></tr>
						<tr><td><code>Form.list(name, value, [MinItems(n), MaxItems(n)])</code></td><td>every value posted as <code>name</code> (boxes that share a name); an item's issues at <code>name[i]</code></td></tr>
						<tr><td><code>{"{ a: …, b: … }.Form"}</code></td><td>the record builder: every field read, all their issues kept</td></tr>
						<tr><td><code>.check(ok, code)</code>, <code>.check_at(field, ok, code)</code></td><td>a check of your own, its issue at the form's own field, or at another one: a check across fields</td></tr>
						<tr><td><code>.map(f)</code>, <code>.try_map(f)</code>, <code>.message(text)</code></td><td>what was read, made into another value; its issues with this message</td></tr>
						<tr><td><code>.parse(fields)</code>, <code>.parse_body(body)</code>, <code>.issues(fields)</code></td><td>the record, or every issue: from fields (as <code>Server.form_fields</code> reads them) or from a form's body</td></tr>
						<tr><td><code>.attributes(name)</code>, <code>.json_schema()</code></td><td>the attributes a browser checks a field by; the form as JSON Schema</td></tr>
						<tr><td><code>.names()</code>, <code>.is_list(name)</code>, <code>.secrets()</code></td><td>its fields; whether one takes several values; the <code>Secret</code> ones</td></tr>
					</tbody>
				</table>
			</TableWrap>

			<Heading id="issues">Issues</Heading>
			<p>
				An issue is <code>{"{ field : Str, code : Issues.Code, message : Str }"}</code>: where, what, and the
				English for it. A code is a plain tag that carries what its message needs, so a translation can
				match on it, or look it up by its <code>key</code> and <code>params</code>
				(<a href={Paths.ecosystem_intl}>intl</a> does). Each code, and its English, from the package as this
				site is built:
			</p>
			<TableWrap>
				<table id="forms-codes">
					<thead><tr><th>Code</th><th>Key and params</th><th>English</th></tr></thead>
					<tbody>
						{...codes.map(|(written, code)| <tr><td><code>{written}</code></td><td><code>{Issues.key(code)}</code>{params(code)}</td><td>{Issues.english(code)}</td></tr>)}
					</tbody>
				</table>
			</TableWrap>
			<p>
				<code>Issues.at(issues, field)</code> picks out a field's issues, and <code>Issues.under</code> a
				list's, its items' too. <code>Issues.refusal</code> is an endpoint's <code>422</code>, and
				<code>Issues.from_problem</code> reads one back from a submission's <code>error!()</code> or
				<code>Endpoint.send!</code>.
			</p>

			<Heading id="regex">Patterns</Heading>
			<p>
				Roc has no regular expressions, so the package has an engine written in plain Roc. A pattern
				compiles once, to a program. A Pike VM runs the program over the text, following every way the
				pattern could match at once, one step per character, so no pattern and no text can make it slow.
				The price is that there are no backreferences and no lookaround. The syntax is JavaScript's, so a
				pattern means the same in an input's <code>pattern</code> attribute: characters and
				<code>.</code>, classes (<code>[a-z]</code>, <code>[^,]</code>, <code>\d \w \s</code>),
				<code>^ $ \b</code>, groups, <code>|</code>, and <code>* + ? {"{m,n}"}</code>. Matched as this site
				is built:
			</p>
			<TableWrap>
				<table id="forms-regex">
					<thead><tr><th>Pattern</th><th>Text</th><th><code>matches</code></th><th><code>find</code></th></tr></thead>
					<tbody>
						{...patterns.map(|(pattern, typed)| <tr><td><code>{pattern}</code></td><td><code>{typed}</code></td><td>{matched(pattern, typed)}</td><td>{found(pattern, typed)}</td></tr>)}
					</tbody>
				</table>
			</TableWrap>
			<p>
				The last row is the classic trap. A backtracking engine (JavaScript's, say) tries each of the
				hundreds of millions of ways to split those a's into groups before it says no. Here it is one step
				per character. <code>Regex.compile</code> says what is wrong with a pattern, and where;
				<code>Regex.must</code> crashes instead, which in a top-level value stops the build.
			</p>

			<Heading id="components">The components</Heading>
			<p>
				<code>rocx build</code> copies the package's components into your app, as it copies the
				<a href={Paths.ecosystem_charts}>charts</a>: <code>import forms.TextField</code> imports the copy.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Component</th><th>Props</th></tr></thead>
					<tbody>
						<tr><td><code>{"<TextField>"}</code></td><td><code>live</code>, <code>name</code>, <code>label</code>; <code>hint</code>, <code>type</code> (when the checks don't give one: <code>tel</code>, <code>search</code>), <code>autocomplete</code></td></tr>
						<tr><td><code>{"<CheckboxField>"}</code></td><td><code>live</code>, <code>name</code>, <code>label</code></td></tr>
						<tr><td><code>{"<IssueSummary>"}</code></td><td><code>live</code>, <code>title</code>: once the form is sent, its issues, each a link to its field; <code>labels</code>, the fields' labels by name, so a link says which field it is about (<code>Name: Fill this in</code>)</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<TableWrap>
				<table>
					<thead><tr><th>LiveForm</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>LiveForm.of!(form, endpoint)</code></td><td>a form that posts to <code>endpoint</code> (through <code>Router.use_submission!</code>): the endpoint's issues show at their fields</td></tr>
						<tr><td><code>LiveForm.filled!(form, endpoint, values)</code></td><td>the same, starting with <code>values</code> typed in, field by field (<code>[("title", task.title)]</code>; a ticked box is <code>("done", "on")</code>)</td></tr>
						<tr><td><code>LiveForm.local!(form)</code>, <code>local_filled!(form, values)</code></td><td>a form that posts nowhere, checked as it is typed, for an <code>on:submit</code> handler to read</td></tr>
						<tr><td><code>live.reset!()</code>, <code>accepted!()</code></td><td>from a handler, start afresh where it is, issues forgotten; whether the endpoint accepted what was last sent</td></tr>
						<tr><td><code>live.value!(name)</code>, <code>input!(name, value)</code>, <code>leave!(name)</code></td><td>what a field holds; for <code>on:input.value</code>; for <code>on:blur</code></td></tr>
						<tr><td><code>live.issues!(name)</code>, <code>invalid!(name)</code>, <code>all_issues!()</code></td><td>the issues to show now: a field's once it is left, every field's once the form is sent</td></tr>
						<tr><td><code>live.show_all!()</code>, <code>fields!()</code>, <code>url()</code></td><td>show every issue from now on; what is typed, for <code>form.parse</code>; the form's <code>action</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Their colours come from the custom properties <code>--form-invalid</code>, <code>--form-border</code>,
				<code>--form-muted</code> and <code>--form-radius</code>; the demo sets them from this site's tokens.
				The <a href="https://github.com/Roc-Solid/rocx/blob/master/packages/forms/README.md">package's
				README</a> lists every function, and when each issue shows.
			</p>

			<Heading id="status">Not yet</Heading>
			<p>
				Everything above works today. <code>roc test packages/forms/main.roc</code> runs the package's
				<code>expect</code>s. A few things wait on proposals in <code>packages/forms/PROPOSALS.md</code>:
			</p>
			<ul>
				<li>
					A refusal with field issues of the platform's own (RFC 9457's problem details). Today it is a
					<code>422</code> whose body is the issues' JSON, labelled <code>application/json</code>, which
					<code>Issues.from_problem</code> reads back.
				</li>
				<li>
					Holding a send back in the browser when the form has issues. Today it always goes to the
					endpoint, which refuses it with the same issues.
				</li>
			</ul>
			<p>
				And for now: decimals written with a <code>.</code>; patterns with no flags and no captures;
				<code>form.parse_body(text)</code>, for a page that has a form's text, reads it URL-encoded only
				(an endpoint's body is read for the form by the platform, JSON too).
			</p>
			<details>
				<summary>The demo: <code>{Sources.forms_demo_file.file}</code></summary>
				<Code title={Sources.forms_demo_file.file} source={Sources.forms_demo_file.rocx} />
			</details>
			<details>
				<summary>A form's state: <code>{Sources.forms_live_form.file}</code></summary>
				<Code title={Sources.forms_live_form.file} source={Sources.forms_live_form.rocx} />
			</details>
			<details>
				<summary>A field: <code>{Sources.forms_text_field.file}</code></summary>
				<Code title={Sources.forms_text_field.file} source={Sources.forms_text_field.rocx} />
			</details>
		</NoHydration>
	</>

# What the page renders from the package as the site is built, inside its `<NoHydration>`s.

## A post that doesn't read, and one that does, as a browser posts the form.
bad_post : Str
bad_post = "name=&email=ada%40&age=12&password=short&confirm=shirt"

good_post : Str
good_post = "name=Ada&email=Ada%40Example.com&age=36&password=correct+horse&confirm=correct+horse&terms=on"

## The same, as JSON.
good_json : Str
good_json = "{\"name\":\"Ada\",\"email\":\"ada@example.com\",\"age\":36,\"password\":\"correct horse\",\"confirm\":\"correct horse\",\"terms\":true}"

## What an app's route file says for the endpoint.
signup_route : Str
signup_route = "import pf.Server\nimport pf.Endpoint\nimport ../../Signup\n\n## What POST /signup is sent: an account, read and checked by the form.\npost_body = Signup.form\n\npost! : { request : Server.Request, params : {}, context : c, body : Signup.Account } => Try({ welcome : Str }, Endpoint.Refusal)\npost! = |{ body, .. }| Ok({ welcome: \"Welcome, \${body.name}\" })"

## The endpoint's answer to a body (a form's, or JSON's when it starts with `{`), as the server
## answers it (`Endpoint.respond!`): its status, its type when it is JSON, and what it sends.
answered! : Str => Str
answered! = |body| {
	type = if (body.starts_with("{")) "application/json" else "application/x-www-form-urlencoded"
	request = Server.from_http("POST", "/signup", "content-type: ${type}\naccept: application/json", body.to_utf8())
	answer = Endpoint.respond!(FormsSignup.signup, request, {})
	said = Server.body_text(answer)
	if answer.status == 200 {
		"200 ${said}"
	} else {
		kind = answer.headers.find_first(|header| header.name == "content-type").map_ok(|header| header.value) ?? ""
		"${answer.status.to_str()} ${kind}\n${pretty(said, 1)}"
	}
}

## The issues the endpoint refuses a form's body with, read back as a page reads them.
refused! : Str => List(Issues.Issue)
refused! = |body| {
	request = Server.from_http("POST", "/signup", "content-type: application/x-www-form-urlencoded\naccept: application/json", body.to_utf8())
	answer = Endpoint.respond!(FormsSignup.signup, request, {})
	if (answer.status == 200) [] else Issues.from_problem(Refused(answer.status, Server.body_text(answer)))
}

## A code as it is written, and the code.
codes : List((Str, Issues.Code))
codes = [
	("Required", Required),
	("Unchecked", Unchecked),
	("TooShort(8)", TooShort(8)),
	("TooLong(80)", TooLong(80)),
	("NoMatch(\"\\\\d{5}\")", NoMatch("\\d{5}")),
	("NotEmail", NotEmail),
	("NotUrl", NotUrl),
	("NotDate", NotDate),
	("NotOneOf([\"free\", \"pro\"])", NotOneOf(["free", "pro"])),
	("NotInteger", NotInteger),
	("NotNumber", NotNumber),
	("TooSmall(18)", TooSmall(18.0)),
	("TooLarge(130)", TooLarge(130.0)),
	("NotStep(15, 20)", NotStep(15.0, 20.0)),
	("TooEarly(\"2026-01-01\")", TooEarly("2026-01-01")),
	("TooLate(\"2026-12-31\")", TooLate("2026-12-31")),
	("TooFew(1)", TooFew(1)),
	("TooMany(3)", TooMany(3)),
	("NotSame(\"password\")", NotSame("password")),
	("Custom(\"taken\", \"That name is taken\")", Custom("taken", "That name is taken")),
]

## A code's params, after its key: ` (min: 8)`, or nothing.
params : Issues.Code -> Str
params = |code| {
	said = Issues.params(code).map(|param| "${param.name}: ${param.value}")
	if (said.is_empty()) "" else " (${Str.join_with(said, ", ")})"
}

## Patterns, and a text each is matched against.
patterns : List((Str, Str))
patterns = [
	("\\d{2}-\\d{3}", "12-345"),
	("\\d{2}-\\d{3}", "12-3456"),
	("[a-z]+(-[a-z]+)*", "roc-solid"),
	("colou?r", "colour"),
	("\\bcat\\b", "a cat sat"),
	("\\d+", "ab 123 45"),
	("(a+)+$", "${Str.repeat("a", 30)}!"),
]

## Whether the whole text matches.
matched : Str, Str -> Str
matched = |pattern, typed| if (Regex.must(pattern).matches(typed)) "yes" else "no"

## Where it first matches, if anywhere.
found : Str, Str -> Str
found = |pattern, typed|
	match Regex.must(pattern).find(typed) {
		Ok(span) => "\"${span.text}\" at ${span.start.to_str()}"
		Err(NotFound) => "nowhere"
	}

## JSON, a line for each member of a container up to `depth` deep; deeper ones on one line.
pretty : Str, U64 -> Str
pretty = |json, depth| {
	var $out = []
	var $open = []
	var $in_string = Bool.False
	var $escaped = Bool.False
	for byte in json.to_utf8() {
		if $in_string {
			$out = $out.append(byte)
			if $escaped {
				$escaped = Bool.False
			} else if byte == '\\' {
				$escaped = Bool.True
			} else if byte == '"' {
				$in_string = Bool.False
			}
		} else if byte == '"' {
			$out = $out.append(byte)
			$in_string = Bool.True
		} else if byte == '{' or byte == '[' {
			breaks = $open.len() < depth
			$open = $open.append(breaks)
			$out = $out.append(byte)
			if breaks {
				$out = $out.concat(line($open.count_if(|each| each)))
			}
		} else if byte == '}' or byte == ']' {
			breaks = $open.last() ?? Bool.False
			$open = $open.drop_last(1)
			if breaks {
				$out = $out.concat(line($open.count_if(|each| each)))
			}
			$out = $out.append(byte)
		} else if byte == ',' {
			$out = $out.append(byte)
			if $open.last() ?? Bool.False {
				$out = $out.concat(line($open.count_if(|each| each)))
			}
		} else if byte == ':' and ($open.last() ?? Bool.False) {
			$out = $out.concat([':', ' '])
		} else {
			$out = $out.append(byte)
		}
	}
	Str.from_utf8_lossy($out)
}

## A new line, indented `depth` tabs.
line : U64 -> List(U8)
line = |depth| ['\n'].concat(List.repeat('\t', depth))

<style>
	/* The codes' table has long ones (`Custom("taken", …)`): they wrap, so the English fits. */
	#forms-codes code {
		white-space: normal;
	}
</style>
