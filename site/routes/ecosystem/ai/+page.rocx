import pf.Html
import ../../../Ui/Callout
import ../../../Ui/Code
import ../../../Ui/Heading
import ../../../Ui/PageHero
import ../../../Ui/TableWrap
import ../../../Generated/Sources
import ../../../Generated/Paths

## The ai package, a plugin: Claude from an app's server. Installing it (the key, the model),
## asking, streaming an answer to a page, typed answers, the app's functions as tools, agents (and
## agents as tools), conversations, what it costs, what can go wrong, what it sends, and the example
## app, file by file. Static: asking needs a server.
meta = {
	title: "AI",
	description: "packages/ai, a plugin for Roc Solid's server: Claude through Anthropic's Messages API, in plain Roc. Answers whole or streamed to a page, answers read into Roc types, the app's functions as tools, and agents that other agents use as tools.",
	toc: [
		{ id: "install", label: "Installing it" },
		{ id: "ask", label: "Asking" },
		{ id: "stream", label: "Streaming to a page" },
		{ id: "extract", label: "Typed answers" },
		{ id: "tools", label: "Tools" },
		{ id: "agents", label: "Agents" },
		{ id: "updates", label: "Updates" },
		{ id: "conversations", label: "Conversations" },
		{ id: "cost", label: "What it costs" },
		{ id: "problems", label: "What went wrong" },
		{ id: "sends", label: "What it sends" },
		{ id: "example", label: "The example app" },
	],
}

view! = |_|
	<>
		<NoHydration>
			<PageHero
				kicker={[<>{"The ecosystem · "}</>, <code>packages/ai</code>]}
				title="Claude, from your app's server"
			>
				Stream answers to a page, read them into Roc types, give the model your app's functions as tools, and
				build agents that hand work to each other. Plain Roc on the server platform's HTTP client: no SDK, no
				platform change.
			</PageHero>
			<p>
				The package does the parts that are easy to get wrong: it rebuilds streamed messages exactly, retries
				when the API asks, makes a refusal an error, stops the model when the page goes, turns Roc types into
				JSON Schemas, and logs tokens. Your app keeps its prompts, its tools, and what it does with the
				answers.
			</p>

			<Heading id="install">Installing it</Heading>
			<p>
				Name the package in the app's header with the two packages it uses (<code>crypto</code> and
				<code>tools</code>), and list its <a href={"${Paths.platform_server}#plugins"}>plugin</a>. It names
				the
				server platform, so only the server's half of the app sees it. The example app's
				<code>main.roc</code>:
			</p>
			<Code title={Sources.ai_example_main.file} source={Sources.ai_example_main.rocx} />
			<p>
				Then set <code>ANTHROPIC_API_KEY</code> (from
				<a href="https://console.anthropic.com">console.anthropic.com</a>)
				in the environment or in a <code>.env</code> where you run <code>rocx dev</code>
				(<a href={"${Paths.platform_settings}#env"}>which passes it to the server</a>). Without a key the
				server doesn't start, except under <code>--dev</code>, where it logs
				<code>AI off: no ANTHROPIC_API_KEY</code> and each call answers <code>NoKey</code>.
			</p>
			<p>The model it asks:</p>
			<TableWrap>
				<table>
					<thead><tr><th>When</th><th>Model</th></tr></thead>
					<tbody>
						<tr><td>by default</td><td><code>claude-opus-5-5</code></td></tr>
						<tr><td>under <code>--dev</code> (<code>rocx dev</code>)</td><td><code>claude-haiku-5-5</code>: fast and cheap while you develop</td></tr>
						<tr><td><code>ANTHROPIC_MODEL</code> or the plugin's <code>model</code> names one</td><td>that model, under <code>--dev</code> too</td></tr>
						<tr><td>a request names one (<code>model</code>)</td><td>that model, for that call</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				At start, the server logs the default model (<code>ai.model</code>), and the API's address if it isn't
				Anthropic's:
			</p>
			<Code source={"default AI model: claude-haiku-5-5"} plain numbers={Bool.False} />
			<p>
				Or pass each setting to <code>{"Ai.plugin({ key, model, base_url })"}</code>; code wins over the
				environment.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Option</th><th>Environment</th><th>Default</th></tr></thead>
					<tbody>
						<tr><td><code>key</code></td><td><code>ANTHROPIC_API_KEY</code></td><td>none: outside <code>--dev</code> the server doesn't start</td></tr>
						<tr><td><code>model</code></td><td><code>ANTHROPIC_MODEL</code></td><td><code>claude-opus-5-5</code>, or <code>claude-haiku-5-5</code> under <code>--dev</code></td></tr>
						<tr><td><code>base_url</code></td><td><code>ANTHROPIC_BASE_URL</code></td><td><code>https://api.anthropic.com</code></td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				<code>ANTHROPIC_BASE_URL</code> is the API's address; the example's tests point it at a stand-in.
			</p>

			<Heading id="ask">Asking</Heading>
			<p>
				Every call takes an <code>Ai.Request</code>. All fields have defaults; give a <code>prompt</code> or
				<code>messages</code>.
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Field</th><th>Default</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>prompt</code></td><td><code>""</code></td><td>the user's message, after <code>messages</code></td></tr>
						<tr><td><code>messages</code></td><td><code>[]</code></td><td>the conversation so far: an earlier reply's <code>messages</code>, or <code>Message.load</code>ed</td></tr>
						<tr><td><code>system</code></td><td><code>""</code></td><td>its role, the rules, the app's facts</td></tr>
						<tr><td><code>model</code></td><td>the plugin's</td><td>this call's model</td></tr>
						<tr><td><code>max_tokens</code></td><td><code>64_000</code></td><td>how much the model may write, thinking included</td></tr>
						<tr><td><code>effort</code></td><td><code>Medium</code></td><td><code>Low</code>, <code>Medium</code>, <code>High</code>, <code>XHigh</code> or <code>Max</code>: how hard it thinks. More costs more and takes longer</td></tr>
						<tr><td><code>cache</code></td><td><code>Bool.True</code></td><td>use the API's prompt cache: a later call that starts the same reads it at a tenth of the price or less</td></tr>
						<tr><td><code>max_turns</code></td><td><code>10</code></td><td>how many turns <code>run!</code> takes at most</td></tr>
						<tr><td><code>label</code></td><td><code>""</code></td><td>names the call on the log (<code>ai.turn</code>'s <code>label</code>: <code>"summary"</code>, an agent's name)</td></tr>
						<tr><td><code>updates</code></td><td><code>Bool.False</code></td><td>whether <code>run!</code> reports what the model is doing (<a href="#updates">updates</a>)</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				<code>Low</code> effort suits a chat or a label; <code>High</code> and above, careful work.
				<code>Ai.ask!</code> waits for the whole answer. The example sums up the notes with it:
			</p>
			<Code title={Sources.ai_example_summary.file} source={Sources.ai_example_summary.rocx} />
			<p>The reply is <code>{"{ text, messages, stop, usage, model }"}</code>:</p>
			<ul>
				<li><code>text</code>: the answer;</li>
				<li><code>messages</code>: the conversation with the answer, to go on with or keep;</li>
				<li>
					<code>stop</code>: why the model stopped: <code>EndTurn</code>, <code>MaxTokens</code> (text cut
					off),
					<code>ToolUse</code>, and a few more;
				</li>
				<li>
					<code>usage</code>: tokens spent, <code>{"{ input, output, cache_read, cache_write }"}</code>
					(summed
					over all turns, for <code>run!</code>);
				</li>
				<li><code>model</code>: the model that wrote it.</li>
			</ul>

			<Heading id="stream">Streaming to a page</Heading>
			<p>
				<code>{"Ai.stream!(request, heard!)"}</code> passes each piece of text to <code>heard!</code> as it is
				written, then answers the whole reply. In an endpoint's
				<a href={"${Paths.calls}#events"}><code>events!</code></a>, send each piece as an event for the page's
				<code>Endpoint.listen!</code>:
			</p>
			<Code
				title="+server.roc, in part"
				source={"events! = |{ params, .. }|\n\tOk(Events.stream(|{ send!, .. }|\n\t\tmatch Ai.stream!({ prompt: params.question }, |text| send!({ text: text })) {\n\t\t\tOk(_) => send!({ text: \"\" })\n\t\t\tErr(Stopped(Gone)) => Err(Gone)\n\t\t\tErr(problem) => send!({ text: Ai.explain(problem) })\n\t\t}))"}
				numbers={Bool.False}
			/>
			<Callout kind="note" title="When the page goes, the model stops">
				<p>
					<code>send!</code> answers <code>Err(Gone)</code> and <code>heard!</code> passes it on. The
					package
					closes the API request, so the model stops writing and costing. <code>stream!</code> answers
					<code>Err(Stopped(Gone))</code>; <code>events!</code> returns <code>Err(Gone)</code>.
				</p>
			</Callout>
			<p>
				<code>events!</code> takes no body, so a page posts its question first, then listens on a path that
				names it. The example's chat posts to <code>/api/chat/[chat]</code>, then listens there:
			</p>
			<Code title={"${Sources.ai_example_listen.file}, in part"} source={Sources.ai_example_listen.rocx} numbers={Bool.False} />
			<p>
				<code>heard!</code> gets <code>Event(said)</code> for each event, then <code>Ended</code> or
				<code>Failed(problem)</code>. On the server, <code>post!</code> adds the message to the chat's
				conversation (in <a href={Paths.platform_kv}>Kv</a>, by chat id). <code>events!</code> streams the
				assistant's answer (an <a href="#agents">agent</a>, via <code>Agent.chat!</code>): its text, a status
				line while the team works (<a href="#updates">updates</a>), then the current notes. If the team runs
				out of turns, its work is kept.
			</p>
			<Code title={Sources.ai_example_chat.file} source={Sources.ai_example_chat.rocx} />

			<Heading id="extract">Typed answers</Heading>
			<p>
				<code>{"Ai.extract!(request, Ai.schema(tags))"}</code> holds the model to the JSON Schema of the
				answer's
				type (the API's structured outputs), then reads the answer into it with <code>Json</code>, as an
				endpoint reads a body. The annotation gives the type:
			</p>
			<Code
				source={"Meal : { items : List({ food : Str, grams : U32, kcal : U32 }), total_kcal : U32 }\n\nmeal : Meal\nmeal = Ai.extract!({ system: \"Read the meal into its foods.\", prompt: said }, Ai.schema([]))?"}
				numbers={Bool.False}
			/>
			<p>The example's meal endpoint reads what the user typed into that type:</p>
			<Code title={Sources.ai_example_meal.file} source={Sources.ai_example_meal.rocx} />
			<ul>
				<li>
					<strong>The schema is the platform's</strong>, the one the
					<a href={"${Paths.routing}#openapi"}>OpenAPI document</a> uses. <code>tags</code> lists the tags
					of the
					type's unions (<code>["Breakfast", "Lunch"]</code>; <code>[]</code> for none), because a union's
					parser
					doesn't say them.
				</li>
				<li>
					<strong>It is cut to the API's subset</strong>: every object closed
					(<code>additionalProperties: false</code>), <code>oneOf</code> written as <code>anyOf</code>,
					and what
					the API doesn't enforce (an integer's range, a string's length) left out. <code>Json</code>
					checks those
					while reading, so an answer outside a <code>U32</code> is <code>InvalidJson</code>, not a wrong
					number.
				</li>
				<li>
					<strong>A type that isn't a record</strong> is asked for as an object's <code>result</code> field.
				</li>
				<li>
					<strong><code>Ai.schema</code> is a value</strong>, made where the type is known, like
					<code>{"McpHttp.openapi({})"}</code>.
				</li>
			</ul>
			<p>
				An answer that reaches <code>max_tokens</code> before its JSON ends is <code>Truncated</code>.
			</p>

			<Heading id="tools">Tools</Heading>
			<p>
				<code>{"Ai.run!(request, tools, context, heard!)"}</code> gives the model tools. The tools a turn asks
				for run in order, each given <code>context</code>, and their answers go back, until the model stops
				asking or <code>max_turns</code> is reached (<code>TooManyTurns(reply)</code>, with its
				<code>messages</code> and <code>usage</code> to keep and bill). A turn cut off at
				<code>max_tokens</code>
				ends the run; its half-written tool call is neither run nor kept, so the conversation can be sent
				again.
				A refused turn runs no tools. <code>heard!</code> gets <code>Text(piece)</code> as the model writes,
				<code>Calling(name)</code> before a tool runs, and, with <code>updates</code>, <code>Update(…)</code>
				(<a href="#updates">below</a>).
			</p>
			<p>
				A tool is <code>packages/tools</code>' <code>Tool</code>, which the <a href={Paths.ecosystem_mcp}>MCP
				package</a> serves too, so one tool serves both. <code>Ai.tool</code> makes one from a name and
				description for the model, a function of the app's (given the typed arguments and the context), and
				the arguments' schema. The example's notes, and its notes keeper's three tools:
			</p>
			<Code title={Sources.ai_example_notes.file} source={Sources.ai_example_notes.rocx} />
			<p>
				Tools from <code>McpHttp.endpoint</code>, <code>McpHttp.tool</code> and <code>Tool.typed</code> work
				too,
				with their own context (an MCP tool's is <code>McpHttp.Caller(c)</code>: the request, the context,
				<code>progress!</code>). A tool's input streams in, then is checked against its type before the tool
				runs. The model gets back:
			</p>
			<ul>
				<li>the tool's answer, as JSON text;</li>
				<li>its <code>Err(why)</code>, as a tool error the model can read and act on;</li>
				<li>arguments that don't fit the tool's type, input that isn't JSON, or an unknown tool, as tool
				errors too;</li>
				<li>
					a failure inside (<code>Failed</code>), as <code>{"\"<name> failed.\""}</code>, its reason logged
					(<code>ai.tool</code>), not sent.
				</li>
			</ul>

			<Heading id="agents">Agents</Heading>
			<p>
				An <code>Agent(ctx)</code> is a model with a role and tools: a plain value, made once and asked as
				often
				as needed:
			</p>
			<Code
				source={"keeper : Agent({})\nkeeper = {\n\tname: \"notes_keeper\",\n\tdescription: \"Keeps the user's notes. Give it a task in words: add a note, say what is noted, or remove one.\",\n\tsystem: \"You keep the user's notes, with the tools list_notes, add_note and remove_note.\",\n\ttools: Notes.tools,\n\teffort: Low,\n}\n\nreply = Agent.ask!(keeper, \"What did I note about the dentist?\", {}, |_| Ok({}))?\nreply = Agent.chat!(keeper, conversation, {}, heard!)?"}
				numbers={Bool.False}
			/>
			<TableWrap>
				<table>
					<thead><tr><th>Field</th><th>What it is</th></tr></thead>
					<tbody>
						<tr><td><code>name</code>, <code>description</code></td><td>what a model using the agent as a tool reads</td></tr>
						<tr><td><code>system</code></td><td>its role</td></tr>
						<tr><td><code>tools</code></td><td>the tools it may use (<code>[]</code>)</td></tr>
						<tr><td><code>model</code></td><td>its model (the plugin's)</td></tr>
						<tr><td><code>effort</code></td><td>how hard it thinks (<code>Medium</code>)</td></tr>
						<tr><td><code>max_turns</code>, <code>max_tokens</code></td><td>as a request's (10, and 64,000)</td></tr>
						<tr><td><code>updates</code></td><td>whether it reports what it is doing (<code>Bool.False</code>; <a href="#updates">updates</a>)</td></tr>
						<tr><td><code>doing</code></td><td>what a page shows while another agent has it at work (<code>""</code>)</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				<code>{"Agent.ask!(agent, prompt, context, heard!)"}</code> asks one message;
				<code>{"Agent.chat!(agent, messages, context, heard!)"}</code> answers a conversation whose last
				message
				is the user's. Both are <code>Ai.run!</code> with the agent's settings, logged under its name
				(<code>label</code>).
			</p>
			<p>
				<strong>Agents as tools.</strong> <code>agent.as_tool()</code> is the agent as a <code>Tool</code>
				taking one argument, <code>task</code>: the work, in words. A team is plain values: specialists with
				their own prompts and tools, and a calling agent that stays in charge and knows which to ask. The
				example's chat (<a href="#stream">streaming to a page</a>) talks to such a team:
			</p>
			<Code title={Sources.ai_example_team.file} source={Sources.ai_example_team.rocx} />
			<ul>
				<li>
					<strong>A task is a conversation of its own.</strong> The agent sees nothing of its caller's, so
					the
					task must hold everything. Say so in the caller's system prompt, as the assistant's does.
				</li>
				<li>
					<strong>An agent's text isn't streamed to its caller.</strong> With <code>updates</code>, its
					progress
					notes and tools are (<a href="#updates">below</a>).
				</li>
				<li>
					<strong>Its answer is the tool's result.</strong> A failure is a tool error
					(<code>{"\"<name> couldn't do it: …\""}</code>), and so is a call with no task, without asking
					the API.
				</li>
				<li>
					<strong>One context.</strong> Every agent in a team gives its tools the context it was given.
				</li>
				<li>
					<strong>An MCP tool too.</strong> Being a <code>Tool</code>, an agent can be an MCP server's tool.
				</li>
			</ul>

			<Heading id="updates">Updates</Heading>
			<p>
				With <code>updates: Bool.True</code>, a request or agent sends its listener
				<code>Update(update)</code>
				(the tools package's <code>Tool.Update</code>) for a page to show while the model works:
			</p>
			<ul>
				<li>
					<code>{"Progress({ agent, says })"}</code>: a note the model wrote between tool calls (“I'll look
					through your notes first.”). Asked for on Claude Opus 5.5, Sonnet 5.5, Fable and Mythos, whose
					reasoning stays hidden. Claude Haiku 5.5 writes them as plain <code>Text</code>.
				</li>
				<li>
					<code>{"Using({ agent, tool, says })"}</code>: one of the app's tools starting, with what it
					says it is
					doing: <code>{"Ai.tool(…).doing(\"Looking through your notes…\")"}</code>, or an agent's
					<code>doing</code> field.
				</li>
				<li>
					Agents used as tools pass theirs up, each under its name (<code>agent</code>).
				</li>
			</ul>
			<p>
				Your app decides where they go. The example's chat sends each as an event on its page's stream
				(<a href="#stream">above</a>), shown as a status line: “Counting the calories…”, “Seeing to your
				notes…”, “notes_keeper: Writing that down…”. A page that started the work with a form can listen on a
				<a href={"${Paths.platform_live}#channels"}>channel</a> instead:
			</p>
			<Code
				source={"Agent.chat!(Team.assistant, conversation, {}, |heard|\n\tmatch heard {\n\t\tUpdate(update) => Ok(Endpoint.publish!(Api.channel_api_chat_chat_updates({ chat }), update))\n\t\t_ => Ok({})\n\t})"}
				numbers={Bool.False}
			/>
			<p>
				Progress notes stay in the conversation and go back to the API. They are billed as output, shown or
				not.
			</p>

			<Heading id="conversations">Conversations</Heading>
			<p>
				A conversation is a <code>List(Message)</code>; <code>Message.user(text)</code> makes the user's. The
				model's are kept exactly as the API wrote them, thinking blocks and signatures included, because the
				API needs them back. To go on, pass <code>reply.messages</code> as the next request's
				<code>messages</code> with a
				new <code>prompt</code>.
			</p>
			<p>
				<code>Message.save(messages)</code> writes a conversation as JSON text, for Kv or a table;
				<code>Message.load(text)</code> reads it back exactly. <code>Message.text(message)</code> is its
				text alone, without
				thinking or tool use. The example keeps each chat in Kv for a day:
			</p>
			<Code title={Sources.ai_example_chats.file} source={Sources.ai_example_chats.rocx} />
			<p>
				After a mid-turn <a href="#sends">server-side fallback</a> (another model took over where the first
				declined), the message drops the first model's thinking
				and tool uses before the <code>fallback</code> block, as the API asks, and keeps the block.
			</p>

			<Heading id="cost">What it costs</Heading>
			<p>Each turn is logged with its tokens (<code>ai.turn</code>):</p>
			<Code
				source={"{\"msg\":\"ai.turn\",\"label\":\"notes_keeper\",\"model\":\"claude-haiku-5-5\",\"stop\":\"tool_use\",\"input\":4,\"cache_read\":640,\"cache_write\":215,\"output\":112,\"ms\":878}"}
				plain
				numbers={Bool.False}
			/>
			<ul>
				<li>
					<code>label</code>: the request's, or the agent's name, so each agent's spending can be told
					apart (absent
					when empty);
				</li>
				<li><code>input</code>: read without the cache;</li>
				<li>
					<code>cache_read</code>: read from the cache, at a tenth of the input price (a twentieth on Opus 5.5
					and Sonnet 5.5);
				</li>
				<li><code>cache_write</code>: written to the cache, once, at a quarter more;</li>
				<li><code>output</code>: what the model wrote; <code>ms</code>: how long the turn took.</li>
			</ul>
			<p>
				With <code>cache</code> on (the default), each turn reads the previous one from the cache. A prompt
				under the model's minimum (512 to 4,096 tokens, by model) isn't cached, and asking costs nothing
				extra. The other levers are the model and <code>effort</code>: <code>--dev</code> uses
				<code>claude-haiku-5-5</code>, and the example <code>Low</code> effort.
			</p>

			<Heading id="problems">What went wrong</Heading>
			<p>
				A failed call answers an <code>Ai.Problem(err)</code>; <code>Ai.explain(problem)</code> puts it in a
				sentence:
			</p>
			<TableWrap>
				<table>
					<thead><tr><th>Tag</th><th>When</th></tr></thead>
					<tbody>
						<tr><td><code>NoKey</code></td><td>no <code>ANTHROPIC_API_KEY</code> (under <code>--dev</code>)</td></tr>
						<tr><td><code>Status(code, why)</code></td><td>the API refused: 400 the request, 401 the key, 429 too many (still, after two retries), 529 overloaded</td></tr>
						<tr><td><code>Unreachable(why)</code>, <code>TimedOut</code>, <code>Broken(why)</code></td><td>no whole answer came</td></tr>
						<tr><td><code>Refused(category)</code></td><td>the model declined (the API's category, as <code>"cyber"</code>; often <code>""</code>)</td></tr>
						<tr><td><code>Truncated</code></td><td><code>extract!</code>'s answer reached <code>max_tokens</code> before its JSON ended</td></tr>
						<tr><td><code>InvalidJson(why)</code></td><td><code>extract!</code>'s answer didn't fit its type</td></tr>
						<tr><td><code>TooManyTurns(reply)</code></td><td><code>run!</code> took <code>max_turns</code> turns and the model still wanted its tools; <code>reply</code> is what it did (its <code>messages</code> and <code>usage</code>)</td></tr>
						<tr><td><code>Stopped(err)</code></td><td><code>heard!</code> answered <code>Err(err)</code>: from an endpoint's <code>events!</code>, the page went (<code>Stopped(Gone)</code>)</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				A 408, 409, 429, 500, 502, 503, 504 or 529, or a stream error event meaning one (overloaded, a rate
				limit, a
				timeout, the API's own error), is retried twice
				after <code>retry-after</code> (a minute at most; else half a second, then a second), each retry
				logged (<code>ai.retry</code>). Nothing is retried once text has been passed on, or when the
				connection fails (<code>Unreachable</code>).
			</p>

			<Heading id="sends">What it sends</Heading>
			<p>
				<code>{"POST <base_url>/v1/messages"}</code>, with <code>anthropic-version: 2026-10-21</code>,
				<code>x-api-key</code> and <code>"stream": true</code>: every call streams, so a long answer never
				times out (30 minutes at most). <code>output_config</code> carries the effort and
				<code>extract!</code>'s
				format; <code>cache_control</code> asks for the prompt cache. No sampling parameters (that version
				refuses <code>temperature</code> and the rest), no <code>thinking</code> (models think as they need;
				<code>effort</code> says how much), no forced <code>tool_choice</code> (Claude Opus 5.5 refuses it).
				With <code>updates</code>, on models that write progress notes, <code>thinking</code> is
				<code>{"{\"type\": \"adaptive\", \"display\": \"updates\"}"}</code> and <code>anthropic-beta</code>
				lists
				<code>thinking-display-updates-2026-08-18</code>.
			</p>
			<p>
				<code>effort</code> is always sent. Claude Opus 4.5 and every model from 4.6 on accept it; Claude
				Haiku 4.5 and Sonnet 4.5 refuse it (a 400), so <code>ANTHROPIC_MODEL</code> can't name them. Opus
				4.5 takes <code>Low</code> to <code>High</code> only, and the 4.6s have no <code>XHigh</code>.
			</p>
			<p>
				On models that support it (<code>claude-opus-5-5</code>, <code>claude-opus-5</code>,
				<code>claude-sonnet-5-5</code>, <code>claude-fable-5-2</code>, <code>claude-fable-5-1</code>, and
				Mythos
				5.2 and 5.1), it sends <code>"fallbacks": "default"</code> with
				<code>anthropic-beta: server-side-fallback-2026-07-01</code>. When the model's safety classifiers
				decline a request, the API reruns it, in the same call, on the model it names for that refusal.
				<code>claude-haiku-5-5</code> has no fallback: a refusal there is <code>Refused</code>.
			</p>

			<Heading id="example">The example app</Heading>
			<p><code>packages/ai/example</code> is a notes assistant, its notes and chats kept in Kv. Its page
			has:</p>
			<ul>
				<li>
					a streamed chat with an assistant that hands notes to a notes keeper and meals to a nutritionist,
					agents it uses as tools;
				</li>
				<li>a button that sums up the notes (<code>ask!</code>);</li>
				<li>a meal described in words, read into a typed record (<code>extract!</code>).</li>
			</ul>
			<TableWrap>
				<table>
					<thead><tr><th>File</th><th>What it shows</th></tr></thead>
					<tbody>
						<tr><td><code>main.roc</code></td><td>the header and the plugin</td></tr>
						<tr><td><code>Notes.roc</code></td><td>the notes, and the three tools the notes keeper uses</td></tr>
						<tr><td><code>Team.roc</code></td><td>the agents: the notes keeper, the nutritionist, and the assistant that uses both as tools</td></tr>
						<tr><td><code>Chats.roc</code></td><td>each chat's conversation, saved and loaded</td></tr>
						<tr><td><code>routes/api/chat/[chat]/+server.roc</code></td><td>the chat: <code>post!</code> the message, then <code>events!</code> with <code>Agent.chat!</code></td></tr>
						<tr><td><code>routes/api/notes/summary/+server.roc</code></td><td>the summary, with <code>ask!</code></td></tr>
						<tr><td><code>routes/api/meal/+server.roc</code></td><td>the meal, with <code>extract!</code></td></tr>
						<tr><td><code>Ui/Chat.rocx</code></td><td>the page's chat: it posts, then listens</td></tr>
					</tbody>
				</table>
			</TableWrap>
			<p>
				Its tests (<code>example/test/ai.test.mjs</code>) run it against a stand-in for the API
				(<code>example/test/stand-in.mjs</code>), checking what the app sent and what it made of the answer;
				they never call the API. To try it for real, put your key in a <code>.env</code>:
			</p>
			<Code source={"echo 'ANTHROPIC_API_KEY=sk-ant-…' >> .env\nbin/rocx dev packages/ai/example --port 8095"} plain numbers={Bool.False} />
			<p>
				On <code>claude-haiku-5-5</code>, one chat message took six model calls (the assistant three, the
				nutritionist one, the notes keeper two): about 4,400 tokens read, mostly cached, and 470 written, well
				under a tenth of a cent.
			</p>
			<p>
				The package's <code>README.md</code> is the reference. Not built yet (see its
				<code>PROPOSALS.md</code>):
				images and documents in a prompt, batches, token counting, the API's own tools (web search, code
				execution), and an agent's text streamed to its caller.
			</p>
		</NoHydration>
	</>
