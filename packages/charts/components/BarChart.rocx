import pf.Html
import pf.Solid exposing [create_memo!, create_signal!]
import pf.For
import pf.Show
import pf.Transition
import charts.Band
import charts.Ease
import charts.Format
import charts.Keys
import charts.Scale
import charts.Ticks

## A bar for each of `data!`'s values, on an axis from zero (or the least value, when one is
## negative) to the greatest, widened to round numbers, with its ticks on round numbers too. When
## the data changes, the bars and the axis glide to where they go: Roc moves them each animation
## frame until they get there, and then asks for no more frames. A bar is its label's: one that
## comes grows out of the axis as the others make room, one whose label is gone shrinks into the
## axis as it fades (`transition:out`) while the others close up, and sorted, each slides to its
## place. Pointing at a bar, or reaching it with Tab, shows its value.
##
## `label` names the chart for screen readers, `format` writes a value (`Format.short`, or
## `|mm| "${Format.num(mm, 0)} mm"`), and `padding` is the share of each bar's slot left empty
## (0.3 unless said).
BarChart := [].{
	Bar : { label : Str, value : Dec }

	## A bar and its key: its label, numbered when another bar before it has the same one.
	Row : { key : Str, bar : BarChart.Bar }

	## A bar as drawn: its value, and its slot (0 for the first), on their way to the data's.
	Placed : { key : Str, value : Dec, slot : Dec }

	## What is drawn: the bars, how many slots there are, and the axis's ends.
	Drawn : { bars : List(BarChart.Placed), count : Dec, domain : (Dec, Dec) }

	Props := { data! : () => List(BarChart.Bar), label : Str, format : Dec -> Str, padding : Dec ?? 0.3 }

	view! : Props => Html
	view! = |props| {
		data! = props.data!
		format = props.format
		rows! = create_memo!(|| BarChart.keyed(data!()))
		goal! = create_memo!(|| BarChart.place(rows!()))
		(drawn!, set_drawn!) = create_signal!(goal!())
		(hover!, set_hover!) = create_signal!(Err(None))
		y! = create_memo!(|| Scale.linear(drawn!().domain, (bottom, top)))
		x! = create_memo!(|| Band.band(drawn!().count, (left, right), props.padding))
		placed! = |key| BarChart.placed(drawn!(), goal!(), key)
		value! = |key| placed!(key).value
		# A bar goes from the axis's zero to its value, up or down.
		bar_top! = |key| Dec.min(y!().at(value!(key)), y!().at(0.0))
		bar_height! = |key| Dec.abs(y!().at(value!(key)) - y!().at(0.0))
		# Its value over its end: above a bar that goes up, below one that goes down.
		value_y! = |key| if (value!(key) < 0.0) bar_top!(key) + bar_height!(key) + 18.0 else bar_top!(key) - 8.0
		<figure class="bar-chart">
			<svg viewBox="0 0 640 320" role="group" aria-label={props.label}>
				<g class="ticks" aria-hidden="true">
					<For each!={BarChart.ticks(goal!())} keyed={|tick| Format.num(tick, 9)}>
						{|tick!, _|
							<g class:out={BarChart.outside(drawn!().domain, tick!())}>
								<line x1={Format.coord(left)} x2={Format.coord(right)} y1={Format.coord(y!().at(tick!()))} y2={Format.coord(y!().at(tick!()))} />
								<text x={Format.coord(left - 8.0)} y={Format.coord(y!().at(tick!()))} dy="0.32em">{format(tick!())}</text>
							</g>}
					</For>
				</g>
				<For each!={rows!()} keyed={|row| row.key}>
					{|row!, _|
						<g
							class="bar"
							class:active={hover!() == Ok(row!().key)}
							role="img"
							tabindex="0"
							aria-label={"${row!().bar.label}: ${format(row!().bar.value)}"}
							on:pointerenter={|| set_hover!(Ok(row!().key))}
							on:pointerleave={|| set_hover!(Err(None))}
							on:focus={|| set_hover!(Ok(row!().key))}
							on:blur={|| set_hover!(Err(None))}
						>
							{# Gone from the data, it shrinks into the axis as it fades. }
							<rect
								x={Format.coord(x!().at(placed!(row!().key).slot))}
								y={Format.coord(bar_top!(row!().key))}
								width={Format.coord(x!().width())}
								height={Format.coord(bar_height!(row!().key))}
								rx="3"
								transition:out={Transition.grow(if (row!().bar.value < 0.0) Top else Bottom).plus(Transition.fade)}
							/>
							<text class="value" x={Format.coord(x!().center(placed!(row!().key).slot))} y={Format.coord(value_y!(row!().key))}>{format(row!().bar.value)}</text>
							<text class="label" x={Format.coord(x!().center(placed!(row!().key).slot))} y={Format.coord(bottom + 20.0)} transition={Transition.fade}>{row!().bar.label}</text>
						</g>}
				</For>
				<line class="axis" x1={Format.coord(left)} x2={Format.coord(right)} y1={Format.coord(y!().at(0.0))} y2={Format.coord(y!().at(0.0))} />
			</svg>
			{# Frames only while something moves: once the bars are where the data says, none. }
			<Show when!={drawn!() != goal!()}>
				<span hidden on:frame.ms={|ms| set_drawn!(BarChart.glide(drawn!(), goal!(), ms))}></span>
			</Show>
		</figure>
	}

	## Each bar with its key: its label, or, after the first bar with that label, the label numbered
	## (`Jan#1`), so each bar keeps a row of its own.
	keyed : List(BarChart.Bar) -> List(BarChart.Row)
	keyed = |bars| List.map2(Keys.unique(bars.map(|bar| bar.label)), bars, |key, bar| { key, bar })

	## Where the bars go: each to its value, in its slot, on an axis from zero (or below it) to the
	## greatest value, widened to round numbers.
	place : List(BarChart.Row) -> BarChart.Drawn
	place = |rows| {
		values = rows.map(|row| row.bar.value)
		(low, high) = Scale.extent(values)
		from = Dec.min(low, 0.0)
		to = Dec.max(high, 0.0)
		domain =
			if from == to {
				(0.0, 1.0)
			} else {
				Ticks.nice(from, to, tick_count)
			}
		{
			bars: rows.map_with_index(|row, i| { key: row.key, value: row.bar.value, slot: i.to_dec() }),
			count: rows.len().to_dec(),
			domain,
		}
	}

	## Where the bar with `key` is drawn now: as drawn, or, not drawn yet, at zero in its slot.
	placed : BarChart.Drawn, BarChart.Drawn, Str -> BarChart.Placed
	placed = |drawn, goal, key|
		match drawn.bars.find_first(|bar| bar.key == key) {
			Ok(bar) => bar
			Err(_) => {
				slot = goal.bars.find_first(|bar| bar.key == key).map_ok(|bar| bar.slot) ?? 0.0
				{ key, value: 0.0, slot }
			}
		}

	## A frame's way from `drawn` toward `goal`. A bar that is new starts at zero in its slot, and
	## the slots make room for it; one that has gone is gone from here at once (its row shrinks it
	## into the axis), and the slots close up.
	glide : BarChart.Drawn, BarChart.Drawn, F64 -> BarChart.Drawn
	glide = |drawn, goal, ms| {
		(d0, d1) = drawn.domain
		(g0, g1) = goal.domain
		# Within a five-hundredth of the axis is there: under a pixel. So is a hundredth of a slot.
		close = (g1 - g0) / 500.0
		near = 0.01
		{
			bars: goal.bars.map(
				|bar| {
					from = BarChart.placed(drawn, goal, bar.key)
					{ key: bar.key, value: Ease.toward(from.value, bar.value, ms, close), slot: Ease.toward(from.slot, bar.slot, ms, near) }
				},
			),
			count: Ease.toward(drawn.count, goal.count, ms, near),
			domain: (Ease.toward(d0, g0, ms, close), Ease.toward(d1, g1, ms, close)),
		}
	}

	## The axis's ticks.
	ticks : BarChart.Drawn -> List(Dec)
	ticks = |drawn| {
		(from, to) = drawn.domain
		Ticks.between(from, to, tick_count)
	}

	## Whether a tick is off the axis as drawn: one the axis is gliding toward, faded until it is on.
	outside : (Dec, Dec), Dec -> Bool
	outside = |(from, to), tick| tick < Dec.min(from, to) or tick > Dec.max(from, to)

	<style>
		.bar-chart {
			margin: 0;
		}

		svg {
			display: block;
			width: 100%;
			height: auto;
			overflow: visible;
			font: 12px/1 var(--chart-font, inherit);
		}

		.ticks line {
			stroke: var(--chart-grid, color-mix(in srgb, currentColor 12%, transparent));
			stroke-dasharray: var(--chart-grid-dash, none);
		}

		.ticks g {
			transition: opacity 0.2s;
		}

		.ticks .out {
			opacity: 0;
		}

		.ticks text {
			fill: var(--chart-muted, color-mix(in srgb, currentColor 60%, transparent));
			text-anchor: end;
			font-variant-numeric: tabular-nums;
		}

		.axis {
			stroke: var(--chart-axis, color-mix(in srgb, currentColor 45%, transparent));
		}

		.bar {
			outline: none;
			cursor: default;
		}

		.bar rect {
			fill: var(--chart-color, #4f6bed);
			fill-opacity: var(--chart-fill, 1);
			stroke: var(--chart-stroke, none);
			stroke-width: var(--chart-stroke-width, 0);
			rx: var(--chart-radius, 3px);
			filter: var(--chart-glow, none);
			transition: fill 0.15s, fill-opacity 0.15s;
		}

		.bar.active rect {
			fill: var(--chart-active, #2f49c4);
			fill-opacity: 1;
		}

		.bar:focus-visible rect {
			stroke: var(--chart-active, #2f49c4);
			stroke-width: 2;
		}

		.bar text {
			text-anchor: middle;
			fill: currentColor;
		}

		.bar .label {
			fill: var(--chart-muted, color-mix(in srgb, currentColor 60%, transparent));
		}

		.bar .value {
			font-weight: 600;
			opacity: 0;
			transition: opacity 0.15s;
			font-variant-numeric: tabular-nums;
		}

		.bar.active .value {
			opacity: 1;
		}
	</style>
}

## The plot's edges in the SVG's units (640 by 320): room on the left for the ticks' labels, and
## below for the bars'.
left : Dec
left = 48.0

right : Dec
right = 632.0

top : Dec
top = 16.0

bottom : Dec
bottom = 288.0

tick_count : U64
tick_count = 5
