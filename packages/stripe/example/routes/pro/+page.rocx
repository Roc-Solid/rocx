import pf.Html
import pf.Endpoint
import ../../Generated/Api

## The pro pages: subscribers only, as its `+server.roc`'s middleware (`Middlewares.subscribers`)
## says. Anyone else goes to the pricing page.
meta = { title: "Pro" }

## Whose page it is (`GET /pro`).
reader! : {} => { email : Str }
reader! = |{}| Endpoint.get!(Api.get_pro({}))

view! = |_| {
	reader = reader!({})
	<main>
		<h1>The pro pages</h1>
		<p>Thank you for subscribing, {reader.email}. Everything here is yours while your subscription is.</p>
		<p><a href="/account">Your account</a></p>
	</main>
}
