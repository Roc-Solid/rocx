import pf.Html
import ../../../Generated/Api

## The e-book: for those who bought it, as its middleware (`Middlewares.readers`) says. Anyone
## else goes to the pricing page.
meta = { title: "The e-book" }

## The book (`GET /api/ebook`).
book! : {} => { title : Str, chapters : List(Str) }
book! = |{}| Api.get_api_ebook({}).read!()

view! = |_| {
	book = book!({})
	<main>
		<h1>{book.title}</h1>
		<ol>
			{...book.chapters.map(|chapter|
				<li key={chapter}>{chapter}</li>
			)}
		</ol>
	</main>
}
