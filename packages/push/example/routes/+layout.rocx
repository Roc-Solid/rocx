import pf.Html

## Every page: the push script in the head, so it is there before the page wakes up.
view! = |{ children, .. }|
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<title>Push</title>
			<script type="module" src="/push.js"></script>
		</head>
		<body>
			{...children}
		</body>
	</html>
