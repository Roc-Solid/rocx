import pf.Html

## Every page. The push plugin's script comes with every page the server renders (D-050): nothing to
## load here.
view! = |{ children, .. }|
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<title>Push</title>
		</head>
		<body>
			{...children}
		</body>
	</html>
