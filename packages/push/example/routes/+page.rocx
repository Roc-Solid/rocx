import pf.Html
import pf.Server
import pf.Solid exposing [create_signal!]
import push.PushButton
import pf.Endpoint
import pf.Call
import ../Generated/Api

## Asks the server to notify everyone (`POST /push/announce`), from the button's handler: how
## many it queued, or why not.
announce! : {} => Str
announce! = |{}|
	match Endpoint.send!(Api.post_push_announce({}), {}, Call.fetch!) {
		Ok(said) => said
		Err(problem) => Server.explain(problem)
	}

view! = |_| {
	(said!, set_said!) = create_signal!("")
	<main>
		<h1>Push</h1>
		<PushButton api="/push" />
		<button type="button" on:click={|| set_said!(announce!({}))}>Notify everyone</button>
		<p>{said!()}</p>
	</main>
}
