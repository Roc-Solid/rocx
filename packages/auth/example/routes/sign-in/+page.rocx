import pf.Html
import pf.Endpoint
import pf.Router
import pf.Server
import pf.Router exposing [use_submission!]
import auth.SignInError
import ../../Generated/Api

## Signing in: an address, and a link mailed to it; or a provider's button; or, under `--dev`, any
## address at once. Plain forms and links, so it works before the page's JavaScript has loaded.
meta = { title: "Sign in" }

## What the page offers (`GET /sign-in`).
offered! : {} => { providers : List({ name : Str, label : Str, path : Str }), dev : Bool }
offered! = |{}| Endpoint.get!(Api.get_sign_in({}))

view! = |_| {
	query = Router.location!({}).query
	then = SignInError.field(query, "then")
	problem = SignInError.message(query)
	sending = use_submission!(Api.post_sign_in({}))
	offers = offered!({})
	<main>
		<h1>Sign in</h1>
		{if !problem.is_empty() {
			<p role="alert">{problem}</p>
		}}
		{match sending.result!() {
			Ok(sent) => <p role="status">We sent a sign-in link to <strong>{sent.sent}</strong>.</p>
			Err(_) =>
				<form method="post" action={Endpoint.url_of(Api.post_sign_in({}))}>
					<input type="hidden" name="then" value={then} />
					<label for="email">Email address</label>
					<input id="email" name="email" type="email" required autocomplete="email" />
					<button type="submit">Email me a link</button>
					{match sending.error!() {
						Ok(failed) => <p role="alert">{Server.explain(failed)}</p>
						Err(_) => <></>
					}}
				</form>
		}}
		<ul>
			{...offers.providers.map(|provider|
				<li key={provider.name}><a href={"${provider.path}?then=${Server.encode_segment(then)}"}>Continue with {provider.label}</a></li>
			)}
		</ul>
		{if offers.dev {
			<form method="post" action="/auth/dev">
				<input type="hidden" name="then" value={then} />
				<label for="dev-email">Any address (--dev)</label>
				<input id="dev-email" name="email" type="email" required />
				<button type="submit">Sign in at once</button>
			</form>
		}}
	</main>
}
