import pf.Endpoint
import guard.Flags
import Generated/Api

## Who is visiting, as the server knows them.
Visitor := [].{

	## The app's flags, decided on the server for whoever is signed in: `GET /flags`
	## (`routes/flags/+server.roc`), which the server answers as it renders the page, and the page
	## carries, so the browser's first run reads the same values instead of asking again.
	flags! : {} => Flags.Values
	flags! = |{}| Endpoint.get!(Api.get_flags({}))
}
