import pf.Server
import guard.Flags
import FlagStore
import Features

## Who is visiting, as the server knows them.
Visitor := [].{

	## The app's flags, decided on the server for whoever is signed in (the `user` its middleware
	## handed on). A page's call is answered as the server renders it, and the answer is put in the
	## page, so the browser's first run reads the same values instead of asking again.
	flags! : {} => Flags.Values
	flags! = server!(|_request, {}| FlagStore.values!(Features.all, { user: Server.context!({}).user, groups: [] }))
}
