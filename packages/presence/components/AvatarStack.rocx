import pf.Html
import pf.Solid exposing [create_memo!]
import pf.Transition
import presence.Stack

## Who is here, as a row of overlapping avatars: a picture, or initials on a colour of their own,
## and their status (`Stack.Status`, a class each: `status-away`): `Online` as it is, `Away` dimmed
## with an orange dot, `Busy` with a red one, `Offline` greyed. Past `max`, the last place says how
## many more (`+3`). One who comes grows in, one who goes fades out. A screen reader hears who is
## here (`Stack.label`), or `label` when one is given, and each face's status after its name.
##
## A "who's viewing this page" stack is one fed by a presence stream for the page's path.
AvatarStack := [].{
	Props := {
		faces! : () => List(Stack.Face),
		max : U64 ?? 5,
		label : Str ?? "",
	}

	view! : Props => Html
	view! = |{ faces!, max, label }| {
		split! = create_memo!(|| Stack.split(faces!(), max))
		<div class="avatar-stack" role="group" aria-label={if (label.is_empty()) Stack.label(faces!()) else label}>
			{...split!().shown.map(|face|
				<span key={face.key}
					class={"avatar status-${Stack.status_word(face.status)}"}
					role="img"
					aria-label={Stack.said(face)}
					title={face.name}
					style:--avatar-color={Stack.color_of(face)}
					transition={Transition.scale(0.5).plus(Transition.fade)}
				>
					{if (face.image.is_empty()) <span class="initials" aria-hidden="true">{Stack.initials(face.name)}</span> else <img src={face.image} alt="" />}
				</span>
			)}
			{if split!().more > 0 {
				<span class="avatar more" role="img" aria-label={"and ${split!().more.to_str()} more"} title={more_names(faces!(), split!().shown.len())}>
					+{split!().more.to_str()}
				</span>
			}}
		</div>
	}

	<story name="Three here">
		<AvatarStack faces!={|| [sample("ada", "Ada Lovelace", Online), sample("alan", "Alan Turing", Away), sample("grace", "Grace Hopper", Online)]} />
	</story>

	<story name="More than fit">
		<AvatarStack
			faces!={|| [sample("ada", "Ada Lovelace", Online), sample("alan", "Alan Turing", Online), sample("grace", "Grace Hopper", Busy), sample("edsger", "Edsger Dijkstra", Online), sample("barbara", "Barbara Liskov", Online), sample("donald", "Donald Knuth", Away), sample("frances", "Frances Allen", Online)]}
			max={4}
		/>
	</story>

	<story name="One dropped">
		<AvatarStack faces!={|| [sample("ada", "Ada Lovelace", Online), sample("alan", "Alan Turing", Offline), sample("grace", "Grace Hopper", Online)]} />
	</story>

	<style>
		.avatar-stack {
			display: inline-flex;
			flex-direction: row;
			align-items: center;
			padding-left: var(--avatar-overlap, 0.375rem);
		}

		.avatar {
			position: relative;
			display: inline-grid;
			place-items: center;
			width: var(--avatar-size, 2rem);
			height: var(--avatar-size, 2rem);
			margin-left: calc(-1 * var(--avatar-overlap, 0.375rem));
			border-radius: 50%;
			background: var(--avatar-color, #4f6bed);
			box-shadow: 0 0 0 2px var(--avatar-ring, Canvas);
			color: #fff;
			/* Longhands: `inherit` inside the `font` shorthand would drop the whole of it. With no
			   --avatar-font, font-family has no value, and so inherits. */
			font-family: var(--avatar-font);
			font-size: calc(var(--avatar-size, 2rem) * 0.38);
			font-weight: 600;
			line-height: 1;
			letter-spacing: 0.02em;
			user-select: none;
		}

		.avatar img {
			width: 100%;
			height: 100%;
			border-radius: 50%;
			object-fit: cover;
		}

		.avatar.status-away img,
		.avatar.status-away .initials {
			opacity: 0.55;
		}

		.avatar.status-offline {
			filter: grayscale(1);
			opacity: var(--avatar-offline, 0.5);
		}

		/* A dot for away and busy: the stack is who is here, so being here needs none. */
		.avatar.status-away::after,
		.avatar.status-busy::after {
			content: "";
			position: absolute;
			right: -1px;
			bottom: -1px;
			width: 30%;
			height: 30%;
			border-radius: 50%;
			background: var(--avatar-away, #f08c00);
			box-shadow: 0 0 0 2px var(--avatar-ring, Canvas);
		}

		.avatar.status-busy::after {
			background: var(--avatar-busy, #e03131);
		}

		.avatar.more {
			background: var(--avatar-more, color-mix(in srgb, currentColor 18%, Canvas));
			color: inherit;
		}
	</style>
}

## The names past those shown: the `+N`'s tooltip.
more_names : List(Stack.Face), U64 -> Str
more_names = |faces, shown| Str.join_with(faces.drop_first(shown).map(|face| face.name), ", ")

sample : Str, Str, Stack.Status -> Stack.Face
sample = |key, name, status| { key, name, image: "", color: "", status }
