import Plural
import NumberFormat
import DateFormat
import RelativeTime

## Each locale's data: its plural rules, how it writes numbers, money and dates, and its words for
## relative times. Written by `tools/locales.mjs` from CLDR 48.0 (Node's ICU 78.3); add a
## locale there, not here. An app names the ones it supports (`[Locales.en, Locales.pl]`), and only
## those are compiled into it.
Locales := [].{

	## What a locale needs to format: `Intl.new(Locales.pl)`.
	Data : {
		tag : Str,
		name : Str,
		cardinal : Plural.Operands -> Plural.Category,
		ordinal : Plural.Operands -> Plural.Category,
		number : NumberFormat.Symbols,
		dates : DateFormat.Names,
		relative : RelativeTime.Words,
	}

	## Every locale this package has data for.
	all : List(Data)
	all = [en, en_gb, de, fr, es, pl, cs, ru, ar, ja]

	en : Data
	en = {
		tag: "en",
		name: "English",
		cardinal: Plural.en,
		ordinal: Plural.ordinal_en,
		number: {
			decimal: ".",
			group: ",",
			min_grouping: 1,
			minus: "-",
			percent: "{-}{0}%",
			currency: "{-}¤{0}",
			currency_symbols: [("USD", "\$"), ("EUR", "€"), ("GBP", "£"), ("JPY", "¥"), ("CNY", "CN¥"), ("INR", "₹"), ("CAD", "CA\$"), ("AUD", "A\$"), ("BRL", "R\$"), ("MXN", "MX\$"), ("KRW", "₩"), ("ILS", "₪")],
			compact: ["0K", "00K", "000K", "0M", "00M", "000M", "0B", "00B", "000B", "0T", "00T", "000T"],
		},
		dates: {
			months: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
			months_short: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
			months_standalone: [],
			weekdays: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
			weekdays_short: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"],
			am: "AM",
			pm: "PM",
			date: { short: "M/d/yy", medium: "MMM d, y", long: "MMMM d, y", full: "EEEE, MMMM d, y" },
			time: { short: "h:mm a", medium: "h:mm:ss a" },
			date_time: { short: "{1}, {0}", medium: "{1}, {0}", long: "{1} at {0}", full: "{1} at {0}" },
			month_year: "MMMM y",
		},
		relative: {
			second: { future: { ..Plural.none, one: "in {0} second", other: "in {0} seconds" }, past: { ..Plural.none, one: "{0} second ago", other: "{0} seconds ago" } },
			minute: { future: { ..Plural.none, one: "in {0} minute", other: "in {0} minutes" }, past: { ..Plural.none, one: "{0} minute ago", other: "{0} minutes ago" } },
			hour: { future: { ..Plural.none, one: "in {0} hour", other: "in {0} hours" }, past: { ..Plural.none, one: "{0} hour ago", other: "{0} hours ago" } },
			day: { future: { ..Plural.none, one: "in {0} day", other: "in {0} days" }, past: { ..Plural.none, one: "{0} day ago", other: "{0} days ago" } },
			week: { future: { ..Plural.none, one: "in {0} week", other: "in {0} weeks" }, past: { ..Plural.none, one: "{0} week ago", other: "{0} weeks ago" } },
			month: { future: { ..Plural.none, one: "in {0} month", other: "in {0} months" }, past: { ..Plural.none, one: "{0} month ago", other: "{0} months ago" } },
			year: { future: { ..Plural.none, one: "in {0} year", other: "in {0} years" }, past: { ..Plural.none, one: "{0} year ago", other: "{0} years ago" } },
			yesterday: "yesterday",
			today: "today",
			tomorrow: "tomorrow",
			now: "now",
		},
	}

