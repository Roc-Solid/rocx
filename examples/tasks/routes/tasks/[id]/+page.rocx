import pf.Html
import pf.Endpoint
import pf.Show
import pf.Router exposing [use_before_leave!]
import pf.Solid exposing [create_signal!]
import pf.For
import pf.Title
import forms.LiveForm
import forms.TextField
import forms.CheckboxField
import ../../../Tasks
import ../../../TaskForm
import ../../../Generated/Api
import ../../../Generated/Paths

## A task's page: everything about it in one form (title, notes, due day, who has it, done), and a
## button that deletes it. Both are plain forms. Saving posts to this page's own URL
## (`POST /tasks/:id`), whose endpoint reads the form with `TaskForm.editing` (packages/forms) and
## sends you back to the list, or refuses it (422) with each field's issues, which show here under
## their fields, with what was typed: without JavaScript the browser posts and comes back (a 303,
## and a flash); with it, the runtime sends the form with fetch and the page stays. A task that
## isn't there is the app's error page, a 404 (its endpoint refuses it, and `get!` fails the page).
## Leaving it with changes not saved asks first (`Router.use_before_leave!`).
meta = { title: "A task" }

view! = |{ params, .. }| <Editor detail={Endpoint.get!(Api.get_tasks_id({ id: params.id }))} />

## The form, filled in with the task as it is (`LiveForm.filled!`), checked as it is typed with the
## same `TaskForm.editing` the endpoint reads it with; after a refusal, what was typed and the
## endpoint's issues show instead. While what is typed isn't the task as it is, and isn't on its
## way to be saved (whose answer sends you back to the list), leaving asks first: a link, Back or
## Cancel is stopped (`use_before_leave!`) and the question shows, whose "Leave without saving"
## goes after all (`retry!`); a reload, or another site, the browser asks about, in its own words.
Editor := [].{
	view! : { detail : Tasks.Detail } => Html
	view! = |{ detail }| {
		{ task, list, people } = detail
		ticked = if (task.done) [("done", "on")] else []
		values = [("title", task.title), ("notes", task.notes), ("due", task.due), ("assignee", task.assignee)].concat(ticked)
		live = LiveForm.filled!(TaskForm.editing, Api.post_tasks_id({ id: task.id }), values)
		(leaving!, set_leaving!) = create_signal!(Err(Staying))
		unsaved! = || Editor.changed(live.fields!(), values) and !live.pending!()
		use_before_leave!(
			|leave|
				if unsaved!() {
					leave.prevent!()
					set_leaving!(Ok(leave))
				},
		)
		discard! = || {
			match leaving!() {
				Ok(leave) => {
					set_leaving!(Err(Staying))
					leave.retry!(Bool.True)
				}
				Err(_) => {}
			}
		}
		<article class="task">
			<Title>{task.title} · Tasks</Title>
			<p class="crumb"><a href={Paths.lists_id({ id: list.id })}>← {list.name}</a></p>
			<h1>Edit task</h1>
			<Show when!={leaving!()}>
				{|_leave!|
					<div class="leaving" role="alertdialog" aria-labelledby="leaving-says">
						<p id="leaving-says">This task has changes that aren't saved.</p>
						<button type="button" class="stay" on:click={|| set_leaving!(Err(Staying))}>Keep editing</button>
						<button type="button" class="discard" on:click={discard!}>Leave without saving</button>
					</div>}
			</Show>
			<Show when!={live.sent!() and !live.all_issues!().is_empty()}>
				<p class="problem" role="alert">That didn't save: fix what's marked below, then save again.</p>
			</Show>
			<form class="edit" method="post" action={live.url()} novalidate>
				<TextField live={live} name="title" label="Title" autocomplete="off" />
				<Field live={live} name="notes" label="Notes">
					<textarea
						id="field-notes"
						name="notes"
						rows="5"
						maxlength="2000"
						aria-invalid={if (live.invalid!("notes")) "true" else "false"}
						aria-describedby="field-notes-issues"
						on:input.value={|typed| live.input!("notes", typed)}
						on:blur={|| live.leave!("notes")}
					>{live.value!("notes")}</textarea>
				</Field>
				<div class="pair">
					<TextField live={live} name="due" label="Due" />
					<Field live={live} name="assignee" label="For">
						<select
							id="field-assignee"
							name="assignee"
							aria-invalid={if (live.invalid!("assignee")) "true" else "false"}
							aria-describedby="field-assignee-issues"
							on:change.value={|picked| live.input!("assignee", picked)}
						>
							<option value="">Nobody yet</option>
							{...people.map(|person| <option value={person.id} selected?={live.value!("assignee") == person.id}>{person.name}</option>)}
						</select>
					</Field>
				</div>
				<CheckboxField live={live} name="done" label="Done" />
				<div class="actions">
					<button type="submit" class="save" disabled?={live.pending!()}>{if (live.pending!()) "Saving…" else "Save"}</button>
					<a href={Paths.lists_id({ id: list.id })}>Cancel</a>
				</div>
			</form>
			<form class="delete" method="post" action={Endpoint.url_of(Api.post_api_tasks_delete({}))}>
				<input type="hidden" name="id" value={task.id} />
				<button type="submit">Delete this task</button>
			</form>
		</article>
	}

	## Whether what is typed isn't what the form started with, field by field (in any order).
	changed : List({ name : Str, value : Str }), List((Str, Str)) -> Bool
	changed = |typed, values| typed.len() != values.len() or !values.all(|(name, value)| typed.any(|field| field.name == name and field.value == value))
}

## A field with a control of its own (`children`, whose `id` is `field-<name>`): its label, the
## control, and its issues under it, in a line kept for them, so one that shows moves nothing below.
Field := [].{
	view! : { live : LiveForm, name : Str, label : Str, children : List(Html) } => Html
	view! = |{ live, name, label, children }|
		<div class="field" class:invalid={live.invalid!(name)}>
			<label for={LiveForm.field_id(name)}>{label}</label>
			{...children}
			<ul id={"field-${name}-issues"} class="issues" aria-live="polite">
				<For each!={live.issues!(name)} keyed={|issue| issue.message}>
					{|issue!, _| <li>{issue!().message}</li>}
				</For>
			</ul>
		</div>
}

<style>
	.task {
		display: grid;
		gap: 1rem;
		max-width: 40rem;
	}

	.crumb {
		margin: 0;
	}

	.crumb a,
	.actions a {
		color: var(--accent-strong);
		font-weight: 600;
		text-decoration: none;
	}

	.edit {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.9rem;
		background: var(--surface);
	}

	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.field {
		display: grid;
		gap: 0.25rem;
	}

	label {
		font-weight: 600;
	}

	textarea,
	select {
		font: inherit;
		padding: 0.4rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.5rem;
	}

	textarea {
		resize: vertical;
	}

	.invalid textarea,
	.invalid select {
		border-color: var(--overdue);
	}

	.issues {
		min-height: 1lh;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--overdue);
	}

	.leaving {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.75rem;
		background: var(--surface);
	}

	.leaving p {
		flex: 1 1 100%;
		margin: 0;
		font-weight: 600;
	}

	.leaving button {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.6rem;
		background: transparent;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.leaving .discard {
		color: var(--overdue);
	}

	.problem {
		margin: 0;
		padding: 0.6rem 0.9rem;
		border-radius: 0.6rem;
		background: var(--overdue-soft);
		color: var(--overdue);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.save {
		padding: 0.55rem 1.3rem;
		border: 0;
		border-radius: 0.6rem;
		background: var(--accent);
		color: var(--on-accent);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.save:hover {
		background: var(--accent-strong);
	}

	.delete button {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.6rem;
		background: transparent;
		color: var(--overdue);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.delete button:hover {
		border-color: var(--overdue);
		background: var(--overdue-soft);
	}

	@media (max-width: 34rem) {
		.pair {
			grid-template-columns: 1fr;
		}
	}
</style>
