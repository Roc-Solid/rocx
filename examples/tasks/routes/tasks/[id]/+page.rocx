import pf.Html
import pf.Endpoint
import pf.Show
import pf.For
import pf.Title
import pf.HttpStatusCode
import forms.LiveForm
import forms.TextField
import forms.CheckboxField
import ../../../Tasks
import ../../../TaskForm
import ../../../Generated/Api
import ../../../Generated/Paths

## A task's page: everything about it in one form (title, notes, due day, who has it, done), and a
## button that deletes it. Both are plain forms. Saving posts to this page's own URL
## (`POST /tasks/:id`), whose endpoint reads the form with `TaskForm.editing` (packages/forms) and
## sends you back to the list, or refuses it (422) with each field's issues, which show here under
## their fields, with what was typed: without JavaScript the browser posts and comes back (a 303,
## and a flash); with it, the runtime sends the form with fetch and the page stays.
meta = { title: "A task" }

view! = |{ params, .. }|
	match Endpoint.read!(Api.get_tasks_id({ id: params.id })) {
		Ok(detail) => <Editor detail={detail} />
		Err(_) =>
			<section class="missing">
				<HttpStatusCode code={404} />
				<Title>No such task · Acme Tasks</Title>
				<h1>There's no such task</h1>
				<p>It may have been deleted. <a href={Paths.root}>See all the lists</a></p>
			</section>
	}

## The form, filled in with the task as it is (`LiveForm.filled!`), checked as it is typed with the
## same `TaskForm.editing` the endpoint reads it with; after a refusal, what was typed and the
## endpoint's issues show instead.
Editor := [].{
	view! : { detail : Tasks.Detail } => Html
	view! = |{ detail }| {
		{ task, list, people } = detail
		ticked = if (task.done) [("done", "on")] else []
		live = LiveForm.filled!(
			TaskForm.editing,
			Api.post_tasks_id({ id: task.id }),
			[("title", task.title), ("notes", task.notes), ("due", task.due), ("assignee", task.assignee)].concat(ticked),
		)
		<article class="task">
			<Title>{task.title} · Acme Tasks</Title>
			<p class="crumb"><a href={Paths.lists_id({ id: list.id })}>← {list.name}</a></p>
			<h1>Edit task</h1>
			<Show when!={live.sent!() and !live.all_issues!().is_empty()}>
				<p class="problem" role="alert">That didn't save: fix what's marked below, then save again.</p>
			</Show>
			<form class="edit" method="post" action={live.url()} novalidate>
				<TextField live={live} name="title" label="Title" autocomplete="off" />
				<Field live={live} name="notes" label="Notes">
					<textarea
						id="field-notes"
						name="notes"
						rows="5"
						maxlength="2000"
						aria-invalid={if (live.invalid!("notes")) "true" else "false"}
						aria-describedby="field-notes-issues"
						on:input.value={|typed| live.input!("notes", typed)}
						on:blur={|| live.leave!("notes")}
					>{live.value!("notes")}</textarea>
				</Field>
				<div class="pair">
					<TextField live={live} name="due" label="Due" />
					<Field live={live} name="assignee" label="For">
						<select
							id="field-assignee"
							name="assignee"
							aria-invalid={if (live.invalid!("assignee")) "true" else "false"}
							aria-describedby="field-assignee-issues"
							on:change.value={|picked| live.input!("assignee", picked)}
						>
							<option value="">Nobody yet</option>
							{...people.map(|person| <option value={person.id} selected?={live.value!("assignee") == person.id}>{person.name}</option>)}
						</select>
					</Field>
				</div>
				<CheckboxField live={live} name="done" label="Done" />
				<div class="actions">
					<button type="submit" class="save" disabled?={live.pending!()}>{if (live.pending!()) "Saving…" else "Save"}</button>
					<a href={Paths.lists_id({ id: list.id })}>Cancel</a>
				</div>
			</form>
			<form class="delete" method="post" action={Endpoint.url_of(Api.post_api_tasks_delete({}))}>
				<input type="hidden" name="id" value={task.id} />
				<button type="submit">Delete this task</button>
			</form>
		</article>
	}
}

## A field with a control of its own (`children`, whose `id` is `field-<name>`): its label, the
## control, and its issues under it, in a line kept for them, so one that shows moves nothing below.
Field := [].{
	view! : { live : LiveForm, name : Str, label : Str, children : List(Html) } => Html
	view! = |{ live, name, label, children }|
		<div class="field" class:invalid={live.invalid!(name)}>
			<label for={LiveForm.field_id(name)}>{label}</label>
			{...children}
			<ul id={"field-${name}-issues"} class="issues" aria-live="polite">
				<For each!={live.issues!(name)} keyed={|issue| issue.message}>
					{|issue!, _| <li>{issue!().message}</li>}
				</For>
			</ul>
		</div>
}

<style>
	.task {
		display: grid;
		gap: 1rem;
		max-width: 40rem;
	}

	.crumb {
		margin: 0;
	}

	.crumb a,
	.missing a,
	.actions a {
		color: var(--accent-strong);
		font-weight: 600;
		text-decoration: none;
	}

	.edit {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.9rem;
		background: var(--surface);
	}

	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.field {
		display: grid;
		gap: 0.25rem;
	}

	label {
		font-weight: 600;
	}

	textarea,
	select {
		font: inherit;
		padding: 0.4rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.5rem;
	}

	textarea {
		resize: vertical;
	}

	.invalid textarea,
	.invalid select {
		border-color: var(--overdue);
	}

	.issues {
		min-height: 1lh;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--overdue);
	}

	.problem {
		margin: 0;
		padding: 0.6rem 0.9rem;
		border-radius: 0.6rem;
		background: var(--overdue-soft);
		color: var(--overdue);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.save {
		padding: 0.55rem 1.3rem;
		border: 0;
		border-radius: 0.6rem;
		background: var(--accent);
		color: var(--on-accent);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.save:hover {
		background: var(--accent-strong);
	}

	.delete button {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.6rem;
		background: transparent;
		color: var(--overdue);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.delete button:hover {
		border-color: var(--overdue);
		background: var(--overdue-soft);
	}

	@media (max-width: 34rem) {
		.pair {
			grid-template-columns: 1fr;
		}
	}
</style>
