import pf.Html
import pf.Transition
import pf.Solid exposing [create_memo!, create_signal!, set_timeout!]
import ../Game
import ../Score

## The leaderboard after a question: first in the order the room stood in before it, and then,
## once everyone has had a look, each row glides to its new place (`transition:move`) as the points
## it earned land. One who climbs into the top `limit` comes in, one who falls out goes. The
## player's own row (`me`) stands out; one who dropped is dimmed.
Board := [].{

	## A player, with their score before the question and the points it earned them.
	Row : { id : Str, name : Str, score : U64, gained : U64, here : Bool }

	view! : { rows : List(Board.Row), limit : U64, me : Str } => Html
	view! = |{ rows, limit, me }| {
		(landed!, set_landed!) = create_signal!(Bool.False)
		_land = set_timeout!(Board.pause, || set_landed!(Bool.True))
		placed! = create_memo!(|| Board.placed(rows, landed!()).take_first(limit))
		<ol class="board" aria-label="Leaderboard">
			{...placed!().map(|row|
				<li
					key={"board-${row.id}"}
					class:me={row.id == me}
					class:gone={!row.here}
					transition:move={Transition.glide.ms(700).easing("cubic-bezier(0.3, 1.25, 0.5, 1)")}
					transition={Transition.fly({ x: 0, y: 16 })}
				>
					<span class="place">{Score.ordinal(row.place)}</span>
					<span class="name">{row.name}{if (row.here) "" else " (dropped)"}</span>
					<span class="gained" class:none={row.gained == 0}>{if (row.gained == 0) "+0" else "+${row.gained.to_str()}"}</span>
					<span class="score">{row.shown.to_str()}</span>
				</li>
			)}
		</ol>
	}

	## How long the board stands as it was before it moves, in milliseconds.
	pause : U64
	pause = 900

	## The rows in their places: before the points `landed`, by the scores before; after, by the
	## new ones, which they show.
	placed : List(Board.Row), Bool -> List({ id : Str, name : Str, place : U64, shown : U64, gained : U64, here : Bool })
	placed = |given, landed| {
		shown = |row| if (landed) row.score else row.score - U64.min(row.gained, row.score)
		ranked = Score.ranked(given.map(|row| { id: row.id, name: row.name, score: shown(row) }))
		ranked.map(
			|each| {
				row = given.find_first(|other| other.id == each.id) ?? { id: each.id, name: each.name, score: 0, gained: 0, here: Bool.False }
				{ id: each.id, name: each.name, place: each.place, shown: each.score, gained: row.gained, here: row.here }
			},
		)
	}

	## A revealed question's rows: each player's score (after it) and what it earned them.
	rows : Game.View, Game.Revealing -> List(Board.Row)
	rows = |view, revealing|
		view.players.map(
			|player| {
				gained = (revealing.gains.find_first(|gain| gain.id == player.id) ?? { id: player.id, choice: 0, gained: 0 }).gained
				{ id: player.id, name: player.name, score: player.score, gained, here: player.here }
			},
		)

	<style>
		.board {
			display: grid;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		li {
			display: grid;
			grid-template-columns: 3.2em 1fr auto 4.5em;
			align-items: center;
			gap: 0.75rem;
			padding: 0.55em 0.9em;
			border: var(--outline);
			border-radius: var(--radius-sm);
			background: var(--card);
			box-shadow: var(--lift-low);
		}

		li.me {
			background: #fff3c4;
		}

		li.gone {
			opacity: 0.55;
		}

		.place {
			font-weight: 800;
			color: var(--ink-soft);
		}

		.name {
			overflow: hidden;
			font-weight: 700;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.gained {
			padding: 0.05em 0.55em;
			border-radius: var(--pill);
			background: var(--good-soft);
			color: var(--good);
			font-weight: 800;
			font-size: 0.85em;
		}

		.gained.none {
			background: var(--paper-deep);
			color: var(--ink-faint);
		}

		.score {
			text-align: right;
			font-weight: 800;
			font-variant-numeric: tabular-nums;
		}
	</style>

	<story name="After a question">
		<Board rows={[{ id: "p1", name: "Ada", score: 900, gained: 0, here: Bool.True }, { id: "p2", name: "Bo", score: 1700, gained: 950, here: Bool.True }, { id: "p3", name: "Cy", score: 1200, gained: 600, here: Bool.False }]} limit={5} me="p2" />
	</story>
}

expect
	Board.placed([{ id: "p1", name: "Ada", score: 900, gained: 0, here: Bool.True }, { id: "p2", name: "Bo", score: 1700, gained: 950, here: Bool.True }], Bool.False).map(|row| (row.id, row.place, row.shown))
		== [("p1", 1, 900), ("p2", 2, 750)]

expect
	Board.placed([{ id: "p1", name: "Ada", score: 900, gained: 0, here: Bool.True }, { id: "p2", name: "Bo", score: 1700, gained: 950, here: Bool.True }], Bool.True).map(|row| (row.id, row.place, row.shown))
		== [("p2", 1, 1700), ("p1", 2, 900)]
