import pf.Html

## What a path nothing answers shows (404), and what a page that failed shows (500).
meta = { title: "Not here · Acme Notes" }

view! = |{ status, problem }|
	<main id="main" class="error">
		<p class="code">{status.to_str()}</p>
		<h1>{if (status == 404) "There's no page here" else "Something went wrong"}</h1>
		<p>{if (status == 404) "The note may have been deleted, or the address is wrong." else problem}</p>
		<p><a class="button" href="/">Back to your notes</a></p>
	</main>

<style>
	.error {
		max-width: 32rem;
		margin: 5rem auto;
		padding: 0 1.25rem;
		text-align: center;
	}

	.code {
		margin: 0;
		color: var(--ink-faint);
		font: 700 3rem/1 var(--mono);
	}

	h1 {
		margin: 0.5rem 0 1rem;
	}
</style>
