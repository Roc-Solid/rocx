import pf.Html
import markdown.Markdown

## A note's Markdown, as it reads (packages/markdown's `<Markdown>`): a note's page, and the editor's
## preview. Raw HTML in a note is shown as text, and a link that could run script points nowhere
## (the package's rules); links to other sites open in a new tab.
Prose := [].{

	view : { source : Str } -> Html
	view = |{ source }|
		<div class="prose">
			{=Markdown.view({ source: source, link: Prose.link })}
		</div>

	## A link: one to another site opens in a new tab, and tells it nothing of where it came from.
	link : Markdown.Link -> Html
	link = |found|
		if found.url.starts_with("https://") or found.url.starts_with("http://") {
			<a href={found.url} target="_blank" rel="noopener noreferrer">{...found.children}</a>
		} else {
			Markdown.link(found)
		}

	<story name="Kinds of Markdown">
		<Prose source="## Launch week\n\nThe **pad** is booked; tell [the crew](https://example.com).\n\n- [x] Fuel ordered\n- [ ] Weather check\n\n> Measure twice.\n\n```\nT-minus 10\n```" />
	</story>

	<style>
		.prose {
			font-family: var(--serif);
			font-size: 1.08rem;
			line-height: 1.65;
			overflow-wrap: anywhere;
		}

		.prose :global {
			h1,
			h2,
			h3,
			h4 {
				margin: 1.6em 0 0.5em;
				font-family: var(--sans);
				line-height: 1.25;
			}

			h1 {
				font-size: 1.45rem;
			}

			h2 {
				font-size: 1.25rem;
			}

			h3,
			h4 {
				font-size: 1.05rem;
			}

			p,
			ul,
			ol,
			blockquote,
			pre,
			table {
				margin: 0 0 1em;
			}

			ul,
			ol {
				padding-left: 1.4em;
			}

			li + li {
				margin-top: 0.2em;
			}

			li:has(> input[type="checkbox"]) {
				list-style: none;
				margin-left: -1.3em;
			}

			input[type="checkbox"] {
				margin: 0 0.45em 0 0;
				accent-color: var(--accent);
			}

			blockquote {
				padding: 0.1em 1em;
				border-left: 3px solid var(--mark);
				color: var(--ink-soft);
			}

			code {
				padding: 0.1em 0.3em;
				border-radius: 5px;
				background: var(--sunk);
				font-family: var(--mono);
				font-size: 0.86em;
			}

			pre {
				padding: 0.9em 1em;
				overflow-x: auto;
				border-radius: 10px;
				background: var(--sunk);
				line-height: 1.45;
			}

			pre code {
				padding: 0;
				background: none;
			}

			table {
				border-collapse: collapse;
				font-family: var(--sans);
				font-size: 0.92rem;
			}

			th,
			td {
				padding: 0.35em 0.7em;
				border: 1px solid var(--line);
				text-align: left;
			}

			hr {
				border: 0;
				border-top: 1px solid var(--line);
				margin: 2em 0;
			}

			img {
				max-width: 100%;
			}

			:first-child {
				margin-top: 0;
			}
		}
	</style>
}
