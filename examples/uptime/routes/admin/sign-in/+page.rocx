import pf.Html
import pf.Endpoint
import pf.Server
import pf.Title
import pf.Router exposing [use_submission!]
import pf.Router
import ../../../Words
import ../../../Generated/Api

## The admin's sign-in: the password the server was started with (`ADMIN_PASSWORD`). The admin's
## pages send a browser here, with where it was going (`?next=/admin/jobs`), and it goes on there.
## A refusal is the submission's error, with the runtime or without it (a flash).
meta = { title: "Sign in · Status" }

view! = |_| {
	next = Words.query_value(Router.location!({}).query, "next")
	sign_in = Api.post_admin_sign_in({})
	submission = use_submission!(sign_in)
	<section class="sign-in">
		<Title>Sign in · Status</Title>
		<h1>Sign in to the admin</h1>
		<form method="post" action={Endpoint.url_of(sign_in)}>
			<label for="password">Admin password</label>
			<input id="password" name="password" type="password" required autocomplete="current-password" />
			<input type="hidden" name="next" value={if (next.is_empty()) "/admin" else next} />
			<button disabled?={submission.pending!()}>{if (submission.pending!()) "Signing in…" else "Sign in"}</button>
			{match submission.error!() { Ok(problem) => <p class="problem" role="alert">{Server.explain(problem)}</p>, Err(_) => <></> }}
		</form>
	</section>
}

<style>
	.sign-in {
		display: grid;
		gap: var(--space-4);
		max-width: 24rem;
		padding: var(--space-6) 0;
	}

	form {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-5);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	label {
		font-weight: 600;
	}

	input {
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-small);
		background: var(--surface);
	}

	button {
		margin-top: var(--space-2);
		padding: 0.6rem 1.1rem;
		border: 0;
		border-radius: var(--radius-small);
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 650;
		cursor: pointer;
	}

	.problem {
		color: var(--major);
	}
</style>
