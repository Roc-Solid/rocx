import pf.Html
import ../Generated/Styles

## The document around every page: the brand and the way to the admin, the page, and a footer that
## says the times are UTC and where the JSON is. Everything but the page is the server's alone
## (`<NoHydration>`): it never changes in the browser.
view! = |{ children, .. }|
	<>
		<!doctype html>
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<title>Status</title>
				<meta name="description" content="Whether Acme's services are up, how they have been, and what we are doing when they aren't." />
				<meta name="color-scheme" content="light dark" />
				<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
				<link rel="stylesheet" href="/uptime.css" />
				<NoHydration>
					{Styles.style}
				</NoHydration>
			</head>
			<body>
				<NoHydration>
					<a class="skip" href="#content">Skip to the status</a>
					<header class="top">
						<a class="brand" href="/">
							<svg viewBox="0 0 32 32" aria-hidden="true" width="28" height="28">
								<rect width="32" height="32" rx="8" fill="currentColor" />
								<path d="M5 17h5l3-7 5 13 3-6h6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span><strong>Status</strong></span>
						</a>
						<nav aria-label="Main">
							<a href="/#subscribe">Subscribe</a>
							<a href="/admin">Admin</a>
						</nav>
					</header>
				</NoHydration>
				<main id="content" tabindex="-1">{...children}</main>
				<NoHydration>
					<footer class="bottom">
						<p>Times are in UTC. Each page is JSON too: <code>curl -H 'accept: application/json' …/</code></p>
						<p>This status page is an example app of <a href="https://roc-solid.github.io/">Roc Solid</a>.</p>
					</footer>
				</NoHydration>
			</body>
		</html>
	</>

<style>
	.skip {
		position: absolute;
		left: var(--space-4);
		top: -4rem;
		padding: var(--space-2) var(--space-4);
		background: var(--accent);
		color: var(--accent-ink);
		border-radius: var(--radius-small);
		z-index: 2;
	}

	.skip:focus {
		top: var(--space-3);
	}

	.top,
	main,
	.bottom {
		width: 100%;
		max-width: var(--width);
		margin: 0 auto;
		padding: 0 var(--space-5);
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--accent);
		text-decoration: none;
		font-size: 1.15rem;
	}

	.brand span {
		color: var(--ink);
	}

	nav {
		display: flex;
		gap: var(--space-4);
		font-size: var(--text-small);
	}

	nav a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	main {
		flex: 1;
		outline: none;
		padding-bottom: var(--space-7);
	}

	.bottom {
		display: grid;
		gap: var(--space-1);
		padding-top: var(--space-5);
		padding-bottom: var(--space-6);
		border-top: 1px solid var(--line);
		font-size: var(--text-small);
		color: var(--ink-faint);
	}
</style>
