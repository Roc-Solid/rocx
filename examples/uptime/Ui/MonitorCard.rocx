import pf.Html
import charts.Sparkline
import ../Generated/Paths
import ../Report
import ../Words
import StatePill
import UptimeStrip

## A monitor on the status page: its name (a link to its page), its state, its uptime over 24 hours,
## 7 and 90 days, its last latency with the day's trend (`<Sparkline>`, which glides to new values),
## and its 90 days. It takes the monitor as an accessor, so a new reading patches the numbers in
## place; the pill and the strip are pure components drawn anew in their holes.
MonitorCard := [].{
	view : { monitor! : () => Report.Monitor } -> Html
	view = |{ monitor! }|
		<li class="monitor">
			<div class="head">
				<h3><a href={Paths.monitors_id({ id: monitor!().id.to_str() })}>{monitor!().name}</a></h3>
				{=<StatePill state={monitor!().state} label={monitor!().label} />}
			</div>
			<dl class="numbers">
				<div>
					<dt>24 hours</dt>
					<dd>{monitor!().uptime_24h}</dd>
				</div>
				<div>
					<dt>7 days</dt>
					<dd>{monitor!().uptime_7d}</dd>
				</div>
				<div>
					<dt>90 days</dt>
					<dd>{monitor!().uptime_90d}</dd>
				</div>
				<div class="trend">
					<dt>Response time</dt>
					<dd>
						<span class="latency">{Words.latency(monitor!().latency_ms)}</span>
						<Sparkline data!={monitor!().trend.map(|ms| ms.to_dec())} label!={"${monitor!().name}'s response time over the last 24 hours"} />
					</dd>
				</div>
			</dl>
			{=<UptimeStrip days={monitor!().days} />}
		</li>

	<style>
		.monitor {
			display: grid;
			gap: var(--space-4);
			padding: var(--space-5);
			background: var(--surface);
			border: 1px solid var(--line);
			border-radius: var(--radius);
			box-shadow: var(--shadow);
		}

		.head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			flex-wrap: wrap;
		}

		h3 {
			font-size: 1.05rem;
		}

		h3 a {
			color: inherit;
			text-decoration: none;
		}

		h3 a:hover {
			text-decoration: underline;
		}

		.numbers {
			display: grid;
			grid-template-columns: repeat(3, minmax(4.5rem, auto)) 1fr;
			gap: var(--space-3) var(--space-5);
			margin: 0;
		}

		dt {
			font-size: var(--text-tiny);
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--ink-faint);
		}

		dd {
			margin: 0;
			font-size: var(--text-big);
			font-weight: 650;
			font-variant-numeric: tabular-nums;
		}

		.trend dd {
			display: flex;
			align-items: center;
			gap: var(--space-3);
		}

		.latency {
			white-space: nowrap;
			font-size: 1rem;
			color: var(--ink-soft);
		}

		.trend dd > :global(*:last-child) {
			flex: 1;
			max-width: 14rem;
			height: 2rem;
		}

		@media (max-width: 40rem) {
			.numbers {
				grid-template-columns: repeat(3, 1fr);
			}

			.trend {
				grid-column: 1 / -1;
			}
		}
	</style>
}
