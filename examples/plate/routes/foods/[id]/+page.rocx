import pf.Html
import pf.Solid exposing [create_memo!, untrack!]
import pf.Router
import pf.Server
import pf.Title
import pf.HttpStatusCode
import forms.LiveForm
import forms.TextField
import ../../../Plate
import ../../../PlateForm
import ../../../Query
import ../../../Links
import ../../../Generated/Api
import ../../../Generated/Paths
import ../../../components/Facts
import ../../../components/HitRow

## A food: how much of it to log, to which meal on which day, what that amount has as it is typed,
## its nutrition facts, and where its data came from. The form starts at the day and meal the
## address says (`?day=…&meal=…`, from the add page), and at the food's first portion, or 100 g.
meta = { title: "A food" }

view! = |{ params, .. }| {
	read = Api.get_api_foods_id({ id: params.id })
	pick! : () => Try(Plate.Pick, Server.Problem)
	pick! = create_memo!(|| read.send!({}))
	<>{match pick!() {
		Ok(found) => <FoodPage id={params.id} pick!={found} />
		Err(_) => <NoFood />
	}}</>
}

## The food, once it has been read.
FoodPage := [].{
	view! : { id : Str, pick! : () => Plate.Pick } => Html
	view! = |{ id, pick! }| {
		location = Router.location!({})
		food! = || pick!().food
		asked_day = Query.value(location.query, "day")
		asked_meal = Query.value(location.query, "meal")
		# Where the form starts: the food as it was first read (one read, meant), not as it is read again.
		start = untrack!(|| pick!())
		day = if (asked_day.is_empty()) start.today else asked_day
		meal = if (asked_meal.is_empty()) start.meal else asked_meal
		first = if (start.food.portions.is_empty()) ("100", "g") else ("1", "0")
		live = LiveForm.filled!(PlateForm.amount, Api.post_api_foods_id({ id: id }), [("amount", first.0), ("unit", first.1), ("meal", meal), ("day", day)])
		grams! = || Plate.grams_of(Dec.from_str(live.value!("amount").trim()) ?? 0.0, live.value!("unit"), food!().portions)
		eaten! = || Plate.scaled(food!().per100, grams!())
		<article class="food">
			<Title>{food!().name} · Plate</Title>
			<header>
				<a class="back" href={Links.add({ day, meal, query: "" })} aria-label="Back to the search">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
				</a>
				<div>
					<h1>{food!().name}</h1>
					<p class="quiet">
						{HitRow.tag(food!().source)}
						{" ${Str.join_with([food!().brand, food!().group].keep_if(|word| !word.is_empty()), " · ")}"}
					</p>
				</div>
			</header>
			<form class="log card" method="post" action={live.url()} novalidate>
				<div class="how-much">
					<TextField live={live} name="amount" label="Amount" />
					<div class="field">
						<label for="field-unit">Of</label>
						<select id="field-unit" name="unit" on:change.value={|picked| live.input!("unit", picked)}>
							{...food!().portions.map_with_index(|portion, index| <option key={index} value={index.to_str()} selected?={live.value!("unit") == index.to_str()}>{"${portion.label} (${Plate.grams_label(portion.grams)})"}</option>)}
							<option value="g" selected?={live.value!("unit") == "g"}>grams</option>
						</select>
					</div>
				</div>
				<div class="when">
					<div class="field">
						<label for="field-meal">Meal</label>
						<select id="field-meal" name="meal" on:change.value={|picked| live.input!("meal", picked)}>
							{...Plate.meals.map(|each| <option value={Plate.meal_id(each)} selected?={live.value!("meal") == Plate.meal_id(each)}>{Plate.meal_name(each)}</option>)}
						</select>
					</div>
					<TextField live={live} name="day" label="Day" type="date" />
				</div>
				<p class="preview" aria-live="polite">
					<strong>{"${Plate.whole(eaten!().kcal)} kcal"}</strong>
					<span>{"in ${Plate.grams_label(grams!())} · protein ${Plate.grams_label(eaten!().protein)} · carbs ${Plate.grams_label(eaten!().carbs)} · fat ${Plate.grams_label(eaten!().fat)}"}</span>
				</p>
				<button class="button" type="submit" disabled?={live.pending!()}>
					{if (live.pending!()) "Adding…" else "Add to ${Plate.meal_name(Plate.meal_of(live.value!("meal")))}"}
				</button>
			</form>
			<section class="card">
				{Facts.view({ food: food!(), grams: grams!() })}
			</section>
			<p class="source quiet">
				{if food!().source == "recipe" {
					<a href={Paths.recipes_id({ id: food!().recipe })}>Your recipe: see what goes into it</a>
				} else {
					<Credit food!={food!()} />
				}}
			</p>
		</article>
	}
}

## Where a food's data came from, with a link to it there.
Credit := [].{
	view! : { food! : () => Plate.Food } => Html
	view! = |{ food! }|
		match Plate.source_url(food!()) {
			Ok(url) => <span>Data from <a href={url} rel="external noopener">{Plate.source_name(food!().source)}</a>{if (food!().source == "off") ", under the Open Database License." else " (public domain)."}</span>
			Err(None) => <span>A food you made.</span>
		}
}

## A food that isn't there: a 404.
NoFood := [].{
	view! : {} => Html
	view! = |{}|
		<section>
			<HttpStatusCode code={404} />
			<Title>No such food · Plate</Title>
			<h1>There's no such food</h1>
			<p><a href={Paths.add}>Search for another</a></p>
		</section>
}

<style>
	.food {
		display: grid;
		gap: 1rem;
		max-width: 40rem;
	}

	header {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	header p {
		margin: 0.2rem 0 0;
		font-size: 0.9rem;
	}

	.back {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: var(--ink-soft);
	}

	.back svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.log {
		display: grid;
		gap: 0.25rem;
	}

	.how-much,
	.when {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 0.75rem;
	}

	/* A field fits its column, however narrow the phone. */
	.how-much :global(input),
	.when :global(input) {
		width: 100%;
		min-width: 0;
	}

	.field {
		display: grid;
		align-content: start;
		gap: 0.25rem;
	}

	label {
		font-weight: 600;
	}

	select {
		width: 100%;
		min-width: 0;
		min-height: 2.6rem;
		padding: 0.4rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.55rem;
	}

	.preview {
		display: grid;
		margin: 0.25rem 0 0.75rem;
		padding: 0.6rem 0.8rem;
		border-radius: 0.7rem;
		background: var(--accent-soft);
	}

	.preview strong {
		font-size: 1.3rem;
	}

	.preview span {
		color: var(--ink-soft);
		font-size: 0.85rem;
	}

	.source a {
		color: var(--accent-strong);
	}
</style>
