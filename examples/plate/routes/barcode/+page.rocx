import pf.Html
import pf.Router
import forms.LiveForm
import forms.TextField
import ../../PlateForm
import ../../Query
import ../../Links
import ../../Generated/Api
import ../../Generated/Paths

## A packet's barcode, typed: the food is found in the diary, or asked of Open Food Facts and kept.
## When it isn't known there, the way to make the food yourself, with the barcode filled in.
meta = { title: "Barcode" }

view! = |_| {
	location = Router.location!({})
	day = Query.value(location.query, "day")
	meal = Query.value(location.query, "meal")
	live = LiveForm.of!(PlateForm.barcode, Api.post_barcode({}))
	<section class="barcode">
		<header>
			<a class="back" href={Links.add({ day, meal, query: "" })} aria-label="Back to the search">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
			</a>
			<div>
				<h1>A packet's barcode</h1>
				<p class="quiet">The digits under its lines. Packets come from <a href="https://world.openfoodfacts.org" rel="external noopener">Open Food Facts</a>, the open database anyone can add to.</p>
			</div>
		</header>
		<form class="card" method="post" action={live.url()} novalidate>
			<input type="hidden" name="then_day" value={day} />
			<input type="hidden" name="then_meal" value={meal} />
			<TextField live={live} name="barcode" label="Barcode" hint="8 to 14 digits, as EAN-13: 5000159484695." autocomplete="off" />
			<button class="button" type="submit" disabled?={live.pending!()}>{if (live.pending!()) "Looking it up…" else "Look it up"}</button>
		</form>
		{if !live.issues!("barcode").is_empty() {
			<p>
				<a class="button quiet" href={Query.link(Paths.foods_new, Query.of([("barcode", live.value!("barcode").trim()), ("day", day), ("meal", meal)]))}>Make the food yourself</a>
			</p>
		} else {
			<></>
		}}
	</section>
}

<style>
	.barcode {
		display: grid;
		gap: 1rem;
		max-width: 36rem;
	}

	header {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	header p {
		margin: 0.2rem 0 0;
	}

	header a {
		color: var(--accent-strong);
	}

	.back {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: var(--ink-soft);
	}

	.back svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	form {
		display: grid;
		gap: 0.5rem;
	}

	button {
		justify-self: start;
	}
</style>
