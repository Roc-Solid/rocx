import pf.Html
import pf.Solid exposing [create_memo!, is_pending!]
import pf.Endpoint
import pf.Router
import charts.BarChart
import charts.LineChart
import charts.Format
import forms.LiveForm
import forms.TextField
import ../../../Plate
import ../../../Query
import ../../../PlateForm
import ../../../Generated/Api
import ../../../Generated/Paths

## How the days have gone: energy eaten each day of the last week, month or three months
## (`?days=7`, `30`, `90`) against the target, the average day's energy and macronutrients, and
## weight over the same time (each on its day, to scale), with a form that logs today's. The range is an address, a link
## each, so it can be shared and works without JavaScript.
meta = { title: "Trends" }

view! = |_| {
	location = Router.location!({})
	read = Endpoint.with_query(Api.get_api_trends({}), location.query)
	trends! : () => Plate.Trends
	trends! = create_memo!(|| read.read!())
	average! = || Plate.average(trends!().totals)
	logged! = || Plate.logged(trends!().totals).len()
	weigh = LiveForm.filled!(PlateForm.weight, Api.post_api_weights({}), [("day", trends!().today), ("kg", trends!().weights.last().map_ok(|weight| Plate.number(weight.kg)) ?? "")])
	<section class="trends" class:stale={is_pending!(trends!)}>
		<h1>Trends</h1>
		<nav class="ranges" aria-label="How far back">
			{...Plate.ranges.map(|range| <a class="chip" href={Query.link(Paths.trends, Query.of([("days", range.to_str())]))} aria-current??={if (trends!().range == range) "page" else ""}>{Ranges.name(range)}</a>)}
		</nav>
		<section class="card" aria-labelledby="energy">
			<h2 id="energy">Energy each day</h2>
			<p class="quiet">{"Target ${Plate.whole(trends!().target.kcal)} kcal a day · ${Ranges.logged(logged!(), trends!().range)}"}</p>
			<div class="chart">
				<BarChart data!={Plate.bars(trends!().totals, trends!().range).map(|{ label, value }| { label, value })} label="Energy eaten each day, in kcal" format={|kcal| "${Plate.whole(kcal)} kcal"} />
			</div>
		</section>
		<section class="card" aria-labelledby="average">
			<h2 id="average">An average day</h2>
			{if logged!() > 0 {
				<dl class="average">
					<div>
						<dt>Energy</dt>
						<dd>{"${Plate.whole(average!().kcal)} kcal"}</dd>
						<dd class="of">{"of ${Plate.whole(trends!().target.kcal)}"}</dd>
					</div>
					<div class="protein">
						<dt>Protein</dt>
						<dd>{Plate.grams_label(average!().protein)}</dd>
						<dd class="of">{"of ${Plate.grams_label(trends!().target.protein)}"}</dd>
					</div>
					<div class="carbs">
						<dt>Carbs</dt>
						<dd>{Plate.grams_label(average!().carbs)}</dd>
						<dd class="of">{"of ${Plate.grams_label(trends!().target.carbs)}"}</dd>
					</div>
					<div class="fat">
						<dt>Fat</dt>
						<dd>{Plate.grams_label(average!().fat)}</dd>
						<dd class="of">{"of ${Plate.grams_label(trends!().target.fat)}"}</dd>
					</div>
				</dl>
			} else {
				<p class="quiet">Nothing logged in this time yet.</p>
			}}
		</section>
		<section class="card" aria-labelledby="weight">
			<h2 id="weight">Weight</h2>
			{if trends!().weights.len() >= 2 {
				<>
					<p class="quiet">{Ranges.change(trends!().weights)}</p>
					<div class="chart">
						<LineChart data!={Plate.weight_points(trends!().weights)} label="Weight on the days it was logged, in kg" format={|kg| "${Format.num(kg, 1)} kg"} format_x={Plate.day_at} smooth={Bool.True} />
					</div>
				</>
			} else {
				<p class="quiet">Log your weight a few days, and how it goes shows here.</p>
			}}
			<form class="weigh" method="post" action={weigh.url()} novalidate>
				<TextField live={weigh} name="kg" label="Weight (kg)" />
				<TextField live={weigh} name="day" label="Day" type="date" />
				<button class="button" type="submit" disabled?={weigh.pending!()}>Log it</button>
			</form>
		</section>
	</section>
}

## What the page says of its range.
Ranges := [].{

	## "Week", "Month", "3 months".
	name : U64 -> Str
	name = |range|
		match range {
			7 => "Week"
			30 => "Month"
			_ => "3 months"
		}

	## "5 of 7 days logged".
	logged : U64, U64 -> Str
	logged = |count, range| "${count.to_str()} of ${range.to_str()} days logged"

	## How the weight changed, first to last: "Down 1.2 kg since Nov 2", "Up 0.4 kg…", "No change…".
	change : List(Plate.Weight) -> Str
	change = |weights|
		match (weights.first(), weights.last()) {
			(Ok(first), Ok(last)) => {
				moved = last.kg - first.kg
				since = "since ${Plate.short_day(first.day)}"
				if moved < 0.0 {
					"Down ${Format.num(-moved, 1)} kg ${since}"
				} else if moved > 0.0 {
					"Up ${Format.num(moved, 1)} kg ${since}"
				} else {
					"No change ${since}"
				}
			}
			_ => ""
		}
}

<style>
	.trends {
		display: grid;
		gap: 1rem;
		transition: opacity 160ms;
	}

	.trends.stale {
		opacity: 0.75;
	}

	.ranges {
		display: flex;
		gap: 0.4rem;
	}

	.chip {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.chip[aria-current="page"] {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent-strong);
	}

	section > p {
		margin: 0.2rem 0 0.5rem;
	}

	.chart {
		--chart-color: var(--accent);
		--chart-active: var(--accent-strong);
		--chart-surface: var(--surface);
		color: var(--ink-soft);
	}

	.average {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
		gap: 0.75rem;
		margin: 0.5rem 0 0;
	}

	.average div {
		padding-left: 0.6rem;
		border-left: 3px solid var(--accent);
	}

	.average .protein {
		border-color: var(--protein);
	}

	.average .carbs {
		border-color: var(--carbs);
	}

	.average .fat {
		border-color: var(--fat);
	}

	dt {
		color: var(--ink-soft);
		font-size: 0.85rem;
		font-weight: 600;
	}

	dd {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
	}

	dd.of {
		color: var(--ink-faint);
		font-size: 0.8rem;
		font-weight: 400;
	}

	.weigh {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
		align-items: start;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.weigh :global(input) {
		width: 100%;
		min-width: 0;
	}

	.weigh button {
		margin-top: 1.75rem;
	}

	@media (max-width: 30rem) {
		.weigh {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.weigh button {
			grid-column: 1 / -1;
			margin-top: 0;
		}
	}
</style>
