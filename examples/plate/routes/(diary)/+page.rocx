import pf.Html
import pf.Solid exposing [create_memo!, is_pending!]
import ../../Plate
import ../../Generated/Api
import ../../components/Diary

## Today's page of the diary. Its data is its endpoint's, under `api/` at this page's path
## (`GET /api`, in `routes/api/+server.roc`): today, in the profile's time zone. Any other day is
## `/days/:day`, the same `Diary`.
meta = { title: "Today" }

view! = |_| {
	read = Api.get_api({})
	day! : () => Plate.Day
	day! = create_memo!(|| read.read!())
	<Diary day!={day!()} stale!={is_pending!(day!)} />
}
