import pf.Html
import pf.Solid exposing [create_memo!, create_signal!, is_pending!]
import pf.Router exposing [use_submissions!]
import pf.Endpoint
import pf.Server
import pf.For
import pf.Show
import pf.Title
import pf.HttpStatusCode
import pf.Transition
import forms.LiveForm
import forms.TextField
import ../../../Plate
import ../../../PlateForm
import ../../../Query
import ../../../Links
import ../../../Generated/Api
import ../../../Generated/Paths

## A recipe: what a serving has, its ingredients, a search that adds more, and its name, servings
## and notes. Its data is its own URL's (`GET /recipes/:id`), with the search's words (`?q=`): the
## search box is a form that asks this page again, so it works without JavaScript; with it, typing
## sets a signal that the memo reads, so the foods found follow the typing.
meta = { title: "A recipe" }

view! = |{ params, .. }| {
	location = Router.location!({})
	(query!, set_query!) = create_signal!(Query.value(location.query, "q"))
	kitchen! : () => Try(Plate.Kitchen, Server.Problem)
	kitchen! = create_memo!(|| Endpoint.read!(Endpoint.with_query(Api.get_recipes_id({ id: params.id }), Query.of([("q", query!())]))))
	search = { query!, set_query! }
	<Show when!={kitchen!()} fallback={<NoRecipe />}>
		{|found!| <Kitchen id={params.id} kitchen!={found!()} search={search} stale!={is_pending!(kitchen!)} />}
	</Show>
}

## The recipe, once it has been read.
Kitchen := [].{
	view! : { id : Str, kitchen! : () => Plate.Kitchen, search : { query! : () => Str, set_query! : Str => {} }, stale! : () => Bool } => Html
	view! = |{ id, kitchen!, search, stale! }| {
		{ query!, set_query! } = search
		recipe! = || kitchen!().recipe
		# Every form on this page posts to one of these endpoints; the runtime sends each with fetch
		# because the page reads its submissions, and reads the recipe again once it's in.
		_adds = use_submissions!(Api.post_recipes_id_ingredients({ id: id }))
		removes = use_submissions!(Api.post_api_ingredients_delete({}))
		ingredients! = create_memo!(
			|| {
				gone = removes.pending_inputs!().map(|sent| sent.id)
				recipe!().ingredients.drop_if(|each| gone.contains(each.id))
			},
		)
		whole! = || Plate.sum(ingredients!().map(|each| each.nutrients))
		serving! = || Plate.per_serving(whole!(), recipe!().servings)
		weight! = || ingredients!().fold(0.0, |sum, each| sum + each.grams)
		edit = LiveForm.filled!(PlateForm.recipe_edit, Api.post_recipes_id({ id: id }), [("name", recipe!().name), ("servings", recipe!().servings.to_str()), ("notes", recipe!().notes)])
		add = Endpoint.url_of(Api.post_recipes_id_ingredients({ id: id }))
		remove = Endpoint.url_of(Api.post_api_ingredients_delete({}))
		<article class="kitchen" class:stale={stale!()}>
			<Title>{recipe!().name} · Plate</Title>
			<header>
				<a class="back" href={Paths.recipes} aria-label="Back to the recipes">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
				</a>
				<div>
					<h1>{recipe!().name}</h1>
					<p class="quiet">{"${Servings.say(recipe!().servings)} · ${Plate.grams_label(weight!())} in all"}</p>
				</div>
			</header>
			<section class="card totals" aria-label="A serving">
				<div>
					<strong>{Plate.whole(serving!().kcal)} kcal</strong>
					<span class="quiet">a serving</span>
				</div>
				<p>{"Protein ${Plate.grams_label(serving!().protein)} · carbs ${Plate.grams_label(serving!().carbs)} · fat ${Plate.grams_label(serving!().fat)}"}</p>
				<a class="button" href={Links.food(recipe!().food, { day: "", meal: "" })}>Add a serving to the diary</a>
			</section>
			<section class="card" aria-labelledby="ingredients">
				<h2 id="ingredients">Ingredients</h2>
				<Show when!={!ingredients!().is_empty()} fallback={<p class="quiet">Nothing in it yet: search below for what goes in.</p>}>
					<ul class="rows">
						<For each!={ingredients!()} keyed={|each| each.id}>
							{|each!, _|
								<li transition:in={Transition.fade}>
									<a class="name" href={Links.food(each!().food, { day: "", meal: "" })}>{each!().name}</a>
									<span class="grams">{Plate.grams_label(each!().grams)}</span>
									<span class="kcal">{"${Plate.whole(each!().nutrients.kcal)} kcal"}</span>
									<form method="post" action={remove}>
										<input type="hidden" name="id" value={each!().id} />
										<button class="remove" type="submit" aria-label={"Take out ${each!().name}"}>
											<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
										</button>
									</form>
								</li>
							}
						</For>
					</ul>
				</Show>
			</section>
			<section class="card" aria-labelledby="add-ingredient">
				<h2 id="add-ingredient">Add an ingredient</h2>
				<form class="search" method="get" action={Paths.recipes_id({ id: id })} role="search">
					<label class="hidden" for="q">Search foods</label>
					<input id="q" type="search" name="q" value={query!()} placeholder="Search: oats, milk, honey…" autocomplete="off" on:input.value={set_query!} />
					<button class="button quiet" type="submit">Search</button>
				</form>
				<ul class="rows found" aria-label="Foods found">
					<For each!={kitchen!().hits} keyed={|hit| hit.id}>
						{|hit!, _|
							<li>
								<form class="pick" method="post" action={add}>
									<input type="hidden" name="food" value={hit!().id} />
									<span class="name">
										{Plate.full_name(hit!().name, hit!().brand)}
										<span class="quiet">{"${Plate.whole(hit!().kcal)} kcal / 100 g"}</span>
									</span>
									<input class="grams-input" name="grams" value="100" inputmode="decimal" aria-label={"Grams of ${hit!().name}"} />
									<span class="unit">g</span>
									<button class="button quiet" type="submit">Add</button>
								</form>
							</li>
						}
					</For>
				</ul>
			</section>
			<section class="card" aria-labelledby="about">
				<h2 id="about">About it</h2>
				<form class="about" method="post" action={edit.url()} novalidate>
					<TextField live={edit} name="name" label="Name" autocomplete="off" />
					<TextField live={edit} name="servings" label="Servings" hint="How many it makes." />
					<TextField live={edit} name="notes" label="Notes" hint="How it's made, or where it's from." autocomplete="off" />
					<button class="button quiet" type="submit" disabled?={edit.pending!()}>{if (edit.accepted!()) "Saved" else "Save"}</button>
				</form>
			</section>
		</article>
	}
}

## "1 serving", "4 servings".
Servings := [].{
	say : I64 -> Str
	say = |count| if (count == 1) "1 serving" else "${count.to_str()} servings"
}

## A recipe that isn't there: a 404.
NoRecipe := [].{
	view! : {} => Html
	view! = |{}|
		<section>
			<HttpStatusCode code={404} />
			<Title>No such recipe · Plate</Title>
			<h1>There's no such recipe</h1>
			<p><a href={Paths.recipes}>See your recipes</a></p>
		</section>
}

<style>
	.kitchen {
		display: grid;
		gap: 1rem;
		max-width: 44rem;
		transition: opacity 160ms;
	}

	.kitchen.stale {
		opacity: 0.8;
	}

	header {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	header p {
		margin: 0.2rem 0 0;
	}

	.back {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: var(--ink-soft);
	}

	svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.back svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.totals {
		display: grid;
		gap: 0.4rem;
		background: var(--accent-soft);
	}

	.totals strong {
		margin-right: 0.4rem;
		font-size: 1.5rem;
	}

	.totals p {
		margin: 0;
		color: var(--ink-soft);
	}

	.totals .button {
		justify-self: start;
	}

	section h2 {
		margin-bottom: 0.5rem;
	}

	.rows {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.rows > li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto auto;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0;
		border-top: 1px solid var(--line);
	}

	.rows > li:first-child {
		border-top: 0;
	}

	.found > li {
		display: block;
	}

	.name {
		display: grid;
		min-width: 0;
		color: var(--ink);
		font-weight: 550;
		text-decoration: none;
	}

	.name .quiet {
		font-size: 0.8rem;
		font-weight: 400;
	}

	.grams,
	.kcal {
		color: var(--ink-soft);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	form[method="post"]:not(.pick):not(.about) {
		display: contents;
	}

	.remove {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--ink-faint);
		cursor: pointer;
	}

	.remove:hover {
		background: var(--over-soft);
		color: var(--over);
	}

	.search {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.search input {
		flex: 1;
		min-width: 0;
		min-height: 2.75rem;
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.7rem;
	}

	.pick {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 4.5rem auto auto;
		align-items: center;
		gap: 0.4rem;
	}

	.grams-input {
		width: 100%;
		min-height: 2.5rem;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.55rem;
		text-align: right;
	}

	.unit {
		color: var(--ink-faint);
	}

	.about {
		display: grid;
	}

	.about button {
		justify-self: start;
	}

	.hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}
</style>
