import pf.Html
import pf.Solid exposing [create_memo!, is_pending!]
import pf.Server
import pf.Title
import pf.HttpStatusCode
import ../../../Plate
import ../../../Generated/Api
import ../../../Generated/Paths
import ../../../components/Diary

## A day of the diary other than today (`/days/2026-11-21`): the same `Diary`, its data its own
## URL's. An address that isn't a day is a 404 of its own.
meta = { title: "A day" }

view! = |{ params, .. }| {
	read = Api.get_api_days_day({ day: params.day })
	day! : () => Try(Plate.Day, Server.Problem)
	day! = create_memo!(|| read.send!({}))
	<>{match day!() {
		Ok(found) => <Diary day!={found} stale!={is_pending!(day!)} />
		Err(_) => <NotADay />
	}}</>
}

## An address that isn't a day of the diary: a 404.
NotADay := [].{
	view! : {} => Html
	view! = |{}|
		<section>
			<HttpStatusCode code={404} />
			<Title>No such day · Plate</Title>
			<h1>That isn't a day</h1>
			<p><a href={Paths.root}>Go to today</a></p>
		</section>
}
