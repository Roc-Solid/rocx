import pf.Html
import pf.Solid exposing [create_memo!]
import pf.Router exposing [use_action!, use_submissions!]
import pf.Endpoint
import pf.Server
import ../I18n
import ../Reaction
import ../Generated/Api

## A post's reactions (👏 ❤️ 💡 😄), the one island on its page. A click shows at once: the counts
## are the server's (`GET …/reactions`), with the toggles still on their way applied
## (`use_submissions!`'s `pending_inputs!`, folded with `Reaction.apply`). The toggle is sent
## without the click waiting for it (`use_action!`); once it is in, the counts are read again and
## the server's take the place of the ones shown. A refusal (too many at once: guard's rate limit)
## takes the toggle back, and says why.
##
## Each button is also a plain form, so without JavaScript a click posts the toggle and comes back
## to the page (`Endpoint.respond!`'s flash); with it, the click is taken over (`on:click.prevent`).
ReactionBar := [].{
	view! : { lang : Str, slug : Str } => Html
	view! = |{ lang, slug }| {
		intl = I18n.intl(lang)
		# The read named outside the memo: a computation's read that waits mustn't lose what it made.
		counts = Api.get_api_posts_lang_slug_reactions({ lang, slug })
		sender = Api.post_api_posts_lang_slug_reactions({ lang, slug })
		toggles = use_submissions!(sender)
		toggle! = use_action!(sender)
		shown! = create_memo!(
			|| {
				server = Endpoint.read!(counts)
				pending = toggles.pending_inputs!()
				server.map_ok(|tally| pending.fold(tally, Reaction.apply))
			},
		)
		# Shown once the server's counts are in: a post that isn't there has none, and nothing shows.
		# The arm's `tally` reads the newest counts, and its rows are a .map of their own.
		<>{match shown!() {
			Ok(tally) =>
				<section class="reactions" aria-labelledby="reactions-title">
					<h2 class="title" id="reactions-title">{intl.t("react.lead", [])}</h2>
					<ul class="kinds" aria-label={intl.t("react.label", [])}>
						{...Reaction.kinds.map(|kind|
							<li key={kind.id}>
								<form method="post" action={Endpoint.url_of(sender)}>
									<input type="hidden" name="kind" value={kind.id} />
									<input type="hidden" name="on" value={if (Reaction.given(tally, kind.id)) "false" else "true"} />
									<button
										type="submit"
										class="kind"
										class:mine={Reaction.given(tally, kind.id)}
										aria-pressed={if (Reaction.given(tally, kind.id)) "true" else "false"}
										on:click.prevent={|| toggle!({ kind: kind.id, on: if (Reaction.given(tally, kind.id)) "false" else "true" })}
									>
										<span class="emoji" aria-hidden="true">{kind.emoji}</span>
										<span class="label">{intl.t("react.${kind.id}", [])}</span>
										<span class="count">{intl.int(Reaction.count_of(tally, kind.id))}</span>
									</button>
								</form>
							</li>
						)}
					</ul>
					{...toggles.all!().keep_if(|sent| sent.error.is_ok()).map(|sent|
						<p key={sent.id} class="refused" role="alert">
							<span>{ReactionBar.why(lang, sent.error)}</span>
							<button type="button" class="dismiss" on:click={|| toggles.clear!(sent.id)}>{intl.t("react.dismiss", [])}</button>
						</p>
					)}
				</section>
			Err(_) => <></>
		}}</>
	}

	## Why a toggle was refused, as the page says it.
	why : Str, Try(Server.Problem, [NoError]) -> Str
	why = |lang, error| {
		intl = I18n.intl(lang)
		match error {
			Ok(Refused(429, _)) => intl.t("react.slow", [])
			Ok(Refused(_, said)) => intl.t("react.failed", [("why", Text(said))])
			Ok(problem) => intl.t("react.failed", [("why", Text(Server.explain(problem)))])
			Err(NoError) => ""
		}
	}

	<style>
		.reactions {
			max-width: var(--measure);
			margin: var(--space-6) auto 0;
			padding: var(--space-4) var(--space-5);
			border: 1px solid var(--rule);
			border-radius: calc(var(--radius) * 2);
			background: var(--surface);
		}

		.title {
			margin: 0 0 var(--space-3);
			font-family: var(--serif);
			font-size: var(--size-lg);
			font-style: italic;
			font-weight: 400;
		}

		.kinds {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		form {
			margin: 0;
		}

		.kind {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			padding: var(--space-2) var(--space-3);
			border: 1px solid var(--rule-strong);
			border-radius: 999px;
			background: var(--paper);
			color: var(--ink);
			font: inherit;
			font-size: var(--size-sm);
			cursor: pointer;
			transition: background 120ms, border-color 120ms, transform 120ms;
		}

		.kind:hover {
			border-color: var(--accent);
		}

		.kind:active {
			transform: scale(0.96);
		}

		.kind.mine {
			border-color: var(--accent);
			background: var(--accent-soft);
		}

		.emoji {
			font-size: 1.15rem;
			line-height: 1;
		}

		.count {
			min-width: 1.5ch;
			color: var(--ink-soft);
			font-variant-numeric: tabular-nums;
			font-weight: 650;
		}

		.refused {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			margin: var(--space-3) 0 0;
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius);
			background: var(--accent-soft);
			color: var(--ink);
			font-size: var(--size-sm);
		}

		.dismiss {
			padding: var(--space-1) var(--space-3);
			border: 1px solid var(--rule-strong);
			border-radius: 999px;
			background: transparent;
			color: inherit;
			font: inherit;
			cursor: pointer;
		}

		@media (max-width: 30rem) {
			.label {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}
		}

		@media print {
			.reactions {
				display: none;
			}
		}
	</style>
}
