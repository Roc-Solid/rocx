import pf.Html
import testing.Dom
import ../I18n
import ../Generated/Paths

## The index's pages: newer and older, and each page by number, the current one marked. Page 1 is
## the language's index itself (`/en`), the rest `/en/page/2`, ….
Pagination := [].{
	view : { lang : Str, page : U64, pages : U64 } -> Html
	view = |{ lang, page, pages }| {
		intl = I18n.intl(lang)
		url = |number| if (number <= 1) Paths.lang({ lang: lang }) else Paths.lang_page_number({ lang, number: number.to_str() })
		numbers = List.repeat(0, pages.to_u64()).map_with_index(|_, index| index + 1)
		if pages <= 1 {
			<></>
		} else {
			<nav class="pagination" aria-label={intl.t("pager.label", [])}>
				{=if (page > 1) <a class="step" rel="prev" href={url(page - 1)}>← {intl.t("pager.newer", [])}</a> else <span class="step" aria-hidden="true"></span>}
				<ol>
					{...numbers.map(|number| <li><a href={url(number)} aria-current??={if (number == page) "page" else ""} aria-label={intl.t("index.page", [("page", Int(number.to_i64_wrap())), ("pages", Int(pages.to_i64_wrap()))])}>{number.to_str()}</a></li>)}
				</ol>
				{=if (page < pages) <a class="step" rel="next" href={url(page + 1)}>{intl.t("pager.older", [])} →</a> else <span class="step" aria-hidden="true"></span>}
			</nav>
		}
	}

	<story name="Second of three">
		<Pagination lang="en" page={2} pages={3} />
	</story>

	<style>
		.pagination {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: var(--space-3);
			margin: var(--space-6) 0 0;
			font-size: var(--size-sm);
		}

		.step:last-child {
			justify-self: end;
		}

		ol {
			display: flex;
			gap: var(--space-1);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		ol a {
			display: grid;
			place-items: center;
			min-width: 2.25rem;
			height: 2.25rem;
			border-radius: 999px;
			color: var(--ink);
			text-decoration: none;
		}

		ol a:hover {
			background: var(--accent-soft);
		}

		ol a[aria-current="page"] {
			background: var(--ink);
			color: var(--paper);
		}
	</style>
}

pages : U64, U64 -> Dom
pages = |page, count| Dom.parse(Html.to_str(Pagination.view({ lang: "en", page, pages: count })))

expect pages(1, 1).count(Role("navigation")) == 0
expect pages(1, 3).texts(Role("link")) == ["1", "2", "3", "Older posts →"]
expect pages(2, 3).get(Named("link", "Page 2 of 3")).map_ok(|link| link.attr("aria-current")) == Ok(Ok("page"))
expect pages(3, 3).get(Named("link", "← Newer posts")).map_ok(|link| link.attr("href")) == Ok(Ok("/en/page/2"))
expect pages(2, 3).get(Named("link", "← Newer posts")).map_ok(|link| link.attr("href")) == Ok(Ok("/en"))
