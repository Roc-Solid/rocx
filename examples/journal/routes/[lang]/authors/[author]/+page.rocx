import pf.Html
import pf.Title
import ../../../../Authors
import ../../../../I18n
import ../../../../Ui/Listings

## A writer's page (`/en/authors/iris-vale`): who they are, and their posts.
view! = |{ params }|
	<>
		<Title>{Authors.name_of(params.author)} · Acme Journal</Title>
		<NoHydration>{=Listings.author(params.lang, params.author)}</NoHydration>
	</>
