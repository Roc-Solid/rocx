import pf.Html
import pf.Title
import ../../I18n
import ../../Ui/Listings

## A language's index (`/en`, `/pl`): its latest writing, newest first, a page of it.
view! = |{ params }|
	<>
		<Title>{I18n.t(params.lang, "site.tagline")} · Acme Journal</Title>
		<NoHydration>{=Listings.index(params.lang, "1")}</NoHydration>
	</>
