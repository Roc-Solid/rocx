import pf.Html
import pf.Endpoint
import pf.Server
import pf.Router exposing [use_submission!]
import pf.Router
import ../../Board
import ../../Generated/Api
import ../../Ui/Avatar

## Who you are: a name and a colour, kept in a cookie (no passwords). Pick someone who has joined
## already, or type a new name. A plain form: it works before the page's JavaScript has loaded, and
## without it. `?then=` says where to go after.
meta = { title: "Join · Board" }

## Everyone who has joined (`GET /join`). Its type is said here: in the browser's copy of the app,
## an endpoint has none.
people! : {} => List(Board.Person)
people! = |{}| Endpoint.get!(Api.get_join({}))

view! = |_| {
	then = Board.after_join(then_in(Router.location!({}).query))
	joining = use_submission!(Api.post_join({}))
	<main class="join">
		<h1><span class="mark" aria-hidden="true">▲</span> Board</h1>
		<p class="lead">Who are you? Pick a name and a colour: that's you on every board, for everyone else to see.</p>
		{if !people!({}).is_empty() {
			<section class="quick" aria-labelledby="quick-title">
				<h2 id="quick-title">Continue as</h2>
				<ul>
					{...people!({}).map(|person|
						<li key={person.id}>
							<form method="post" action={Endpoint.url_of(Api.post_join({}))}>
								<input type="hidden" name="name" value={person.name} />
								<input type="hidden" name="color" value={person.color} />
								<input type="hidden" name="then" value={then} />
								<button type="submit" class="person">
									{Avatar.view({ person: person, label: "" })}
									{person.name}
								</button>
							</form>
						</li>
					)}
				</ul>
			</section>
		}}
		<form class="new" method="post" action={Endpoint.url_of(Api.post_join({}))}>
			<h2>Someone new</h2>
			<input type="hidden" name="then" value={then} />
			<label for="join-name">Your name</label>
			<input id="join-name" name="name" maxlength="40" required autocomplete="nickname" value={joining.field!("name")} />
			<fieldset class="colors">
				<legend>Your colour</legend>
				{...Board.colors.map_with_index(|color, index| <label class="swatch" style:--swatch={color}><input type="radio" name="color" value={color} checked?={index == 0} /><span class="hidden">{"Colour ${(index + 1).to_str()}"}</span></label>)}
			</fieldset>
			<button type="submit" class="primary" disabled?={joining.pending!()}>Join</button>
			{match joining.error!() {
				Ok(problem) => <p class="problem" role="alert">{Server.explain(problem)}</p>
				Err(_) => <></>
			}}
		</form>
	</main>
}

## Where `?then=` says to go after (`%XX`-decoded), or `""`.
then_in : Str -> Str
then_in = |query|
	match query.split_on("&").find_first(|pair| pair.starts_with("then=")) {
		Ok(pair) => Server.decode_segment(pair.drop_prefix("then="))
		Err(_) => ""
	}

<style>
	.join {
		display: grid;
		gap: 1.5rem;
		max-width: 30rem;
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
	}

	h1 {
		margin: 0;
		font-size: 1.6rem;
		letter-spacing: -0.02em;
	}

	.mark {
		color: var(--accent);
	}

	.lead {
		margin: -0.75rem 0 0;
		color: var(--ink-soft);
	}

	h2 {
		margin: 0 0 0.6rem;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.quick ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.person {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.85rem 0.35rem 0.35rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--ink);
		font-weight: 600;
	}

	.person:hover {
		border-color: var(--accent);
	}

	.new {
		display: grid;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: calc(var(--radius) + 4px);
		background: var(--card);
	}

	.new > label {
		font-weight: 600;
	}

	.colors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.5rem 0;
		padding: 0;
		border: 0;
	}

	.colors legend {
		margin-bottom: 0.5rem;
		font-weight: 600;
	}

	.swatch {
		position: relative;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		background: var(--swatch);
		cursor: pointer;
	}

	.swatch input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}

	.swatch:has(input:checked) {
		box-shadow: 0 0 0 3px var(--card), 0 0 0 5px var(--swatch);
	}

	.swatch:has(input:focus-visible) {
		outline: 3px solid var(--focus);
		outline-offset: 4px;
	}

	.hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.problem {
		margin: 0;
		color: var(--danger);
	}
</style>
