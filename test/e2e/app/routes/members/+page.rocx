import pf.Html
import pf.Endpoint
import ../../Middlewares
import ../../Generated/Api

meta = { title: "Members" }

middleware = Middlewares.member

## Who is asking: this path's endpoint (`GET /members`, for JSON), behind the same middleware,
## which says who. The server answers it as it renders the page, and the page carries the answer.
who! : {} => Str
who! = |{}| Endpoint.get!(Api.get_members({}))

view! = |_|
	<>
		<p class="who">{who!({})}</p>
		<NoHydration>
			<p class="again">{who!({})}, said once</p>
		</NoHydration>
	</>
