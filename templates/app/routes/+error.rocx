import pf.Html

## What a path no page has shows (404), and a page that failed (500): what happened, and the way
## home.
meta = { title: "Not here" }

view! = |{ status, problem }|
	<section class="error" role="alert">
		<p class="code">{status.to_str()}</p>
		<h1>{if (status == 404) "There's nothing here" else "Something went wrong"}</h1>
		<p>{if (status == 404) "No page has this address." else problem}</p>
		<p><a href="/">Back home</a></p>
	</section>

<style>
	.error {
		display: grid;
		gap: 0.75rem;
	}

	.error p {
		margin: 0;
		color: var(--ink-soft);
	}

	.error .code {
		color: var(--accent);
		font-weight: 800;
		letter-spacing: 0.08em;
	}
</style>
