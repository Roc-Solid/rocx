import pf.Html
import pf.Solid exposing [create_memo!]
import pf.Endpoint
import pf.Errored
import pf.Router
import ../Generated/Api
import ../Generated/Styles
import ../components/Nav

## The document around every page: its head (the page's title, the stylesheet every component's
## `<style>` is in), the bar at the top (`Nav`: who is signed in, from `GET /api/me`), and the page.
## A story (a dev build's catalog, /__rocx/stories/…) is the component alone, without the bar.
view! = |{ meta, children, .. }| {
	me! = create_memo!(|| Endpoint.get!(Api.get_api_me({})))
	story! = create_memo!(|| Router.location!({}).path.starts_with("/__rocx/stories/"))
	<>
		<!doctype html>
		<html lang="en">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width, initial-scale=1" />
				<meta name="color-scheme" content="light dark" />
				<title>{"${meta.title} · {{title}}"}</title>
				<NoHydration>{Styles.style}</NoHydration>
			</head>
			<body>
				<a class="skip" href="#main">Skip to the page</a>
				{if !story!() {
					<Errored fallback={|_, _| Nav.view({ name: "{{title}}", email: "" })}>
						{Nav.view({ name: "{{title}}", email: me!().email })}
					</Errored>
				}}
				<main id="main">{...children}</main>
			</body>
		</html>
	</>
}

<style>
	/* The app's look, for every page: its colours as tokens on :root (light, and dark when the
	   system is), and the elements' defaults. Each component styles its own markup in its own
	   <style>, scoped to it; :global reaches every page. */
	:global {
		:root {
			--paper: #f7f7f4;
			--surface: #ffffff;
			--sunk: #f0efea;
			--ink: #1d1d1b;
			--ink-soft: #5e5d57;
			--ink-faint: #8d8b83;
			--line: #e4e2db;
			--line-strong: #cbc8bf;
			--accent: #3b5bdb;
			--accent-ink: #ffffff;
			--accent-soft: #e8edff;
			--danger: #c92a2a;
			--danger-soft: #fff0f0;
			--ok: #2b8a3e;
			--ok-soft: #e6f6ea;
			--radius: 10px;
			--sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
			--mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		}

		@media (prefers-color-scheme: dark) {
			:root {
				--paper: #141413;
				--surface: #1d1d1b;
				--sunk: #262624;
				--ink: #edece7;
				--ink-soft: #aeaca4;
				--ink-faint: #7d7b74;
				--line: #302f2c;
				--line-strong: #4a4844;
				--accent: #91a7ff;
				--accent-ink: #141413;
				--accent-soft: #232b4d;
				--danger: #ff8787;
				--danger-soft: #3a1d1d;
				--ok: #69db7c;
				--ok-soft: #1c3324;
			}
		}

		*,
		*::before,
		*::after {
			box-sizing: border-box;
		}

		body {
			margin: 0;
			min-height: 100vh;
			background: var(--paper);
			color: var(--ink);
			font: 16px/1.55 var(--sans);
		}

		h1,
		h2 {
			margin: 0;
			line-height: 1.2;
			letter-spacing: -0.01em;
		}

		h1 {
			font-size: 1.75rem;
		}

		h2 {
			font-size: 1.15rem;
		}

		a {
			color: var(--accent);
			text-underline-offset: 0.15em;
		}

		code {
			padding: 0.05em 0.3em;
			border-radius: 4px;
			background: var(--sunk);
			font-family: var(--mono);
			font-size: 0.88em;
		}

		label {
			font-weight: 600;
		}

		input {
			width: 100%;
			padding: 0.6rem 0.75rem;
			border: 1px solid var(--line-strong);
			border-radius: var(--radius);
			background: var(--surface);
			color: var(--ink);
			font: inherit;
		}

		button,
		.button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
			padding: 0.55rem 1rem;
			border: 1px solid var(--line-strong);
			border-radius: var(--radius);
			background: var(--surface);
			color: var(--ink);
			font: inherit;
			font-weight: 600;
			text-decoration: none;
			cursor: pointer;
		}

		button:hover:not(:disabled),
		.button:hover {
			border-color: var(--ink-faint);
		}

		button:disabled {
			cursor: default;
			opacity: 0.6;
		}

		.primary {
			border-color: var(--accent);
			background: var(--accent);
			color: var(--accent-ink);
		}

		.primary:hover:not(:disabled) {
			border-color: var(--accent);
			filter: brightness(1.08);
		}

		.quiet {
			border-color: transparent;
			background: transparent;
			color: var(--ink-soft);
		}

		.quiet:hover:not(:disabled) {
			border-color: transparent;
			background: var(--sunk);
			color: var(--ink);
		}

		:focus-visible {
			outline: 3px solid var(--accent);
			outline-offset: 2px;
		}

		.problem {
			margin: 0;
			padding: 0.6rem 0.8rem;
			border-radius: var(--radius);
			background: var(--danger-soft);
			color: var(--danger);
		}

		.card {
			padding: clamp(1.25rem, 4vw, 2rem);
			border: 1px solid var(--line);
			border-radius: calc(var(--radius) + 4px);
			background: var(--surface);
		}
	}

	.skip {
		position: absolute;
		left: 0.75rem;
		top: -3rem;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius);
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 700;
	}

	.skip:focus {
		top: 0.75rem;
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem);
	}
</style>
