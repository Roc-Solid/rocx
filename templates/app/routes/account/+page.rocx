import pf.Html
import pf.Endpoint
import pf.Server
import pf.Router exposing [use_submission!]
import qr.QrCode
import ../../Generated/Api

## Your account: the address you sign in with, every browser you are signed in on (with a way to
## sign out of all of them), and two-factor sign-in: set up with an authenticator app's QR code,
## turned on with its first code (the recovery codes shown once), turned off with a code. Only
## signed-in people get here: `+server.roc`, which answers what the page reads and posts, names
## `Middlewares.signed_in`, and a page that names no middleware runs behind its `+server.roc`'s. It
## sends anyone else to sign in, and back here after. The two-factor forms post to `two-factor/`.
meta = { title: "Your account" }

## The account, as `GET /account` says.
account! : {} => { email : Str, sessions : List({ id : Str, current : Bool, started : Str }), two_factor : { state : Str, secret : Str, uri : Str, recovery_codes : U64 } }
account! = |{}| Endpoint.get!(Api.get_account({}))

view! = |_| {
	me = account!({})
	# Read where it is shown, so it is read again after each of the two-factor forms.
	two_factor! = || account!({}).two_factor
	setting_up = use_submission!(Api.post_account_two_factor({}))
	confirming = use_submission!(Api.post_account_two_factor_confirm({}))
	stopping = use_submission!(Api.post_account_two_factor_off({}))
	<>
		<section class="who">
			<h1>Your account</h1>
			<p>You sign in as <strong>{me.email}</strong>.</p>
		</section>
		<section class="sessions card" aria-labelledby="sessions-title">
			<h2 id="sessions-title">Where you're signed in</h2>
			<ul>
				{...me.sessions.map(|session|
					<li key={session.id}>
						<span>{if (session.current) "This browser" else "Another browser"}</span>
						<span class="when">signed in {session.started}</span>
					</li>
				)}
			</ul>
			<form method="post" action={Endpoint.url_of(Api.post_account({}))}>
				<button type="submit">Sign out everywhere</button>
			</form>
		</section>
		<section class="two-factor card" aria-labelledby="two-factor-title">
			<h2 id="two-factor-title">Two-factor sign-in</h2>
			{match confirming.result!() {
				Ok(done) =>
					<div class="codes" role="status">
						<p><strong>It's on.</strong> Save these recovery codes somewhere safe. Each signs you in once in place of a code, if you lose your phone. They won't be shown again.</p>
						<ul>
							{...done.recovery_codes.map(|code| <li key={code}><code>{code}</code></li>)}
						</ul>
					</div>
				Err(_) => <></>
			}}
			{match two_factor!().state {
				"on" =>
					<form method="post" action={Endpoint.url_of(Api.post_account_two_factor_off({}))}>
						<p>On: signing in asks for the code your authenticator app shows. You have {two_factor!().recovery_codes} recovery codes left.</p>
						<label for="off-code">To turn it off, a code from your app or a recovery code</label>
						<input id="off-code" name="code" required autocomplete="one-time-code" autocapitalize="off" spellcheck="false" />
						<button type="submit">Turn off</button>
						{match stopping.error!() {
							Ok(problem) => <p class="problem" role="alert">{Server.explain(problem)}</p>
							Err(_) => <></>
						}}
					</form>
				"pending" =>
					<form method="post" action={Endpoint.url_of(Api.post_account_two_factor_confirm({}))}>
						<p>Scan this with your authenticator app, or type in the key below it. Then enter the code the app shows.</p>
						<div class="qr">
							<QrCode text={two_factor!().uri} label="A QR code for your authenticator app" />
						</div>
						<p class="key"><code>{two_factor!().secret}</code></p>
						<label for="confirm-code">The code your app shows</label>
						<input id="confirm-code" name="code" required inputmode="numeric" autocomplete="one-time-code" />
						<button type="submit" class="primary">Turn on</button>
						{match confirming.error!() {
							Ok(problem) => <p class="problem" role="alert">{Server.explain(problem)}</p>
							Err(_) => <></>
						}}
					</form>
				_ =>
					<form method="post" action={Endpoint.url_of(Api.post_account_two_factor({}))}>
						<p>Off. Turned on, signing in asks for a code from an authenticator app on your phone too, so a stolen email account isn't enough to get in.</p>
						<button type="submit" disabled?={setting_up.pending!()}>Set up</button>
					</form>
			}}
		</section>
	</>
}

<style>
	.who {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.who p {
		margin: 0;
		color: var(--ink-soft);
	}

	.sessions,
	.two-factor {
		display: grid;
		gap: 1rem;
	}

	.two-factor {
		margin-top: 1.5rem;
	}

	.two-factor form {
		display: grid;
		gap: 0.6rem;
	}

	.two-factor p {
		margin: 0;
	}

	.two-factor p:not(.problem) {
		color: var(--ink-soft);
	}

	.two-factor button {
		justify-self: start;
	}

	.qr {
		width: 12rem;
	}

	.key code {
		font-size: 1rem;
		letter-spacing: 0.05em;
	}

	.codes {
		display: grid;
		gap: 0.75rem;
		padding: 1rem;
		border-radius: var(--radius);
		background: var(--ok-soft);
	}

	.codes ul {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.25rem 1rem;
	}

	.codes li {
		padding: 0;
		border: 0;
	}

	ul {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line);
	}

	.when {
		color: var(--ink-faint);
		font-size: 0.9rem;
	}

	form {
		margin: 0;
	}
</style>
