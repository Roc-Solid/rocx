+/**
+ * A trace's events from when tracing started on: a trace may hold events from before it, the
+ * warmup's clicks among them, when the page's renderer (shared by same-site tabs) still traced from
+ * an earlier iteration; those aren't the measured run's. (Local patch for Roc Solid's runs: its
+ * pages' traces held them, and failed "at most one mousedown event is expected".)
+ */
+function sinceTracingStarted(entries: any[]): any[] {
+  const started = entries.find((e: any) => e.name === "TracingStartedInBrowser");
+  if (!started) return entries;
+  return entries.filter((e: any) => e.ph === "M" || !(+e.ts > 0) || +e.ts >= +started.ts);
+}
