import pf.Html
import pf.Solid exposing [create_selector!, create_signal!]
import ../Rows

## The benchmark's table, with the vanillajs entry's markup (the runner finds the buttons by id
## and the rows by their classes). Keyed: each row is kept by its id (`key={row.id}`), moved with
## it and dropped with it; a row whose data changed (`==`) runs its holes again, and no other does.
view! = |_| {
	(rows!, set_rows!) = create_signal!([])
	(selected!, set_selected!) = create_signal!(0)
	# Selecting a row runs the class holes of the row it leaves and the row it comes to, not every
	# row's (Solid's createSelector, as its entry does).
	is_selected! = create_selector!(selected!)
	(made!, set_made!) = create_signal!(Rows.start)
	more! = |count| {
		built = Rows.build(made!(), count)
		set_made!(built.made)
		built.rows
	}
	<div id="main">
		<div class="container">
			<div class="jumbotron">
				<div class="row">
					<div class="col-md-6"><h1>Roc Solid (keyed)</h1></div>
					<div class="col-md-6">
						<div class="row">
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="run" on:click={|| set_rows!(more!(1000))}>Create 1,000 rows</button></div>
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="runlots" on:click={|| set_rows!(more!(10000))}>Create 10,000 rows</button></div>
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="add" on:click={|| set_rows!(rows!().concat(more!(1000)))}>Append 1,000 rows</button></div>
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="update" on:click={|| set_rows!(Rows.updated(rows!()))}>Update every 10th row</button></div>
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="clear" on:click={|| set_rows!([])}>Clear</button></div>
							<div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="swaprows" on:click={|| set_rows!(Rows.swapped(rows!()))}>Swap Rows</button></div>
						</div>
					</div>
				</div>
			</div>
			<table class="table table-hover table-striped test-data">
				<tbody id="tbody">
					{...rows!().map(|row|
						<tr key={row.id} class:danger={is_selected!(row.id)}>
							<td class="col-md-1">{row.id.to_str()}</td>
							<td class="col-md-4"><a class="lbl" on:click={|| set_selected!(row.id)}>{row.label}</a></td>
							<td class="col-md-1"><a class="remove" on:click={|| set_rows!(Rows.removed(rows!(), row.id))}><span class="remove glyphicon glyphicon-remove" aria-hidden="true"></span></a></td>
							<td class="col-md-6"></td>
						</tr>
					)}
				</tbody>
			</table>
			<span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
		</div>
	</div>
}
